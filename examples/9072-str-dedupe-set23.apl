# مثال 9072 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 23)
# dedupe (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9072-str-dedupe-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("civic"), "civ", "حالة 1")
تأكد_يساوي(ف("mars"), "mars", "حالة 2")
تأكد_يساوي(ف("loop"), "lop", "حالة 3")
تأكد_يساوي(ف("moon"), "mon", "حالة 4")
تأكد_يساوي(ف("array"), "ary", "حالة 5")
