# مثال 6351 — طول الناتج بعد أخذ حروف آخر الأبجدية وتحويلها إلى (رقم الحرف)
# len of code applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6351-txt-late-code-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + str(ord(خ))+","
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 16, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 16, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 0, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 36, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 36, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 12, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 28, "حالة 8")
