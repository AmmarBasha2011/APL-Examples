# مثال 9749 — الجذر التربيعي الصحيح (مجموعة اختبار 20)
# sqrtint (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9749-num-sqrtint-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(3070), 55, "حالة 1")
تأكد_يساوي(ف(4104), 64, "حالة 2")
تأكد_يساوي(ف(2055), 45, "حالة 3")
تأكد_يساوي(ف(3359), 57, "حالة 4")
تأكد_يساوي(ف(2784), 52, "حالة 5")
