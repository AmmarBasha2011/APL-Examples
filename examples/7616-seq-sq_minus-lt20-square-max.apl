# مثال 7616 — أكبر قيمة: من مربع ناقص ي نأخذ الأصغر من 20 ثم (مربع)
# max over sq_minus sequence, keep lt20, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7616-seq-sq_minus-lt20-square-max.apl

# نولّد أول ن حد من: مربع ناقص ي
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي - ي
    لو خ < 20:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 144, "حالة 3")
تأكد_يساوي(ف(10), 144, "حالة 4")
تأكد_يساوي(ف(15), 144, "حالة 5")
