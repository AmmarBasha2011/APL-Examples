# مثال 8298 — آخر عنصر من المدى 0 إلى 100 بخطوة 10 بعد (زيادة واحد)
# last over range(0,100,10) mapped by inc
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8298-range-0-100-10-inc-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 100:
    ر = ر + [خ + 1]
    خ = خ + (10)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 91, "المدى كله")
