# مثال 8630 — المجموع من المدى 7 إلى 70 بخطوة 7 بعد (ثلاثة أضعاف)
# sum over range(7,70,7) mapped by triple
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8630-range-7-70-7-triple-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ * 3]
    خ = خ + (7)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 945, "المدى كله")
