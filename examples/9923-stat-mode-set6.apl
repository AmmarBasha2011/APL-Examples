# مثال 9923 — المنوال (الأصغر عند التساوي) (مجموعة 6)
# mode (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9923-stat-mode-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([1, 37, 11, 46, 5, 59]), 1, "حالة 1")
تأكد_يساوي(ف([-18, 42, 28, -16]), -18, "حالة 2")
تأكد_يساوي(ف([29, 8, 40, 32, 17]), 8, "حالة 3")
تأكد_يساوي(ف([12, 20, 10, -17, 54]), -17, "حالة 4")
