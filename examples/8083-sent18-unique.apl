# مثال 8083 — عدد الكلمات المختلفة في الجملة رقم 19
# unique for sentence 19
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8083-sent18-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("left right left left right"), 2, "حالة 1")
تأكد_يساوي(ف("to be or not to be"), 4, "حالة 2")
تأكد_يساوي(ف("we love data and data loves us"), 6, "حالة 3")
