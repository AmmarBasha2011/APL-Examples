# مثال 9600 — الجذر الرقمي (مجموعة اختبار 31)
# droot (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9600-num-droot-set31.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(48585), 3, "حالة 1")
تأكد_يساوي(ف(44125), 7, "حالة 2")
تأكد_يساوي(ف(2757), 3, "حالة 3")
تأكد_يساوي(ف(16456), 4, "حالة 4")
تأكد_يساوي(ف(87342), 6, "حالة 5")
