# مثال 5291 — مقارنة العدد مع 15
# Compare number with 15
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5291-triple-compare-15.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 15:
    ارجع "اصغر"
  والا_لو ن > 15:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(14), "اصغر", "حالة 1")
تأكد_يساوي(ف(15), "يساوي", "حالة 2")
تأكد_يساوي(ف(16), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
