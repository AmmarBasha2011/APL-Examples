# مثال 9379 — مجموع الأرقام (مجموعة اختبار 10)
# digsum (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9379-num-digsum-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(6863), 23, "حالة 1")
تأكد_يساوي(ف(35084), 20, "حالة 2")
تأكد_يساوي(ف(11427), 15, "حالة 3")
تأكد_يساوي(ف(53377), 25, "حالة 4")
تأكد_يساوي(ف(34937), 26, "حالة 5")
