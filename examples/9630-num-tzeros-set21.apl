# مثال 9630 — الأصفار في نهاية العاملي (مجموعة اختبار 21)
# tzeros (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9630-num-tzeros-set21.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(494), 120, "حالة 1")
تأكد_يساوي(ف(35), 8, "حالة 2")
تأكد_يساوي(ف(277), 68, "حالة 3")
تأكد_يساوي(ف(349), 84, "حالة 4")
تأكد_يساوي(ف(345), 84, "حالة 5")
