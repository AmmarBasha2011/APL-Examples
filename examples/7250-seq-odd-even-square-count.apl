# مثال 7250 — العدد: من الأعداد الفردية نأخذ الزوجي ثم (مربع)
# count over odd sequence, keep even, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7250-seq-odd-even-square-count.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ % 2 == 0:
      ر = ر + [خ * خ]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 0, "حالة 3")
تأكد_يساوي(ف(10), 0, "حالة 4")
تأكد_يساوي(ف(15), 0, "حالة 5")
