# مثال 10049 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 7)
# spread (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10049-stat-spread-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([18, -9, 39, 19, 34]), 27, "حالة 1")
تأكد_يساوي(ف([34, 15, 9, 27, 3]), 12, "حالة 2")
تأكد_يساوي(ف([-4, 30, 3, 1, 14, 38, 5, 13, 23]), 9, "حالة 3")
تأكد_يساوي(ف([16, 43, 30, 60, 10, 9, 12, 45]), 15, "حالة 4")
