# مثال 4520 — أكبر نتيجة ضعفها للأعداد التقبل القسمة على 3
# Largest (or 0) of double over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4520-pipeline-div3-double-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [خ * 2]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 60, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 6, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 18, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 12, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
