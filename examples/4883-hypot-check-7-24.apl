# مثال 4883 — هل مثلث أضلاعه مضاعفات (7,24) قائم؟
# Right triangle check with scale of (7,24)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4883-hypot-check-7-24.apl

# نتحقق من فيثاغورس: أ² + ب² = ج²

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, ج):
  أ = 7 * م
  ب = 24 * م
  ارجع أ * أ + ب * ب == ج * ج

تأكد_يساوي(ف(1, 1), خطأ, "حالة 1")
تأكد_يساوي(ف(1, 5), خطأ, "حالة 2")
تأكد_يساوي(ف(2, 10), خطأ, "حالة 3")
تأكد_يساوي(ف(3, 3), خطأ, "حالة 4")
