# مثال 6339 — أول 3 حروف من الناتج بعد أخذ الأرقام فقط وتحويلها إلى (رقم الحرف)
# head of code applied to digit chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6339-txt-digit-code-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ الأرقام فقط فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "0" و خ <= "9":
      ر = ر + str(ord(خ))+","
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "52,", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "49,", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "50,", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "", "حالة 8")
