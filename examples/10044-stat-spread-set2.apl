# مثال 10044 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 2)
# spread (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10044-stat-spread-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([57, -9, 59, 45, -16, 60, 27, 36]), 36, "حالة 1")
تأكد_يساوي(ف([-7, 38, 56, 16, 28, 34, 36]), 23, "حالة 2")
تأكد_يساوي(ف([-14, -9, 32, -11]), 41, "حالة 3")
تأكد_يساوي(ف([16, 26, 35, 55, 52, 26, 53]), 17, "حالة 4")
