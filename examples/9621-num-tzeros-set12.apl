# مثال 9621 — الأصفار في نهاية العاملي (مجموعة اختبار 12)
# tzeros (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9621-num-tzeros-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(36), 8, "حالة 1")
تأكد_يساوي(ف(50), 12, "حالة 2")
تأكد_يساوي(ف(128), 31, "حالة 3")
تأكد_يساوي(ف(193), 46, "حالة 4")
تأكد_يساوي(ف(71), 16, "حالة 5")
