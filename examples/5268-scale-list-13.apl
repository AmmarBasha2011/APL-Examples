# مثال 5268 — ضرب كل عنصر في 13
# Scale list by 13
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5268-scale-list-13.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 13]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [13, 26, 39], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -52, 130], "حالة 3")
