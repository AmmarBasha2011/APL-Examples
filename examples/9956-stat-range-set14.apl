# مثال 9956 — المدى (مجموعة 14)
# range (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9956-stat-range-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([36, 13, 51, 10, 54, 53, -8, 35, 44]), 62, "حالة 1")
تأكد_يساوي(ف([-11, 48, 38, 47, 50]), 61, "حالة 2")
تأكد_يساوي(ف([-7, 13, 15, -3, 56, -1, -13]), 69, "حالة 3")
تأكد_يساوي(ف([2, -14, -5, 41]), 55, "حالة 4")
