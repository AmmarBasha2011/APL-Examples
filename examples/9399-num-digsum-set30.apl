# مثال 9399 — مجموع الأرقام (مجموعة اختبار 30)
# digsum (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9399-num-digsum-set30.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(67658), 32, "حالة 1")
تأكد_يساوي(ف(69629), 32, "حالة 2")
تأكد_يساوي(ف(52894), 28, "حالة 3")
تأكد_يساوي(ف(18998), 35, "حالة 4")
تأكد_يساوي(ف(30437), 17, "حالة 5")
