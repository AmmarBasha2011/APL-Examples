# مثال 7901 — أول عنصر: من عكسية نأخذ الموجب ثم (زيادة واحد)
# first over rev sequence, keep pos, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7901-seq-rev-pos-inc-first.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ > 0:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 21, "حالة 2")
تأكد_يساوي(ف(5), 21, "حالة 3")
تأكد_يساوي(ف(10), 21, "حالة 4")
تأكد_يساوي(ف(15), 21, "حالة 5")
