# مثال 9623 — الأصفار في نهاية العاملي (مجموعة اختبار 14)
# tzeros (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9623-num-tzeros-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(227), 55, "حالة 1")
تأكد_يساوي(ف(120), 28, "حالة 2")
تأكد_يساوي(ف(26), 6, "حالة 3")
تأكد_يساوي(ف(370), 90, "حالة 4")
تأكد_يساوي(ف(293), 71, "حالة 5")
