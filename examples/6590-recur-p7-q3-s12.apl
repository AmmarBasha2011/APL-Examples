# مثال 6590 — متتالية a(n) = 7·a(n-1) + 3·a(n-2) تبدأ بـ 1,2
# Linear recurrence p=7 q=3 start 1,2
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6590-recur-p7-q3-s12.apl

# كل حد يعتمد على الحدين السابقين
# نحدّث زوجاً من المتغيرات في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = 1
  ص = 2
  لكل ي في range(ن):
    ت = 7 * ص + 3 * س
    س = ص
    ص = ت
  ارجع س

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(2), 17, "حالة 3")
تأكد_يساوي(ف(5), 6857, "حالة 4")
تأكد_يساوي(ف(8), 2784401, "حالة 5")
تأكد_يساوي(ف(12), 8372618801, "حالة 6")
