# مثال 9004 — حروف الكلمة مرتبة (مجموعة اختبار 35)
# sortchars (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9004-str-sortchars-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("galaxy"), "aaglxy", "حالة 1")
تأكد_يساوي(ف("loop"), "loop", "حالة 2")
تأكد_يساوي(ف("apple"), "aelpp", "حالة 3")
تأكد_يساوي(ف("deed"), "ddee", "حالة 4")
تأكد_يساوي(ف("comet"), "cemot", "حالة 5")
