# مثال 8230 — أكبر قيمة من المدى 5 إلى 50 بخطوة 5 بعد (مربع)
# max over range(5,50,5) mapped by square
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8230-range-5-50-5-square-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ * خ]
    خ = خ + (5)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 2025, "المدى كله")
