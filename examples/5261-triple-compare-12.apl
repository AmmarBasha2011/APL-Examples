# مثال 5261 — مقارنة العدد مع 12
# Compare number with 12
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5261-triple-compare-12.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 12:
    ارجع "اصغر"
  والا_لو ن > 12:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(11), "اصغر", "حالة 1")
تأكد_يساوي(ف(12), "يساوي", "حالة 2")
تأكد_يساوي(ف(13), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
