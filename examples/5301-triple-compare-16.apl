# مثال 5301 — مقارنة العدد مع 16
# Compare number with 16
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5301-triple-compare-16.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 16:
    ارجع "اصغر"
  والا_لو ن > 16:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(15), "اصغر", "حالة 1")
تأكد_يساوي(ف(16), "يساوي", "حالة 2")
تأكد_يساوي(ف(17), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
