# مثال 6627 — الأعداد التي باقيها 0 عند القسمة على 4
# Numbers with remainder 0 mod 4
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6627-residue-4-0.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 4 == 0:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [0, 4, 8], "حالة 2")
تأكد_يساوي(ف(40), [0, 4, 8, 12, 16, 20, 24, 28, 32, 36], "حالة 3")
تأكد_يساوي(ف(75), [0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60, 64, 68, 72], "حالة 4")
