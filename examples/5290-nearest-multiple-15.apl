# مثال 5290 — أقرب مضاعف للعدد 15
# Nearest multiple of 15
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5290-nearest-multiple-15.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 15
  لو ب * 2 < 15:
    ارجع ن - ب
  ارجع ن - ب + 15

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 0, "حالة 2")
تأكد_يساوي(ف(13), 15, "حالة 3")
تأكد_يساوي(ف(100), 105, "حالة 4")
تأكد_يساوي(ف(16), 15, "حالة 5")
