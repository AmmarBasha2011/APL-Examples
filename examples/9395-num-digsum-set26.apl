# مثال 9395 — مجموع الأرقام (مجموعة اختبار 26)
# digsum (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9395-num-digsum-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(95932), 28, "حالة 1")
تأكد_يساوي(ف(42089), 23, "حالة 2")
تأكد_يساوي(ف(22445), 17, "حالة 3")
تأكد_يساوي(ف(32496), 24, "حالة 4")
تأكد_يساوي(ف(82823), 23, "حالة 5")
