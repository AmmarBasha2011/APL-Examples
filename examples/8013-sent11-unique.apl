# مثال 8013 — عدد الكلمات المختلفة في الجملة رقم 12
# unique for sentence 12
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8013-sent11-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("up down up down up up down"), 2, "حالة 1")
تأكد_يساوي(ف("learn code learn more code more"), 3, "حالة 2")
تأكد_يساوي(ف("left right left left right"), 2, "حالة 3")
