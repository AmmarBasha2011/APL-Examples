# مثال 9756 — الجذر التربيعي الصحيح (مجموعة اختبار 27)
# sqrtint (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9756-num-sqrtint-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2335), 48, "حالة 1")
تأكد_يساوي(ف(47), 6, "حالة 2")
تأكد_يساوي(ف(1348), 36, "حالة 3")
تأكد_يساوي(ف(3359), 57, "حالة 4")
تأكد_يساوي(ف(834), 28, "حالة 5")
