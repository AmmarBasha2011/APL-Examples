# مثال 7284 — أصغر قيمة: من الأعداد الفردية نأخذ الأكبر من 5 ثم (مربع)
# min over odd sequence, keep gt5, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7284-seq-odd-gt5-square-min.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ > 5:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 49, "حالة 3")
تأكد_يساوي(ف(10), 49, "حالة 4")
تأكد_يساوي(ف(15), 49, "حالة 5")
