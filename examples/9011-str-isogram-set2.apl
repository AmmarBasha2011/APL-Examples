# مثال 9011 — هل لا يتكرر أي حرف (مجموعة اختبار 2)
# isogram (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9011-str-isogram-set2.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("python"), صواب, "حالة 1")
تأكد_يساوي(ف("venus"), صواب, "حالة 2")
تأكد_يساوي(ف("bob"), خطأ, "حالة 3")
تأكد_يساوي(ف("listen"), صواب, "حالة 4")
تأكد_يساوي(ف("racecar"), خطأ, "حالة 5")
