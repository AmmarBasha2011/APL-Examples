# مثال 10286 — تحويل وحدة إلى 25 وحدات صغرى والعكس
# Convert units with factor 25
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10286-unit-scale-25.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 25, ن // 25, ن % 25]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [25, 0, 1], "حالة 2")
تأكد_يساوي(ف(25), [625, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [25000, 40, 0], "حالة 4")
