# مثال 9180 — عكس حالة الأحرف (مجموعة اختبار 11)
# swapcase (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9180-str-swapcase-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("river"), "RIVER", "حالة 1")
تأكد_يساوي(ف("python"), "PYTHON", "حالة 2")
تأكد_يساوي(ف("enlist"), "ENLIST", "حالة 3")
تأكد_يساوي(ف("racecar"), "RACECAR", "حالة 4")
تأكد_يساوي(ف("planet"), "PLANET", "حالة 5")
