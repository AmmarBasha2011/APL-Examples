# مثال 4527 — عدد نتيجة سالبها للأعداد التقبل القسمة على 3
# Count of negated over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4527-pipeline-div3-negate-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [0 - خ]
  ارجع len(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 1, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 3, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 2, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 2, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
