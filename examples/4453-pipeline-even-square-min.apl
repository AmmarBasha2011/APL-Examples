# مثال 4453 — أصغر نتيجة مربعها للأعداد الزوجية
# Smallest (or 0) of square over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4453-pipeline-even-square-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 4, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 16, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 4, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 36, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
