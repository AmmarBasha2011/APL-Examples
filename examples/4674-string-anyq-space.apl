# مثال 4674 — هل يوجد (مسافة) في نص
# String: is there any space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4674-string-anyq-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو خ == " ":
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(ف("  spaced   out  text "), صواب, "حالة 1")
تأكد_يساوي(ف("aeiou AEIOU xyz"), صواب, "حالة 2")
تأكد_يساوي(ف("2026-11-28 launch"), صواب, "حالة 3")
تأكد_يساوي(ف("Data Science 101"), صواب, "حالة 4")
تأكد_يساوي(ف(""), خطأ, "حالة 5")
