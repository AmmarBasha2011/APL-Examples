# مثال 7048 — المجموع: من المربعات نأخذ مضاعفات 3 ثم (سالب)
# sum over squares sequence, keep m3, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7048-seq-squares-m3-neg-sum.apl

# نولّد أول ن حد من: المربعات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي
    لو خ % 3 == 0:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -9, "حالة 3")
تأكد_يساوي(ف(10), -126, "حالة 4")
تأكد_يساوي(ف(15), -270, "حالة 5")
