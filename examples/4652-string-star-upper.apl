# مثال 4652 — استبدال بنجمة (حرف كبير) في نص
# String: replace with star uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4652-string-star-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو خ.isupper():
      ن = ن + "*"
    والا:
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("  spaced   out  text "), "  spaced   out  text ", "حالة 1")
تأكد_يساوي(ف("apple PIE 7 and 9"), "apple *** 7 and 9", "حالة 2")
تأكد_يساوي(ف("Hello World 42"), "*ello *orld 42", "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), "a1b2c3d4", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
