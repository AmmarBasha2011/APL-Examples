# مثال 9985 — التباين الصحيح (مجموعة 18)
# variance (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9985-stat-variance-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([33, 30, 55, 31]), 106, "حالة 1")
تأكد_يساوي(ف([-5, 9, -7, 0]), 38, "حالة 2")
تأكد_يساوي(ف([50, 58, 29, 3, 43, 6]), 441, "حالة 3")
تأكد_يساوي(ف([-17, 41, -18, 44, 60, 36, 7, -3, 18]), 708, "حالة 4")
