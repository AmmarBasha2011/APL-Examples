# مثال 8422 — أكبر قيمة من المدى 10 إلى 0 بخطوة -1 بعد (سالب)
# max over range(10,0,-1) mapped by neg
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8422-range-10-0-n1-neg-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 10
  طالما خ > 0:
    ر = ر + [0 - خ]
    خ = خ + (-1)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), -1, "المدى كله")
