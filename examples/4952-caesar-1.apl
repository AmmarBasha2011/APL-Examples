# مثال 4952 — شيفرة قيصر بإزاحة 1
# Caesar cipher shift 1
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4952-caesar-1.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 1) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "bcd", "حالة 1")
تأكد_يساوي(ف("hello world"), "ifmmp xpsme", "حالة 2")
تأكد_يساوي(ف("xyz"), "yza", "حالة 3")
تأكد_يساوي(ف("a b-c"), "b c-d", "حالة 4")
