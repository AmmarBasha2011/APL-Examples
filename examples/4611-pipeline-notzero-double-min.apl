# مثال 4611 — أصغر نتيجة ضعفها للأعداد الغير الصفرية
# Smallest (or 0) of double over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4611-pipeline-notzero-double-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ * 2]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -10, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 14, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 8, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 2, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
