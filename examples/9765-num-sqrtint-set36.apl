# مثال 9765 — الجذر التربيعي الصحيح (مجموعة اختبار 36)
# sqrtint (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9765-num-sqrtint-set36.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(4855), 69, "حالة 1")
تأكد_يساوي(ف(609), 24, "حالة 2")
تأكد_يساوي(ف(3166), 56, "حالة 3")
تأكد_يساوي(ف(1502), 38, "حالة 4")
تأكد_يساوي(ف(215), 14, "حالة 5")
