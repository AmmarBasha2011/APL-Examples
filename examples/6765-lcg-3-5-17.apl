# مثال 6765 — مولّد أرقام عشوائية خطي (3,5,17)
# LCG a=3 c=5 m=17
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6765-lcg-3-5-17.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (3 * س + 5) % 17
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [8, 12, 7, 9, 15], "حالة 1")
تأكد_يساوي(ف(0, 8), [5, 3, 14, 13, 10, 1, 8, 12], "حالة 2")
تأكد_يساوي(ف(7, 10), [9, 15, 16, 2, 11, 4, 0, 5, 3, 14], "حالة 3")
