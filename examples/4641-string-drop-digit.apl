# مثال 4641 — حذف (رقم) في نص
# String: drop digit
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4641-string-drop-digit.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو ليس (خ.isdigit()):
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("2026-11-28 launch"), "-- launch", "حالة 1")
تأكد_يساوي(ف("  spaced   out  text "), "  spaced   out  text ", "حالة 2")
تأكد_يساوي(ف("MixedCASE123abc"), "MixedCASEabc", "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), "apple PIE  and ", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
