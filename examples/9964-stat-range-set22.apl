# مثال 9964 — المدى (مجموعة 22)
# range (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9964-stat-range-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([37, 53, -7, -14, 49, 40, -12, 45]), 67, "حالة 1")
تأكد_يساوي(ف([50, -9, 8, 59, 50, 57, 6]), 68, "حالة 2")
تأكد_يساوي(ف([60, -9, -4, -2, -6, 52, -18, 50, 60]), 78, "حالة 3")
تأكد_يساوي(ف([-1, 12, 47, -8, -14, 49, -19, 60]), 79, "حالة 4")
