# مثال 9422 — عكس الأرقام (مجموعة اختبار 13)
# revnum (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9422-num-revnum-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(7039), 9307, "حالة 1")
تأكد_يساوي(ف(90456), 65409, "حالة 2")
تأكد_يساوي(ف(82269), 96228, "حالة 3")
تأكد_يساوي(ف(26820), 2862, "حالة 4")
تأكد_يساوي(ف(65564), 46556, "حالة 5")
