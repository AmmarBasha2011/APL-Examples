# مثال 8835 — مجموع كل صف لمصفوفة قيمها i*3 - j*2
# Matrix rows for cell formula i*3 - j*2
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8835-mat-cross-rows.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * 3 - ك * 2]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل س في ق:
    م = 0
    لكل خ في س:
      م = م + خ
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [-2, 4], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [-6, 3, 12], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [-20, -5, 10, 25, 40], "حجم 5")
