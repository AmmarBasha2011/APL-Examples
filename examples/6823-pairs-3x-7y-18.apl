# مثال 6823 — عدد حلول 3س + 7ص = 18
# Count solutions of 3x+7y=18
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6823-pairs-3x-7y-18.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 3 * س + 7 * ص == 18:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 1, "حالة 3")
تأكد_يساوي(ف(18), 1, "حالة 4")
