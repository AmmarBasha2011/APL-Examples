# مثال 9466 — عدد القواسم (مجموعة اختبار 17)
# ndiv (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9466-num-ndiv-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(203), 4, "حالة 1")
تأكد_يساوي(ف(22), 4, "حالة 2")
تأكد_يساوي(ف(299), 4, "حالة 3")
تأكد_يساوي(ف(31), 2, "حالة 4")
تأكد_يساوي(ف(154), 8, "حالة 5")
