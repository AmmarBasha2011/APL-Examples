# مثال 9023 — هل لا يتكرر أي حرف (مجموعة اختبار 14)
# isogram (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9023-str-isogram-set14.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("deed"), خطأ, "حالة 1")
تأكد_يساوي(ف("pluto"), صواب, "حالة 2")
تأكد_يساوي(ف("noon"), خطأ, "حالة 3")
تأكد_يساوي(ف("star"), صواب, "حالة 4")
تأكد_يساوي(ف("banana"), خطأ, "حالة 5")
