# مثال 9618 — الأصفار في نهاية العاملي (مجموعة اختبار 9)
# tzeros (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9618-num-tzeros-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(478), 117, "حالة 1")
تأكد_يساوي(ف(198), 47, "حالة 2")
تأكد_يساوي(ف(406), 100, "حالة 3")
تأكد_يساوي(ف(420), 103, "حالة 4")
تأكد_يساوي(ف(307), 75, "حالة 5")
