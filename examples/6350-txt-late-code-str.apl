# مثال 6350 — النص الناتج بعد أخذ حروف آخر الأبجدية وتحويلها إلى (رقم الحرف)
# str of code applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6350-txt-late-code-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + str(ord(خ))+","
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "111,119,111,114,", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "112,115,117,110,", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "116,113,117,114,111,119,110,111,120,", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "122,122,122,121,121,121,120,120,120,", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "116,115,110,", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "112,114,111,114,110,110,114,", "حالة 8")
