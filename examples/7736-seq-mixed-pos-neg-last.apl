# مثال 7736 — آخر عنصر: من ي + 10 باقي 7 نأخذ الموجب ثم (سالب)
# last over mixed sequence, keep pos, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7736-seq-mixed-pos-neg-last.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ > 0:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -3, "حالة 2")
تأكد_يساوي(ف(5), -6, "حالة 3")
تأكد_يساوي(ف(10), -5, "حالة 4")
تأكد_يساوي(ف(15), -3, "حالة 5")
