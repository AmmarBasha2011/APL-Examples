# مثال 5231 — مقارنة العدد مع 9
# Compare number with 9
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5231-triple-compare-9.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 9:
    ارجع "اصغر"
  والا_لو ن > 9:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(8), "اصغر", "حالة 1")
تأكد_يساوي(ف(9), "يساوي", "حالة 2")
تأكد_يساوي(ف(10), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
