# مثال 4865 — محيط مضلع منتظم عدد أضلاعه 7
# Perimeter of regular 7-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4865-polygon-perimeter-7.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 7 * ض

تأكد_يساوي(ف(1), 7, "حالة 1")
تأكد_يساوي(ف(5), 35, "حالة 2")
تأكد_يساوي(ف(12), 84, "حالة 3")
تأكد_يساوي(ف(7), 49, "حالة 4")
