# مثال 8311 — أول عنصر من المدى 0 إلى 100 بخطوة 10 بعد (نصف صحيح)
# first over range(0,100,10) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8311-range-0-100-10-half-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 100:
    ر = ر + [خ // 2]
    خ = خ + (10)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 0, "المدى كله")
