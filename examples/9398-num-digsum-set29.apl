# مثال 9398 — مجموع الأرقام (مجموعة اختبار 29)
# digsum (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9398-num-digsum-set29.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(16287), 24, "حالة 1")
تأكد_يساوي(ف(82110), 12, "حالة 2")
تأكد_يساوي(ف(37716), 24, "حالة 3")
تأكد_يساوي(ف(77544), 27, "حالة 4")
تأكد_يساوي(ف(68758), 34, "حالة 5")
