# مثال 7692 — آخر عنصر: من ي + 10 باقي 7 نأخذ الأكبر من 5 ثم (ضعف)
# last over mixed sequence, keep gt5, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7692-seq-mixed-gt5-double-last.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ > 5:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 12, "حالة 3")
تأكد_يساوي(ف(10), 12, "حالة 4")
تأكد_يساوي(ف(15), 12, "حالة 5")
