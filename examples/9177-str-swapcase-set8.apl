# مثال 9177 — عكس حالة الأحرف (مجموعة اختبار 8)
# swapcase (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9177-str-swapcase-set8.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("noon"), "NOON", "حالة 1")
تأكد_يساوي(ف("refer"), "REFER", "حالة 2")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 3")
تأكد_يساوي(ف("tenet"), "TENET", "حالة 4")
تأكد_يساوي(ف("mars"), "MARS", "حالة 5")
