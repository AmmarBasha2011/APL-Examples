# مثال 4860 — مساحة مستطيل طوله 5 أضعاف عرضه
# Area of rectangle with length 5x width
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4860-rect-area-ratio-5.apl

# المساحة = العرض × الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ع):
  ارجع ع * (ع * 5)

تأكد_يساوي(ف(1), 5, "حالة 1")
تأكد_يساوي(ف(2), 20, "حالة 2")
تأكد_يساوي(ف(5), 125, "حالة 3")
تأكد_يساوي(ف(10), 500, "حالة 4")
