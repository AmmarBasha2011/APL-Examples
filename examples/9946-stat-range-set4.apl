# مثال 9946 — المدى (مجموعة 4)
# range (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9946-stat-range-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([53, -15, 25, 33, -13]), 68, "حالة 1")
تأكد_يساوي(ف([16, 51, -12, 43, 5, 30]), 63, "حالة 2")
تأكد_يساوي(ف([26, -20, -20]), 46, "حالة 3")
تأكد_يساوي(ف([29, 18, 22, -15, 42, 4, 49, 1, 31]), 64, "حالة 4")
