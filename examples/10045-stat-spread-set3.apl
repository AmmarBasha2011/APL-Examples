# مثال 10045 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 3)
# spread (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10045-stat-spread-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([39, 44, -6, 57, 54, 11, 35, 40]), 24, "حالة 1")
تأكد_يساوي(ف([22, 36, 50, 26, 1]), 21, "حالة 2")
تأكد_يساوي(ف([-5, -15, 49, 41, -7, 23, -13]), 28, "حالة 3")
تأكد_يساوي(ف([57, 2, 4]), 53, "حالة 4")
