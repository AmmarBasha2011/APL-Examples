# مثال 9587 — الجذر الرقمي (مجموعة اختبار 18)
# droot (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9587-num-droot-set18.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(63445), 4, "حالة 1")
تأكد_يساوي(ف(4175), 8, "حالة 2")
تأكد_يساوي(ف(84093), 6, "حالة 3")
تأكد_يساوي(ف(72116), 8, "حالة 4")
تأكد_يساوي(ف(77162), 5, "حالة 5")
