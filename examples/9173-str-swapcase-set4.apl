# مثال 9173 — عكس حالة الأحرف (مجموعة اختبار 4)
# swapcase (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9173-str-swapcase-set4.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("saturn"), "SATURN", "حالة 1")
تأكد_يساوي(ف("radar"), "RADAR", "حالة 2")
تأكد_يساوي(ف("deed"), "DEED", "حالة 3")
تأكد_يساوي(ف("silent"), "SILENT", "حالة 4")
تأكد_يساوي(ف("kayak"), "KAYAK", "حالة 5")
