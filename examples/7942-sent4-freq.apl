# مثال 7942 — تكرار كل كلمة في الجملة رقم 5
# freq for sentence 5
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7942-sent4-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("a rose is a rose is a rose"), {"a": 3, "rose": 3, "is": 2}, "حالة 1")
تأكد_يساوي(ف("run run run fast fast slow"), {"run": 3, "fast": 2, "slow": 1}, "حالة 2")
تأكد_يساوي(ف("up down up down up up down"), {"up": 4, "down": 3}, "حالة 3")
