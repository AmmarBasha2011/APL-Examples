# مثال 9428 — عكس الأرقام (مجموعة اختبار 19)
# revnum (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9428-num-revnum-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(80793), 39708, "حالة 1")
تأكد_يساوي(ف(7688), 8867, "حالة 2")
تأكد_يساوي(ف(4853), 3584, "حالة 3")
تأكد_يساوي(ف(41404), 40414, "حالة 4")
تأكد_يساوي(ف(19013), 31091, "حالة 5")
