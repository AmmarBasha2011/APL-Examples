# مثال 5004 — تكرار النص 9 مرات بفاصل
# Repeat text 9 times with separator
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/5004-repeat-str-9.apl

# نبني النص بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(9):
    ر = ر + [ن]
  ارجع "-".join(ر)

تأكد_يساوي(ف("a"), "a-a-a-a-a-a-a-a-a", "حالة 1")
تأكد_يساوي(ف("xy"), "xy-xy-xy-xy-xy-xy-xy-xy-xy", "حالة 2")
تأكد_يساوي(ف(""), "--------", "حالة 3")
