# مثال 4890 — تقسيم القيمة على 100 إلى (خارج, باقي)
# Split into quotient and remainder by 100
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4890-split-by-100.apl

# نستخدم // و %

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 100, ن % 100]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(99), [0, 99], "حالة 2")
تأكد_يساوي(ف(100), [1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [10, 0], "حالة 4")
تأكد_يساوي(ف(12345), [123, 45], "حالة 5")
