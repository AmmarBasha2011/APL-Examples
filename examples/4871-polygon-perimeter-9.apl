# مثال 4871 — محيط مضلع منتظم عدد أضلاعه 9
# Perimeter of regular 9-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4871-polygon-perimeter-9.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 9 * ض

تأكد_يساوي(ف(1), 9, "حالة 1")
تأكد_يساوي(ف(5), 45, "حالة 2")
تأكد_يساوي(ف(12), 108, "حالة 3")
تأكد_يساوي(ف(7), 63, "حالة 4")
