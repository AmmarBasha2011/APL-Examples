# مثال 7850 — العدد: من عكسية نأخذ الأكبر من 5 ثم (ضعف)
# count over rev sequence, keep gt5, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7850-seq-rev-gt5-double-count.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ > 5:
      ر = ر + [خ * 2]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 5, "حالة 3")
تأكد_يساوي(ف(10), 8, "حالة 4")
تأكد_يساوي(ف(15), 8, "حالة 5")
