# مثال 4457 — آخر نتيجة ضعفها للأعداد الزوجية
# Last (or -1) of double over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4457-pipeline-even-double-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * 2]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 12, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 8, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 16, "حالة 3")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 84, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
