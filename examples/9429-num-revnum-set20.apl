# مثال 9429 — عكس الأرقام (مجموعة اختبار 20)
# revnum (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9429-num-revnum-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(70542), 24507, "حالة 1")
تأكد_يساوي(ف(69753), 35796, "حالة 2")
تأكد_يساوي(ف(50022), 22005, "حالة 3")
تأكد_يساوي(ف(53347), 74335, "حالة 4")
تأكد_يساوي(ف(19124), 42191, "حالة 5")
