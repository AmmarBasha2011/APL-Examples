# مثال 9689 — هل العدد أرمسترونغ (مجموعة اختبار 40)
# arm (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9689-num-arm-set40.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(702), خطأ, "حالة 1")
تأكد_يساوي(ف(826), خطأ, "حالة 2")
تأكد_يساوي(ف(565), خطأ, "حالة 3")
تأكد_يساوي(ف(293), خطأ, "حالة 4")
تأكد_يساوي(ف(783), خطأ, "حالة 5")
