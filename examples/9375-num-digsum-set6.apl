# مثال 9375 — مجموع الأرقام (مجموعة اختبار 6)
# digsum (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9375-num-digsum-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(42434), 17, "حالة 1")
تأكد_يساوي(ف(66645), 27, "حالة 2")
تأكد_يساوي(ف(81268), 25, "حالة 3")
تأكد_يساوي(ف(1111), 4, "حالة 4")
تأكد_يساوي(ف(34725), 21, "حالة 5")
