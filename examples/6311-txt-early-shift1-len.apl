# مثال 6311 — طول الناتج بعد أخذ حروف أول الأبجدية وتحويلها إلى (الحرف التالي)
# len of shift1 applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6311-txt-early-shift1-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: الحرف التالي
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + chr(ord(خ) + 1)
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 6, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 4, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 3, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 7, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 0, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 8, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 12, "حالة 8")
