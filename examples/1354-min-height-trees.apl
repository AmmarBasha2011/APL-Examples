# مثال 1354 — أشجار أقل ارتفاعاً
# Minimum height trees roots
# Demonstrates: رسوم بيانية
#
# Run:  python apl.py examples/1354-min-height-trees.apl

# نقشر الأوراق طبقة بعد طبقة
# ما يبقى في النهاية هو المركز

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة جذور_دنيا(ن, حواف):
  لو ن == 1:
    ارجع [0]
  جيران = []
  لكل ع في نطاق(ن):
    جيران = جيران + [[]]
  لكل ح في حواف:
    جيران[ح[0]] = جيران[ح[0]] + [ح[1]]
    جيران[ح[1]] = جيران[ح[1]] + [ح[0]]
  اوراق = []
  لكل ع في نطاق(ن):
    لو طول(جيران[ع]) == 1:
      اوراق = اوراق + [ع]
  متبقي = ن
  طالما متبقي > 2:
    متبقي = متبقي - طول(اوراق)
    جديدة = []
    لكل ور في اوراق:
      ج = جيران[ور][0]
      جيران[ج].remove(ور)
      لو طول(جيران[ج]) == 1:
        جديدة = جديدة + [ج]
    اوراق = جديدة
  ارجع sorted(اوراق)

تأكد_يساوي(جذور_دنيا(4, [[1,0],[1,2],[1,3]]), [1], "جذر واحد")
تأكد_يساوي(جذور_دنيا(6, [[3,0],[3,1],[3,2],[3,4],[5,4]]), [3,4], "جذران")
تأكد_يساوي(جذور_دنيا(1, []), [0], "عقدة")
