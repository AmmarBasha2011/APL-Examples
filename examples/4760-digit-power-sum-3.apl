# مثال 4760 — مجموع قوى الأرقام (القوة 3)
# Sum of digits raised to 3
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4760-digit-power-sum-3.apl

# نرفع كل رقم لقوة ثابتة
# ونجمع النتائج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ج = 0
  لكل د في str(ن):
    ج = ج + int(د) ** 3
  ارجع ج

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(9), 729, "حالة 2")
تأكد_يساوي(ف(153), 153, "حالة 3")
تأكد_يساوي(ف(407), 407, "حالة 4")
تأكد_يساوي(ف(9474), 1200, "حالة 5")
