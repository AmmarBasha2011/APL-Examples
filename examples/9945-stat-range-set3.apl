# مثال 9945 — المدى (مجموعة 3)
# range (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9945-stat-range-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([-6, 32, 39]), 45, "حالة 1")
تأكد_يساوي(ف([14, 56, 34, 42, 59, 15]), 45, "حالة 2")
تأكد_يساوي(ف([-15, 2, 16, -16]), 32, "حالة 3")
تأكد_يساوي(ف([36, 3, -5, -8]), 44, "حالة 4")
