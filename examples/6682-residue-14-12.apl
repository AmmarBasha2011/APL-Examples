# مثال 6682 — الأعداد التي باقيها 12 عند القسمة على 14
# Numbers with remainder 12 mod 14
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6682-residue-14-12.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 14 == 12:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [], "حالة 2")
تأكد_يساوي(ف(40), [12, 26], "حالة 3")
تأكد_يساوي(ف(75), [12, 26, 40, 54, 68], "حالة 4")
