# مثال 5298 — ضرب كل عنصر في 16
# Scale list by 16
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5298-scale-list-16.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 16]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [16, 32, 48], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -64, 160], "حالة 3")
