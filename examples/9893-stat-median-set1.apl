# مثال 9893 — الوسيط (بعد الترتيب) (مجموعة 1)
# median (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9893-stat-median-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([53, -10, 42, 13, -16, -20, -2, 55, 40]), 13, "حالة 1")
تأكد_يساوي(ف([27, 20, -18, 14, 42, 5, 32, 48, 49]), 27, "حالة 2")
تأكد_يساوي(ف([-8, 4, 52, 50, 13, 58, -9, 34]), 23, "حالة 3")
تأكد_يساوي(ف([-9, 26, 32, 12, 36]), 26, "حالة 4")
