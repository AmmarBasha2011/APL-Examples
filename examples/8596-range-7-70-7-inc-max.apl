# مثال 8596 — أكبر قيمة من المدى 7 إلى 70 بخطوة 7 بعد (زيادة واحد)
# max over range(7,70,7) mapped by inc
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8596-range-7-70-7-inc-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ + 1]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 64, "المدى كله")
