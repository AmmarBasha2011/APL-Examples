# مثال 4472 — أكبر نتيجة ناقص 3 للأعداد الزوجية
# Largest (or 0) of minus 3 over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4472-pipeline-even-minus3-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 39, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 7, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 13, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 17, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
