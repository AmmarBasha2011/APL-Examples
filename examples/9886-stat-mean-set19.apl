# مثال 9886 — المتوسط الصحيح (مجموعة 19)
# mean (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9886-stat-mean-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([27, -5, -13, 5, -6, 28, 3, 25]), 8, "حالة 1")
تأكد_يساوي(ف([37, -13, 38, 43, 32, 59]), 32, "حالة 2")
تأكد_يساوي(ف([33, 18, -19]), 10, "حالة 3")
تأكد_يساوي(ف([51, -9, 59, -20, -14, 11]), 13, "حالة 4")
