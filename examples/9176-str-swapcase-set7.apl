# مثال 9176 — عكس حالة الأحرف (مجموعة اختبار 7)
# swapcase (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9176-str-swapcase-set7.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("rocket"), "ROCKET", "حالة 1")
تأكد_يساوي(ف("listen"), "LISTEN", "حالة 2")
تأكد_يساوي(ف("refer"), "REFER", "حالة 3")
تأكد_يساوي(ف("bob"), "BOB", "حالة 4")
تأكد_يساوي(ف("comet"), "COMET", "حالة 5")
