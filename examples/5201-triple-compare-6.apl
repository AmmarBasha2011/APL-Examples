# مثال 5201 — مقارنة العدد مع 6
# Compare number with 6
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5201-triple-compare-6.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 6:
    ارجع "اصغر"
  والا_لو ن > 6:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(5), "اصغر", "حالة 1")
تأكد_يساوي(ف(6), "يساوي", "حالة 2")
تأكد_يساوي(ف(7), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
