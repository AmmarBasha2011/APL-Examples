# مثال 5158 — ضرب كل عنصر في 2
# Scale list by 2
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5158-scale-list-2.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 2]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [2, 4, 6], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -8, 20], "حالة 3")
