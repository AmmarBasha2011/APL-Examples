# مثال 8095 — عدد الكلمات المكررة في الجملة رقم 20
# repeated for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8095-sent19-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("yes no yes yes no maybe"), 2, "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), 2, "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), 3, "حالة 3")
