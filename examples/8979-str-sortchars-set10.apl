# مثال 8979 — حروف الكلمة مرتبة (مجموعة اختبار 10)
# sortchars (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8979-str-sortchars-set10.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("radar"), "aadrr", "حالة 1")
تأكد_يساوي(ف("array"), "aarry", "حالة 2")
تأكد_يساوي(ف("deed"), "ddee", "حالة 3")
تأكد_يساوي(ف("earth"), "aehrt", "حالة 4")
تأكد_يساوي(ف("refer"), "eefrr", "حالة 5")
