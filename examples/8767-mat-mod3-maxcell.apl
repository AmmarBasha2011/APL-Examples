# مثال 8767 — أكبر خانة لمصفوفة قيمها (i*2+j) % 3
# Matrix maxcell for cell formula (i*2+j) % 3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8767-mat-mod3-maxcell.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [(ي * 2 + ك) % 3]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  م = ق[0][0]
  لكل س في ق:
    لكل خ في س:
      م = max(م, خ)
  ارجع م

تأكد_يساوي(ف(بناء(1)), 0, "حجم 1")
تأكد_يساوي(ف(بناء(2)), 2, "حجم 2")
تأكد_يساوي(ف(بناء(3)), 2, "حجم 3")
تأكد_يساوي(ف(بناء(5)), 2, "حجم 5")
