# مثال 9540 — خطوات كولاتز (مجموعة اختبار 11)
# collatz (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9540-num-collatz-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(19), 20, "حالة 1")
تأكد_يساوي(ف(47), 104, "حالة 2")
تأكد_يساوي(ف(105), 38, "حالة 3")
تأكد_يساوي(ف(84), 9, "حالة 4")
تأكد_يساوي(ف(50), 24, "حالة 5")
