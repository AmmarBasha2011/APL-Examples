# مثال 5282 — مجموع تراكمي مع زيادة 14
# Running total plus 14 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5282-cumulative-14.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 14
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [15, 31, 48], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [19, 38, 57, 76], "حالة 3")
