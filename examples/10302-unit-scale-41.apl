# مثال 10302 — تحويل وحدة إلى 41 وحدات صغرى والعكس
# Convert units with factor 41
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10302-unit-scale-41.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 41, ن // 41, ن % 41]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [41, 0, 1], "حالة 2")
تأكد_يساوي(ف(41), [1681, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [41000, 24, 16], "حالة 4")
