# مثال 10276 — تحويل وحدة إلى 15 وحدات صغرى والعكس
# Convert units with factor 15
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10276-unit-scale-15.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 15, ن // 15, ن % 15]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [15, 0, 1], "حالة 2")
تأكد_يساوي(ف(15), [225, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [15000, 66, 10], "حالة 4")
