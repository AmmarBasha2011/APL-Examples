# مثال 5200 — أقرب مضاعف للعدد 6
# Nearest multiple of 6
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5200-nearest-multiple-6.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 6
  لو ب * 2 < 6:
    ارجع ن - ب
  ارجع ن - ب + 6

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 6, "حالة 2")
تأكد_يساوي(ف(13), 12, "حالة 3")
تأكد_يساوي(ف(100), 102, "حالة 4")
تأكد_يساوي(ف(7), 6, "حالة 5")
