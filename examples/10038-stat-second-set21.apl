# مثال 10038 — ثاني أكبر قيمة مختلفة (مجموعة 21)
# second (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10038-stat-second-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([-5, 8, -18, -3, 21]), 8, "حالة 1")
تأكد_يساوي(ف([29, 7, -20, 43, 10, 57, 19]), 43, "حالة 2")
تأكد_يساوي(ف([38, -6, -20, 45, -10, -12, -5, 41, 36]), 41, "حالة 3")
تأكد_يساوي(ف([14, 43, 16, 5, -1]), 16, "حالة 4")
