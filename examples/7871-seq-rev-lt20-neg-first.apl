# مثال 7871 — أول عنصر: من عكسية نأخذ الأصغر من 20 ثم (سالب)
# first over rev sequence, keep lt20, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7871-seq-rev-lt20-neg-first.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ < 20:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -18, "حالة 3")
تأكد_يساوي(ف(10), -18, "حالة 4")
تأكد_يساوي(ف(15), -18, "حالة 5")
