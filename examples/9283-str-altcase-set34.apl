# مثال 9283 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 34)
# altcase (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9283-str-altcase-set34.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("refer"), "ReFeR", "حالة 1")
تأكد_يساوي(ف("kayak"), "KaYaK", "حالة 2")
تأكد_يساوي(ف("planet"), "PlAnEt", "حالة 3")
تأكد_يساوي(ف("radar"), "RaDaR", "حالة 4")
تأكد_يساوي(ف("data"), "DaTa", "حالة 5")
