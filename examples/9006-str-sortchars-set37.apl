# مثال 9006 — حروف الكلمة مرتبة (مجموعة اختبار 37)
# sortchars (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9006-str-sortchars-set37.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("planet"), "aelnpt", "حالة 1")
تأكد_يساوي(ف("apple"), "aelpp", "حالة 2")
تأكد_يساوي(ف("array"), "aarry", "حالة 3")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 4")
تأكد_يساوي(ف("earth"), "aehrt", "حالة 5")
