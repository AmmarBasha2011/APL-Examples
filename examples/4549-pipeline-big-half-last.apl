# مثال 4549 — آخر نتيجة نصفها بالقسمة الصحيحة للأعداد الأكبر من 10
# Last (or -1) of integer half over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4549-pipeline-big-half-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ // 2]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 12, "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 6, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 7, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 6, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
