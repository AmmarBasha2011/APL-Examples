# مثال 9238 — الحرف الأوسط (مجموعة اختبار 29)
# midchar (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9238-str-midchar-set29.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("kayak"), "y", "حالة 1")
تأكد_يساوي(ف("noon"), "o", "حالة 2")
تأكد_يساوي(ف("rocket"), "k", "حالة 3")
تأكد_يساوي(ف("rotor"), "t", "حالة 4")
تأكد_يساوي(ف("apple"), "p", "حالة 5")
