# مثال 10344 — تحويل 62 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 62 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10344-temp-c-62.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 62) * 9 // 5 + 32

تأكد_يساوي(ف(0), 143, "حالة 1")
تأكد_يساوي(ف(10), 161, "حالة 2")
تأكد_يساوي(ف(37), 210, "حالة 3")
تأكد_يساوي(ف(-5), 134, "حالة 4")
