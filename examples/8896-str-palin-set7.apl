# مثال 8896 — هل الكلمة متناظرة (مجموعة اختبار 7)
# palin (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8896-str-palin-set7.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("deed"), صواب, "حالة 1")
تأكد_يساوي(ف("radar"), صواب, "حالة 2")
تأكد_يساوي(ف("planet"), خطأ, "حالة 3")
تأكد_يساوي(ف("saturn"), خطأ, "حالة 4")
تأكد_يساوي(ف("galaxy"), خطأ, "حالة 5")
