# مثال 7891 — العدد: من عكسية نأخذ الموجب ثم (سالب)
# count over rev sequence, keep pos, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7891-seq-rev-pos-neg-count.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ > 0:
      ر = ر + [0 - خ]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 5, "حالة 3")
تأكد_يساوي(ف(10), 10, "حالة 4")
تأكد_يساوي(ف(15), 10, "حالة 5")
