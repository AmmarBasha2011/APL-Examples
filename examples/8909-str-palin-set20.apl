# مثال 8909 — هل الكلمة متناظرة (مجموعة اختبار 20)
# palin (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8909-str-palin-set20.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("river"), خطأ, "حالة 1")
تأكد_يساوي(ف("sun"), خطأ, "حالة 2")
تأكد_يساوي(ف("orbit"), خطأ, "حالة 3")
تأكد_يساوي(ف("enlist"), خطأ, "حالة 4")
تأكد_يساوي(ف("rotor"), صواب, "حالة 5")
