# مثال 7595 — آخر عنصر: من مربع ناقص ي نأخذ الفردي ثم (سالب)
# last over sq_minus sequence, keep odd, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7595-seq-sq_minus-odd-neg-last.apl

# نولّد أول ن حد من: مربع ناقص ي
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي - ي
    لو خ % 2 == 1:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -1, "حالة 3")
تأكد_يساوي(ف(10), -1, "حالة 4")
تأكد_يساوي(ف(15), -1, "حالة 5")
