# مثال 9459 — عدد القواسم (مجموعة اختبار 10)
# ndiv (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9459-num-ndiv-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(45), 6, "حالة 1")
تأكد_يساوي(ف(112), 10, "حالة 2")
تأكد_يساوي(ف(299), 4, "حالة 3")
تأكد_يساوي(ف(204), 12, "حالة 4")
تأكد_يساوي(ف(91), 4, "حالة 5")
