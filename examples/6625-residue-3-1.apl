# مثال 6625 — الأعداد التي باقيها 1 عند القسمة على 3
# Numbers with remainder 1 mod 3
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6625-residue-3-1.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 3 == 1:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [1, 4, 7], "حالة 2")
تأكد_يساوي(ف(40), [1, 4, 7, 10, 13, 16, 19, 22, 25, 28, 31, 34, 37], "حالة 3")
تأكد_يساوي(ف(75), [1, 4, 7, 10, 13, 16, 19, 22, 25, 28, 31, 34, 37, 40, 43, 46, 49, 52, 55, 58, 61, 64, 67, 70, 73], "حالة 4")
