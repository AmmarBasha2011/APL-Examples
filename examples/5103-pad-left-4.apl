# مثال 5103 — ملء النص من اليسار حتى عرض 4
# Left pad to width 4
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5103-pad-left-4.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 4:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "0007", "حالة 1")
تأكد_يساوي(ف("123"), "0123", "حالة 2")
تأكد_يساوي(ف("1111"), "1111", "حالة 3")
تأكد_يساوي(ف(""), "0000", "حالة 4")
