# مثال 8188 — أكبر قيمة من المدى 1 إلى 30 بخطوة 2 بعد (نصف صحيح)
# max over range(1,30,2) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8188-range-1-30-2-half-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [خ // 2]
    خ = خ + (2)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 14, "المدى كله")
