# مثال 6347 — الناتج معكوس بعد أخذ حروف أول الأبجدية وتحويلها إلى (رقم الحرف)
# rev of code applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6347-txt-early-code-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + str(ord(خ))+","
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), ",001,801,801,801,101,401", "حالة 1")
تأكد_يساوي(ف("apl is fun"), ",201,501,801,79", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), ",99,89,79", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), ",201,89,701,99,501,101,401", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), ",101,99,101,501,99,79,79,001", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), ",99,501,89,79,79,501,301,501,901,901,79,301", "حالة 8")
