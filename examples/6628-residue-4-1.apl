# مثال 6628 — الأعداد التي باقيها 1 عند القسمة على 4
# Numbers with remainder 1 mod 4
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6628-residue-4-1.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 4 == 1:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [1, 5, 9], "حالة 2")
تأكد_يساوي(ف(40), [1, 5, 9, 13, 17, 21, 25, 29, 33, 37], "حالة 3")
تأكد_يساوي(ف(75), [1, 5, 9, 13, 17, 21, 25, 29, 33, 37, 41, 45, 49, 53, 57, 61, 65, 69, 73], "حالة 4")
