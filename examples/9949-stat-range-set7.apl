# مثال 9949 — المدى (مجموعة 7)
# range (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9949-stat-range-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([47, 50, 45, 44, -2, 31, 41, -13, 58]), 71, "حالة 1")
تأكد_يساوي(ف([-14, 31, 41]), 55, "حالة 2")
تأكد_يساوي(ف([34, 27, -14, -10, 60]), 74, "حالة 3")
تأكد_يساوي(ف([17, -17, 45, 51]), 68, "حالة 4")
