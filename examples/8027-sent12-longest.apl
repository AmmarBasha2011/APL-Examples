# مثال 8027 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 13
# longest for sentence 13
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8027-sent12-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("cairo is big and cairo is old"), "cairo", "حالة 1")
تأكد_يساوي(ف("stars and moon and stars again"), "stars", "حالة 2")
تأكد_يساوي(ف("yes no yes yes no maybe"), "maybe", "حالة 3")
