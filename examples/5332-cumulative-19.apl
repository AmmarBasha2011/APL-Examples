# مثال 5332 — مجموع تراكمي مع زيادة 19
# Running total plus 19 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5332-cumulative-19.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 19
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [20, 41, 63], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [24, 48, 72, 96], "حالة 3")
