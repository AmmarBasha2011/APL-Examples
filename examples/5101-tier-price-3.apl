# مثال 5101 — سعر متدرج بحد 3
# Tiered price with cutoff 3
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5101-tier-price-3.apl

# أول 3 وحدات بسعر 3 والباقي بسعر 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن <= 3:
    ارجع ن * 3
  ارجع 3 * 3 + (ن - 3) * 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(3), 9, "حالة 3")
تأكد_يساوي(ف(8), 19, "حالة 4")
تأكد_يساوي(ف(9), 21, "حالة 5")
