# مثال 4653 — أول موضع (حرف كبير) في نص
# String: first position of uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4653-string-first-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  لكل خ في س:
    لو خ.isupper():
      ارجع ر
    ر = ر + 1
  ارجع -1

تأكد_يساوي(ف("aeiou AEIOU xyz"), 6, "حالة 1")
تأكد_يساوي(ف("Data Science 101"), 0, "حالة 2")
تأكد_يساوي(ف("quick brown fox"), -1, "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), 6, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
