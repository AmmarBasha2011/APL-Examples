# مثال 9033 — هل لا يتكرر أي حرف (مجموعة اختبار 24)
# isogram (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9033-str-isogram-set24.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("civic"), خطأ, "حالة 1")
تأكد_يساوي(ف("venus"), صواب, "حالة 2")
تأكد_يساوي(ف("refer"), خطأ, "حالة 3")
تأكد_يساوي(ف("sun"), صواب, "حالة 4")
تأكد_يساوي(ف("array"), خطأ, "حالة 5")
