# مثال 9383 — مجموع الأرقام (مجموعة اختبار 14)
# digsum (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9383-num-digsum-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(58190), 23, "حالة 1")
تأكد_يساوي(ف(30754), 19, "حالة 2")
تأكد_يساوي(ف(6791), 23, "حالة 3")
تأكد_يساوي(ف(94950), 27, "حالة 4")
تأكد_يساوي(ف(75158), 26, "حالة 5")
