# مثال 9930 — المنوال (الأصغر عند التساوي) (مجموعة 13)
# mode (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9930-stat-mode-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([31, 40, 17, 0, 46, -8, 34, 29]), -8, "حالة 1")
تأكد_يساوي(ف([54, -20, 37, 21]), -20, "حالة 2")
تأكد_يساوي(ف([18, 60, 58, 57]), 18, "حالة 3")
تأكد_يساوي(ف([9, 37, -9]), -9, "حالة 4")
