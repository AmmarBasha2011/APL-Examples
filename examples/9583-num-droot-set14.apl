# مثال 9583 — الجذر الرقمي (مجموعة اختبار 14)
# droot (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9583-num-droot-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(614), 2, "حالة 1")
تأكد_يساوي(ف(57957), 6, "حالة 2")
تأكد_يساوي(ف(3188), 2, "حالة 3")
تأكد_يساوي(ف(65086), 7, "حالة 4")
تأكد_يساوي(ف(47128), 4, "حالة 5")
