# مثال 9887 — المتوسط الصحيح (مجموعة 20)
# mean (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9887-stat-mean-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([26, 24, -10, 42, 29]), 22, "حالة 1")
تأكد_يساوي(ف([33, 59, -20, 2, -1, 28, 15, -16]), 12, "حالة 2")
تأكد_يساوي(ف([6, -10, 33, 53]), 20, "حالة 3")
تأكد_يساوي(ف([-8, -12, -19, 14, 44, 2, 24, 34, -15]), 7, "حالة 4")
