# مثال 4818 — فائدة بسيطة بنسبة 3%
# Simple interest at 3 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4818-simple-interest-3.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 3 * س // 100

تأكد_يساوي(ف(1000, 1), 30, "حالة 1")
تأكد_يساوي(ف(2500, 3), 225, "حالة 2")
تأكد_يساوي(ف(100, 10), 30, "حالة 3")
تأكد_يساوي(ف(8000, 2), 480, "حالة 4")
