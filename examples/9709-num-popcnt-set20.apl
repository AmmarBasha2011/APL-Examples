# مثال 9709 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 20)
# popcnt (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9709-num-popcnt-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(4408), 5, "حالة 1")
تأكد_يساوي(ف(4359), 5, "حالة 2")
تأكد_يساوي(ف(3126), 6, "حالة 3")
تأكد_يساوي(ف(3334), 5, "حالة 4")
تأكد_يساوي(ف(1195), 6, "حالة 5")
