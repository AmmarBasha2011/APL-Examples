# مثال 9243 — الحرف الأوسط (مجموعة اختبار 34)
# midchar (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9243-str-midchar-set34.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("refer"), "f", "حالة 1")
تأكد_يساوي(ف("kayak"), "y", "حالة 2")
تأكد_يساوي(ف("planet"), "n", "حالة 3")
تأكد_يساوي(ف("radar"), "d", "حالة 4")
تأكد_يساوي(ف("data"), "t", "حالة 5")
