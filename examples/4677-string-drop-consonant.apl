# مثال 4677 — حذف (حرف ساكن) في نص
# String: drop consonant
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4677-string-drop-consonant.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو ليس (ord(خ.lower()) >= 97 و ord(خ.lower()) <= 122 و "aeiou".find(خ.lower()) == -1):
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("ZZtop and the Beatles"), "o a e eae", "حالة 1")
تأكد_يساوي(ف("MixedCASE123abc"), "ieAE123a", "حالة 2")
تأكد_يساوي(ف("Data Science 101"), "aa iee 101", "حالة 3")
تأكد_يساوي(ف("  spaced   out  text "), "  ae   ou  e ", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
