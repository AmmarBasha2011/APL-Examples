# مثال 10291 — تحويل وحدة إلى 30 وحدات صغرى والعكس
# Convert units with factor 30
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10291-unit-scale-30.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 30, ن // 30, ن % 30]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [30, 0, 1], "حالة 2")
تأكد_يساوي(ف(30), [900, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [30000, 33, 10], "حالة 4")
