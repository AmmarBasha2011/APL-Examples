# مثال 7962 — تكرار كل كلمة في الجملة رقم 7
# freq for sentence 7
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7962-sent6-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("tea for two and two for tea"), {"tea": 2, "for": 2, "two": 2, "and": 1}, "حالة 1")
تأكد_يساوي(ف("in the end the end is the start"), {"in": 1, "the": 3, "end": 2, "is": 1, "start": 1}, "حالة 2")
تأكد_يساوي(ف("nile river nile delta river"), {"nile": 2, "river": 2, "delta": 1}, "حالة 3")
