# مثال 9418 — عكس الأرقام (مجموعة اختبار 9)
# revnum (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9418-num-revnum-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(50860), 6805, "حالة 1")
تأكد_يساوي(ف(78663), 36687, "حالة 2")
تأكد_يساوي(ف(32474), 47423, "حالة 3")
تأكد_يساوي(ف(53930), 3935, "حالة 4")
تأكد_يساوي(ف(63184), 48136, "حالة 5")
