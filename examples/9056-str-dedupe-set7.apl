# مثال 9056 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 7)
# dedupe (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9056-str-dedupe-set7.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("saturn"), "saturn", "حالة 1")
تأكد_يساوي(ف("google"), "gole", "حالة 2")
تأكد_يساوي(ف("stats"), "sta", "حالة 3")
تأكد_يساوي(ف("earth"), "earth", "حالة 4")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 5")
