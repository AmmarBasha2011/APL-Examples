# مثال 5160 — أقرب مضاعف للعدد 2
# Nearest multiple of 2
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5160-nearest-multiple-2.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 2
  لو ب * 2 < 2:
    ارجع ن - ب
  ارجع ن - ب + 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 8, "حالة 2")
تأكد_يساوي(ف(13), 14, "حالة 3")
تأكد_يساوي(ف(100), 100, "حالة 4")
تأكد_يساوي(ف(3), 4, "حالة 5")
