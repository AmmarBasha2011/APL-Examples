# مثال 9815 — إزاحة لليسار 10 خانات
# Shift left by 10
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9815-bits-shl-10.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1024, "حالة 2")
تأكد_يساوي(ف(5), 5120, "حالة 3")
تأكد_يساوي(ف(100), 102400, "حالة 4")
