# مثال 9465 — عدد القواسم (مجموعة اختبار 16)
# ndiv (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9465-num-ndiv-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(177), 4, "حالة 1")
تأكد_يساوي(ف(202), 4, "حالة 2")
تأكد_يساوي(ف(142), 4, "حالة 3")
تأكد_يساوي(ف(159), 4, "حالة 4")
تأكد_يساوي(ف(6), 4, "حالة 5")
