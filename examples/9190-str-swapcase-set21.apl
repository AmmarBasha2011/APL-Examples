# مثال 9190 — عكس حالة الأحرف (مجموعة اختبار 21)
# swapcase (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9190-str-swapcase-set21.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("moon"), "MOON", "حالة 1")
تأكد_يساوي(ف("noon"), "NOON", "حالة 2")
تأكد_يساوي(ف("deed"), "DEED", "حالة 3")
تأكد_يساوي(ف("silent"), "SILENT", "حالة 4")
تأكد_يساوي(ف("listen"), "LISTEN", "حالة 5")
