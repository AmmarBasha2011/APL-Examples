# مثال 9594 — الجذر الرقمي (مجموعة اختبار 25)
# droot (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9594-num-droot-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(60581), 2, "حالة 1")
تأكد_يساوي(ف(2613), 3, "حالة 2")
تأكد_يساوي(ف(92381), 5, "حالة 3")
تأكد_يساوي(ف(98610), 6, "حالة 4")
تأكد_يساوي(ف(50494), 4, "حالة 5")
