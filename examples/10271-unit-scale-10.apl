# مثال 10271 — تحويل وحدة إلى 10 وحدات صغرى والعكس
# Convert units with factor 10
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10271-unit-scale-10.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 10, ن // 10, ن % 10]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [10, 0, 1], "حالة 2")
تأكد_يساوي(ف(10), [100, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [10000, 100, 0], "حالة 4")
