# مثال 10266 — تحويل وحدة إلى 5 وحدات صغرى والعكس
# Convert units with factor 5
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10266-unit-scale-5.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 5, ن // 5, ن % 5]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [5, 0, 1], "حالة 2")
تأكد_يساوي(ف(5), [25, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [5000, 200, 0], "حالة 4")
