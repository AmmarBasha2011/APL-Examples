# مثال 9939 — المنوال (الأصغر عند التساوي) (مجموعة 22)
# mode (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9939-stat-mode-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([-16, 4, 16, -20, -18, 5, 37, -17, 48]), -20, "حالة 1")
تأكد_يساوي(ف([21, -4, -4, -9, 33, 51, 24]), -4, "حالة 2")
تأكد_يساوي(ف([59, 51, 49, 46, 46, 51, -13]), 46, "حالة 3")
تأكد_يساوي(ف([14, 53, 6, 24, 41, -1, 39, -20, -1]), -1, "حالة 4")
