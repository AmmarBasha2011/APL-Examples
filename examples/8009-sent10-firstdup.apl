# مثال 8009 — أول كلمة تتكرر في الجملة رقم 11
# firstdup for sentence 11
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8009-sent10-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("red blue green red blue red"), "red", "حالة 1")
تأكد_يساوي(ف("nile river nile delta river"), "nile", "حالة 2")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), "bread", "حالة 3")
