# مثال 5168 — ضرب كل عنصر في 3
# Scale list by 3
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5168-scale-list-3.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 3]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [3, 6, 9], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -12, 30], "حالة 3")
