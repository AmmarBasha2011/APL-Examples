# مثال 9988 — التباين الصحيح (مجموعة 21)
# variance (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9988-stat-variance-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-9, 50, 51, -6, 39, -2]), 703, "حالة 1")
تأكد_يساوي(ف([-3, 51, 36, 40, 29, 40, 3, 35, 13]), 303, "حالة 2")
تأكد_يساوي(ف([-4, 47, 25, 18, 33, -18, 4]), 432, "حالة 3")
تأكد_يساوي(ف([24, -20, 28, 45, 44, 14]), 480, "حالة 4")
