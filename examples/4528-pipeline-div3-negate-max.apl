# مثال 4528 — أكبر نتيجة سالبها للأعداد التقبل القسمة على 3
# Largest (or 0) of negated over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4528-pipeline-div3-negate-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 0, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 0, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), -3, "حالة 3")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), -21, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
