# مثال 5049 — حصر القيمة بين 18 و 65
# Clamp value into [18,65]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5049-clamp-18-65.apl

# إن كانت أقل من الحد الأدنى نرجع الحد الأدنى
# وإن زادت نرجع الحد الأعلى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 18:
    ارجع 18
  لو ن > 65:
    ارجع 65
  ارجع ن

تأكد_يساوي(ف(13), 18, "حالة 1")
تأكد_يساوي(ف(70), 65, "حالة 2")
تأكد_يساوي(ف(41), 41, "حالة 3")
تأكد_يساوي(ف(18), 18, "حالة 4")
تأكد_يساوي(ف(65), 65, "حالة 5")
