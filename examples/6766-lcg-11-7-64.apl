# مثال 6766 — مولّد أرقام عشوائية خطي (11,7,64)
# LCG a=11 c=7 m=64
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6766-lcg-11-7-64.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (11 * س + 7) % 64
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [18, 13, 22, 57, 58], "حالة 1")
تأكد_يساوي(ف(0, 8), [7, 20, 35, 8, 31, 28, 59, 16], "حالة 2")
تأكد_يساوي(ف(7, 10), [20, 35, 8, 31, 28, 59, 16, 55, 36, 19], "حالة 3")
