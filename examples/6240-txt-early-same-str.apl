# مثال 6240 — النص الناتج بعد أخذ حروف أول الأبجدية وتحويلها إلى (كما هو)
# str of same applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6240-txt-early-same-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + خ
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "hellld", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "alif", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "abc", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "heickbf", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "daaciece", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "gammigiaabic", "حالة 8")
