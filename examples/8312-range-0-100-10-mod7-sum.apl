# مثال 8312 — المجموع من المدى 0 إلى 100 بخطوة 10 بعد (باقي على 7)
# sum over range(0,100,10) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8312-range-0-100-10-mod7-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 100:
    ر = ر + [خ % 7]
    خ = خ + (10)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 30, "المدى كله")
