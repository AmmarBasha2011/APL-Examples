# مثال 6779 — العدد المضلّع ذو 4 أضلاع
# 4-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6779-polygonal-4.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((4 - 2) * ن * ن - (4 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 4, "حالة 2")
تأكد_يساوي(ف(5), 25, "حالة 3")
تأكد_يساوي(ف(10), 100, "حالة 4")
