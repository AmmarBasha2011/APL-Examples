# مثال 4854 — مساحة مستطيل طوله 3 أضعاف عرضه
# Area of rectangle with length 3x width
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4854-rect-area-ratio-3.apl

# المساحة = العرض × الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ع):
  ارجع ع * (ع * 3)

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(2), 12, "حالة 2")
تأكد_يساوي(ف(5), 75, "حالة 3")
تأكد_يساوي(ف(10), 300, "حالة 4")
