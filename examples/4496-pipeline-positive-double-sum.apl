# مثال 4496 — مجموع نتيجة ضعفها للأعداد الموجبة
# Sum of double over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4496-pipeline-positive-double-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ * 2]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 156, "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 66, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 58, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 86, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
