# مثال 9992 — التباين الصحيح (مجموعة 25)
# variance (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9992-stat-variance-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-16, 23, 30, -9, 13, -1, 19]), 257, "حالة 1")
تأكد_يساوي(ف([-10, 22, 38, 40, 2, -18]), 507, "حالة 2")
تأكد_يساوي(ف([-4, 19, 21, -17, 3, 32]), 275, "حالة 3")
تأكد_يساوي(ف([30, 45, 6, 51, 53, 37]), 254, "حالة 4")
