# مثال 9247 — الحرف الأوسط (مجموعة اختبار 38)
# midchar (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9247-str-midchar-set38.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("radar"), "d", "حالة 1")
تأكد_يساوي(ف("earth"), "r", "حالة 2")
تأكد_يساوي(ف("python"), "h", "حالة 3")
تأكد_يساوي(ف("orbit"), "b", "حالة 4")
تأكد_يساوي(ف("river"), "v", "حالة 5")
