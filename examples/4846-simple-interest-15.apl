# مثال 4846 — فائدة بسيطة بنسبة 15%
# Simple interest at 15 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4846-simple-interest-15.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 15 * س // 100

تأكد_يساوي(ف(1000, 1), 150, "حالة 1")
تأكد_يساوي(ف(2500, 3), 1125, "حالة 2")
تأكد_يساوي(ف(100, 10), 150, "حالة 3")
تأكد_يساوي(ف(8000, 2), 2400, "حالة 4")
