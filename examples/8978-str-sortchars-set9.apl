# مثال 8978 — حروف الكلمة مرتبة (مجموعة اختبار 9)
# sortchars (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8978-str-sortchars-set9.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("star"), "arst", "حالة 1")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 2")
تأكد_يساوي(ف("mars"), "amrs", "حالة 3")
تأكد_يساوي(ف("tenet"), "eentt", "حالة 4")
تأكد_يساوي(ف("orbit"), "biort", "حالة 5")
