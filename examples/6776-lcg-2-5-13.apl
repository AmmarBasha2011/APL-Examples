# مثال 6776 — مولّد أرقام عشوائية خطي (2,5,13)
# LCG a=2 c=5 m=13
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6776-lcg-2-5-13.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (2 * س + 5) % 13
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [7, 6, 4, 0, 5], "حالة 1")
تأكد_يساوي(ف(0, 8), [5, 2, 9, 10, 12, 3, 11, 1], "حالة 2")
تأكد_يساوي(ف(7, 10), [6, 4, 0, 5, 2, 9, 10, 12, 3, 11], "حالة 3")
