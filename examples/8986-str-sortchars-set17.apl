# مثال 8986 — حروف الكلمة مرتبة (مجموعة اختبار 17)
# sortchars (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8986-str-sortchars-set17.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("kayak"), "aakky", "حالة 1")
تأكد_يساوي(ف("rotor"), "oorrt", "حالة 2")
تأكد_يساوي(ف("moon"), "mnoo", "حالة 3")
تأكد_يساوي(ف("array"), "aarry", "حالة 4")
تأكد_يساوي(ف("venus"), "ensuv", "حالة 5")
