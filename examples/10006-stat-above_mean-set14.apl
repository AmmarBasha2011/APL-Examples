# مثال 10006 — عدد العناصر فوق المتوسط (مجموعة 14)
# above_mean (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10006-stat-above_mean-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([39, 3, -10, 50, 17, 2, 51, -2, 12]), 3, "حالة 1")
تأكد_يساوي(ف([36, 15, -7, 48, 39, 12, 18, 24, 53]), 4, "حالة 2")
تأكد_يساوي(ف([41, 4, 15]), 1, "حالة 3")
تأكد_يساوي(ف([18, 21, -2, 20, 20, -10, 39, 23]), 6, "حالة 4")
