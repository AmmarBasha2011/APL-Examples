# مثال 5248 — ضرب كل عنصر في 11
# Scale list by 11
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5248-scale-list-11.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 11]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [11, 22, 33], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -44, 110], "حالة 3")
