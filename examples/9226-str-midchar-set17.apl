# مثال 9226 — الحرف الأوسط (مجموعة اختبار 17)
# midchar (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9226-str-midchar-set17.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("silent"), "e", "حالة 1")
تأكد_يساوي(ف("array"), "r", "حالة 2")
تأكد_يساوي(ف("earth"), "r", "حالة 3")
تأكد_يساوي(ف("saturn"), "u", "حالة 4")
تأكد_يساوي(ف("planet"), "n", "حالة 5")
