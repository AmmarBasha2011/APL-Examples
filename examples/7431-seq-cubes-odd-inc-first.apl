# مثال 7431 — أول عنصر: من المكعبات نأخذ الفردي ثم (زيادة واحد)
# first over cubes sequence, keep odd, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7431-seq-cubes-odd-inc-first.apl

# نولّد أول ن حد من: المكعبات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي * ي
    لو خ % 2 == 1:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 2, "حالة 3")
تأكد_يساوي(ف(10), 2, "حالة 4")
تأكد_يساوي(ف(15), 2, "حالة 5")
