# مثال 9834 — هل الخانة رقم 13 مضاءة
# Is bit 13 set
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9834-bits-test-13.apl

# نمرر الخانة إلى الموضع الأول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن >> 13) & 1 == 1

تأكد_يساوي(ف(0), خطأ, "حالة 1")
تأكد_يساوي(ف(255), خطأ, "حالة 2")
تأكد_يساوي(ف(1000), خطأ, "حالة 3")
تأكد_يساوي(ف(12345), صواب, "حالة 4")
