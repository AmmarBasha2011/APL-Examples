# مثال 9371 — مجموع الأرقام (مجموعة اختبار 2)
# digsum (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9371-num-digsum-set2.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(88752), 30, "حالة 1")
تأكد_يساوي(ف(5669), 26, "حالة 2")
تأكد_يساوي(ف(68218), 25, "حالة 3")
تأكد_يساوي(ف(15818), 23, "حالة 4")
تأكد_يساوي(ف(67042), 19, "حالة 5")
