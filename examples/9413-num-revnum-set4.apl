# مثال 9413 — عكس الأرقام (مجموعة اختبار 4)
# revnum (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9413-num-revnum-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(35635), 53653, "حالة 1")
تأكد_يساوي(ف(54747), 74745, "حالة 2")
تأكد_يساوي(ف(63966), 66936, "حالة 3")
تأكد_يساوي(ف(33772), 27733, "حالة 4")
تأكد_يساوي(ف(10732), 23701, "حالة 5")
