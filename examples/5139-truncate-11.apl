# مثال 5139 — اقتطاع النص إلى 11 حروف مع نقاط
# Truncate to 11 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5139-truncate-11.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 11:
    ارجع ن
  ارجع ن[:11] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello world...", "حالة 2")
تأكد_يساوي(ف("xxxxxxxxxxx"), "xxxxxxxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyyyyyyy"), "yyyyyyyyyyy...", "حالة 4")
