# مثال 10014 — عدد العناصر فوق المتوسط (مجموعة 22)
# above_mean (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10014-stat-above_mean-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([33, 19, -10, 49]), 2, "حالة 1")
تأكد_يساوي(ف([3, 21, 8, 36, 57, -16, 4, 59]), 3, "حالة 2")
تأكد_يساوي(ف([55, 46, 25, 56, -13, 27]), 3, "حالة 3")
تأكد_يساوي(ف([46, 43, 60, -8]), 3, "حالة 4")
