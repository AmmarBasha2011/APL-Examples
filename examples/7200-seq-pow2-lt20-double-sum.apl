# مثال 7200 — المجموع: من قوى 2 نأخذ الأصغر من 20 ثم (ضعف)
# sum over pow2 sequence, keep lt20, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7200-seq-pow2-lt20-double-sum.apl

# نولّد أول ن حد من: قوى 2
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 ** ي
    لو خ < 20:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 62, "حالة 3")
تأكد_يساوي(ف(10), 62, "حالة 4")
تأكد_يساوي(ف(15), 62, "حالة 5")
