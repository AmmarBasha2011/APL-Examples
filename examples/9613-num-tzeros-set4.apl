# مثال 9613 — الأصفار في نهاية العاملي (مجموعة اختبار 4)
# tzeros (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9613-num-tzeros-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(139), 33, "حالة 1")
تأكد_يساوي(ف(213), 51, "حالة 2")
تأكد_يساوي(ف(249), 59, "حالة 3")
تأكد_يساوي(ف(131), 32, "حالة 4")
تأكد_يساوي(ف(41), 9, "حالة 5")
