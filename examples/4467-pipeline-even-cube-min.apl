# مثال 4467 — أصغر نتيجة مكعبها للأعداد الزوجية
# Smallest (or 0) of cube over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4467-pipeline-even-cube-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 8, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 2744, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 8, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), -64, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
