# مثال 9616 — الأصفار في نهاية العاملي (مجموعة اختبار 7)
# tzeros (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9616-num-tzeros-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(374), 90, "حالة 1")
تأكد_يساوي(ف(145), 35, "حالة 2")
تأكد_يساوي(ف(467), 114, "حالة 3")
تأكد_يساوي(ف(396), 97, "حالة 4")
تأكد_يساوي(ف(19), 3, "حالة 5")
