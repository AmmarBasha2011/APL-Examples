# مثال 7837 — آخر عنصر: من عكسية نأخذ الزوجي ثم (ضعف)
# last over rev sequence, keep even, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7837-seq-rev-even-double-last.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ % 2 == 0:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 40, "حالة 2")
تأكد_يساوي(ف(5), 24, "حالة 3")
تأكد_يساوي(ف(10), 4, "حالة 4")
تأكد_يساوي(ف(15), -16, "حالة 5")
