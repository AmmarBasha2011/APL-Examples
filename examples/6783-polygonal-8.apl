# مثال 6783 — العدد المضلّع ذو 8 أضلاع
# 8-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6783-polygonal-8.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((8 - 2) * ن * ن - (8 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 8, "حالة 2")
تأكد_يساوي(ف(5), 65, "حالة 3")
تأكد_يساوي(ف(10), 280, "حالة 4")
