# مثال 5196 — الحد ن في متتالية هندسية أساسها 6
# Nth term of geometric sequence, ratio 6
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5196-geo-seq-6.apl

# كل حد = السابق × الأساس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ر = أ
  لكل ي في range(ن - 1):
    ر = ر * 6
  ارجع ر

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 5), 1296, "حالة 2")
تأكد_يساوي(ف(3, 4), 648, "حالة 3")
تأكد_يساوي(ف(2, 6), 15552, "حالة 4")
