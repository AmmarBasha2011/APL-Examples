# مثال 9950 — المدى (مجموعة 8)
# range (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9950-stat-range-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([-7, 10, 16, 19, -16, -17, 41, 8, 36]), 58, "حالة 1")
تأكد_يساوي(ف([36, 37, -11, -18, -7, 33, -11, 42]), 60, "حالة 2")
تأكد_يساوي(ف([45, 6, 26, 11, 45, 23, 36, 36]), 39, "حالة 3")
تأكد_يساوي(ف([9, -12, 15, 31]), 43, "حالة 4")
