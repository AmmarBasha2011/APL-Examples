# مثال 9442 — عكس الأرقام (مجموعة اختبار 33)
# revnum (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9442-num-revnum-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(50587), 78505, "حالة 1")
تأكد_يساوي(ف(38291), 19283, "حالة 2")
تأكد_يساوي(ف(811), 118, "حالة 3")
تأكد_يساوي(ف(41960), 6914, "حالة 4")
تأكد_يساوي(ف(66033), 33066, "حالة 5")
