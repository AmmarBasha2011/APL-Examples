# مثال 8972 — حروف الكلمة مرتبة (مجموعة اختبار 3)
# sortchars (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8972-str-sortchars-set3.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("silent"), "eilnst", "حالة 1")
تأكد_يساوي(ف("kayak"), "aakky", "حالة 2")
تأكد_يساوي(ف("apple"), "aelpp", "حالة 3")
تأكد_يساوي(ف("enlist"), "eilnst", "حالة 4")
تأكد_يساوي(ف("planet"), "aelnpt", "حالة 5")
