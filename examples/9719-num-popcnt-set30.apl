# مثال 9719 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 30)
# popcnt (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9719-num-popcnt-set30.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(4228), 3, "حالة 1")
تأكد_يساوي(ف(4351), 9, "حالة 2")
تأكد_يساوي(ف(3305), 7, "حالة 3")
تأكد_يساوي(ف(1187), 5, "حالة 4")
تأكد_يساوي(ف(1902), 8, "حالة 5")
