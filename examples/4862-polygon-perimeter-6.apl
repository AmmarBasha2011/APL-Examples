# مثال 4862 — محيط مضلع منتظم عدد أضلاعه 6
# Perimeter of regular 6-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4862-polygon-perimeter-6.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 6 * ض

تأكد_يساوي(ف(1), 6, "حالة 1")
تأكد_يساوي(ف(5), 30, "حالة 2")
تأكد_يساوي(ف(12), 72, "حالة 3")
تأكد_يساوي(ف(7), 42, "حالة 4")
