# مثال 9577 — الجذر الرقمي (مجموعة اختبار 8)
# droot (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9577-num-droot-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(48574), 1, "حالة 1")
تأكد_يساوي(ف(41243), 5, "حالة 2")
تأكد_يساوي(ف(88261), 7, "حالة 3")
تأكد_يساوي(ف(51908), 5, "حالة 4")
تأكد_يساوي(ف(27007), 7, "حالة 5")
