# مثال 9427 — عكس الأرقام (مجموعة اختبار 18)
# revnum (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9427-num-revnum-set18.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(52305), 50325, "حالة 1")
تأكد_يساوي(ف(90050), 5009, "حالة 2")
تأكد_يساوي(ف(48434), 43484, "حالة 3")
تأكد_يساوي(ف(10644), 44601, "حالة 4")
تأكد_يساوي(ف(58440), 4485, "حالة 5")
