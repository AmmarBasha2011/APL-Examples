# مثال 4778 — تماثل البتات
# Parity of set bits
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4778-parity-bit.apl

# نعد البتات ونرجع الباقي على 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع ^ (ن & 1)
    ن = ن >> 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(3), 0, "حالة 3")
تأكد_يساوي(ف(7), 1, "حالة 4")
تأكد_يساوي(ف(256), 1, "حالة 5")
