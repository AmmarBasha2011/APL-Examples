# مثال 9057 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 8)
# dedupe (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9057-str-dedupe-set8.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("kayak"), "kay", "حالة 1")
تأكد_يساوي(ف("river"), "rive", "حالة 2")
تأكد_يساوي(ف("data"), "dat", "حالة 3")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 4")
تأكد_يساوي(ف("array"), "ary", "حالة 5")
