# مثال 9634 — الأصفار في نهاية العاملي (مجموعة اختبار 25)
# tzeros (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9634-num-tzeros-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(357), 87, "حالة 1")
تأكد_يساوي(ف(334), 81, "حالة 2")
تأكد_يساوي(ف(24), 4, "حالة 3")
تأكد_يساوي(ف(232), 56, "حالة 4")
تأكد_يساوي(ف(205), 50, "حالة 5")
