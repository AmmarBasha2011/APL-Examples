# مثال 5089 — حذف الحرف d من النص
# Remove letter d
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5089-remove-char-d.apl

# نبني نصاً جديداً بدون الحرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح != "d":
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("banana"), "banana", "حالة 1")
تأكد_يساوي(ف("education"), "eucation", "حالة 2")
تأكد_يساوي(ف(""), "", "حالة 3")
تأكد_يساوي(ف("mississippi"), "mississippi", "حالة 4")
