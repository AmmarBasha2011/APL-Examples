# مثال 6341 — طول الناتج بعد أخذ غير المسافات وتحويلها إلى (رقم الحرف)
# len of code applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6341-txt-nospace-code-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + str(ord(خ))+","
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 46, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 31, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 18, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 62, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 36, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 52, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 71, "حالة 8")
