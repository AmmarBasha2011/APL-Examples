# مثال 10278 — تحويل وحدة إلى 17 وحدات صغرى والعكس
# Convert units with factor 17
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10278-unit-scale-17.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 17, ن // 17, ن % 17]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [17, 0, 1], "حالة 2")
تأكد_يساوي(ف(17), [289, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [17000, 58, 14], "حالة 4")
