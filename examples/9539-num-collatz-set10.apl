# مثال 9539 — خطوات كولاتز (مجموعة اختبار 10)
# collatz (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9539-num-collatz-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(72), 22, "حالة 1")
تأكد_يساوي(ف(141), 15, "حالة 2")
تأكد_يساوي(ف(2), 1, "حالة 3")
تأكد_يساوي(ف(46), 16, "حالة 4")
تأكد_يساوي(ف(16), 4, "حالة 5")
