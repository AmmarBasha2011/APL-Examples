# مثال 4633 — مواضع (حرف علة) في نص
# String: positions of vowel
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4633-string-positions-vowel.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = []
  ر = 0
  لكل خ في س:
    لو "aeiou".find(خ.lower()) != -1:
      ن = ن + [ر]
    ر = ر + 1
  ارجع ن

تأكد_يساوي(ف("quick brown fox"), [1, 2, 8, 13], "حالة 1")
تأكد_يساوي(ف("  spaced   out  text "), [4, 6, 11, 12, 17], "حالة 2")
تأكد_يساوي(ف("apple PIE 7 and 9"), [0, 4, 7, 8, 12], "حالة 3")
تأكد_يساوي(ف("MixedCASE123abc"), [1, 3, 6, 8, 12], "حالة 4")
تأكد_يساوي(ف(""), [], "حالة 5")
