# مثال 10026 — ثاني أكبر قيمة مختلفة (مجموعة 9)
# second (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10026-stat-second-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([44, 12, 32, 23, 7]), 32, "حالة 1")
تأكد_يساوي(ف([44, 21, 41]), 41, "حالة 2")
تأكد_يساوي(ف([54, 2, 37, -18, -12, 7, 11, 58]), 54, "حالة 3")
تأكد_يساوي(ف([17, -5, 23, 47, -16, -20, 29, -7]), 29, "حالة 4")
