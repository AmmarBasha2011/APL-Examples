# مثال 6840 — عدد حلول 6س + 5ص = 37
# Count solutions of 6x+5y=37
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6840-pairs-6x-5y-37.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 6 * س + 5 * ص == 37:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 1, "حالة 3")
تأكد_يساوي(ف(37), 1, "حالة 4")
