# مثال 9825 — إزاحة لليسار 12 خانات
# Shift left by 12
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9825-bits-shl-12.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 12

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 4096, "حالة 2")
تأكد_يساوي(ف(5), 20480, "حالة 3")
تأكد_يساوي(ف(100), 409600, "حالة 4")
