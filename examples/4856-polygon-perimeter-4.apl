# مثال 4856 — محيط مضلع منتظم عدد أضلاعه 4
# Perimeter of regular 4-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4856-polygon-perimeter-4.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 4 * ض

تأكد_يساوي(ف(1), 4, "حالة 1")
تأكد_يساوي(ف(5), 20, "حالة 2")
تأكد_يساوي(ف(12), 48, "حالة 3")
تأكد_يساوي(ف(7), 28, "حالة 4")
