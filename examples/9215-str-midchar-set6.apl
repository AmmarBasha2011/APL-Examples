# مثال 9215 — الحرف الأوسط (مجموعة اختبار 6)
# midchar (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9215-str-midchar-set6.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("civic"), "v", "حالة 1")
تأكد_يساوي(ف("apple"), "p", "حالة 2")
تأكد_يساوي(ف("listen"), "t", "حالة 3")
تأكد_يساوي(ف("bob"), "o", "حالة 4")
تأكد_يساوي(ف("tenet"), "n", "حالة 5")
