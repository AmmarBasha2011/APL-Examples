# مثال 7989 — أول كلمة تتكرر في الجملة رقم 9
# firstdup for sentence 9
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7989-sent8-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("a b c a b a"), "a", "حالة 1")
تأكد_يساوي(ف("up down up down up up down"), "up", "حالة 2")
تأكد_يساوي(ف("stars and moon and stars again"), "and", "حالة 3")
