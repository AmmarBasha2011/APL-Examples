# مثال 9000 — حروف الكلمة مرتبة (مجموعة اختبار 31)
# sortchars (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9000-str-sortchars-set31.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("loop"), "loop", "حالة 1")
تأكد_يساوي(ف("venus"), "ensuv", "حالة 2")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 3")
تأكد_يساوي(ف("python"), "hnopty", "حالة 4")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 5")
