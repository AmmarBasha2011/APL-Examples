# مثال 7686 — أكبر قيمة: من ي + 10 باقي 7 نأخذ الأكبر من 5 ثم (مربع)
# max over mixed sequence, keep gt5, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7686-seq-mixed-gt5-square-max.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ > 5:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 36, "حالة 3")
تأكد_يساوي(ف(10), 36, "حالة 4")
تأكد_يساوي(ف(15), 36, "حالة 5")
