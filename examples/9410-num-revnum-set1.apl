# مثال 9410 — عكس الأرقام (مجموعة اختبار 1)
# revnum (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9410-num-revnum-set1.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(75211), 11257, "حالة 1")
تأكد_يساوي(ف(10560), 6501, "حالة 2")
تأكد_يساوي(ف(63574), 47536, "حالة 3")
تأكد_يساوي(ف(99905), 50999, "حالة 4")
تأكد_يساوي(ف(34291), 19243, "حالة 5")
