# مثال 10047 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 5)
# spread (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10047-stat-spread-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([34, 14, 36, 38, -18, 25, 10]), 28, "حالة 1")
تأكد_يساوي(ف([23, 8, 23, 47, -7, 51, 6]), 24, "حالة 2")
تأكد_يساوي(ف([25, -18, 33, -17, 27, -2, -17, 43, 34]), 27, "حالة 3")
تأكد_يساوي(ف([42, 28, 30, -10, -15]), 38, "حالة 4")
