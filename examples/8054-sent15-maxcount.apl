# مثال 8054 — أعلى تكرار في الجملة رقم 16
# maxcount for sentence 16
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8054-sent15-maxcount.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  م = 0
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
    م = max(م, د[ك])
  ارجع م

تأكد_يساوي(ف("stars and moon and stars again"), 2, "حالة 1")
تأكد_يساوي(ف("left right left left right"), 3, "حالة 2")
تأكد_يساوي(ف("apl code is easy code is fun"), 2, "حالة 3")
