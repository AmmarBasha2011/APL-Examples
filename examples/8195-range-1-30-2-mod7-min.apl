# مثال 8195 — أصغر قيمة من المدى 1 إلى 30 بخطوة 2 بعد (باقي على 7)
# min over range(1,30,2) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8195-range-1-30-2-mod7-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [خ % 7]
    خ = خ + (2)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 0, "المدى كله")
