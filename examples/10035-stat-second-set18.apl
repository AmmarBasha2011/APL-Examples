# مثال 10035 — ثاني أكبر قيمة مختلفة (مجموعة 18)
# second (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10035-stat-second-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([1, 27, 13, 32, -14, 42]), 32, "حالة 1")
تأكد_يساوي(ف([16, 3, 28, -3, 56]), 28, "حالة 2")
تأكد_يساوي(ف([-6, 25, -17, 18, 50, -5, 6, 59, 44]), 50, "حالة 3")
تأكد_يساوي(ف([-2, 51, 13, -8, -20, -3, -20, 10]), 13, "حالة 4")
