# مثال 8862 — صنف عداد يزيد 11 من 0
# Counter class step 11 from 0
# Demonstrates: البرمجة الكائنية
#
# Run:  python apl.py examples/8862-class-counter-11-0.apl

# صنف بحالة داخلية
# دالة تزيد القيمة وأخرى تصفّرها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف عداد:
    دالة_إنشاء(ذات, بداية):
        ذات.قيمة = بداية

    دالة زد(ذات):
        ذات.قيمة = ذات.قيمة + 11
        ارجع ذات.قيمة

    دالة صفر(ذات):
        ذات.قيمة = 0

ع = عداد(0)
تأكد_يساوي(ع.قيمة, 0, "البداية")
تأكد_يساوي(ع.زد(), 11, "خطوة 1")
تأكد_يساوي(ع.زد(), 22, "خطوة 2")
تأكد_يساوي(ع.زد(), 33, "خطوة 3")
تأكد_يساوي(ع.زد(), 44, "خطوة 4")
تأكد_يساوي(ع.زد(), 55, "خطوة 5")
ع.صفر()
تأكد_يساوي(ع.قيمة, 0, "بعد التصفير")
