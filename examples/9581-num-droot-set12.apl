# مثال 9581 — الجذر الرقمي (مجموعة اختبار 12)
# droot (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9581-num-droot-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(52887), 3, "حالة 1")
تأكد_يساوي(ف(92132), 8, "حالة 2")
تأكد_يساوي(ف(83365), 7, "حالة 3")
تأكد_يساوي(ف(5099), 5, "حالة 4")
تأكد_يساوي(ف(89014), 4, "حالة 5")
