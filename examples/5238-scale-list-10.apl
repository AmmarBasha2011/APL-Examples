# مثال 5238 — ضرب كل عنصر في 10
# Scale list by 10
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5238-scale-list-10.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 10]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [10, 20, 30], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -40, 100], "حالة 3")
