# مثال 5310 — أقرب مضاعف للعدد 17
# Nearest multiple of 17
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5310-nearest-multiple-17.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 17
  لو ب * 2 < 17:
    ارجع ن - ب
  ارجع ن - ب + 17

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 0, "حالة 2")
تأكد_يساوي(ف(13), 17, "حالة 3")
تأكد_يساوي(ف(100), 102, "حالة 4")
تأكد_يساوي(ف(18), 17, "حالة 5")
