# مثال 4842 — فائدة بسيطة بنسبة 12%
# Simple interest at 12 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4842-simple-interest-12.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 12 * س // 100

تأكد_يساوي(ف(1000, 1), 120, "حالة 1")
تأكد_يساوي(ف(2500, 3), 900, "حالة 2")
تأكد_يساوي(ف(100, 10), 120, "حالة 3")
تأكد_يساوي(ف(8000, 2), 1920, "حالة 4")
