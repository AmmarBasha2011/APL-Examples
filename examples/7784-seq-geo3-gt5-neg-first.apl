# مثال 7784 — أول عنصر: من قوى 3 نأخذ الأكبر من 5 ثم (سالب)
# first over geo3 sequence, keep gt5, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7784-seq-geo3-gt5-neg-first.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ > 5:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -9, "حالة 3")
تأكد_يساوي(ف(10), -9, "حالة 4")
تأكد_يساوي(ف(15), -9, "حالة 5")
