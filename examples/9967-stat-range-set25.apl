# مثال 9967 — المدى (مجموعة 25)
# range (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9967-stat-range-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([38, 37, 1, 35, 20, -18, 44, 38, 13]), 62, "حالة 1")
تأكد_يساوي(ف([59, -11, 32]), 70, "حالة 2")
تأكد_يساوي(ف([60, 21, 45]), 39, "حالة 3")
تأكد_يساوي(ف([42, 28, 5, 14, 24, -19, 59]), 78, "حالة 4")
