# مثال 4874 — محيط مضلع منتظم عدد أضلاعه 10
# Perimeter of regular 10-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4874-polygon-perimeter-10.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 10 * ض

تأكد_يساوي(ف(1), 10, "حالة 1")
تأكد_يساوي(ف(5), 50, "حالة 2")
تأكد_يساوي(ف(12), 120, "حالة 3")
تأكد_يساوي(ف(7), 70, "حالة 4")
