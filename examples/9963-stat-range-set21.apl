# مثال 9963 — المدى (مجموعة 21)
# range (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9963-stat-range-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([12, 56, 57, -9, 12, 31]), 66, "حالة 1")
تأكد_يساوي(ف([42, 59, -7, 23, -8]), 67, "حالة 2")
تأكد_يساوي(ف([-5, 24, 50, 54]), 59, "حالة 3")
تأكد_يساوي(ف([-12, 9, 8, 55, 0, 49, 43, 58]), 70, "حالة 4")
