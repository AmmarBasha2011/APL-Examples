# مثال 9896 — الوسيط (بعد الترتيب) (مجموعة 4)
# median (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9896-stat-median-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([28, 5, 56, 2, 9, 11]), 10, "حالة 1")
تأكد_يساوي(ف([-9, 12, 29, 47]), 20, "حالة 2")
تأكد_يساوي(ف([48, -9, 59, 42, 5, 33, 58, 55]), 45, "حالة 3")
تأكد_يساوي(ف([27, 29, 7, -1]), 17, "حالة 4")
