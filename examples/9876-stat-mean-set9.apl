# مثال 9876 — المتوسط الصحيح (مجموعة 9)
# mean (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9876-stat-mean-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([59, -18, 17, 49, -2, 4, 23, 15, 38]), 20, "حالة 1")
تأكد_يساوي(ف([13, -18, -7, 56, 13, 43]), 16, "حالة 2")
تأكد_يساوي(ف([-10, 16, -15, 15, 10, 14, 60, 55, -18]), 14, "حالة 3")
تأكد_يساوي(ف([27, 44, 14, -10]), 18, "حالة 4")
