# مثال 6812 — عدد حلول 2س + 1ص = 40
# Count solutions of 2x+1y=40
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6812-pairs-2x-1y-40.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 2 * س + 1 * ص == 40:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 0, "حالة 3")
تأكد_يساوي(ف(40), 21, "حالة 4")
