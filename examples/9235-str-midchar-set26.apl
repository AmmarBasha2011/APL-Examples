# مثال 9235 — الحرف الأوسط (مجموعة اختبار 26)
# midchar (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9235-str-midchar-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("orbit"), "b", "حالة 1")
تأكد_يساوي(ف("deed"), "e", "حالة 2")
تأكد_يساوي(ف("tenet"), "n", "حالة 3")
تأكد_يساوي(ف("google"), "g", "حالة 4")
تأكد_يساوي(ف("silent"), "e", "حالة 5")
