# مثال 7235 — المجموع: من قوى 2 نأخذ الموجب ثم (ضعف)
# sum over pow2 sequence, keep pos, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7235-seq-pow2-pos-double-sum.apl

# نولّد أول ن حد من: قوى 2
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 ** ي
    لو خ > 0:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 62, "حالة 3")
تأكد_يساوي(ف(10), 2046, "حالة 4")
تأكد_يساوي(ف(15), 65534, "حالة 5")
