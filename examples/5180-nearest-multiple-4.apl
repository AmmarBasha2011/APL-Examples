# مثال 5180 — أقرب مضاعف للعدد 4
# Nearest multiple of 4
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5180-nearest-multiple-4.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 4
  لو ب * 2 < 4:
    ارجع ن - ب
  ارجع ن - ب + 4

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 8, "حالة 2")
تأكد_يساوي(ف(13), 12, "حالة 3")
تأكد_يساوي(ف(100), 100, "حالة 4")
تأكد_يساوي(ف(5), 4, "حالة 5")
