# مثال 5279 — قابل للقسمة على 14 وزوجي؟
# Divisible by 14 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5279-is-multiple-and-even-14.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 14 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(14), صواب, "حالة 2")
تأكد_يساوي(ف(28), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(56), صواب, "حالة 5")
