# مثال 7999 — أول كلمة تتكرر في الجملة رقم 10
# firstdup for sentence 10
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7999-sent9-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("in the end the end is the start"), "the", "حالة 1")
تأكد_يساوي(ف("cairo is big and cairo is old"), "cairo", "حالة 2")
تأكد_يساوي(ف("sun sand sea sun sand sun"), "sun", "حالة 3")
