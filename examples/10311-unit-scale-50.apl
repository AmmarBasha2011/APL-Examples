# مثال 10311 — تحويل وحدة إلى 50 وحدات صغرى والعكس
# Convert units with factor 50
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10311-unit-scale-50.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 50, ن // 50, ن % 50]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [50, 0, 1], "حالة 2")
تأكد_يساوي(ف(50), [2500, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [50000, 20, 0], "حالة 4")
