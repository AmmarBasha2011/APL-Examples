# مثال 7271 — أصغر قيمة: من الأعداد الفردية نأخذ الفردي ثم (سالب)
# min over odd sequence, keep odd, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7271-seq-odd-odd-neg-min.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ % 2 == 1:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -9, "حالة 3")
تأكد_يساوي(ف(10), -19, "حالة 4")
تأكد_يساوي(ف(15), -29, "حالة 5")
