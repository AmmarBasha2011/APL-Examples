# مثال 4651 — مواضع (حرف كبير) في نص
# String: positions of uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4651-string-positions-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = []
  ر = 0
  لكل خ في س:
    لو خ.isupper():
      ن = ن + [ر]
    ر = ر + 1
  ارجع ن

تأكد_يساوي(ف("Data Science 101"), [0, 5], "حالة 1")
تأكد_يساوي(ف("quick brown fox"), [], "حالة 2")
تأكد_يساوي(ف("Hello World 42"), [0, 6], "حالة 3")
تأكد_يساوي(ف("  spaced   out  text "), [], "حالة 4")
تأكد_يساوي(ف(""), [], "حالة 5")
