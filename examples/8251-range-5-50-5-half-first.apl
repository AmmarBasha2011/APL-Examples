# مثال 8251 — أول عنصر من المدى 5 إلى 50 بخطوة 5 بعد (نصف صحيح)
# first over range(5,50,5) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8251-range-5-50-5-half-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ // 2]
    خ = خ + (5)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 2, "المدى كله")
