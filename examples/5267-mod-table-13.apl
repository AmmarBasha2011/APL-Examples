# مثال 5267 — باقي القسمة على 13 لكل عنصر
# Remainders mod 13
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5267-mod-table-13.apl

# نطبق % على كل عنصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ % 13]
  ارجع ر

تأكد_يساوي(ف([0, 3, 6, 9, 12, 15, 18, 21, 24, 27]), [0, 3, 6, 9, 12, 2, 5, 8, 11, 1], "حالة 1")
تأكد_يساوي(ف([-1, -5, 7]), [12, 8, 7], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
