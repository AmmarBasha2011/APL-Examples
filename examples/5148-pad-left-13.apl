# مثال 5148 — ملء النص من اليسار حتى عرض 13
# Left pad to width 13
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5148-pad-left-13.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 13:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "0000000000007", "حالة 1")
تأكد_يساوي(ف("123"), "0000000000123", "حالة 2")
تأكد_يساوي(ف("1111111111111"), "1111111111111", "حالة 3")
تأكد_يساوي(ف(""), "0000000000000", "حالة 4")
