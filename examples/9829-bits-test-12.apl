# مثال 9829 — هل الخانة رقم 12 مضاءة
# Is bit 12 set
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9829-bits-test-12.apl

# نمرر الخانة إلى الموضع الأول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن >> 12) & 1 == 1

تأكد_يساوي(ف(0), خطأ, "حالة 1")
تأكد_يساوي(ف(255), خطأ, "حالة 2")
تأكد_يساوي(ف(1000), خطأ, "حالة 3")
تأكد_يساوي(ف(12345), صواب, "حالة 4")
