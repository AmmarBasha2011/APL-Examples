# مثال 5138 — ملء النص من اليسار حتى عرض 11
# Left pad to width 11
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5138-pad-left-11.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 11:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "00000000007", "حالة 1")
تأكد_يساوي(ف("123"), "00000000123", "حالة 2")
تأكد_يساوي(ف("11111111111"), "11111111111", "حالة 3")
تأكد_يساوي(ف(""), "00000000000", "حالة 4")
