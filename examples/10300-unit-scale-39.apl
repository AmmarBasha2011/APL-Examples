# مثال 10300 — تحويل وحدة إلى 39 وحدات صغرى والعكس
# Convert units with factor 39
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10300-unit-scale-39.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 39, ن // 39, ن % 39]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [39, 0, 1], "حالة 2")
تأكد_يساوي(ف(39), [1521, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [39000, 25, 25], "حالة 4")
