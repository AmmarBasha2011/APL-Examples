# مثال 9197 — عكس حالة الأحرف (مجموعة اختبار 28)
# swapcase (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9197-str-swapcase-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("earth"), "EARTH", "حالة 1")
تأكد_يساوي(ف("level"), "LEVEL", "حالة 2")
تأكد_يساوي(ف("stats"), "STATS", "حالة 3")
تأكد_يساوي(ف("code"), "CODE", "حالة 4")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 5")
