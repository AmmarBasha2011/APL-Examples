# مثال 9244 — الحرف الأوسط (مجموعة اختبار 35)
# midchar (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9244-str-midchar-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("stats"), "a", "حالة 1")
تأكد_يساوي(ف("silent"), "e", "حالة 2")
تأكد_يساوي(ف("comet"), "m", "حالة 3")
تأكد_يساوي(ف("radar"), "d", "حالة 4")
تأكد_يساوي(ف("orbit"), "b", "حالة 5")
