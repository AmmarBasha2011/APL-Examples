# مثال 10057 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 15)
# spread (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10057-stat-spread-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([-10, 18, 17]), 27, "حالة 1")
تأكد_يساوي(ف([6, 5, -13, 21]), 18, "حالة 2")
تأكد_يساوي(ف([60, 52, 10, 57, 28, -3, 9]), 24, "حالة 3")
تأكد_يساوي(ف([30, -17, -10, 32, 11, -8, 39]), 19, "حالة 4")
