# مثال 4878 — مساحة مستطيل طوله 11 أضعاف عرضه
# Area of rectangle with length 11x width
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4878-rect-area-ratio-11.apl

# المساحة = العرض × الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ع):
  ارجع ع * (ع * 11)

تأكد_يساوي(ف(1), 11, "حالة 1")
تأكد_يساوي(ف(2), 44, "حالة 2")
تأكد_يساوي(ف(5), 275, "حالة 3")
تأكد_يساوي(ف(10), 1100, "حالة 4")
