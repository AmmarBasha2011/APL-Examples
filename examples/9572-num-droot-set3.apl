# مثال 9572 — الجذر الرقمي (مجموعة اختبار 3)
# droot (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9572-num-droot-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(1609), 7, "حالة 1")
تأكد_يساوي(ف(61548), 6, "حالة 2")
تأكد_يساوي(ف(14732), 8, "حالة 3")
تأكد_يساوي(ف(51489), 9, "حالة 4")
تأكد_يساوي(ف(18462), 3, "حالة 5")
