# مثال 9703 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 14)
# popcnt (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9703-num-popcnt-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(3636), 6, "حالة 1")
تأكد_يساوي(ف(1922), 5, "حالة 2")
تأكد_يساوي(ف(424), 4, "حالة 3")
تأكد_يساوي(ف(4697), 6, "حالة 4")
تأكد_يساوي(ف(4119), 5, "حالة 5")
