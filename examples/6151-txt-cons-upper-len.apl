# مثال 6151 — طول الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (حرف كبير)
# len of upper applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6151-txt-cons-upper-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ.upper()
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 7, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 5, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 2, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 11, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 9, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 6, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 12, "حالة 8")
