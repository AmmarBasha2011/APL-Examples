# مثال 10312 — تحويل وحدة إلى 51 وحدات صغرى والعكس
# Convert units with factor 51
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10312-unit-scale-51.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 51, ن // 51, ن % 51]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [51, 0, 1], "حالة 2")
تأكد_يساوي(ف(51), [2601, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [51000, 19, 31], "حالة 4")
