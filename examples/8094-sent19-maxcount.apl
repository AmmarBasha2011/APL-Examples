# مثال 8094 — أعلى تكرار في الجملة رقم 20
# maxcount for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8094-sent19-maxcount.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  م = 0
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
    م = max(م, د[ك])
  ارجع م

تأكد_يساوي(ف("yes no yes yes no maybe"), 3, "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), 2, "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), 2, "حالة 3")
