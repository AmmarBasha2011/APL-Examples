# مثال 9910 — الوسيط (بعد الترتيب) (مجموعة 18)
# median (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9910-stat-median-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([1, 27, 13, 32, -14, 42]), 20, "حالة 1")
تأكد_يساوي(ف([16, 3, 28, -3, 56]), 16, "حالة 2")
تأكد_يساوي(ف([-6, 25, -17, 18, 50, -5, 6, 59, 44]), 18, "حالة 3")
تأكد_يساوي(ف([-2, 51, 13, -8, -20, -3, -20, 10]), -3, "حالة 4")
