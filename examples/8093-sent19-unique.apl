# مثال 8093 — عدد الكلمات المختلفة في الجملة رقم 20
# unique for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8093-sent19-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("yes no yes yes no maybe"), 3, "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), 5, "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), 4, "حالة 3")
