# مثال 9818 — قلب الخانة رقم 10
# Flip bit 10
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9818-bits-flip-10.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 10)

تأكد_يساوي(ف(0), 1024, "حالة 1")
تأكد_يساوي(ف(255), 1279, "حالة 2")
تأكد_يساوي(ف(1000), 2024, "حالة 3")
تأكد_يساوي(ف(12345), 13369, "حالة 4")
