# مثال 5230 — أقرب مضاعف للعدد 9
# Nearest multiple of 9
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5230-nearest-multiple-9.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 9
  لو ب * 2 < 9:
    ارجع ن - ب
  ارجع ن - ب + 9

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 9, "حالة 2")
تأكد_يساوي(ف(13), 9, "حالة 3")
تأكد_يساوي(ف(100), 99, "حالة 4")
تأكد_يساوي(ف(10), 9, "حالة 5")
