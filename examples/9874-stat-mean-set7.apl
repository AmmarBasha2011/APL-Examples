# مثال 9874 — المتوسط الصحيح (مجموعة 7)
# mean (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9874-stat-mean-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([1, 22, 27]), 16, "حالة 1")
تأكد_يساوي(ف([8, 40, 30, -11]), 16, "حالة 2")
تأكد_يساوي(ف([-10, 47, -13, 55]), 19, "حالة 3")
تأكد_يساوي(ف([-12, 46, 25, 19, 30, -14, 23]), 16, "حالة 4")
