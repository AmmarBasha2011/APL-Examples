# مثال 9414 — عكس الأرقام (مجموعة اختبار 5)
# revnum (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9414-num-revnum-set5.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(76121), 12167, "حالة 1")
تأكد_يساوي(ف(25841), 14852, "حالة 2")
تأكد_يساوي(ف(26964), 46962, "حالة 3")
تأكد_يساوي(ف(96772), 27769, "حالة 4")
تأكد_يساوي(ف(84144), 44148, "حالة 5")
