# مثال 7967 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 7
# longest for sentence 7
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7967-sent6-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("tea for two and two for tea"), "tea", "حالة 1")
تأكد_يساوي(ف("in the end the end is the start"), "start", "حالة 2")
تأكد_يساوي(ف("nile river nile delta river"), "river", "حالة 3")
