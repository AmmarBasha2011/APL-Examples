# مثال 8581 — أول عنصر من المدى 0 إلى 64 بخطوة 4 بعد (ناقص 3)
# first over range(0,64,4) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8581-range-0-64-4-dec3-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [خ - 3]
    خ = خ + (4)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), -3, "المدى كله")
