# مثال 9588 — الجذر الرقمي (مجموعة اختبار 19)
# droot (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9588-num-droot-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(15560), 8, "حالة 1")
تأكد_يساوي(ف(25104), 3, "حالة 2")
تأكد_يساوي(ف(93136), 4, "حالة 3")
تأكد_يساوي(ف(19637), 8, "حالة 4")
تأكد_يساوي(ف(54647), 8, "حالة 5")
