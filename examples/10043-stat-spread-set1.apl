# مثال 10043 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 1)
# spread (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10043-stat-spread-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([53, -10, 42, 13, -16, -20, -2, 55, 40]), 27, "حالة 1")
تأكد_يساوي(ف([27, 20, -18, 14, 42, 5, 32, 48, 49]), 23, "حالة 2")
تأكد_يساوي(ف([-8, 4, 52, 50, 13, 58, -9, 34]), 21, "حالة 3")
تأكد_يساوي(ف([-9, 26, 32, 12, 36]), 21, "حالة 4")
