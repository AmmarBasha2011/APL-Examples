# مثال 9211 — الحرف الأوسط (مجموعة اختبار 2)
# midchar (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9211-str-midchar-set2.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("python"), "h", "حالة 1")
تأكد_يساوي(ف("venus"), "n", "حالة 2")
تأكد_يساوي(ف("bob"), "o", "حالة 3")
تأكد_يساوي(ف("listen"), "t", "حالة 4")
تأكد_يساوي(ف("racecar"), "e", "حالة 5")
