# مثال 10324 — تحويل 22 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 22 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10324-temp-c-22.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 22) * 9 // 5 + 32

تأكد_يساوي(ف(0), 71, "حالة 1")
تأكد_يساوي(ف(10), 89, "حالة 2")
تأكد_يساوي(ف(37), 138, "حالة 3")
تأكد_يساوي(ف(-5), 62, "حالة 4")
