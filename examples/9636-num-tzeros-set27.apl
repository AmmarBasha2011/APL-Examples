# مثال 9636 — الأصفار في نهاية العاملي (مجموعة اختبار 27)
# tzeros (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9636-num-tzeros-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(192), 46, "حالة 1")
تأكد_يساوي(ف(196), 47, "حالة 2")
تأكد_يساوي(ف(52), 12, "حالة 3")
تأكد_يساوي(ف(148), 35, "حالة 4")
تأكد_يساوي(ف(455), 112, "حالة 5")
