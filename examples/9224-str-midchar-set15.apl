# مثال 9224 — الحرف الأوسط (مجموعة اختبار 15)
# midchar (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9224-str-midchar-set15.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("deed"), "e", "حالة 1")
تأكد_يساوي(ف("python"), "h", "حالة 2")
تأكد_يساوي(ف("level"), "v", "حالة 3")
تأكد_يساوي(ف("enlist"), "i", "حالة 4")
تأكد_يساوي(ف("venus"), "n", "حالة 5")
