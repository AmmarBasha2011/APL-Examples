# مثال 6871 — عدد أرقام العدد في الأساس 9
# Number of digits in base 9
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6871-digit-count-base-9.apl

# نقسم حتى يصبح العدد صفراً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع 1
  ع = 0
  طالما ن > 0:
    ع = ع + 1
    ن = ن // 9
  ارجع ع

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(9), 2, "حالة 3")
تأكد_يساوي(ف(80), 2, "حالة 4")
تأكد_يساوي(ف(1000), 4, "حالة 5")
