# مثال 10023 — ثاني أكبر قيمة مختلفة (مجموعة 6)
# second (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10023-stat-second-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([6, 50, 1, 9, 55, 41, -16]), 50, "حالة 1")
تأكد_يساوي(ف([41, 42, -14, 38, -13, 41, 59, -11, 56]), 56, "حالة 2")
تأكد_يساوي(ف([-20, -19, 13, 47, 15, 31]), 31, "حالة 3")
تأكد_يساوي(ف([6, 24, 39, 48, 13, 33]), 39, "حالة 4")
