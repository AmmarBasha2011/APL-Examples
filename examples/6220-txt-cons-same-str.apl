# مثال 6220 — النص الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (كما هو)
# str of same applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6220-txt-cons-same-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "hllwrld", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "plsfn", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "bc", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "thqckbrwnfx", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "zzzyyyxxx", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "dtscnc", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "prgrmmngnrbc", "حالة 8")
