# مثال 9738 — الجذر التربيعي الصحيح (مجموعة اختبار 9)
# sqrtint (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9738-num-sqrtint-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(1742), 41, "حالة 1")
تأكد_يساوي(ف(2588), 50, "حالة 2")
تأكد_يساوي(ف(4046), 63, "حالة 3")
تأكد_يساوي(ف(1590), 39, "حالة 4")
تأكد_يساوي(ف(3257), 57, "حالة 5")
