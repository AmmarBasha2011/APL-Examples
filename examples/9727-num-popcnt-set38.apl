# مثال 9727 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 38)
# popcnt (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9727-num-popcnt-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(4939), 7, "حالة 1")
تأكد_يساوي(ف(3045), 8, "حالة 2")
تأكد_يساوي(ف(2578), 4, "حالة 3")
تأكد_يساوي(ف(330), 4, "حالة 4")
تأكد_يساوي(ف(1526), 8, "حالة 5")
