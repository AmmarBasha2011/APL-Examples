# مثال 8004 — أعلى تكرار في الجملة رقم 11
# maxcount for sentence 11
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8004-sent10-maxcount.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  م = 0
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
    م = max(م, د[ك])
  ارجع م

تأكد_يساوي(ف("red blue green red blue red"), 3, "حالة 1")
تأكد_يساوي(ف("nile river nile delta river"), 2, "حالة 2")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), 3, "حالة 3")
