# مثال 10054 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 12)
# spread (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10054-stat-spread-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([56, 40, 15, 43, 4]), 25, "حالة 1")
تأكد_يساوي(ف([10, 22, 13, 1, 35, -13, -15, -19]), 14, "حالة 2")
تأكد_يساوي(ف([-18, 22, 40, 8, 48, -3]), 18, "حالة 3")
تأكد_يساوي(ف([46, 34, 35, 49]), 11, "حالة 4")
