# مثال 9913 — الوسيط (بعد الترتيب) (مجموعة 21)
# median (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9913-stat-median-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([-5, 8, -18, -3, 21]), -3, "حالة 1")
تأكد_يساوي(ف([29, 7, -20, 43, 10, 57, 19]), 19, "حالة 2")
تأكد_يساوي(ف([38, -6, -20, 45, -10, -12, -5, 41, 36]), -5, "حالة 3")
تأكد_يساوي(ف([14, 43, 16, 5, -1]), 14, "حالة 4")
