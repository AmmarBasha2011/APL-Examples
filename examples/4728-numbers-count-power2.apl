# مثال 4728 — عدد الأعداد القوة للعدد 2 حتى حد معين
# Numbers up to a limit: how many the power of two ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4728-numbers-count-power2.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر > 0 و (ر & (ر - 1)) == 0:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(22), 5, "حالة 1")
تأكد_يساوي(ف(55), 6, "حالة 2")
تأكد_يساوي(ف(96), 7, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
