# مثال 9386 — مجموع الأرقام (مجموعة اختبار 17)
# digsum (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9386-num-digsum-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(67801), 22, "حالة 1")
تأكد_يساوي(ف(95492), 29, "حالة 2")
تأكد_يساوي(ف(46576), 28, "حالة 3")
تأكد_يساوي(ف(54375), 24, "حالة 4")
تأكد_يساوي(ف(39214), 19, "حالة 5")
