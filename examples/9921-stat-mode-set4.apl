# مثال 9921 — المنوال (الأصغر عند التساوي) (مجموعة 4)
# mode (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9921-stat-mode-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([34, 27, -14, 53]), -14, "حالة 1")
تأكد_يساوي(ف([51, -15, -18]), -18, "حالة 2")
تأكد_يساوي(ف([14, 27, -17, -11, 36, 40, -6, 20]), -17, "حالة 3")
تأكد_يساوي(ف([19, 3, 12, 32]), 3, "حالة 4")
