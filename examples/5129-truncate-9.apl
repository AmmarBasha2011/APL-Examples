# مثال 5129 — اقتطاع النص إلى 9 حروف مع نقاط
# Truncate to 9 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5129-truncate-9.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 9:
    ارجع ن
  ارجع ن[:9] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello wor...", "حالة 2")
تأكد_يساوي(ف("xxxxxxxxx"), "xxxxxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyyyyy"), "yyyyyyyyy...", "حالة 4")
