# مثال 9761 — الجذر التربيعي الصحيح (مجموعة اختبار 32)
# sqrtint (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9761-num-sqrtint-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(1204), 34, "حالة 1")
تأكد_يساوي(ف(2544), 50, "حالة 2")
تأكد_يساوي(ف(144), 12, "حالة 3")
تأكد_يساوي(ف(2691), 51, "حالة 4")
تأكد_يساوي(ف(747), 27, "حالة 5")
