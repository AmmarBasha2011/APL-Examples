# مثال 9830 — إزاحة لليسار 13 خانات
# Shift left by 13
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9830-bits-shl-13.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 13

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 8192, "حالة 2")
تأكد_يساوي(ف(5), 40960, "حالة 3")
تأكد_يساوي(ف(100), 819200, "حالة 4")
