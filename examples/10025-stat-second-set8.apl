# مثال 10025 — ثاني أكبر قيمة مختلفة (مجموعة 8)
# second (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10025-stat-second-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([25, 36, 4, 30, 48]), 36, "حالة 1")
تأكد_يساوي(ف([44, -5, 48, -20, 57, 59, 23, -17]), 57, "حالة 2")
تأكد_يساوي(ف([-6, -9, 25, 25, 15, 30, 26, -12, 3]), 26, "حالة 3")
تأكد_يساوي(ف([30, 34, -17, 52, 15, 13, 4, -12]), 34, "حالة 4")
