# مثال 8075 — عدد الكلمات المكررة في الجملة رقم 18
# repeated for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8075-sent17-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("bread milk bread eggs milk bread"), 2, "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), 2, "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), 3, "حالة 3")
