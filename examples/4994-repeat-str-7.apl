# مثال 4994 — تكرار النص 7 مرات بفاصل
# Repeat text 7 times with separator
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4994-repeat-str-7.apl

# نبني النص بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(7):
    ر = ر + [ن]
  ارجع "-".join(ر)

تأكد_يساوي(ف("a"), "a-a-a-a-a-a-a", "حالة 1")
تأكد_يساوي(ف("xy"), "xy-xy-xy-xy-xy-xy-xy", "حالة 2")
تأكد_يساوي(ف(""), "------", "حالة 3")
