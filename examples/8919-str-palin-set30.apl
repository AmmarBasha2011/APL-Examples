# مثال 8919 — هل الكلمة متناظرة (مجموعة اختبار 30)
# palin (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8919-str-palin-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("listen"), خطأ, "حالة 1")
تأكد_يساوي(ف("venus"), خطأ, "حالة 2")
تأكد_يساوي(ف("river"), خطأ, "حالة 3")
تأكد_يساوي(ف("banana"), خطأ, "حالة 4")
تأكد_يساوي(ف("pluto"), خطأ, "حالة 5")
