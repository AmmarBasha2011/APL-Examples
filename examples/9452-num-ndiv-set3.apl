# مثال 9452 — عدد القواسم (مجموعة اختبار 3)
# ndiv (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9452-num-ndiv-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(277), 2, "حالة 1")
تأكد_يساوي(ف(149), 2, "حالة 2")
تأكد_يساوي(ف(16), 5, "حالة 3")
تأكد_يساوي(ف(108), 12, "حالة 4")
تأكد_يساوي(ف(132), 12, "حالة 5")
