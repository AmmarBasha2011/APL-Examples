# مثال 8982 — حروف الكلمة مرتبة (مجموعة اختبار 13)
# sortchars (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8982-str-sortchars-set13.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("rocket"), "cekort", "حالة 1")
تأكد_يساوي(ف("pluto"), "loptu", "حالة 2")
تأكد_يساوي(ف("deed"), "ddee", "حالة 3")
تأكد_يساوي(ف("civic"), "cciiv", "حالة 4")
تأكد_يساوي(ف("kayak"), "aakky", "حالة 5")
