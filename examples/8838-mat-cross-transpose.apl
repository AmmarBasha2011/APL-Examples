# مثال 8838 — المنقولة لمصفوفة قيمها i*3 - j*2
# Matrix transpose for cell formula i*3 - j*2
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8838-mat-cross-transpose.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * 3 - ك * 2]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل ك في range(len(ق)):
    س = []
    لكل ي في range(len(ق)):
      س = س + [ق[ي][ك]]
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [[0]], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [[0, 3], [-2, 1]], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [[0, 3, 6], [-2, 1, 4], [-4, -1, 2]], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [[0, 3, 6, 9, 12], [-2, 1, 4, 7, 10], [-4, -1, 2, 5, 8], [-6, -3, 0, 3, 6], [-8, -5, -2, 1, 4]], "حجم 5")
