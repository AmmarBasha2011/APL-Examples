# مثال 9357 — هل العدد أولي (مجموعة اختبار 28)
# prime (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9357-num-prime-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(167), صواب, "حالة 1")
تأكد_يساوي(ف(11), صواب, "حالة 2")
تأكد_يساوي(ف(121), خطأ, "حالة 3")
تأكد_يساوي(ف(66), خطأ, "حالة 4")
تأكد_يساوي(ف(105), خطأ, "حالة 5")
