# مثال 9977 — التباين الصحيح (مجموعة 10)
# variance (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9977-stat-variance-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-17, 20, 13, -5, 1, 33, 59]), 559, "حالة 1")
تأكد_يساوي(ف([45, 8, -17, -2, 23, 16, 3]), 336, "حالة 2")
تأكد_يساوي(ف([-7, -16, 56, 48, 22, 43]), 754, "حالة 3")
تأكد_يساوي(ف([4, 3, 50, 28, -4, 47, 36, 15]), 381, "حالة 4")
