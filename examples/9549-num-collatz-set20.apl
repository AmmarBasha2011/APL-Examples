# مثال 9549 — خطوات كولاتز (مجموعة اختبار 20)
# collatz (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9549-num-collatz-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(96), 12, "حالة 1")
تأكد_يساوي(ف(129), 121, "حالة 2")
تأكد_يساوي(ف(65), 27, "حالة 3")
تأكد_يساوي(ف(105), 38, "حالة 4")
تأكد_يساوي(ف(170), 10, "حالة 5")
