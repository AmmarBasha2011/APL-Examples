# مثال 6824 — عدد حلول 4س + 1ص = 8
# Count solutions of 4x+1y=8
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6824-pairs-4x-1y-8.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 4 * س + 1 * ص == 8:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 1, "حالة 2")
تأكد_يساوي(ف(10), 3, "حالة 3")
تأكد_يساوي(ف(8), 3, "حالة 4")
