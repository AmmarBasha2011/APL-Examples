# مثال 9233 — الحرف الأوسط (مجموعة اختبار 24)
# midchar (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9233-str-midchar-set24.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("civic"), "v", "حالة 1")
تأكد_يساوي(ف("venus"), "n", "حالة 2")
تأكد_يساوي(ف("refer"), "f", "حالة 3")
تأكد_يساوي(ف("sun"), "u", "حالة 4")
تأكد_يساوي(ف("array"), "r", "حالة 5")
