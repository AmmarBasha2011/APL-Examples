# مثال 5030 — فيزباز بالعددين 7 و 13
# FizzBuzz variant with 7 and 13
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5030-fizz-7-13.apl

# A للقابل على الأول، B للثاني، AB للاثنين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    لو ي % 7 == 0 و ي % 13 == 0:
      ر = ر + ["AB"]
    والا_لو ي % 7 == 0:
      ر = ر + ["A"]
    والا_لو ي % 13 == 0:
      ر = ر + ["B"]
    والا:
      ر = ر + [str(ي)]
  ارجع ر

تأكد_يساوي(ف(1), ["1"], "حالة 1")
تأكد_يساوي(ف(10), ["1", "2", "3", "4", "5", "6", "A", "8", "9", "10"], "حالة 2")
تأكد_يساوي(ف(30), ["1", "2", "3", "4", "5", "6", "A", "8", "9", "10", "11", "12", "B", "A", "15", "16", "17", "18", "19", "20", "A", "22", "23", "24", "25", "B", "27", "A", "29", "30"], "حالة 3")
تأكد_يساوي(ف(0), [], "حالة 4")
