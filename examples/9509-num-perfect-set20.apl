# مثال 9509 — هل العدد تام (مجموعة اختبار 20)
# perfect (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9509-num-perfect-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في range(1, ن):
    لو ن % ي == 0:
      م = م + ي
  ارجع م == ن و ن > 1

تأكد_يساوي(ف(192), خطأ, "حالة 1")
تأكد_يساوي(ف(257), خطأ, "حالة 2")
تأكد_يساوي(ف(129), خطأ, "حالة 3")
تأكد_يساوي(ف(210), خطأ, "حالة 4")
تأكد_يساوي(ف(339), خطأ, "حالة 5")
