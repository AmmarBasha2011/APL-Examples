# مثال 9570 — الجذر الرقمي (مجموعة اختبار 1)
# droot (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9570-num-droot-set1.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(81644), 5, "حالة 1")
تأكد_يساوي(ف(33481), 1, "حالة 2")
تأكد_يساوي(ف(97227), 9, "حالة 3")
تأكد_يساوي(ف(46993), 4, "حالة 4")
تأكد_يساوي(ف(90498), 3, "حالة 5")
