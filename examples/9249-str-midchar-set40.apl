# مثال 9249 — الحرف الأوسط (مجموعة اختبار 40)
# midchar (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9249-str-midchar-set40.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("enlist"), "i", "حالة 1")
تأكد_يساوي(ف("orbit"), "b", "حالة 2")
تأكد_يساوي(ف("kayak"), "y", "حالة 3")
تأكد_يساوي(ف("racecar"), "e", "حالة 4")
تأكد_يساوي(ف("saturn"), "u", "حالة 5")
