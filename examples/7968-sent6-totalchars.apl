# مثال 7968 — مجموع حروف الكلمات في الجملة رقم 7
# totalchars for sentence 7
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7968-sent6-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("tea for two and two for tea"), 21, "حالة 1")
تأكد_يساوي(ف("in the end the end is the start"), 24, "حالة 2")
تأكد_يساوي(ف("nile river nile delta river"), 23, "حالة 3")
