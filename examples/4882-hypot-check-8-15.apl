# مثال 4882 — هل مثلث أضلاعه مضاعفات (8,15) قائم؟
# Right triangle check with scale of (8,15)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4882-hypot-check-8-15.apl

# نتحقق من فيثاغورس: أ² + ب² = ج²

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, ج):
  أ = 8 * م
  ب = 15 * م
  ارجع أ * أ + ب * ب == ج * ج

تأكد_يساوي(ف(1, 1), خطأ, "حالة 1")
تأكد_يساوي(ف(1, 5), خطأ, "حالة 2")
تأكد_يساوي(ف(2, 10), خطأ, "حالة 3")
تأكد_يساوي(ف(3, 3), خطأ, "حالة 4")
