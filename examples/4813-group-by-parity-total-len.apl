# مثال 4813 — تجميع الكلمات حسب زوجية الطول (مجموع الأطوال)
# Group words by length parity: total length
# Demonstrates: قواميس وتجميع
#
# Run:  python apl.py examples/4813-group-by-parity-total-len.apl

# نمر على الكلمات
# ونحدّث القاموس حسب المفتاح

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    ك = len(خ) % 2
    لو ك في د:
      د[ك] = د[ك] + len(خ)
    والا:
      د[ك] = len(خ)
  ارجع د

تأكد_يساوي(ف(["apple", "bob", "cat", "apricot", "bear", "dog", "axe"]), {1: 24, 0: 4}, "حالة 1")
تأكد_يساوي(ف(["sun", "moon", "star", "sky", "mars"]), {1: 6, 0: 12}, "حالة 2")
تأكد_يساوي(ف(["one", "two", "three", "four", "five", "six"]), {1: 14, 0: 8}, "حالة 3")
تأكد_يساوي(ف(["kiwi", "lime", "lemon", "kale", "leek"]), {0: 16, 1: 5}, "حالة 4")
