# مثال 9486 — عدد القواسم (مجموعة اختبار 37)
# ndiv (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9486-num-ndiv-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(80), 10, "حالة 1")
تأكد_يساوي(ف(101), 2, "حالة 2")
تأكد_يساوي(ف(233), 2, "حالة 3")
تأكد_يساوي(ف(30), 8, "حالة 4")
تأكد_يساوي(ف(90), 12, "حالة 5")
