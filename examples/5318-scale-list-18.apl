# مثال 5318 — ضرب كل عنصر في 18
# Scale list by 18
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5318-scale-list-18.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 18]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [18, 36, 54], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -72, 180], "حالة 3")
