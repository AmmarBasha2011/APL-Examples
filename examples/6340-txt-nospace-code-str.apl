# مثال 6340 — النص الناتج بعد أخذ غير المسافات وتحويلها إلى (رقم الحرف)
# str of code applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6340-txt-nospace-code-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + str(ord(خ))+","
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "104,101,108,108,111,119,111,114,108,100,52,50,", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "97,112,108,105,115,102,117,110,", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "97,49,98,50,99,51,", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "116,104,101,113,117,105,99,107,98,114,111,119,110,102,111,120,", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "122,122,122,121,121,121,120,120,120,", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "100,97,116,97,50,48,50,54,115,99,105,101,110,99,101,", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "112,114,111,103,114,97,109,109,105,110,103,105,110,97,114,97,98,105,99,", "حالة 8")
