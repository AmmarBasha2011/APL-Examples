# مثال 6700 — الأعداد التي باقيها 12 عند القسمة على 18
# Numbers with remainder 12 mod 18
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6700-residue-18-12.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 18 == 12:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [], "حالة 2")
تأكد_يساوي(ف(40), [12, 30], "حالة 3")
تأكد_يساوي(ف(75), [12, 30, 48, 66], "حالة 4")
