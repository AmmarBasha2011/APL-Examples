# مثال 4487 — ترتيب نتيجة سالبها للأعداد الفردية
# Sorted list of negated over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4487-pipeline-odd-negate-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [0 - خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [-35, -21, -7], "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [-11, -3, -1], "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [-15, -9, -7], "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [-13, -5, -3, -1, -1], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
