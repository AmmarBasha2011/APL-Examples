# مثال 9944 — المدى (مجموعة 2)
# range (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9944-stat-range-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([-13, -18, 16, -10, -20]), 36, "حالة 1")
تأكد_يساوي(ف([60, 2, 11, 14, 35, 26, 51]), 58, "حالة 2")
تأكد_يساوي(ف([49, -11, 53, 32, 42]), 64, "حالة 3")
تأكد_يساوي(ف([24, 30, 11, 30, 1, -5]), 35, "حالة 4")
