# مثال 4539 — آخر نتيجة مربعها للأعداد الأكبر من 10
# Last (or -1) of square over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4539-pipeline-big-square-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([3, 1, 2, 8, 5]), -1, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 1764, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 169, "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 625, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
