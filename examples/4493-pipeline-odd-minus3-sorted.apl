# مثال 4493 — ترتيب نتيجة ناقص 3 للأعداد الفردية
# Sorted list of minus 3 over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4493-pipeline-odd-minus3-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ - 3]
  ارجع sorted(ن)

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [-2, 0, 8], "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [-8, 22], "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), [-2, 0, 2], "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [4, 6, 12], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
