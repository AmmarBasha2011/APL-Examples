# مثال 9075 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 26)
# dedupe (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9075-str-dedupe-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("python"), "python", "حالة 1")
تأكد_يساوي(ف("banana"), "ban", "حالة 2")
تأكد_يساوي(ف("loop"), "lop", "حالة 3")
تأكد_يساوي(ف("river"), "rive", "حالة 4")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 5")
