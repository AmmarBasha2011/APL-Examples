# مثال 5222 — مجموع تراكمي مع زيادة 8
# Running total plus 8 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5222-cumulative-8.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 8
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [9, 19, 30], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [13, 26, 39, 52], "حالة 3")
