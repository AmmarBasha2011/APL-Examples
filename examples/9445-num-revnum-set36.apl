# مثال 9445 — عكس الأرقام (مجموعة اختبار 36)
# revnum (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9445-num-revnum-set36.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(94397), 79349, "حالة 1")
تأكد_يساوي(ف(41016), 61014, "حالة 2")
تأكد_يساوي(ف(99593), 39599, "حالة 3")
تأكد_يساوي(ف(8732), 2378, "حالة 4")
تأكد_يساوي(ف(73789), 98737, "حالة 5")
