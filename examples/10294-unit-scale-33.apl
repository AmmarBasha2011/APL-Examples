# مثال 10294 — تحويل وحدة إلى 33 وحدات صغرى والعكس
# Convert units with factor 33
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10294-unit-scale-33.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 33, ن // 33, ن % 33]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [33, 0, 1], "حالة 2")
تأكد_يساوي(ف(33), [1089, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [33000, 30, 10], "حالة 4")
