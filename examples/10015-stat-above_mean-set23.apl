# مثال 10015 — عدد العناصر فوق المتوسط (مجموعة 23)
# above_mean (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10015-stat-above_mean-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-17, -4, 50, 38, 44, 3, 37, -16, -18]), 4, "حالة 1")
تأكد_يساوي(ف([56, 9, 6]), 1, "حالة 2")
تأكد_يساوي(ف([51, 14, 58, 35]), 2, "حالة 3")
تأكد_يساوي(ف([40, 51, 31, 40, -7, 23]), 4, "حالة 4")
