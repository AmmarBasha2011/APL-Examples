# مثال 4452 — أكبر نتيجة مربعها للأعداد الزوجية
# Largest (or 0) of square over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4452-pipeline-even-square-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 100, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 1764, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 256, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 144, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
