# مثال 4522 — عدد نتيجة زائد 7 للأعداد التقبل القسمة على 3
# Count of plus 7 over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4522-pipeline-div3-plus7-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [خ + 7]
  ارجع len(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 0, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 3, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 1, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 1, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
