# مثال 9360 — هل العدد أولي (مجموعة اختبار 31)
# prime (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9360-num-prime-set31.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(95), خطأ, "حالة 1")
تأكد_يساوي(ف(87), خطأ, "حالة 2")
تأكد_يساوي(ف(6), خطأ, "حالة 3")
تأكد_يساوي(ف(33), خطأ, "حالة 4")
تأكد_يساوي(ف(171), خطأ, "حالة 5")
