# مثال 4975 — أول 8 مضاعفات للعدد 3 بدءاً من n
# Eight multiples starting at n for step 3
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4975-multiples-3.apl

# نضيف الخطوة في كل مرة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(8):
    ر = ر + [ن + ي * 3]
  ارجع ر

تأكد_يساوي(ف(0), [0, 3, 6, 9, 12, 15, 18, 21], "حالة 1")
تأكد_يساوي(ف(5), [5, 8, 11, 14, 17, 20, 23, 26], "حالة 2")
تأكد_يساوي(ف(100), [100, 103, 106, 109, 112, 115, 118, 121], "حالة 3")
