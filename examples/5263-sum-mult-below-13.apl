# مثال 5263 — مجموع مضاعفات 13 تحت ن
# Sum of multiples of 13 below n
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5263-sum-mult-below-13.apl

# نمر على الأعداد ونجمع المضاعفات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في range(ن):
    لو ي % 13 == 0:
      م = م + ي
  ارجع م

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(10), 0, "حالة 2")
تأكد_يساوي(ف(50), 78, "حالة 3")
تأكد_يساوي(ف(100), 364, "حالة 4")
