# مثال 5250 — أقرب مضاعف للعدد 11
# Nearest multiple of 11
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5250-nearest-multiple-11.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 11
  لو ب * 2 < 11:
    ارجع ن - ب
  ارجع ن - ب + 11

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 11, "حالة 2")
تأكد_يساوي(ف(13), 11, "حالة 3")
تأكد_يساوي(ف(100), 99, "حالة 4")
تأكد_يساوي(ف(12), 11, "حالة 5")
