# مثال 4688 — عدد الأعداد التقبل القسمة على 4 ولا على 6 حتى حد معين
# Numbers up to a limit: how many the divisible by 4 but not 6 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4688-numbers-count-div4not6.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 4 == 0 و ر % 6 != 0:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(17), 3, "حالة 1")
تأكد_يساوي(ف(36), 6, "حالة 2")
تأكد_يساوي(ف(129), 22, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
