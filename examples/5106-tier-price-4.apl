# مثال 5106 — سعر متدرج بحد 4
# Tiered price with cutoff 4
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5106-tier-price-4.apl

# أول 4 وحدات بسعر 3 والباقي بسعر 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن <= 4:
    ارجع ن * 3
  ارجع 4 * 3 + (ن - 4) * 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(4), 12, "حالة 3")
تأكد_يساوي(ف(9), 22, "حالة 4")
تأكد_يساوي(ف(12), 28, "حالة 5")
