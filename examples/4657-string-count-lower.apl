# مثال 4657 — عدّ (حرف صغير) في نص
# String: count lowercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4657-string-count-lower.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ع = 0
  لكل خ في س:
    لو خ.islower():
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("apple PIE 7 and 9"), 8, "حالة 1")
تأكد_يساوي(ف("Data Science 101"), 9, "حالة 2")
تأكد_يساوي(ف("ZZtop and the Beatles"), 15, "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), 4, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
