# مثال 8063 — عدد الكلمات المختلفة في الجملة رقم 17
# unique for sentence 17
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8063-sent16-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("sun sand sea sun sand sun"), 3, "حالة 1")
تأكد_يساوي(ف("yes no yes yes no maybe"), 3, "حالة 2")
تأكد_يساوي(ف("one fish two fish red fish blue fish"), 5, "حالة 3")
