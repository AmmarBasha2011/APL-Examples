# مثال 9813 — قلب الخانة رقم 9
# Flip bit 9
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9813-bits-flip-9.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 9)

تأكد_يساوي(ف(0), 512, "حالة 1")
تأكد_يساوي(ف(255), 767, "حالة 2")
تأكد_يساوي(ف(1000), 488, "حالة 3")
تأكد_يساوي(ف(12345), 12857, "حالة 4")
