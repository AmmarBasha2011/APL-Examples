# مثال 10277 — تحويل وحدة إلى 16 وحدات صغرى والعكس
# Convert units with factor 16
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10277-unit-scale-16.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 16, ن // 16, ن % 16]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [16, 0, 1], "حالة 2")
تأكد_يساوي(ف(16), [256, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [16000, 62, 8], "حالة 4")
