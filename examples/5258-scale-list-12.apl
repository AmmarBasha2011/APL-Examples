# مثال 5258 — ضرب كل عنصر في 12
# Scale list by 12
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5258-scale-list-12.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 12]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [12, 24, 36], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -48, 120], "حالة 3")
