# مثال 9284 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 35)
# altcase (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9284-str-altcase-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("stats"), "StAtS", "حالة 1")
تأكد_يساوي(ف("silent"), "SiLeNt", "حالة 2")
تأكد_يساوي(ف("comet"), "CoMeT", "حالة 3")
تأكد_يساوي(ف("radar"), "RaDaR", "حالة 4")
تأكد_يساوي(ف("orbit"), "OrBiT", "حالة 5")
