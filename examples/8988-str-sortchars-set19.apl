# مثال 8988 — حروف الكلمة مرتبة (مجموعة اختبار 19)
# sortchars (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8988-str-sortchars-set19.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("refer"), "eefrr", "حالة 1")
تأكد_يساوي(ف("listen"), "eilnst", "حالة 2")
تأكد_يساوي(ف("rocket"), "cekort", "حالة 3")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 4")
تأكد_يساوي(ف("civic"), "cciiv", "حالة 5")
