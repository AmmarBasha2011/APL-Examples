# مثال 7958 — مجموع حروف الكلمات في الجملة رقم 6
# totalchars for sentence 6
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7958-sent5-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("we love data and data loves us"), 24, "حالة 1")
تأكد_يساوي(ف("a b c a b a"), 6, "حالة 2")
تأكد_يساوي(ف("cairo is big and cairo is old"), 23, "حالة 3")
