# مثال 9746 — الجذر التربيعي الصحيح (مجموعة اختبار 17)
# sqrtint (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9746-num-sqrtint-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(360), 18, "حالة 1")
تأكد_يساوي(ف(2699), 51, "حالة 2")
تأكد_يساوي(ف(814), 28, "حالة 3")
تأكد_يساوي(ف(2347), 48, "حالة 4")
تأكد_يساوي(ف(1945), 44, "حالة 5")
