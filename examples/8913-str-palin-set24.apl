# مثال 8913 — هل الكلمة متناظرة (مجموعة اختبار 24)
# palin (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8913-str-palin-set24.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("array"), خطأ, "حالة 1")
تأكد_يساوي(ف("star"), خطأ, "حالة 2")
تأكد_يساوي(ف("planet"), خطأ, "حالة 3")
تأكد_يساوي(ف("level"), صواب, "حالة 4")
تأكد_يساوي(ف("google"), خطأ, "حالة 5")
