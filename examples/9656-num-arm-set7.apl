# مثال 9656 — هل العدد أرمسترونغ (مجموعة اختبار 7)
# arm (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9656-num-arm-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(519), خطأ, "حالة 1")
تأكد_يساوي(ف(860), خطأ, "حالة 2")
تأكد_يساوي(ف(465), خطأ, "حالة 3")
تأكد_يساوي(ف(347), خطأ, "حالة 4")
تأكد_يساوي(ف(572), خطأ, "حالة 5")
