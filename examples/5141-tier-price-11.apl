# مثال 5141 — سعر متدرج بحد 11
# Tiered price with cutoff 11
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5141-tier-price-11.apl

# أول 11 وحدات بسعر 3 والباقي بسعر 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن <= 11:
    ارجع ن * 3
  ارجع 11 * 3 + (ن - 11) * 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(11), 33, "حالة 3")
تأكد_يساوي(ف(16), 43, "حالة 4")
تأكد_يساوي(ف(33), 77, "حالة 5")
