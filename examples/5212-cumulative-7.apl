# مثال 5212 — مجموع تراكمي مع زيادة 7
# Running total plus 7 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5212-cumulative-7.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 7
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [8, 17, 27], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [12, 24, 36, 48], "حالة 3")
