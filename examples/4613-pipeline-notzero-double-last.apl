# مثال 4613 — آخر نتيجة ضعفها للأعداد الغير الصفرية
# Last (or -1) of double over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4613-pipeline-notzero-double-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ * 2]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 26, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 32, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 30, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 12, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
