# مثال 5262 — مجموع تراكمي مع زيادة 12
# Running total plus 12 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5262-cumulative-12.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 12
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [13, 27, 42], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [17, 34, 51, 68], "حالة 3")
