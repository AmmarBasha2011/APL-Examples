# مثال 9592 — الجذر الرقمي (مجموعة اختبار 23)
# droot (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9592-num-droot-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(86302), 1, "حالة 1")
تأكد_يساوي(ف(61958), 2, "حالة 2")
تأكد_يساوي(ف(96189), 6, "حالة 3")
تأكد_يساوي(ف(82978), 7, "حالة 4")
تأكد_يساوي(ف(65835), 9, "حالة 5")
