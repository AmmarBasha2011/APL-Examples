# مثال 9245 — الحرف الأوسط (مجموعة اختبار 36)
# midchar (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9245-str-midchar-set36.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("apple"), "p", "حالة 1")
تأكد_يساوي(ف("silent"), "e", "حالة 2")
تأكد_يساوي(ف("earth"), "r", "حالة 3")
تأكد_يساوي(ف("data"), "t", "حالة 4")
تأكد_يساوي(ف("river"), "v", "حالة 5")
