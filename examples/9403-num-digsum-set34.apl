# مثال 9403 — مجموع الأرقام (مجموعة اختبار 34)
# digsum (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9403-num-digsum-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(25269), 24, "حالة 1")
تأكد_يساوي(ف(67696), 34, "حالة 2")
تأكد_يساوي(ف(63746), 26, "حالة 3")
تأكد_يساوي(ف(40740), 15, "حالة 4")
تأكد_يساوي(ف(6818), 23, "حالة 5")
