# مثال 4619 — ترتيب نتيجة سالبها للأعداد الغير الصفرية
# Sorted list of negated over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4619-pipeline-notzero-negate-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [0 - خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [-42, -35, -28, -21, -14, -7], "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [-13, -8, -5, -3, -2, -1, -1], "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [-15, -12, -9, -7, 4], "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [-20, -11, -6, -4, -3, -1], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
