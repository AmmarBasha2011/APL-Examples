# مثال 4509 — آخر نتيجة مكعبها للأعداد الموجبة
# Last (or -1) of cube over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4509-pipeline-positive-cube-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ * خ * خ]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 4096, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 3375, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 8, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 125, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
