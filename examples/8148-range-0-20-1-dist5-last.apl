# مثال 8148 — آخر عنصر من المدى 0 إلى 20 بخطوة 1 بعد (البعد عن 5)
# last over range(0,20,1) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8148-range-0-20-1-dist5-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 20:
    ر = ر + [abs(خ - 5)]
    خ = خ + (1)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 14, "المدى كله")
