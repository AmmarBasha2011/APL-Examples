# مثال 9915 — الوسيط (بعد الترتيب) (مجموعة 23)
# median (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9915-stat-median-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([14, 21, 30, 11, 45, -1, 12, 4, -11]), 12, "حالة 1")
تأكد_يساوي(ف([38, -5, -4]), -4, "حالة 2")
تأكد_يساوي(ف([44, 39, 19, 43, 38, 24]), 38, "حالة 3")
تأكد_يساوي(ف([20, 13, 1, -12, 42, 47, 50]), 20, "حالة 4")
