# مثال 6850 — عدد أرقام العدد في الأساس 2
# Number of digits in base 2
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6850-digit-count-base-2.apl

# نقسم حتى يصبح العدد صفراً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع 1
  ع = 0
  طالما ن > 0:
    ع = ع + 1
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(2), 2, "حالة 3")
تأكد_يساوي(ف(3), 2, "حالة 4")
تأكد_يساوي(ف(1000), 10, "حالة 5")
