# مثال 9961 — المدى (مجموعة 19)
# range (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9961-stat-range-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([18, -20, 2, -12, 27, 26, 10]), 47, "حالة 1")
تأكد_يساوي(ف([-3, 57, 56, 59, 21, 15]), 62, "حالة 2")
تأكد_يساوي(ف([4, -10, 53]), 63, "حالة 3")
تأكد_يساوي(ف([36, 40, 38, 50, 42, 38, 8, -17]), 67, "حالة 4")
