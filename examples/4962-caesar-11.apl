# مثال 4962 — شيفرة قيصر بإزاحة 11
# Caesar cipher shift 11
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4962-caesar-11.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 11) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "lmn", "حالة 1")
تأكد_يساوي(ف("hello world"), "spwwz hzcwo", "حالة 2")
تأكد_يساوي(ف("xyz"), "ijk", "حالة 3")
تأكد_يساوي(ف("a b-c"), "l m-n", "حالة 4")
