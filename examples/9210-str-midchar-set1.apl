# مثال 9210 — الحرف الأوسط (مجموعة اختبار 1)
# midchar (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9210-str-midchar-set1.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("google"), "g", "حالة 1")
تأكد_يساوي(ف("data"), "t", "حالة 2")
تأكد_يساوي(ف("moon"), "o", "حالة 3")
تأكد_يساوي(ف("banana"), "a", "حالة 4")
تأكد_يساوي(ف("radar"), "d", "حالة 5")
