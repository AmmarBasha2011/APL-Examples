# مثال 4552 — مجموع نتيجة مكعبها للأعداد الأكبر من 10
# Sum of cube over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4552-pipeline-big-cube-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ * خ * خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 2197, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 9331, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 15625, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 5103, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
