# مثال 4829 — إجمالي مع ضريبة 5%
# Total with 5 percent tax
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4829-tax-5.apl

# الإجمالي = السعر + الضريبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س + س * 5 // 100

تأكد_يساوي(ف(100), 105, "حالة 1")
تأكد_يساوي(ف(200), 210, "حالة 2")
تأكد_يساوي(ف(1500), 1575, "حالة 3")
تأكد_يساوي(ف(80), 84, "حالة 4")
