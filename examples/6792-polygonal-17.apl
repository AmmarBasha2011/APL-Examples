# مثال 6792 — العدد المضلّع ذو 17 أضلاع
# 17-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6792-polygonal-17.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((17 - 2) * ن * ن - (17 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 17, "حالة 2")
تأكد_يساوي(ف(5), 155, "حالة 3")
تأكد_يساوي(ف(10), 685, "حالة 4")
