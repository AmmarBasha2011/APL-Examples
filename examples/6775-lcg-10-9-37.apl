# مثال 6775 — مولّد أرقام عشوائية خطي (10,9,37)
# LCG a=10 c=9 m=37
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6775-lcg-10-9-37.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (10 * س + 9) % 37
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [19, 14, 1, 19, 14], "حالة 1")
تأكد_يساوي(ف(0, 8), [9, 25, 0, 9, 25, 0, 9, 25], "حالة 2")
تأكد_يساوي(ف(7, 10), [5, 22, 7, 5, 22, 7, 5, 22, 7, 5], "حالة 3")
