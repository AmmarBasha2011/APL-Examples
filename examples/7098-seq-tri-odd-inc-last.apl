# مثال 7098 — آخر عنصر: من الأعداد المثلثية نأخذ الفردي ثم (زيادة واحد)
# last over tri sequence, keep odd, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7098-seq-tri-odd-inc-last.apl

# نولّد أول ن حد من: الأعداد المثلثية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (ي + 1) // 2
    لو خ % 2 == 1:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 4, "حالة 3")
تأكد_يساوي(ف(10), 46, "حالة 4")
تأكد_يساوي(ف(15), 106, "حالة 5")
