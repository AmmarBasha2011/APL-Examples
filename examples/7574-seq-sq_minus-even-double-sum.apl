# مثال 7574 — المجموع: من مربع ناقص ي نأخذ الزوجي ثم (ضعف)
# sum over sq_minus sequence, keep even, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7574-seq-sq_minus-even-double-sum.apl

# نولّد أول ن حد من: مربع ناقص ي
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي - ي
    لو خ % 2 == 0:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 40, "حالة 3")
تأكد_يساوي(ف(10), 480, "حالة 4")
تأكد_يساوي(ف(15), 1820, "حالة 5")
