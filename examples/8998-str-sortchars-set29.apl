# مثال 8998 — حروف الكلمة مرتبة (مجموعة اختبار 29)
# sortchars (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8998-str-sortchars-set29.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("planet"), "aelnpt", "حالة 1")
تأكد_يساوي(ف("comet"), "cemot", "حالة 2")
تأكد_يساوي(ف("python"), "hnopty", "حالة 3")
تأكد_يساوي(ف("earth"), "aehrt", "حالة 4")
تأكد_يساوي(ف("rocket"), "cekort", "حالة 5")
