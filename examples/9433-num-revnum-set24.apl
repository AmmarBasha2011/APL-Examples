# مثال 9433 — عكس الأرقام (مجموعة اختبار 24)
# revnum (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9433-num-revnum-set24.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(23932), 23932, "حالة 1")
تأكد_يساوي(ف(75335), 53357, "حالة 2")
تأكد_يساوي(ف(74261), 16247, "حالة 3")
تأكد_يساوي(ف(51225), 52215, "حالة 4")
تأكد_يساوي(ف(82736), 63728, "حالة 5")
