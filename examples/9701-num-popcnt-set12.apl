# مثال 9701 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 12)
# popcnt (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9701-num-popcnt-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(582), 4, "حالة 1")
تأكد_يساوي(ف(803), 5, "حالة 2")
تأكد_يساوي(ف(2062), 4, "حالة 3")
تأكد_يساوي(ف(3090), 4, "حالة 4")
تأكد_يساوي(ف(1136), 4, "حالة 5")
