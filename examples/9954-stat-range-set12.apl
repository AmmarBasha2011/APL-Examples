# مثال 9954 — المدى (مجموعة 12)
# range (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9954-stat-range-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([4, 57, 46, -6, 51, 20, 47]), 63, "حالة 1")
تأكد_يساوي(ف([51, 37, 40, -1, 53, -7, -9]), 62, "حالة 2")
تأكد_يساوي(ف([34, 46, -8, 22]), 54, "حالة 3")
تأكد_يساوي(ف([-15, -2, 25, 30, 29]), 45, "حالة 4")
