# مثال 7276 — المجموع: من الأعداد الفردية نأخذ الأكبر من 5 ثم (مربع)
# sum over odd sequence, keep gt5, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7276-seq-odd-gt5-square-sum.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ > 5:
      ر = ر + [خ * خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 130, "حالة 3")
تأكد_يساوي(ف(10), 1295, "حالة 4")
تأكد_يساوي(ف(15), 4460, "حالة 5")
