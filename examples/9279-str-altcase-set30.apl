# مثال 9279 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 30)
# altcase (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9279-str-altcase-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("sun"), "SuN", "حالة 1")
تأكد_يساوي(ف("level"), "LeVeL", "حالة 2")
تأكد_يساوي(ف("moon"), "MoOn", "حالة 3")
تأكد_يساوي(ف("code"), "CoDe", "حالة 4")
تأكد_يساوي(ف("apple"), "ApPlE", "حالة 5")
