# مثال 9273 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 24)
# altcase (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9273-str-altcase-set24.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("civic"), "CiViC", "حالة 1")
تأكد_يساوي(ف("venus"), "VeNuS", "حالة 2")
تأكد_يساوي(ف("refer"), "ReFeR", "حالة 3")
تأكد_يساوي(ف("sun"), "SuN", "حالة 4")
تأكد_يساوي(ف("array"), "ArRaY", "حالة 5")
