# مثال 9200 — عكس حالة الأحرف (مجموعة اختبار 31)
# swapcase (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9200-str-swapcase-set31.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("enlist"), "ENLIST", "حالة 1")
تأكد_يساوي(ف("array"), "ARRAY", "حالة 2")
تأكد_يساوي(ف("python"), "PYTHON", "حالة 3")
تأكد_يساوي(ف("deed"), "DEED", "حالة 4")
تأكد_يساوي(ف("loop"), "LOOP", "حالة 5")
