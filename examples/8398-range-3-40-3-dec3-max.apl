# مثال 8398 — أكبر قيمة من المدى 3 إلى 40 بخطوة 3 بعد (ناقص 3)
# max over range(3,40,3) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8398-range-3-40-3-dec3-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ - 3]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 36, "المدى كله")
