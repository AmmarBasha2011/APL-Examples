# مثال 9382 — مجموع الأرقام (مجموعة اختبار 13)
# digsum (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9382-num-digsum-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(7039), 19, "حالة 1")
تأكد_يساوي(ف(90456), 24, "حالة 2")
تأكد_يساوي(ف(82269), 27, "حالة 3")
تأكد_يساوي(ف(26820), 18, "حالة 4")
تأكد_يساوي(ف(65564), 26, "حالة 5")
