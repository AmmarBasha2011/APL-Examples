# مثال 8893 — هل الكلمة متناظرة (مجموعة اختبار 4)
# palin (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8893-str-palin-set4.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("river"), خطأ, "حالة 1")
تأكد_يساوي(ف("rotor"), صواب, "حالة 2")
تأكد_يساوي(ف("planet"), خطأ, "حالة 3")
تأكد_يساوي(ف("earth"), خطأ, "حالة 4")
تأكد_يساوي(ف("banana"), خطأ, "حالة 5")
