# مثال 7939 — أول كلمة تتكرر في الجملة رقم 4
# firstdup for sentence 4
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7939-sent3-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("one fish two fish red fish blue fish"), "fish", "حالة 1")
تأكد_يساوي(ف("tea for two and two for tea"), "two", "حالة 2")
تأكد_يساوي(ف("red blue green red blue red"), "red", "حالة 3")
