# مثال 10342 — تحويل 58 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 58 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10342-temp-c-58.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 58) * 9 // 5 + 32

تأكد_يساوي(ف(0), 136, "حالة 1")
تأكد_يساوي(ف(10), 154, "حالة 2")
تأكد_يساوي(ف(37), 203, "حالة 3")
تأكد_يساوي(ف(-5), 127, "حالة 4")
