# مثال 7323 — آخر عنصر: من الأعداد الفردية نأخذ الموجب ثم (زيادة واحد)
# last over odd sequence, keep pos, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7323-seq-odd-pos-inc-last.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ > 0:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 10, "حالة 3")
تأكد_يساوي(ف(10), 20, "حالة 4")
تأكد_يساوي(ف(15), 30, "حالة 5")
