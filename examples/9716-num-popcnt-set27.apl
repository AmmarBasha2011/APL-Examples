# مثال 9716 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 27)
# popcnt (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9716-num-popcnt-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(3082), 4, "حالة 1")
تأكد_يساوي(ف(3149), 6, "حالة 2")
تأكد_يساوي(ف(838), 5, "حالة 3")
تأكد_يساوي(ف(2381), 6, "حالة 4")
تأكد_يساوي(ف(4296), 4, "حالة 5")
