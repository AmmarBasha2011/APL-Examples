# مثال 7988 — مجموع حروف الكلمات في الجملة رقم 9
# totalchars for sentence 9
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7988-sent8-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("a b c a b a"), 6, "حالة 1")
تأكد_يساوي(ف("up down up down up up down"), 20, "حالة 2")
تأكد_يساوي(ف("stars and moon and stars again"), 25, "حالة 3")
