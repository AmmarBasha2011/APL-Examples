# مثال 9696 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 7)
# popcnt (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9696-num-popcnt-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(2323), 5, "حالة 1")
تأكد_يساوي(ف(305), 4, "حالة 2")
تأكد_يساوي(ف(4006), 8, "حالة 3")
تأكد_يساوي(ف(35), 3, "حالة 4")
تأكد_يساوي(ف(4273), 5, "حالة 5")
