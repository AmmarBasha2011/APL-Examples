# مثال 9786 — إزاحة لليمين 4 خانات
# Shift right by 4
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9786-bits-shr-4.apl

# الإزاحة لليمين تقسم وتقتطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 4

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(4096), 256, "حالة 3")
تأكد_يساوي(ف(100000), 6250, "حالة 4")
