# مثال 9715 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 26)
# popcnt (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9715-num-popcnt-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(2630), 5, "حالة 1")
تأكد_يساوي(ف(1402), 7, "حالة 2")
تأكد_يساوي(ف(2031), 10, "حالة 3")
تأكد_يساوي(ف(847), 7, "حالة 4")
تأكد_يساوي(ف(3897), 8, "حالة 5")
