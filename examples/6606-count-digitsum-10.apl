# مثال 6606 — عدد الأعداد التي مجموع أرقامها 10
# Count numbers below n with digit sum 10
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6606-count-digitsum-10.apl

# نجمع أرقام كل عدد ونقارن

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(ن):
    م = 0
    ت = ي
    طالما ت > 0:
      م = م + ت % 10
      ت = ت // 10
    لو م == 10:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(10), 0, "حالة 1")
تأكد_يساوي(ف(100), 9, "حالة 2")
تأكد_يساوي(ف(300), 28, "حالة 3")
تأكد_يساوي(ف(500), 43, "حالة 4")
