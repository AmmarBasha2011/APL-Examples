# مثال 9667 — هل العدد أرمسترونغ (مجموعة اختبار 18)
# arm (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9667-num-arm-set18.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(66), خطأ, "حالة 1")
تأكد_يساوي(ف(865), خطأ, "حالة 2")
تأكد_يساوي(ف(195), خطأ, "حالة 3")
تأكد_يساوي(ف(476), خطأ, "حالة 4")
تأكد_يساوي(ف(79), خطأ, "حالة 5")
