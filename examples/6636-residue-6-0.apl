# مثال 6636 — الأعداد التي باقيها 0 عند القسمة على 6
# Numbers with remainder 0 mod 6
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6636-residue-6-0.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 6 == 0:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [0, 6], "حالة 2")
تأكد_يساوي(ف(40), [0, 6, 12, 18, 24, 30, 36], "حالة 3")
تأكد_يساوي(ف(75), [0, 6, 12, 18, 24, 30, 36, 42, 48, 54, 60, 66, 72], "حالة 4")
