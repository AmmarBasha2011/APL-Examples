# مثال 6189 — أول 3 حروف من الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (حرف مكرر)
# head of twice applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6189-txt-cons-twice-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ + خ
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "hhl", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "ppl", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "bbc", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "tth", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "zzz", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "ddt", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "ppr", "حالة 8")
