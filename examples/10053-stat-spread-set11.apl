# مثال 10053 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 11)
# spread (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10053-stat-spread-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([-19, 20, -19]), 39, "حالة 1")
تأكد_يساوي(ف([8, 11, 42, -19, 38, 47, -12, 41, 44]), 27, "حالة 2")
تأكد_يساوي(ف([8, 9, -16, -1, 21, 5, 49, 43]), 22, "حالة 3")
تأكد_يساوي(ف([44, 40, 27, 35, -15, 13, -1, 53]), 14, "حالة 4")
