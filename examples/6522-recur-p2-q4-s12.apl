# مثال 6522 — متتالية a(n) = 2·a(n-1) + 4·a(n-2) تبدأ بـ 1,2
# Linear recurrence p=2 q=4 start 1,2
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6522-recur-p2-q4-s12.apl

# كل حد يعتمد على الحدين السابقين
# نحدّث زوجاً من المتغيرات في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = 1
  ص = 2
  لكل ي في range(ن):
    ت = 2 * ص + 4 * س
    س = ص
    ص = ت
  ارجع س

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(2), 8, "حالة 3")
تأكد_يساوي(ف(5), 256, "حالة 4")
تأكد_يساوي(ف(8), 8704, "حالة 5")
تأكد_يساوي(ف(12), 954368, "حالة 6")
