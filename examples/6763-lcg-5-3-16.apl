# مثال 6763 — مولّد أرقام عشوائية خطي (5,3,16)
# LCG a=5 c=3 m=16
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6763-lcg-5-3-16.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (5 * س + 3) % 16
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [8, 11, 10, 5, 12], "حالة 1")
تأكد_يساوي(ف(0, 8), [3, 2, 13, 4, 7, 6, 1, 8], "حالة 2")
تأكد_يساوي(ف(7, 10), [6, 1, 8, 11, 10, 5, 12, 15, 14, 9], "حالة 3")
