# مثال 9489 — عدد القواسم (مجموعة اختبار 40)
# ndiv (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9489-num-ndiv-set40.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(56), 8, "حالة 1")
تأكد_يساوي(ف(233), 2, "حالة 2")
تأكد_يساوي(ف(63), 6, "حالة 3")
تأكد_يساوي(ف(74), 4, "حالة 4")
تأكد_يساوي(ف(125), 4, "حالة 5")
