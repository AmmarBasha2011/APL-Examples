# مثال 9665 — هل العدد أرمسترونغ (مجموعة اختبار 16)
# arm (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9665-num-arm-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(55), خطأ, "حالة 1")
تأكد_يساوي(ف(587), خطأ, "حالة 2")
تأكد_يساوي(ف(729), خطأ, "حالة 3")
تأكد_يساوي(ف(493), خطأ, "حالة 4")
تأكد_يساوي(ف(104), خطأ, "حالة 5")
