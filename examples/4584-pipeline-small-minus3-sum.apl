# مثال 4584 — مجموع نتيجة ناقص 3 للأعداد الأقل من 5
# Sum of minus 3 over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4584-pipeline-small-minus3-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ - 3]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([3, 1, 2, 8, 5]), -3, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), -10, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 0, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -1, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
