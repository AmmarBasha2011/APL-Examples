# مثال 10213 — شريط بعرض 7 من الرمز *
# Bar of width 7 using *
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10213-bar-7-42.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "*"
  ارجع ر + "|" + str(7)

تأكد_يساوي(ف(0), "|7", "حالة 1")
تأكد_يساوي(ف(3), "***|7", "حالة 2")
تأكد_يساوي(ف(7), "*******|7", "حالة 3")
