# مثال 9999 — عدد العناصر فوق المتوسط (مجموعة 7)
# above_mean (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9999-stat-above_mean-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([44, -17, 6, 34, 20, -10, 18, -1]), 4, "حالة 1")
تأكد_يساوي(ف([15, 56, -7, -3, 50, 19, 58]), 3, "حالة 2")
تأكد_يساوي(ف([25, 53, 34, -12, 52]), 3, "حالة 3")
تأكد_يساوي(ف([50, 57, 15, 1, -13, 59]), 3, "حالة 4")
