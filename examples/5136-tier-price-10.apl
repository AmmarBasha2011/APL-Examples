# مثال 5136 — سعر متدرج بحد 10
# Tiered price with cutoff 10
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5136-tier-price-10.apl

# أول 10 وحدات بسعر 3 والباقي بسعر 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن <= 10:
    ارجع ن * 3
  ارجع 10 * 3 + (ن - 10) * 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(10), 30, "حالة 3")
تأكد_يساوي(ف(15), 40, "حالة 4")
تأكد_يساوي(ف(30), 70, "حالة 5")
