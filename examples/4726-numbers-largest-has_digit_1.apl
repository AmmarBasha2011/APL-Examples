# مثال 4726 — أكبر الأعداد اليحتوي على الرقم 1 حتى حد معين
# Numbers up to a limit: largest of the contains digit 1 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4726-numbers-largest-has_digit_1.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو str(ر).find("1") != -1:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(16), 16, "حالة 1")
تأكد_يساوي(ف(58), 51, "حالة 2")
تأكد_يساوي(ف(118), 118, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
