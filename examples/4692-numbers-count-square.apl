# مثال 4692 — عدد الأعداد المربع كامل حتى حد معين
# Numbers up to a limit: how many the perfect square ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4692-numbers-count-square.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو int(ر ** 0.5) * int(ر ** 0.5) == ر:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(24), 4, "حالة 1")
تأكد_يساوي(ف(59), 7, "حالة 2")
تأكد_يساوي(ف(108), 10, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
