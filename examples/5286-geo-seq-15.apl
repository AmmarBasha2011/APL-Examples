# مثال 5286 — الحد ن في متتالية هندسية أساسها 15
# Nth term of geometric sequence, ratio 15
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5286-geo-seq-15.apl

# كل حد = السابق × الأساس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ر = أ
  لكل ي في range(ن - 1):
    ر = ر * 15
  ارجع ر

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 5), 50625, "حالة 2")
تأكد_يساوي(ف(3, 4), 10125, "حالة 3")
تأكد_يساوي(ف(2, 6), 1518750, "حالة 4")
