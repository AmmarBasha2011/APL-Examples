# مثال 9589 — الجذر الرقمي (مجموعة اختبار 20)
# droot (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9589-num-droot-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(81512), 8, "حالة 1")
تأكد_يساوي(ف(2126), 2, "حالة 2")
تأكد_يساوي(ف(90005), 5, "حالة 3")
تأكد_يساوي(ف(38268), 9, "حالة 4")
تأكد_يساوي(ف(70858), 1, "حالة 5")
