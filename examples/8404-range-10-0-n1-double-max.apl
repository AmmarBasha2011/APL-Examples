# مثال 8404 — أكبر قيمة من المدى 10 إلى 0 بخطوة -1 بعد (ضعف)
# max over range(10,0,-1) mapped by double
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8404-range-10-0-n1-double-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 10
  طالما خ > 0:
    ر = ر + [خ * 2]
    خ = خ + (-1)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 20, "المدى كله")
