# مثال 4956 — شيفرة قيصر بإزاحة 5
# Caesar cipher shift 5
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4956-caesar-5.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 5) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "fgh", "حالة 1")
تأكد_يساوي(ف("hello world"), "mjqqt btwqi", "حالة 2")
تأكد_يساوي(ف("xyz"), "cde", "حالة 3")
تأكد_يساوي(ف("a b-c"), "f g-h", "حالة 4")
