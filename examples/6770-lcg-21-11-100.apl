# مثال 6770 — مولّد أرقام عشوائية خطي (21,11,100)
# LCG a=21 c=11 m=100
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6770-lcg-21-11-100.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (21 * س + 11) % 100
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [32, 83, 54, 45, 56], "حالة 1")
تأكد_يساوي(ف(0, 8), [11, 42, 93, 64, 55, 66, 97, 48], "حالة 2")
تأكد_يساوي(ف(7, 10), [58, 29, 20, 31, 62, 13, 84, 75, 86, 17], "حالة 3")
