# مثال 9405 — مجموع الأرقام (مجموعة اختبار 36)
# digsum (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9405-num-digsum-set36.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(94397), 32, "حالة 1")
تأكد_يساوي(ف(41016), 12, "حالة 2")
تأكد_يساوي(ف(99593), 35, "حالة 3")
تأكد_يساوي(ف(8732), 20, "حالة 4")
تأكد_يساوي(ف(73789), 34, "حالة 5")
