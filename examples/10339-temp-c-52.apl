# مثال 10339 — تحويل 52 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 52 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10339-temp-c-52.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 52) * 9 // 5 + 32

تأكد_يساوي(ف(0), 125, "حالة 1")
تأكد_يساوي(ف(10), 143, "حالة 2")
تأكد_يساوي(ف(37), 192, "حالة 3")
تأكد_يساوي(ف(-5), 116, "حالة 4")
