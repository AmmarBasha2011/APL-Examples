# مثال 4583 — ترتيب نتيجة باقي قسمتها على 10 للأعداد الأقل من 5
# Sorted list of last digit mod 10 over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4583-pipeline-small-mod10-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ % 10]
  ارجع sorted(ن)

تأكد_يساوي(ف([3, 1, 2, 8, 5]), [1, 2, 3], "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [1, 3, 4], "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), [0, 0, 4], "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [1], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
