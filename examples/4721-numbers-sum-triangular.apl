# مثال 4721 — مجموع الأعداد المثلثي حتى حد معين
# Numbers up to a limit: sum of the triangular ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4721-numbers-sum-triangular.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو len([م for م in range(0, ر + 1) if م * (م + 1) // 2 == ر]) == 1:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(23), 56, "حالة 1")
تأكد_يساوي(ف(64), 220, "حالة 2")
تأكد_يساوي(ف(143), 816, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
