# مثال 8066 — عدد الكلمات التي ظهرت مرة واحدة في الجملة رقم 17
# once for sentence 17
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8066-sent16-once.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] == 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("sun sand sea sun sand sun"), 1, "حالة 1")
تأكد_يساوي(ف("yes no yes yes no maybe"), 1, "حالة 2")
تأكد_يساوي(ف("one fish two fish red fish blue fish"), 4, "حالة 3")
