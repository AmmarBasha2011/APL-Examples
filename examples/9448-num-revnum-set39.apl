# مثال 9448 — عكس الأرقام (مجموعة اختبار 39)
# revnum (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9448-num-revnum-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(60503), 30506, "حالة 1")
تأكد_يساوي(ف(69038), 83096, "حالة 2")
تأكد_يساوي(ف(75798), 89757, "حالة 3")
تأكد_يساوي(ف(61411), 11416, "حالة 4")
تأكد_يساوي(ف(33506), 60533, "حالة 5")
