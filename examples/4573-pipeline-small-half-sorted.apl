# مثال 4573 — ترتيب نتيجة نصفها بالقسمة الصحيحة للأعداد الأقل من 5
# Sorted list of integer half over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4573-pipeline-small-half-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ // 2]
  ارجع sorted(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), [0, 0, 2], "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [0, 1, 2], "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [], "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [-3, 1, 1], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
