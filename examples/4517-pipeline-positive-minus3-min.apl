# مثال 4517 — أصغر نتيجة ناقص 3 للأعداد الموجبة
# Smallest (or 0) of minus 3 over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4517-pipeline-positive-minus3-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 2, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 4, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -1, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -2, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
