# مثال 4531 — آخر نتيجة سالبها للأعداد التقبل القسمة على 3
# Last (or -1) of negated over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4531-pipeline-div3-negate-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([3, 1, 2, 8, 5]), -3, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -1, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), -6, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 0, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
