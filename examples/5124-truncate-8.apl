# مثال 5124 — اقتطاع النص إلى 8 حروف مع نقاط
# Truncate to 8 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5124-truncate-8.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 8:
    ارجع ن
  ارجع ن[:8] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello wo...", "حالة 2")
تأكد_يساوي(ف("xxxxxxxx"), "xxxxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyyyy"), "yyyyyyyy...", "حالة 4")
