# مثال 7948 — مجموع حروف الكلمات في الجملة رقم 5
# totalchars for sentence 5
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7948-sent4-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("a rose is a rose is a rose"), 19, "حالة 1")
تأكد_يساوي(ف("run run run fast fast slow"), 21, "حالة 2")
تأكد_يساوي(ف("up down up down up up down"), 20, "حالة 3")
