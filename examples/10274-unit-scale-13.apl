# مثال 10274 — تحويل وحدة إلى 13 وحدات صغرى والعكس
# Convert units with factor 13
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10274-unit-scale-13.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 13, ن // 13, ن % 13]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [13, 0, 1], "حالة 2")
تأكد_يساوي(ف(13), [169, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [13000, 76, 12], "حالة 4")
