# مثال 10208 — شريط بعرض 6 من الرمز *
# Bar of width 6 using *
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10208-bar-6-42.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "*"
  ارجع ر + "|" + str(6)

تأكد_يساوي(ف(0), "|6", "حالة 1")
تأكد_يساوي(ف(3), "***|6", "حالة 2")
تأكد_يساوي(ف(6), "******|6", "حالة 3")
