# مثال 9036 — هل لا يتكرر أي حرف (مجموعة اختبار 27)
# isogram (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9036-str-isogram-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("comet"), صواب, "حالة 1")
تأكد_يساوي(ف("listen"), صواب, "حالة 2")
تأكد_يساوي(ف("data"), خطأ, "حالة 3")
تأكد_يساوي(ف("pluto"), صواب, "حالة 4")
تأكد_يساوي(ف("saturn"), صواب, "حالة 5")
