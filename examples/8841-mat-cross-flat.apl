# مثال 8841 — التسطيح لمصفوفة قيمها i*3 - j*2
# Matrix flat for cell formula i*3 - j*2
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8841-mat-cross-flat.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * 3 - ك * 2]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل س في ق:
    ر = ر + س
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [0, -2, 3, 1], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [0, -2, -4, 3, 1, -1, 6, 4, 2], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [0, -2, -4, -6, -8, 3, 1, -1, -3, -5, 6, 4, 2, 0, -2, 9, 7, 5, 3, 1, 12, 10, 8, 6, 4], "حجم 5")
