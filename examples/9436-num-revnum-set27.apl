# مثال 9436 — عكس الأرقام (مجموعة اختبار 27)
# revnum (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9436-num-revnum-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(49319), 91394, "حالة 1")
تأكد_يساوي(ف(50390), 9305, "حالة 2")
تأكد_يساوي(ف(13415), 51431, "حالة 3")
تأكد_يساوي(ف(38111), 11183, "حالة 4")
تأكد_يساوي(ف(88755), 55788, "حالة 5")
