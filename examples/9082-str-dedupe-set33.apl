# مثال 9082 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 33)
# dedupe (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9082-str-dedupe-set33.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("code"), "code", "حالة 1")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 2")
تأكد_يساوي(ف("earth"), "earth", "حالة 3")
تأكد_يساوي(ف("apple"), "aple", "حالة 4")
تأكد_يساوي(ف("planet"), "planet", "حالة 5")
