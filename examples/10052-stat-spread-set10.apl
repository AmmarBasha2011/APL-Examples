# مثال 10052 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 10)
# spread (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10052-stat-spread-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([16, 29, 52, 55, 38, -9, 12]), 21, "حالة 1")
تأكد_يساوي(ف([30, 38, -14, 26, 41]), 40, "حالة 2")
تأكد_يساوي(ف([-2, 60, 3, 14, 31, -20, -5, 26, 48]), 17, "حالة 3")
تأكد_يساوي(ف([9, 6, -16, 16, -20]), 22, "حالة 4")
