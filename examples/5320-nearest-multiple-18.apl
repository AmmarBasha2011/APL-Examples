# مثال 5320 — أقرب مضاعف للعدد 18
# Nearest multiple of 18
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5320-nearest-multiple-18.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 18
  لو ب * 2 < 18:
    ارجع ن - ب
  ارجع ن - ب + 18

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 0, "حالة 2")
تأكد_يساوي(ف(13), 18, "حالة 3")
تأكد_يساوي(ف(100), 108, "حالة 4")
تأكد_يساوي(ف(19), 18, "حالة 5")
