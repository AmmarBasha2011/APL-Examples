# مثال 9957 — المدى (مجموعة 15)
# range (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9957-stat-range-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([22, 19, 32, 14, 45, 35]), 31, "حالة 1")
تأكد_يساوي(ف([13, 57, 33, 41, 15, 9, 37, 18, 45]), 48, "حالة 2")
تأكد_يساوي(ف([-3, 56, -19, -10, 56, 1]), 75, "حالة 3")
تأكد_يساوي(ف([-19, 21, 8, 40, -5, 60, 20, 0, 39]), 79, "حالة 4")
