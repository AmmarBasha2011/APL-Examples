# مثال 6262 — الناتج معكوس بعد أخذ الحروف فقط وتحويلها إلى (حرف مع شرطة)
# rev of dash applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6262-txt-alpha-dash-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + خ + "-"
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "-d-l-r-o-w-o-l-l-e-h", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "-n-u-f-s-i-l-p-a", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "-c-b-a", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "-x-o-f-n-w-o-r-b-k-c-i-u-q-e-h-t", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "-x-x-x-y-y-y-z-z-z", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "-e-c-n-e-i-c-s-a-t-a-d", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "-c-i-b-a-r-a-n-i-g-n-i-m-m-a-r-g-o-r-p", "حالة 8")
