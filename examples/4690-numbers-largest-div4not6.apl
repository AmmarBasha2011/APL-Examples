# مثال 4690 — أكبر الأعداد التقبل القسمة على 4 ولا على 6 حتى حد معين
# Numbers up to a limit: largest of the divisible by 4 but not 6 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4690-numbers-largest-div4not6.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 4 == 0 و ر % 6 != 0:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(25), 20, "حالة 1")
تأكد_يساوي(ف(42), 40, "حالة 2")
تأكد_يساوي(ف(142), 140, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
