# مثال 10263 — تحويل وحدة إلى 2 وحدات صغرى والعكس
# Convert units with factor 2
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10263-unit-scale-2.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 2, ن // 2, ن % 2]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [2, 0, 1], "حالة 2")
تأكد_يساوي(ف(2), [4, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [2000, 500, 0], "حالة 4")
