# مثال 4559 — أصغر نتيجة ناقص 3 للأعداد الأكبر من 10
# Smallest (or 0) of minus 3 over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4559-pipeline-big-minus3-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 10, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 0, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 22, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 13, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
