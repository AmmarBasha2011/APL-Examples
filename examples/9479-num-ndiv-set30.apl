# مثال 9479 — عدد القواسم (مجموعة اختبار 30)
# ndiv (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9479-num-ndiv-set30.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(246), 8, "حالة 1")
تأكد_يساوي(ف(242), 6, "حالة 2")
تأكد_يساوي(ف(296), 8, "حالة 3")
تأكد_يساوي(ف(15), 4, "حالة 4")
تأكد_يساوي(ف(104), 8, "حالة 5")
