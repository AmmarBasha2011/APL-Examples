# مثال 9523 — هل العدد تام (مجموعة اختبار 34)
# perfect (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9523-num-perfect-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في range(1, ن):
    لو ن % ي == 0:
      م = م + ي
  ارجع م == ن و ن > 1

تأكد_يساوي(ف(196), خطأ, "حالة 1")
تأكد_يساوي(ف(247), خطأ, "حالة 2")
تأكد_يساوي(ف(399), خطأ, "حالة 3")
تأكد_يساوي(ف(204), خطأ, "حالة 4")
تأكد_يساوي(ف(118), خطأ, "حالة 5")
