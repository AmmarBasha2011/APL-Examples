# مثال 10048 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 6)
# spread (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10048-stat-spread-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([6, 50, 1, 9, 55, 41, -16]), 32, "حالة 1")
تأكد_يساوي(ف([41, 42, -14, 38, -13, 41, 59, -11, 56]), 49, "حالة 2")
تأكد_يساوي(ف([-20, -19, 13, 47, 15, 31]), 32, "حالة 3")
تأكد_يساوي(ف([6, 24, 39, 48, 13, 33]), 11, "حالة 4")
