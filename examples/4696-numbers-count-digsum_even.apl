# مثال 4696 — عدد الأعداد المجموع أرقامه زوجي حتى حد معين
# Numbers up to a limit: how many the even digit sum ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4696-numbers-count-digsum_even.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو sum([int(د) for د in str(ر)]) % 2 == 0:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(12), 5, "حالة 1")
تأكد_يساوي(ف(38), 18, "حالة 2")
تأكد_يساوي(ف(123), 61, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
