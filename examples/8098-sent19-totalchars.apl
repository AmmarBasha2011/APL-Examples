# مثال 8098 — مجموع حروف الكلمات في الجملة رقم 20
# totalchars for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8098-sent19-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("yes no yes yes no maybe"), 18, "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), 22, "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), 21, "حالة 3")
