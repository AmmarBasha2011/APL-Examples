# مثال 6642 — الأعداد التي باقيها 0 عند القسمة على 7
# Numbers with remainder 0 mod 7
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6642-residue-7-0.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 7 == 0:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [0, 7], "حالة 2")
تأكد_يساوي(ف(40), [0, 7, 14, 21, 28, 35], "حالة 3")
تأكد_يساوي(ف(75), [0, 7, 14, 21, 28, 35, 42, 49, 56, 63, 70], "حالة 4")
