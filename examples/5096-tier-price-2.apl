# مثال 5096 — سعر متدرج بحد 2
# Tiered price with cutoff 2
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5096-tier-price-2.apl

# أول 2 وحدات بسعر 3 والباقي بسعر 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن <= 2:
    ارجع ن * 3
  ارجع 2 * 3 + (ن - 2) * 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(2), 6, "حالة 3")
تأكد_يساوي(ف(7), 16, "حالة 4")
تأكد_يساوي(ف(6), 14, "حالة 5")
