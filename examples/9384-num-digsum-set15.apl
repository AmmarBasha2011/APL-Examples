# مثال 9384 — مجموع الأرقام (مجموعة اختبار 15)
# digsum (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9384-num-digsum-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(92663), 26, "حالة 1")
تأكد_يساوي(ف(29017), 19, "حالة 2")
تأكد_يساوي(ف(34809), 24, "حالة 3")
تأكد_يساوي(ف(492), 15, "حالة 4")
تأكد_يساوي(ف(31643), 17, "حالة 5")
