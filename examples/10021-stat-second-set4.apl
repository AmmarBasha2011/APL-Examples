# مثال 10021 — ثاني أكبر قيمة مختلفة (مجموعة 4)
# second (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10021-stat-second-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([28, 5, 56, 2, 9, 11]), 28, "حالة 1")
تأكد_يساوي(ف([-9, 12, 29, 47]), 29, "حالة 2")
تأكد_يساوي(ف([48, -9, 59, 42, 5, 33, 58, 55]), 58, "حالة 3")
تأكد_يساوي(ف([27, 29, 7, -1]), 27, "حالة 4")
