# مثال 9628 — الأصفار في نهاية العاملي (مجموعة اختبار 19)
# tzeros (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9628-num-tzeros-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(442), 108, "حالة 1")
تأكد_يساوي(ف(315), 77, "حالة 2")
تأكد_يساوي(ف(30), 7, "حالة 3")
تأكد_يساوي(ف(18), 3, "حالة 4")
تأكد_يساوي(ف(488), 119, "حالة 5")
