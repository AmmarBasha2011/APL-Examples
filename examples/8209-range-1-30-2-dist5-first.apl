# مثال 8209 — أول عنصر من المدى 1 إلى 30 بخطوة 2 بعد (البعد عن 5)
# first over range(1,30,2) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8209-range-1-30-2-dist5-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [abs(خ - 5)]
    خ = خ + (2)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 4, "المدى كله")
