# مثال 9073 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 24)
# dedupe (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9073-str-dedupe-set24.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("tenet"), "ten", "حالة 1")
تأكد_يساوي(ف("kayak"), "kay", "حالة 2")
تأكد_يساوي(ف("loop"), "lop", "حالة 3")
تأكد_يساوي(ف("planet"), "planet", "حالة 4")
تأكد_يساوي(ف("google"), "gole", "حالة 5")
