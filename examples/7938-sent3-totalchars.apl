# مثال 7938 — مجموع حروف الكلمات في الجملة رقم 4
# totalchars for sentence 4
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7938-sent3-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("one fish two fish red fish blue fish"), 29, "حالة 1")
تأكد_يساوي(ف("tea for two and two for tea"), 21, "حالة 2")
تأكد_يساوي(ف("red blue green red blue red"), 22, "حالة 3")
