# مثال 9657 — هل العدد أرمسترونغ (مجموعة اختبار 8)
# arm (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9657-num-arm-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(560), خطأ, "حالة 1")
تأكد_يساوي(ف(187), خطأ, "حالة 2")
تأكد_يساوي(ف(128), خطأ, "حالة 3")
تأكد_يساوي(ف(844), خطأ, "حالة 4")
تأكد_يساوي(ف(287), خطأ, "حالة 5")
