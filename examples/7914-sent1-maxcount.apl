# مثال 7914 — أعلى تكرار في الجملة رقم 2
# maxcount for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7914-sent1-maxcount.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  م = 0
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
    م = max(م, د[ك])
  ارجع م

تأكد_يساوي(ف("to be or not to be"), 2, "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), 3, "حالة 2")
تأكد_يساوي(ف("a b c a b a"), 3, "حالة 3")
