# مثال 9900 — الوسيط (بعد الترتيب) (مجموعة 8)
# median (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9900-stat-median-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([25, 36, 4, 30, 48]), 30, "حالة 1")
تأكد_يساوي(ف([44, -5, 48, -20, 57, 59, 23, -17]), 33, "حالة 2")
تأكد_يساوي(ف([-6, -9, 25, 25, 15, 30, 26, -12, 3]), 15, "حالة 3")
تأكد_يساوي(ف([30, 34, -17, 52, 15, 13, 4, -12]), 14, "حالة 4")
