# مثال 8910 — هل الكلمة متناظرة (مجموعة اختبار 21)
# palin (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8910-str-palin-set21.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("planet"), خطأ, "حالة 1")
تأكد_يساوي(ف("venus"), خطأ, "حالة 2")
تأكد_يساوي(ف("level"), صواب, "حالة 3")
تأكد_يساوي(ف("orbit"), خطأ, "حالة 4")
تأكد_يساوي(ف("apple"), خطأ, "حالة 5")
