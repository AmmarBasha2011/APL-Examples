# مثال 5195 — الحد ن في متتالية حسابية فرقها 6
# Nth term of arithmetic sequence, step 6
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5195-arith-seq-6.apl

# الحد = الأول + (ن-1) × الفرق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ارجع أ + (ن - 1) * 6

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 10), 55, "حالة 2")
تأكد_يساوي(ف(5, 7), 41, "حالة 3")
تأكد_يساوي(ف(-3, 4), 15, "حالة 4")
