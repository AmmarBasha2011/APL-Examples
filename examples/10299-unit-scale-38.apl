# مثال 10299 — تحويل وحدة إلى 38 وحدات صغرى والعكس
# Convert units with factor 38
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10299-unit-scale-38.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 38, ن // 38, ن % 38]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [38, 0, 1], "حالة 2")
تأكد_يساوي(ف(38), [1444, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [38000, 26, 12], "حالة 4")
