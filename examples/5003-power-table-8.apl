# مثال 5003 — قوى العدد 8 حتى 6
# Powers of 8 up to 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/5003-power-table-8.apl

# نضرب في العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  ق = 1
  لكل ي في range(ن + 1):
    ر = ر + [ق]
    ق = ق * 8
  ارجع ر

تأكد_يساوي(ف(0), [1], "حالة 1")
تأكد_يساوي(ف(3), [1, 8, 64, 512], "حالة 2")
تأكد_يساوي(ف(6), [1, 8, 64, 512, 4096, 32768, 262144], "حالة 3")
