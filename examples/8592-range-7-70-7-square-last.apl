# مثال 8592 — آخر عنصر من المدى 7 إلى 70 بخطوة 7 بعد (مربع)
# last over range(7,70,7) mapped by square
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8592-range-7-70-7-square-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ * خ]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 3969, "المدى كله")
