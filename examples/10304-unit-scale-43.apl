# مثال 10304 — تحويل وحدة إلى 43 وحدات صغرى والعكس
# Convert units with factor 43
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10304-unit-scale-43.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 43, ن // 43, ن % 43]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [43, 0, 1], "حالة 2")
تأكد_يساوي(ف(43), [1849, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [43000, 23, 11], "حالة 4")
