# مثال 9431 — عكس الأرقام (مجموعة اختبار 22)
# revnum (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9431-num-revnum-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(53797), 79735, "حالة 1")
تأكد_يساوي(ف(46551), 15564, "حالة 2")
تأكد_يساوي(ف(6834), 4386, "حالة 3")
تأكد_يساوي(ف(64251), 15246, "حالة 4")
تأكد_يساوي(ف(24523), 32542, "حالة 5")
