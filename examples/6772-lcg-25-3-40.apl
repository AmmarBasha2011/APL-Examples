# مثال 6772 — مولّد أرقام عشوائية خطي (25,3,40)
# LCG a=25 c=3 m=40
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6772-lcg-25-3-40.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (25 * س + 3) % 40
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [28, 23, 18, 13, 8], "حالة 1")
تأكد_يساوي(ف(0, 8), [3, 38, 33, 28, 23, 18, 13, 8], "حالة 2")
تأكد_يساوي(ف(7, 10), [18, 13, 8, 3, 38, 33, 28, 23, 18, 13], "حالة 3")
