# مثال 8047 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 15
# longest for sentence 15
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8047-sent14-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("learn code learn more code more"), "learn", "حالة 1")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), "bread", "حالة 2")
تأكد_يساوي(ف("to be or not to be"), "not", "حالة 3")
