# مثال 4957 — شيفرة قيصر بإزاحة 6
# Caesar cipher shift 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4957-caesar-6.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 6) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "ghi", "حالة 1")
تأكد_يساوي(ف("hello world"), "nkrru cuxrj", "حالة 2")
تأكد_يساوي(ف("xyz"), "def", "حالة 3")
تأكد_يساوي(ف("a b-c"), "g h-i", "حالة 4")
