# مثال 7959 — أول كلمة تتكرر في الجملة رقم 6
# firstdup for sentence 6
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7959-sent5-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("we love data and data loves us"), "data", "حالة 1")
تأكد_يساوي(ف("a b c a b a"), "a", "حالة 2")
تأكد_يساوي(ف("cairo is big and cairo is old"), "cairo", "حالة 3")
