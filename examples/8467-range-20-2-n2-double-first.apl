# مثال 8467 — أول عنصر من المدى 20 إلى 2 بخطوة -2 بعد (ضعف)
# first over range(20,2,-2) mapped by double
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8467-range-20-2-n2-double-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [خ * 2]
    خ = خ + (-2)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 40, "المدى كله")
