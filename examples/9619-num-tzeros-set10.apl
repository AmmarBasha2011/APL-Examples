# مثال 9619 — الأصفار في نهاية العاملي (مجموعة اختبار 10)
# tzeros (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9619-num-tzeros-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(26), 6, "حالة 1")
تأكد_يساوي(ف(137), 33, "حالة 2")
تأكد_يساوي(ف(44), 9, "حالة 3")
تأكد_يساوي(ف(393), 96, "حالة 4")
تأكد_يساوي(ف(208), 50, "حالة 5")
