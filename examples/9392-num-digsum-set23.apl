# مثال 9392 — مجموع الأرقام (مجموعة اختبار 23)
# digsum (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9392-num-digsum-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(18971), 26, "حالة 1")
تأكد_يساوي(ف(38317), 22, "حالة 2")
تأكد_يساوي(ف(19660), 22, "حالة 3")
تأكد_يساوي(ف(87162), 24, "حالة 4")
تأكد_يساوي(ف(42581), 20, "حالة 5")
