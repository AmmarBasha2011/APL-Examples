# مثال 8090 — الحروف الأولى في الجملة رقم 19
# initials for sentence 19
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8090-sent18-initials.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    ر = ر + ك[0]
  ارجع ر

تأكد_يساوي(ف("left right left left right"), "lrllr", "حالة 1")
تأكد_يساوي(ف("to be or not to be"), "tbontb", "حالة 2")
تأكد_يساوي(ف("we love data and data loves us"), "wldadlu", "حالة 3")
