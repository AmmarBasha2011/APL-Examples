# مثال 9194 — عكس حالة الأحرف (مجموعة اختبار 25)
# swapcase (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9194-str-swapcase-set25.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("apple"), "APPLE", "حالة 1")
تأكد_يساوي(ف("banana"), "BANANA", "حالة 2")
تأكد_يساوي(ف("tenet"), "TENET", "حالة 3")
تأكد_يساوي(ف("civic"), "CIVIC", "حالة 4")
تأكد_يساوي(ف("sun"), "SUN", "حالة 5")
