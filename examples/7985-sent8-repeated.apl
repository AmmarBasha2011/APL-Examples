# مثال 7985 — عدد الكلمات المكررة في الجملة رقم 9
# repeated for sentence 9
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7985-sent8-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("a b c a b a"), 2, "حالة 1")
تأكد_يساوي(ف("up down up down up up down"), 2, "حالة 2")
تأكد_يساوي(ف("stars and moon and stars again"), 2, "حالة 3")
