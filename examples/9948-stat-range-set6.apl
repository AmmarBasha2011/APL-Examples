# مثال 9948 — المدى (مجموعة 6)
# range (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9948-stat-range-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([44, 23, 31]), 21, "حالة 1")
تأكد_يساوي(ف([55, 24, 46, 43]), 31, "حالة 2")
تأكد_يساوي(ف([7, 34, 40, -19, 15, -5, 22]), 59, "حالة 3")
تأكد_يساوي(ف([9, -14, 35]), 49, "حالة 4")
