# مثال 9446 — عكس الأرقام (مجموعة اختبار 37)
# revnum (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9446-num-revnum-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(9125), 5219, "حالة 1")
تأكد_يساوي(ف(6439), 9346, "حالة 2")
تأكد_يساوي(ف(53441), 14435, "حالة 3")
تأكد_يساوي(ف(18304), 40381, "حالة 4")
تأكد_يساوي(ف(39095), 59093, "حالة 5")
