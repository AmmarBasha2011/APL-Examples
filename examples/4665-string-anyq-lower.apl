# مثال 4665 — هل يوجد (حرف صغير) في نص
# String: is there any lowercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4665-string-anyq-lower.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو خ.islower():
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(ف("MixedCASE123abc"), صواب, "حالة 1")
تأكد_يساوي(ف("Hello World 42"), صواب, "حالة 2")
تأكد_يساوي(ف("ZZtop and the Beatles"), صواب, "حالة 3")
تأكد_يساوي(ف("aeiou AEIOU xyz"), صواب, "حالة 4")
تأكد_يساوي(ف(""), خطأ, "حالة 5")
