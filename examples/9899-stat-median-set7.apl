# مثال 9899 — الوسيط (بعد الترتيب) (مجموعة 7)
# median (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9899-stat-median-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([18, -9, 39, 19, 34]), 19, "حالة 1")
تأكد_يساوي(ف([34, 15, 9, 27, 3]), 15, "حالة 2")
تأكد_يساوي(ف([-4, 30, 3, 1, 14, 38, 5, 13, 23]), 13, "حالة 3")
تأكد_يساوي(ف([16, 43, 30, 60, 10, 9, 12, 45]), 23, "حالة 4")
