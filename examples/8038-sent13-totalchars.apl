# مثال 8038 — مجموع حروف الكلمات في الجملة رقم 14
# totalchars for sentence 14
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8038-sent13-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("nile river nile delta river"), 23, "حالة 1")
تأكد_يساوي(ف("sun sand sea sun sand sun"), 20, "حالة 2")
تأكد_يساوي(ف("the cat and the dog and the bird"), 25, "حالة 3")
