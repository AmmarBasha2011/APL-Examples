# مثال 9425 — عكس الأرقام (مجموعة اختبار 16)
# revnum (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9425-num-revnum-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(8795), 5978, "حالة 1")
تأكد_يساوي(ف(93631), 13639, "حالة 2")
تأكد_يساوي(ف(42676), 67624, "حالة 3")
تأكد_يساوي(ف(55095), 59055, "حالة 4")
تأكد_يساوي(ف(481), 184, "حالة 5")
