# مثال 9426 — عكس الأرقام (مجموعة اختبار 17)
# revnum (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9426-num-revnum-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(67801), 10876, "حالة 1")
تأكد_يساوي(ف(95492), 29459, "حالة 2")
تأكد_يساوي(ف(46576), 67564, "حالة 3")
تأكد_يساوي(ف(54375), 57345, "حالة 4")
تأكد_يساوي(ف(39214), 41293, "حالة 5")
