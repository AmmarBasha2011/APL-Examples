# مثال 6833 — عدد حلول 5س + 4ص = 36
# Count solutions of 5x+4y=36
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6833-pairs-5x-4y-36.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 5 * س + 4 * ص == 36:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 2, "حالة 3")
تأكد_يساوي(ف(36), 2, "حالة 4")
