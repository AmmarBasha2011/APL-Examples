# مثال 9140 — ضغط التكرار (مجموعة اختبار 11)
# rle (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9140-str-rle-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("listen"), "l1i1s1t1e1n1", "حالة 1")
تأكد_يساوي(ف("civic"), "c1i1v1i1c1", "حالة 2")
تأكد_يساوي(ف("mars"), "m1a1r1s1", "حالة 3")
تأكد_يساوي(ف("comet"), "c1o1m1e1t1", "حالة 4")
تأكد_يساوي(ف("pluto"), "p1l1u1t1o1", "حالة 5")
