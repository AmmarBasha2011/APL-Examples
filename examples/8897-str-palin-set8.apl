# مثال 8897 — هل الكلمة متناظرة (مجموعة اختبار 8)
# palin (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8897-str-palin-set8.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("stats"), صواب, "حالة 1")
تأكد_يساوي(ف("orbit"), خطأ, "حالة 2")
تأكد_يساوي(ف("saturn"), خطأ, "حالة 3")
تأكد_يساوي(ف("enlist"), خطأ, "حالة 4")
تأكد_يساوي(ف("comet"), خطأ, "حالة 5")
