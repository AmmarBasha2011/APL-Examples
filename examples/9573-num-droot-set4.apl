# مثال 9573 — الجذر الرقمي (مجموعة اختبار 4)
# droot (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9573-num-droot-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(53547), 6, "حالة 1")
تأكد_يساوي(ف(68160), 3, "حالة 2")
تأكد_يساوي(ف(71037), 9, "حالة 3")
تأكد_يساوي(ف(91961), 8, "حالة 4")
تأكد_يساوي(ف(15290), 8, "حالة 5")
