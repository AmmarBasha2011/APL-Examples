# مثال 6594 — متتالية a(n) = 7·a(n-1) + 5·a(n-2) تبدأ بـ 1,2
# Linear recurrence p=7 q=5 start 1,2
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6594-recur-p7-q5-s12.apl

# كل حد يعتمد على الحدين السابقين
# نحدّث زوجاً من المتغيرات في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = 1
  ص = 2
  لكل ي في range(ن):
    ت = 7 * ص + 5 * س
    س = ص
    ص = ت
  ارجع س

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(2), 19, "حالة 3")
تأكد_يساوي(ف(5), 8387, "حالة 4")
تأكد_يساوي(ف(8), 3759751, "حالة 5")
تأكد_يساوي(ف(12), 12899020681, "حالة 6")
