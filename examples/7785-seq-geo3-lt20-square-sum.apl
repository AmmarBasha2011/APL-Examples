# مثال 7785 — المجموع: من قوى 3 نأخذ الأصغر من 20 ثم (مربع)
# sum over geo3 sequence, keep lt20, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7785-seq-geo3-lt20-square-sum.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ < 20:
      ر = ر + [خ * خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 91, "حالة 3")
تأكد_يساوي(ف(10), 91, "حالة 4")
تأكد_يساوي(ف(15), 91, "حالة 5")
