# مثال 9437 — عكس الأرقام (مجموعة اختبار 28)
# revnum (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9437-num-revnum-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(24122), 22142, "حالة 1")
تأكد_يساوي(ف(48897), 79884, "حالة 2")
تأكد_يساوي(ف(91667), 76619, "حالة 3")
تأكد_يساوي(ف(8202), 2028, "حالة 4")
تأكد_يساوي(ف(20682), 28602, "حالة 5")
