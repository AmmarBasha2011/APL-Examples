# مثال 5029 — فيزباز بالعددين 5 و 9
# FizzBuzz variant with 5 and 9
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5029-fizz-5-9.apl

# A للقابل على الأول، B للثاني، AB للاثنين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    لو ي % 5 == 0 و ي % 9 == 0:
      ر = ر + ["AB"]
    والا_لو ي % 5 == 0:
      ر = ر + ["A"]
    والا_لو ي % 9 == 0:
      ر = ر + ["B"]
    والا:
      ر = ر + [str(ي)]
  ارجع ر

تأكد_يساوي(ف(1), ["1"], "حالة 1")
تأكد_يساوي(ف(10), ["1", "2", "3", "4", "A", "6", "7", "8", "B", "A"], "حالة 2")
تأكد_يساوي(ف(30), ["1", "2", "3", "4", "A", "6", "7", "8", "B", "A", "11", "12", "13", "14", "A", "16", "17", "B", "19", "A", "21", "22", "23", "24", "A", "26", "B", "28", "29", "A"], "حالة 3")
تأكد_يساوي(ف(0), [], "حالة 4")
