# مثال 4751 — خطوات متتالية كولاتز (7ن+1) بحد أقصى
# Collatz-style steps with 7n+1 (capped at 60)
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4751-collatz-7n-plus-1.apl

# لو العدد زوجي نقسمه على 2
# وغير كده نضربه ونضيف ثابت، وبحد أقصى 60 خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1 و ع < 60:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = ن * 7 + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(6), 60, "حالة 2")
تأكد_يساوي(ف(7), 60, "حالة 3")
تأكد_يساوي(ف(27), 60, "حالة 4")
تأكد_يساوي(ف(11), 60, "حالة 5")
