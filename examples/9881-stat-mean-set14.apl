# مثال 9881 — المتوسط الصحيح (مجموعة 14)
# mean (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9881-stat-mean-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([-7, 16, 49, 31, 26, 59, 38, 47]), 32, "حالة 1")
تأكد_يساوي(ف([29, -11, 29, 53, 35, -15, 45]), 23, "حالة 2")
تأكد_يساوي(ف([38, 7, 43]), 29, "حالة 3")
تأكد_يساوي(ف([32, -13, 6, 4]), 7, "حالة 4")
