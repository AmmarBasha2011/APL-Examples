# مثال 5341 — مقارنة العدد مع 20
# Compare number with 20
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5341-triple-compare-20.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 20:
    ارجع "اصغر"
  والا_لو ن > 20:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(19), "اصغر", "حالة 1")
تأكد_يساوي(ف(20), "يساوي", "حالة 2")
تأكد_يساوي(ف(21), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
