# مثال 6226 — طول الناتج بعد أخذ الحروف فقط وتحويلها إلى (كما هو)
# len of same applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6226-txt-alpha-same-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + خ
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 10, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 8, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 3, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 16, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 9, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 11, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 19, "حالة 8")
