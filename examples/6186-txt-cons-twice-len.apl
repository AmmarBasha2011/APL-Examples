# مثال 6186 — طول الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (حرف مكرر)
# len of twice applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6186-txt-cons-twice-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ + خ
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 14, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 10, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 4, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 22, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 18, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 12, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 24, "حالة 8")
