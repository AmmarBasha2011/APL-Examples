# مثال 8911 — هل الكلمة متناظرة (مجموعة اختبار 22)
# palin (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8911-str-palin-set22.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("moon"), خطأ, "حالة 1")
تأكد_يساوي(ف("data"), خطأ, "حالة 2")
تأكد_يساوي(ف("sun"), خطأ, "حالة 3")
تأكد_يساوي(ف("river"), خطأ, "حالة 4")
تأكد_يساوي(ف("kayak"), صواب, "حالة 5")
