# مثال 6942 — آخر عنصر: من متتالية حسابية بخطوة 3 نأخذ الفردي ثم (زيادة واحد)
# last over arith3 sequence, keep odd, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/6942-seq-arith3-odd-inc-last.apl

# نولّد أول ن حد من: متتالية حسابية بخطوة 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 1 + ي * 3
    لو خ % 2 == 1:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 14, "حالة 3")
تأكد_يساوي(ف(10), 26, "حالة 4")
تأكد_يساوي(ف(15), 44, "حالة 5")
