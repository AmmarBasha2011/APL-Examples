# مثال 4799 — الصفوف الأطول من 1
# Rows longer than 1
# Demonstrates: مصفوفات وقوائم متداخلة
#
# Run:  python apl.py examples/4799-matrix-row-length-1.apl

# نتحقق من طول كل صف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ع = 0
  لكل ص في م:
    لو len(ص) > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([[1, 2], [3, 4]]), 2, "حالة 1")
تأكد_يساوي(ف([[5, 0, 2], [1, 9, 3], [4, 4, 4]]), 3, "حالة 2")
تأكد_يساوي(ف([[2, -1, 7], [0, 3, -5]]), 2, "حالة 3")
تأكد_يساوي(ف([[1], [2], [3]]), 0, "حالة 4")
تأكد_يساوي(ف([[6, 5, 4, 3], [2, 1, 0, -1]]), 2, "حالة 5")
