# مثال 8012 — تكرار كل كلمة في الجملة رقم 12
# freq for sentence 12
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8012-sent11-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("up down up down up up down"), {"up": 4, "down": 3}, "حالة 1")
تأكد_يساوي(ف("learn code learn more code more"), {"learn": 2, "code": 2, "more": 2}, "حالة 2")
تأكد_يساوي(ف("left right left left right"), {"left": 3, "right": 2}, "حالة 3")
