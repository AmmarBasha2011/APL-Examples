# مثال 8892 — هل الكلمة متناظرة (مجموعة اختبار 3)
# palin (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8892-str-palin-set3.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("noon"), صواب, "حالة 1")
تأكد_يساوي(ف("venus"), خطأ, "حالة 2")
تأكد_يساوي(ف("civic"), صواب, "حالة 3")
تأكد_يساوي(ف("mars"), خطأ, "حالة 4")
تأكد_يساوي(ف("river"), خطأ, "حالة 5")
