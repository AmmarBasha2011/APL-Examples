# مثال 4587 — أصغر نتيجة مربعها للأعداد الباقي قسمتها على 4 يساوي 1
# Smallest (or 0) of square over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4587-pipeline-mod4one-square-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 1, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 81, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 25, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 81, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
