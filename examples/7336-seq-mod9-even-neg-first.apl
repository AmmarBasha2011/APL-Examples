# مثال 7336 — أول عنصر: من ي * 4 باقي 9 نأخذ الزوجي ثم (سالب)
# first over mod9 sequence, keep even, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7336-seq-mod9-even-neg-first.apl

# نولّد أول ن حد من: ي * 4 باقي 9
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي * 4) % 9
    لو خ % 2 == 0:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 0, "حالة 3")
تأكد_يساوي(ف(10), 0, "حالة 4")
تأكد_يساوي(ف(15), 0, "حالة 5")
