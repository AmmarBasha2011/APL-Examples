# مثال 9605 — الجذر الرقمي (مجموعة اختبار 36)
# droot (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9605-num-droot-set36.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(39089), 2, "حالة 1")
تأكد_يساوي(ف(94754), 2, "حالة 2")
تأكد_يساوي(ف(99154), 1, "حالة 3")
تأكد_يساوي(ف(63117), 9, "حالة 4")
تأكد_يساوي(ف(97860), 3, "حالة 5")
