# مثال 9643 — الأصفار في نهاية العاملي (مجموعة اختبار 34)
# tzeros (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9643-num-tzeros-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(423), 103, "حالة 1")
تأكد_يساوي(ف(442), 108, "حالة 2")
تأكد_يساوي(ف(98), 22, "حالة 3")
تأكد_يساوي(ف(264), 64, "حالة 4")
تأكد_يساوي(ف(249), 59, "حالة 5")
