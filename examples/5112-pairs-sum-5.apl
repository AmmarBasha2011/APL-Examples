# مثال 5112 — عدد الأزواج التي مجموعها 5
# Count pairs summing to 5
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5112-pairs-sum-5.apl

# نجرب كل زوج مرة واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل ي في range(len(ق)):
    لكل ك في range(ي + 1, len(ق)):
      لو ق[ي] + ق[ك] == 5:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([0, 1, 2, 3, 4, 5]), 3, "حالة 1")
تأكد_يساوي(ف([1, 2, 3]), 1, "حالة 2")
تأكد_يساوي(ف([5, 0, 5]), 2, "حالة 3")
تأكد_يساوي(ف([]), 0, "حالة 4")
