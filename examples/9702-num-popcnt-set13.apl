# مثال 9702 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 13)
# popcnt (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9702-num-popcnt-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(439), 7, "حالة 1")
تأكد_يساوي(ف(1676), 5, "حالة 2")
تأكد_يساوي(ف(4097), 2, "حالة 3")
تأكد_يساوي(ف(1658), 7, "حالة 4")
تأكد_يساوي(ف(3383), 8, "حالة 5")
