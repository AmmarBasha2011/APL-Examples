# مثال 9998 — عدد العناصر فوق المتوسط (مجموعة 6)
# above_mean (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9998-stat-above_mean-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-13, 35, -11]), 1, "حالة 1")
تأكد_يساوي(ف([9, 2, 34, 20, 54, 41]), 3, "حالة 2")
تأكد_يساوي(ف([-13, 5, -12, 33, -4, 57, 32, -14, 35]), 4, "حالة 3")
تأكد_يساوي(ف([28, 60, 11, -7, 41, 42, 57]), 4, "حالة 4")
