# مثال 8028 — مجموع حروف الكلمات في الجملة رقم 13
# totalchars for sentence 13
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8028-sent12-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("cairo is big and cairo is old"), 23, "حالة 1")
تأكد_يساوي(ف("stars and moon and stars again"), 25, "حالة 2")
تأكد_يساوي(ف("yes no yes yes no maybe"), 18, "حالة 3")
