# مثال 4802 — تجميع الكلمات حسب الطول (عدد الكلمات)
# Group words by length: count
# Demonstrates: قواميس وتجميع
#
# Run:  python apl.py examples/4802-group-by-length-count.apl

# نمر على الكلمات
# ونحدّث القاموس حسب المفتاح

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    ك = len(خ)
    لو ك في د:
      د[ك] = د[ك] + 1
    والا:
      د[ك] = 1
  ارجع د

تأكد_يساوي(ف(["apple", "bob", "cat", "apricot", "bear", "dog", "axe"]), {5: 1, 3: 4, 7: 1, 4: 1}, "حالة 1")
تأكد_يساوي(ف(["sun", "moon", "star", "sky", "mars"]), {3: 2, 4: 3}, "حالة 2")
تأكد_يساوي(ف(["one", "two", "three", "four", "five", "six"]), {3: 3, 5: 1, 4: 2}, "حالة 3")
تأكد_يساوي(ف(["kiwi", "lime", "lemon", "kale", "leek"]), {4: 4, 5: 1}, "حالة 4")
