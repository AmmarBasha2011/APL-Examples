# مثال 5226 — الحد ن في متتالية هندسية أساسها 9
# Nth term of geometric sequence, ratio 9
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5226-geo-seq-9.apl

# كل حد = السابق × الأساس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ر = أ
  لكل ي في range(ن - 1):
    ر = ر * 9
  ارجع ر

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 5), 6561, "حالة 2")
تأكد_يساوي(ف(3, 4), 2187, "حالة 3")
تأكد_يساوي(ف(2, 6), 118098, "حالة 4")
