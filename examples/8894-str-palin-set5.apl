# مثال 8894 — هل الكلمة متناظرة (مجموعة اختبار 5)
# palin (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8894-str-palin-set5.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("pluto"), خطأ, "حالة 1")
تأكد_يساوي(ف("code"), خطأ, "حالة 2")
تأكد_يساوي(ف("tenet"), صواب, "حالة 3")
تأكد_يساوي(ف("listen"), خطأ, "حالة 4")
تأكد_يساوي(ف("comet"), خطأ, "حالة 5")
