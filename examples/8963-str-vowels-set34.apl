# مثال 8963 — عدد حروف العلة (مجموعة اختبار 34)
# vowels (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8963-str-vowels-set34.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح في "aeiou":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("rocket"), 2, "حالة 1")
تأكد_يساوي(ف("code"), 2, "حالة 2")
تأكد_يساوي(ف("bob"), 1, "حالة 3")
تأكد_يساوي(ف("star"), 1, "حالة 4")
تأكد_يساوي(ف("banana"), 3, "حالة 5")
