# مثال 9552 — خطوات كولاتز (مجموعة اختبار 23)
# collatz (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9552-num-collatz-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(123), 46, "حالة 1")
تأكد_يساوي(ف(121), 95, "حالة 2")
تأكد_يساوي(ف(30), 18, "حالة 3")
تأكد_يساوي(ف(60), 19, "حالة 4")
تأكد_يساوي(ف(129), 121, "حالة 5")
