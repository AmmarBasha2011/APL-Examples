# مثال 9890 — المتوسط الصحيح (مجموعة 23)
# mean (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9890-stat-mean-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([48, 17, 17, -12, 28, 35, 40]), 24, "حالة 1")
تأكد_يساوي(ف([-6, 51, 47, 46, -7]), 26, "حالة 2")
تأكد_يساوي(ف([-17, 14, 46, 60]), 25, "حالة 3")
تأكد_يساوي(ف([-12, 14, 14, 48, 25]), 17, "حالة 4")
