# مثال 5013 — قوى العدد 10 حتى 6
# Powers of 10 up to 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/5013-power-table-10.apl

# نضرب في العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  ق = 1
  لكل ي في range(ن + 1):
    ر = ر + [ق]
    ق = ق * 10
  ارجع ر

تأكد_يساوي(ف(0), [1], "حالة 1")
تأكد_يساوي(ف(3), [1, 10, 100, 1000], "حالة 2")
تأكد_يساوي(ف(6), [1, 10, 100, 1000, 10000, 100000, 1000000], "حالة 3")
