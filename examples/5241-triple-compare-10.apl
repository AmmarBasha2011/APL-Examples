# مثال 5241 — مقارنة العدد مع 10
# Compare number with 10
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5241-triple-compare-10.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 10:
    ارجع "اصغر"
  والا_لو ن > 10:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(9), "اصغر", "حالة 1")
تأكد_يساوي(ف(10), "يساوي", "حالة 2")
تأكد_يساوي(ف(11), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
