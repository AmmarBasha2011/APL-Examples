# مثال 5229 — قابل للقسمة على 9 وزوجي؟
# Divisible by 9 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5229-is-multiple-and-even-9.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 9 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(9), خطأ, "حالة 2")
تأكد_يساوي(ف(18), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(36), صواب, "حالة 5")
