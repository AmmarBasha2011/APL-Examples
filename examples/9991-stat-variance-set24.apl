# مثال 9991 — التباين الصحيح (مجموعة 24)
# variance (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9991-stat-variance-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([32, 3, 24, 41]), 197, "حالة 1")
تأكد_يساوي(ف([33, 54, 39, -2, 25, 10, 19, -20]), 487, "حالة 2")
تأكد_يساوي(ف([4, 37, 36, 51, 53, 39, -16, 37]), 497, "حالة 3")
تأكد_يساوي(ف([51, 21, -19, 2, 0, 17]), 472, "حالة 4")
