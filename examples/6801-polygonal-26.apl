# مثال 6801 — العدد المضلّع ذو 26 أضلاع
# 26-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6801-polygonal-26.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((26 - 2) * ن * ن - (26 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 26, "حالة 2")
تأكد_يساوي(ف(5), 245, "حالة 3")
تأكد_يساوي(ف(10), 1090, "حالة 4")
