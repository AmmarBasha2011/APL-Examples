# مثال 9757 — الجذر التربيعي الصحيح (مجموعة اختبار 28)
# sqrtint (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9757-num-sqrtint-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(1963), 44, "حالة 1")
تأكد_يساوي(ف(1696), 41, "حالة 2")
تأكد_يساوي(ف(3205), 56, "حالة 3")
تأكد_يساوي(ف(2549), 50, "حالة 4")
تأكد_يساوي(ف(1544), 39, "حالة 5")
