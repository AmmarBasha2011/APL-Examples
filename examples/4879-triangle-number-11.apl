# مثال 4879 — مجموع الأعداد من 1 إلى ضعف 11 وزيادة
# Sum 1..n for scaled n (k=11)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4879-triangle-number-11.apl

# مجموع الأعداد المتتالية = ن(ن+1)/2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ن = ن * 11
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 66, "حالة 1")
تأكد_يساوي(ف(2), 253, "حالة 2")
تأكد_يساوي(ف(3), 561, "حالة 3")
تأكد_يساوي(ف(10), 6105, "حالة 4")
