# مثال 6198 — هل الناتج فارغ بعد أخذ الأرقام فقط وتحويلها إلى (حرف مكرر)
# empty of twice applied to digit chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6198-txt-digit-twice-empty.apl

# نمر على النص حرفاً حرفاً
# نأخذ الأرقام فقط فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: هل الناتج فارغ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "0" و خ <= "9":
      ر = ر + خ + خ
  ارجع len(ر) == 0

تأكد_يساوي(ف("hello world 42"), خطأ, "حالة 1")
تأكد_يساوي(ف("apl is fun"), صواب, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), خطأ, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), صواب, "حالة 4")
تأكد_يساوي(ف(""), صواب, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), صواب, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), خطأ, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), صواب, "حالة 8")
