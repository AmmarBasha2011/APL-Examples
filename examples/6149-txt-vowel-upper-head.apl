# مثال 6149 — أول 3 حروف من الناتج بعد أخذ حروف العلة وتحويلها إلى (حرف كبير)
# head of upper applied to vowel chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6149-txt-vowel-upper-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف العلة فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "aeiou":
      ر = ر + خ.upper()
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "EOO", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "AIU", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "A", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "EUI", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "AAI", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "OAI", "حالة 8")
