# مثال 9711 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 22)
# popcnt (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9711-num-popcnt-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(3362), 5, "حالة 1")
تأكد_يساوي(ف(2909), 8, "حالة 2")
تأكد_يساوي(ف(427), 6, "حالة 3")
تأكد_يساوي(ف(4015), 10, "حالة 4")
تأكد_يساوي(ف(1532), 8, "حالة 5")
