# مثال 8078 — مجموع حروف الكلمات في الجملة رقم 18
# totalchars for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8078-sent17-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("bread milk bread eggs milk bread"), 27, "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), 25, "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), 19, "حالة 3")
