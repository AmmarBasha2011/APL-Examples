# مثال 9229 — الحرف الأوسط (مجموعة اختبار 20)
# midchar (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9229-str-midchar-set20.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("python"), "h", "حالة 1")
تأكد_يساوي(ف("apple"), "p", "حالة 2")
تأكد_يساوي(ف("listen"), "t", "حالة 3")
تأكد_يساوي(ف("earth"), "r", "حالة 4")
تأكد_يساوي(ف("banana"), "a", "حالة 5")
