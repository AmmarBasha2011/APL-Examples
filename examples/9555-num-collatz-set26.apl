# مثال 9555 — خطوات كولاتز (مجموعة اختبار 26)
# collatz (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9555-num-collatz-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(64), 6, "حالة 1")
تأكد_يساوي(ف(134), 28, "حالة 2")
تأكد_يساوي(ف(136), 15, "حالة 3")
تأكد_يساوي(ف(196), 26, "حالة 4")
تأكد_يساوي(ف(149), 23, "حالة 5")
