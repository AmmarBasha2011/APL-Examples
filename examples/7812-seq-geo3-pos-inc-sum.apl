# مثال 7812 — المجموع: من قوى 3 نأخذ الموجب ثم (زيادة واحد)
# sum over geo3 sequence, keep pos, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7812-seq-geo3-pos-inc-sum.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ > 0:
      ر = ر + [خ + 1]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 126, "حالة 3")
تأكد_يساوي(ف(10), 29534, "حالة 4")
تأكد_يساوي(ف(15), 7174468, "حالة 5")
