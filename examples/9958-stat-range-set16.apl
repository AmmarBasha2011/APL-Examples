# مثال 9958 — المدى (مجموعة 16)
# range (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9958-stat-range-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([24, 3, -4]), 28, "حالة 1")
تأكد_يساوي(ف([41, -7, 28, 31, -13, 20, -14]), 55, "حالة 2")
تأكد_يساوي(ف([23, 26, -11, 10, 4, 20, 46]), 57, "حالة 3")
تأكد_يساوي(ف([58, -8, 42]), 66, "حالة 4")
