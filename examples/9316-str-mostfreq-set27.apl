# مثال 9316 — الحرف الأكثر تكراراً (الأول عند التساوي) (مجموعة اختبار 27)
# mostfreq (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9316-str-mostfreq-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ح في ن:
    د[ح] = د.get(ح, 0) + 1
  ب = ن[0]
  لكل ح في ن:
    لو د[ح] > د[ب]:
      ب = ح
  ارجع ب

تأكد_يساوي(ف("radar"), "r", "حالة 1")
تأكد_يساوي(ف("code"), "c", "حالة 2")
تأكد_يساوي(ف("loop"), "o", "حالة 3")
تأكد_يساوي(ف("refer"), "r", "حالة 4")
تأكد_يساوي(ف("rotor"), "r", "حالة 5")
