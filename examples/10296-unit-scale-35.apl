# مثال 10296 — تحويل وحدة إلى 35 وحدات صغرى والعكس
# Convert units with factor 35
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10296-unit-scale-35.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 35, ن // 35, ن % 35]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [35, 0, 1], "حالة 2")
تأكد_يساوي(ف(35), [1225, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [35000, 28, 20], "حالة 4")
