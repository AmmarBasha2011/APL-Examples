# مثال 4695 — قائمة الأعداد المربع كامل حتى حد معين
# Numbers up to a limit: list of the perfect square ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4695-numbers-list-square.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو int(ر ** 0.5) * int(ر ** 0.5) == ر:
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(12), [1, 4, 9], "حالة 1")
تأكد_يساوي(ف(50), [1, 4, 9, 16, 25, 36, 49], "حالة 2")
تأكد_يساوي(ف(126), [1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121], "حالة 3")
تأكد_يساوي(ف(1), [1], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
