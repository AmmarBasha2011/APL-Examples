# مثال 9934 — المنوال (الأصغر عند التساوي) (مجموعة 17)
# mode (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9934-stat-mode-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([39, 47, 54, 39, 12, 28, 7, -7, 23]), 39, "حالة 1")
تأكد_يساوي(ف([53, -9, -18, 5, 22, 9, 30, 17, -14]), -18, "حالة 2")
تأكد_يساوي(ف([-12, 21, 37, 59, 19, 27, -3, 42, -6]), -12, "حالة 3")
تأكد_يساوي(ف([4, 27, 48, 0, 27, 26, 22, 36, 3]), 27, "حالة 4")
