# مثال 9164 — ضغط التكرار (مجموعة اختبار 35)
# rle (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9164-str-rle-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("earth"), "e1a1r1t1h1", "حالة 1")
تأكد_يساوي(ف("python"), "p1y1t1h1o1n1", "حالة 2")
تأكد_يساوي(ف("deed"), "d1e2d1", "حالة 3")
تأكد_يساوي(ف("radar"), "r1a1d1a1r1", "حالة 4")
تأكد_يساوي(ف("bob"), "b1o1b1", "حالة 5")
