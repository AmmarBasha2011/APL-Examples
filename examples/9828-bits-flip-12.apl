# مثال 9828 — قلب الخانة رقم 12
# Flip bit 12
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9828-bits-flip-12.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 12)

تأكد_يساوي(ف(0), 4096, "حالة 1")
تأكد_يساوي(ف(255), 4351, "حالة 2")
تأكد_يساوي(ف(1000), 5096, "حالة 3")
تأكد_يساوي(ف(12345), 8249, "حالة 4")
