# مثال 9982 — التباين الصحيح (مجموعة 15)
# variance (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9982-stat-variance-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([36, 58, 37, 34, 32]), 89, "حالة 1")
تأكد_يساوي(ف([29, -2, 53, 11, 21, 31]), 295, "حالة 2")
تأكد_يساوي(ف([10, 22, 10]), 32, "حالة 3")
تأكد_يساوي(ف([36, 28, 51, 5]), 276, "حالة 4")
