# مثال 9942 — المنوال (الأصغر عند التساوي) (مجموعة 25)
# mode (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9942-stat-mode-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([3, 21, 19]), 3, "حالة 1")
تأكد_يساوي(ف([29, -15, 22, 36, 22, 32, 51, 54, -19]), 22, "حالة 2")
تأكد_يساوي(ف([40, -5, -14, 60, -17, 55, -15, 6]), -17, "حالة 3")
تأكد_يساوي(ف([21, 44, 25, -10, 30, 30, 58, 24]), 30, "حالة 4")
