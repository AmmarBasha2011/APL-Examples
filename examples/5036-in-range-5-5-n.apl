# مثال 5036 — هل القيمة داخل المدى [-5, 5]؟
# Is value in range [-5,5]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5036-in-range-5-5-n.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= -5 و ن <= 5

تأكد_يساوي(ف(-5), صواب, "حالة 1")
تأكد_يساوي(ف(5), صواب, "حالة 2")
تأكد_يساوي(ف(-6), خطأ, "حالة 3")
تأكد_يساوي(ف(6), خطأ, "حالة 4")
تأكد_يساوي(ف(0), صواب, "حالة 5")
