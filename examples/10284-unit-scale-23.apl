# مثال 10284 — تحويل وحدة إلى 23 وحدات صغرى والعكس
# Convert units with factor 23
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10284-unit-scale-23.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 23, ن // 23, ن % 23]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [23, 0, 1], "حالة 2")
تأكد_يساوي(ف(23), [529, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [23000, 43, 11], "حالة 4")
