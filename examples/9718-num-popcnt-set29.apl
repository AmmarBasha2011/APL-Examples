# مثال 9718 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 29)
# popcnt (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9718-num-popcnt-set29.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(1017), 8, "حالة 1")
تأكد_يساوي(ف(2357), 6, "حالة 2")
تأكد_يساوي(ف(4846), 8, "حالة 3")
تأكد_يساوي(ف(4297), 5, "حالة 4")
تأكد_يساوي(ف(2288), 5, "حالة 5")
