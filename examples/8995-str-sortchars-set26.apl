# مثال 8995 — حروف الكلمة مرتبة (مجموعة اختبار 26)
# sortchars (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8995-str-sortchars-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("listen"), "eilnst", "حالة 1")
تأكد_يساوي(ف("level"), "eellv", "حالة 2")
تأكد_يساوي(ف("bob"), "bbo", "حالة 3")
تأكد_يساوي(ف("google"), "eggloo", "حالة 4")
تأكد_يساوي(ف("loop"), "loop", "حالة 5")
