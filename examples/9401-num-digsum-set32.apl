# مثال 9401 — مجموع الأرقام (مجموعة اختبار 32)
# digsum (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9401-num-digsum-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(67713), 24, "حالة 1")
تأكد_يساوي(ف(71745), 24, "حالة 2")
تأكد_يساوي(ف(62803), 19, "حالة 3")
تأكد_يساوي(ف(19672), 25, "حالة 4")
تأكد_يساوي(ف(71975), 29, "حالة 5")
