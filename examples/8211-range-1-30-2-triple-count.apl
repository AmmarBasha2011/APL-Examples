# مثال 8211 — العدد من المدى 1 إلى 30 بخطوة 2 بعد (ثلاثة أضعاف)
# count over range(1,30,2) mapped by triple
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8211-range-1-30-2-triple-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [خ * 3]
    خ = خ + (2)
  ارجع len(ر)

تأكد_يساوي(ف(), 15, "المدى كله")
