# مثال 9417 — عكس الأرقام (مجموعة اختبار 8)
# revnum (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9417-num-revnum-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(25498), 89452, "حالة 1")
تأكد_يساوي(ف(56225), 52265, "حالة 2")
تأكد_يساوي(ف(48766), 66784, "حالة 3")
تأكد_يساوي(ف(6677), 7766, "حالة 4")
تأكد_يساوي(ف(75280), 8257, "حالة 5")
