# مثال 6813 — عدد حلول 2س + 3ص = 38
# Count solutions of 2x+3y=38
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6813-pairs-2x-3y-38.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 2 * س + 3 * ص == 38:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 3, "حالة 3")
تأكد_يساوي(ف(38), 7, "حالة 4")
