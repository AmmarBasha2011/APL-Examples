# مثال 9737 — الجذر التربيعي الصحيح (مجموعة اختبار 8)
# sqrtint (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9737-num-sqrtint-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2919), 54, "حالة 1")
تأكد_يساوي(ف(4710), 68, "حالة 2")
تأكد_يساوي(ف(352), 18, "حالة 3")
تأكد_يساوي(ف(2886), 53, "حالة 4")
تأكد_يساوي(ف(3425), 58, "حالة 5")
