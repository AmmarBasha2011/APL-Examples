# مثال 6784 — العدد المضلّع ذو 9 أضلاع
# 9-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6784-polygonal-9.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((9 - 2) * ن * ن - (9 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 9, "حالة 2")
تأكد_يساوي(ف(5), 75, "حالة 3")
تأكد_يساوي(ف(10), 325, "حالة 4")
