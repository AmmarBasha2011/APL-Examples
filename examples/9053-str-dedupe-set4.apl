# مثال 9053 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 4)
# dedupe (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9053-str-dedupe-set4.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("comet"), "comet", "حالة 1")
تأكد_يساوي(ف("listen"), "listen", "حالة 2")
تأكد_يساوي(ف("silent"), "silent", "حالة 3")
تأكد_يساوي(ف("river"), "rive", "حالة 4")
تأكد_يساوي(ف("radar"), "rad", "حالة 5")
