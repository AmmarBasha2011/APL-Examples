# مثال 5278 — ضرب كل عنصر في 14
# Scale list by 14
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5278-scale-list-14.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 14]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [14, 28, 42], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -56, 140], "حالة 3")
