# مثال 5161 — مقارنة العدد مع 2
# Compare number with 2
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5161-triple-compare-2.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع "اصغر"
  والا_لو ن > 2:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(1), "اصغر", "حالة 1")
تأكد_يساوي(ف(2), "يساوي", "حالة 2")
تأكد_يساوي(ف(3), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
