# مثال 9606 — الجذر الرقمي (مجموعة اختبار 37)
# droot (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9606-num-droot-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(44083), 1, "حالة 1")
تأكد_يساوي(ف(44926), 7, "حالة 2")
تأكد_يساوي(ف(7055), 8, "حالة 3")
تأكد_يساوي(ف(905), 5, "حالة 4")
تأكد_يساوي(ف(48845), 2, "حالة 5")
