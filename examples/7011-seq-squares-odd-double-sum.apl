# مثال 7011 — المجموع: من المربعات نأخذ الفردي ثم (ضعف)
# sum over squares sequence, keep odd, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7011-seq-squares-odd-double-sum.apl

# نولّد أول ن حد من: المربعات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي
    لو خ % 2 == 1:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 20, "حالة 3")
تأكد_يساوي(ف(10), 330, "حالة 4")
تأكد_يساوي(ف(15), 910, "حالة 5")
