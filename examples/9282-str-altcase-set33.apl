# مثال 9282 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 33)
# altcase (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9282-str-altcase-set33.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("apple"), "ApPlE", "حالة 1")
تأكد_يساوي(ف("stats"), "StAtS", "حالة 2")
تأكد_يساوي(ف("sun"), "SuN", "حالة 3")
تأكد_يساوي(ف("google"), "GoOgLe", "حالة 4")
تأكد_يساوي(ف("pluto"), "PlUtO", "حالة 5")
