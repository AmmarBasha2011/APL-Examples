# مثال 9816 — إزاحة لليمين 10 خانات
# Shift right by 10
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9816-bits-shr-10.apl

# الإزاحة لليمين تقسم وتقتطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(4096), 4, "حالة 3")
تأكد_يساوي(ف(100000), 97, "حالة 4")
