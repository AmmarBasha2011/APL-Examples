# مثال 8905 — هل الكلمة متناظرة (مجموعة اختبار 16)
# palin (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8905-str-palin-set16.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("sun"), خطأ, "حالة 1")
تأكد_يساوي(ف("bob"), صواب, "حالة 2")
تأكد_يساوي(ف("star"), خطأ, "حالة 3")
تأكد_يساوي(ف("comet"), خطأ, "حالة 4")
تأكد_يساوي(ف("listen"), خطأ, "حالة 5")
