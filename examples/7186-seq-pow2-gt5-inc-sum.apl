# مثال 7186 — المجموع: من قوى 2 نأخذ الأكبر من 5 ثم (زيادة واحد)
# sum over pow2 sequence, keep gt5, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7186-seq-pow2-gt5-inc-sum.apl

# نولّد أول ن حد من: قوى 2
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 ** ي
    لو خ > 5:
      ر = ر + [خ + 1]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 26, "حالة 3")
تأكد_يساوي(ف(10), 1023, "حالة 4")
تأكد_يساوي(ف(15), 32772, "حالة 5")
