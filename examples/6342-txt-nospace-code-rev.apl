# مثال 6342 — الناتج معكوس بعد أخذ غير المسافات وتحويلها إلى (رقم الحرف)
# rev of code applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6342-txt-nospace-code-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + str(ord(خ))+","
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), ",05,25,001,801,411,111,911,111,801,801,101,401", "حالة 1")
تأكد_يساوي(ف("apl is fun"), ",011,711,201,511,501,801,211,79", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), ",15,99,05,89,94,79", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), ",021,111,201,011,911,111,411,89,701,99,501,711,311,101,401,611", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), ",021,021,021,121,121,121,221,221,221", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), ",101,99,011,101,501,99,511,45,05,84,05,79,611,79,001", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), ",99,501,89,79,411,79,011,501,301,011,501,901,901,79,411,301,111,411,211", "حالة 8")
