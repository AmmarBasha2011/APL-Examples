# مثال 10328 — تحويل 30 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 30 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10328-temp-c-30.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 30) * 9 // 5 + 32

تأكد_يساوي(ف(0), 86, "حالة 1")
تأكد_يساوي(ف(10), 104, "حالة 2")
تأكد_يساوي(ف(37), 152, "حالة 3")
تأكد_يساوي(ف(-5), 77, "حالة 4")
