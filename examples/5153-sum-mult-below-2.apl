# مثال 5153 — مجموع مضاعفات 2 تحت ن
# Sum of multiples of 2 below n
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5153-sum-mult-below-2.apl

# نمر على الأعداد ونجمع المضاعفات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في range(ن):
    لو ي % 2 == 0:
      م = م + ي
  ارجع م

تأكد_يساوي(ف(1), 0, "حالة 1")
تأكد_يساوي(ف(10), 20, "حالة 2")
تأكد_يساوي(ف(50), 600, "حالة 3")
تأكد_يساوي(ف(100), 2450, "حالة 4")
