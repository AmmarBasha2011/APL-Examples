# مثال 9693 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 4)
# popcnt (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9693-num-popcnt-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(2227), 6, "حالة 1")
تأكد_يساوي(ف(3421), 8, "حالة 2")
تأكد_يساوي(ف(3997), 9, "حالة 3")
تأكد_يساوي(ف(2110), 6, "حالة 4")
تأكد_يساوي(ف(670), 6, "حالة 5")
