# مثال 5198 — ضرب كل عنصر في 6
# Scale list by 6
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5198-scale-list-6.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 6]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [6, 12, 18], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -24, 60], "حالة 3")
