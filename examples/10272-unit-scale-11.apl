# مثال 10272 — تحويل وحدة إلى 11 وحدات صغرى والعكس
# Convert units with factor 11
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10272-unit-scale-11.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 11, ن // 11, ن % 11]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [11, 0, 1], "حالة 2")
تأكد_يساوي(ف(11), [121, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [11000, 90, 10], "حالة 4")
