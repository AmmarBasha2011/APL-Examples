# مثال 9763 — الجذر التربيعي الصحيح (مجموعة اختبار 34)
# sqrtint (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9763-num-sqrtint-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(3131), 55, "حالة 1")
تأكد_يساوي(ف(3936), 62, "حالة 2")
تأكد_يساوي(ف(3262), 57, "حالة 3")
تأكد_يساوي(ف(1878), 43, "حالة 4")
تأكد_يساوي(ف(1469), 38, "حالة 5")
