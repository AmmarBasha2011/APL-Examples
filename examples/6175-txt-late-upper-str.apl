# مثال 6175 — النص الناتج بعد أخذ حروف آخر الأبجدية وتحويلها إلى (حرف كبير)
# str of upper applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6175-txt-late-upper-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + خ.upper()
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "OWOR", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "PSUN", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "TQUROWNOX", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "ZZZYYYXXX", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "TSN", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "PRORNNR", "حالة 8")
