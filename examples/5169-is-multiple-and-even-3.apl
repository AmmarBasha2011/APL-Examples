# مثال 5169 — قابل للقسمة على 3 وزوجي؟
# Divisible by 3 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5169-is-multiple-and-even-3.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 3 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(3), خطأ, "حالة 2")
تأكد_يساوي(ف(6), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(12), صواب, "حالة 5")
