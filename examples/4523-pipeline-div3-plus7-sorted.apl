# مثال 4523 — ترتيب نتيجة زائد 7 للأعداد التقبل القسمة على 3
# Sorted list of plus 7 over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4523-pipeline-div3-plus7-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [خ + 7]
  ارجع sorted(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [], "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [28, 49], "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [7, 16, 19, 22], "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [10], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
