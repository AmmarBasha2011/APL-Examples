# مثال 8942 — عدد حروف العلة (مجموعة اختبار 13)
# vowels (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8942-str-vowels-set13.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح في "aeiou":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("rotor"), 2, "حالة 1")
تأكد_يساوي(ف("kayak"), 2, "حالة 2")
تأكد_يساوي(ف("comet"), 2, "حالة 3")
تأكد_يساوي(ف("pluto"), 2, "حالة 4")
تأكد_يساوي(ف("enlist"), 2, "حالة 5")
