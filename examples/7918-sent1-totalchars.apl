# مثال 7918 — مجموع حروف الكلمات في الجملة رقم 2
# totalchars for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7918-sent1-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("to be or not to be"), 13, "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), 19, "حالة 2")
تأكد_يساوي(ف("a b c a b a"), 6, "حالة 3")
