# مثال 10050 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 8)
# spread (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10050-stat-spread-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([25, 36, 4, 30, 48]), 21, "حالة 1")
تأكد_يساوي(ف([44, -5, 48, -20, 57, 59, 23, -17]), 28, "حالة 2")
تأكد_يساوي(ف([-6, -9, 25, 25, 15, 30, 26, -12, 3]), 12, "حالة 3")
تأكد_يساوي(ف([30, 34, -17, 52, 15, 13, 4, -12]), 18, "حالة 4")
