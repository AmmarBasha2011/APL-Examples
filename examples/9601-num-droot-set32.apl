# مثال 9601 — الجذر الرقمي (مجموعة اختبار 32)
# droot (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9601-num-droot-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(93695), 5, "حالة 1")
تأكد_يساوي(ف(57726), 9, "حالة 2")
تأكد_يساوي(ف(34734), 3, "حالة 3")
تأكد_يساوي(ف(72964), 1, "حالة 4")
تأكد_يساوي(ف(30996), 9, "حالة 5")
