# مثال 4844 — سعر بعد خصم 60%
# Price after 60 percent discount
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4844-discount-60.apl

# السعر × (100 - الخصم) ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س * (100 - 60) // 100

تأكد_يساوي(ف(100), 40, "حالة 1")
تأكد_يساوي(ف(250), 100, "حالة 2")
تأكد_يساوي(ف(999), 399, "حالة 3")
تأكد_يساوي(ف(40), 16, "حالة 4")
