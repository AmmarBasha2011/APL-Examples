# مثال 7979 — أول كلمة تتكرر في الجملة رقم 8
# firstdup for sentence 8
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7979-sent7-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("run run run fast fast slow"), "run", "حالة 1")
تأكد_يساوي(ف("red blue green red blue red"), "red", "حالة 2")
تأكد_يساوي(ف("learn code learn more code more"), "learn", "حالة 3")
