# مثال 9642 — الأصفار في نهاية العاملي (مجموعة اختبار 33)
# tzeros (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9642-num-tzeros-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(197), 47, "حالة 1")
تأكد_يساوي(ف(149), 35, "حالة 2")
تأكد_يساوي(ف(3), 0, "حالة 3")
تأكد_يساوي(ف(163), 39, "حالة 4")
تأكد_يساوي(ف(497), 121, "حالة 5")
