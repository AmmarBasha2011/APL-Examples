# مثال 6277 — الناتج معكوس بعد أخذ حروف أول الأبجدية وتحويلها إلى (حرف مع شرطة)
# rev of dash applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6277-txt-early-dash-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + خ + "-"
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "-d-l-l-l-e-h", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "-f-i-l-a", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "-c-b-a", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "-f-b-k-c-i-e-h", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "-e-c-e-i-c-a-a-d", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "-c-i-b-a-a-i-g-i-m-m-a-g", "حالة 8")
