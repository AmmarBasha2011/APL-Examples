# مثال 10236 — شريط بعرض 11 من الرمز =
# Bar of width 11 using =
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10236-bar-11-61.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "="
  ارجع ر + "|" + str(11)

تأكد_يساوي(ف(0), "|11", "حالة 1")
تأكد_يساوي(ف(3), "===|11", "حالة 2")
تأكد_يساوي(ف(11), "===========|11", "حالة 3")
