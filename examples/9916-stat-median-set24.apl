# مثال 9916 — الوسيط (بعد الترتيب) (مجموعة 24)
# median (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9916-stat-median-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([-6, 3, 45, 15, 59]), 15, "حالة 1")
تأكد_يساوي(ف([22, 34, 49, 49, 45, 60]), 47, "حالة 2")
تأكد_يساوي(ف([59, 32, 12, 11, 6]), 12, "حالة 3")
تأكد_يساوي(ف([-17, 27, 27, 5, 30, -3, 42]), 27, "حالة 4")
