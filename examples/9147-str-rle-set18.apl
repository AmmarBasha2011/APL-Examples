# مثال 9147 — ضغط التكرار (مجموعة اختبار 18)
# rle (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9147-str-rle-set18.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("mars"), "m1a1r1s1", "حالة 1")
تأكد_يساوي(ف("rotor"), "r1o1t1o1r1", "حالة 2")
تأكد_يساوي(ف("enlist"), "e1n1l1i1s1t1", "حالة 3")
تأكد_يساوي(ف("radar"), "r1a1d1a1r1", "حالة 4")
تأكد_يساوي(ف("refer"), "r1e1f1e1r1", "حالة 5")
