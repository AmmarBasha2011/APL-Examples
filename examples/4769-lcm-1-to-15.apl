# مثال 4769 — أصغر عدد يقبل القسمة على كل الأعداد من 1 إلى 15
# Smallest number divisible by 1..15
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4769-lcm-1-to-15.apl

# نحسب المضاعف المشترك الأصغر تدريجيًا

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ب):
  ن = 1
  لكل خ في range(1, ب + 1):
    أ = ن
    ح = خ
    طالما ح != 0:
      أ, ح = ح, أ % ح
    ن = ن * خ // أ
  ارجع ن

تأكد_يساوي(ف(15), 360360, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(13), 360360, "حالة 3")
