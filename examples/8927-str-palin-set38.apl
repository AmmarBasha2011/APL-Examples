# مثال 8927 — هل الكلمة متناظرة (مجموعة اختبار 38)
# palin (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8927-str-palin-set38.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("silent"), خطأ, "حالة 1")
تأكد_يساوي(ف("earth"), خطأ, "حالة 2")
تأكد_يساوي(ف("river"), خطأ, "حالة 3")
تأكد_يساوي(ف("venus"), خطأ, "حالة 4")
تأكد_يساوي(ف("code"), خطأ, "حالة 5")
