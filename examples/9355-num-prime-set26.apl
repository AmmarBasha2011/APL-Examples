# مثال 9355 — هل العدد أولي (مجموعة اختبار 26)
# prime (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9355-num-prime-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(159), خطأ, "حالة 1")
تأكد_يساوي(ف(19), صواب, "حالة 2")
تأكد_يساوي(ف(13), صواب, "حالة 3")
تأكد_يساوي(ف(103), صواب, "حالة 4")
تأكد_يساوي(ف(144), خطأ, "حالة 5")
