# مثال 9790 — إزاحة لليسار 5 خانات
# Shift left by 5
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9790-bits-shl-5.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 5

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 32, "حالة 2")
تأكد_يساوي(ف(5), 160, "حالة 3")
تأكد_يساوي(ف(100), 3200, "حالة 4")
