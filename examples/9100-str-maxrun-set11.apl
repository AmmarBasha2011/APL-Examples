# مثال 9100 — أطول تتابع لحرف واحد (مجموعة اختبار 11)
# maxrun (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9100-str-maxrun-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  ع = 0
  س = ""
  لكل ح في ن:
    لو ح == س:
      ع = ع + 1
    والا:
      ع = 1
      س = ح
    م = max(م, ع)
  ارجع م

تأكد_يساوي(ف("refer"), 1, "حالة 1")
تأكد_يساوي(ف("galaxy"), 1, "حالة 2")
تأكد_يساوي(ف("sun"), 1, "حالة 3")
تأكد_يساوي(ف("river"), 1, "حالة 4")
تأكد_يساوي(ف("enlist"), 1, "حالة 5")
