# مثال 8980 — حروف الكلمة مرتبة (مجموعة اختبار 11)
# sortchars (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8980-str-sortchars-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("data"), "aadt", "حالة 1")
تأكد_يساوي(ف("orbit"), "biort", "حالة 2")
تأكد_يساوي(ف("deed"), "ddee", "حالة 3")
تأكد_يساوي(ف("code"), "cdeo", "حالة 4")
تأكد_يساوي(ف("bob"), "bbo", "حالة 5")
