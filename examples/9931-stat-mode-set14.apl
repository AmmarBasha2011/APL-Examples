# مثال 9931 — المنوال (الأصغر عند التساوي) (مجموعة 14)
# mode (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9931-stat-mode-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([-7, 16, 49, 31, 26, 59, 38, 47]), -7, "حالة 1")
تأكد_يساوي(ف([29, -11, 29, 53, 35, -15, 45]), 29, "حالة 2")
تأكد_يساوي(ف([38, 7, 43]), 7, "حالة 3")
تأكد_يساوي(ف([32, -13, 6, 4]), -13, "حالة 4")
