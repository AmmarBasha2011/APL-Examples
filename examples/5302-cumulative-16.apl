# مثال 5302 — مجموع تراكمي مع زيادة 16
# Running total plus 16 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5302-cumulative-16.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 16
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [17, 35, 54], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [21, 42, 63, 84], "حالة 3")
