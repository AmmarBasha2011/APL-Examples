# مثال 4960 — شيفرة قيصر بإزاحة 9
# Caesar cipher shift 9
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4960-caesar-9.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 9) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "jkl", "حالة 1")
تأكد_يساوي(ف("hello world"), "qnuux fxaum", "حالة 2")
تأكد_يساوي(ف("xyz"), "ghi", "حالة 3")
تأكد_يساوي(ف("a b-c"), "j k-l", "حالة 4")
