# مثال 9246 — الحرف الأوسط (مجموعة اختبار 37)
# midchar (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9246-str-midchar-set37.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("noon"), "o", "حالة 1")
تأكد_يساوي(ف("saturn"), "u", "حالة 2")
تأكد_يساوي(ف("kayak"), "y", "حالة 3")
تأكد_يساوي(ف("planet"), "n", "حالة 4")
تأكد_يساوي(ف("rocket"), "k", "حالة 5")
