# مثال 9048 — هل لا يتكرر أي حرف (مجموعة اختبار 39)
# isogram (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9048-str-isogram-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("river"), خطأ, "حالة 1")
تأكد_يساوي(ف("bob"), خطأ, "حالة 2")
تأكد_يساوي(ف("enlist"), صواب, "حالة 3")
تأكد_يساوي(ف("silent"), صواب, "حالة 4")
تأكد_يساوي(ف("stats"), خطأ, "حالة 5")
