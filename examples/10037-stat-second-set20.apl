# مثال 10037 — ثاني أكبر قيمة مختلفة (مجموعة 20)
# second (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10037-stat-second-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([24, 45, 33, -19, 8]), 33, "حالة 1")
تأكد_يساوي(ف([41, 32, 21, -4, 32, 55, 49]), 49, "حالة 2")
تأكد_يساوي(ف([33, 34, -2, -11, 24, 41, 41, 51, 3]), 41, "حالة 3")
تأكد_يساوي(ف([29, -5, 6, 11, 20, 2, 60, 59]), 59, "حالة 4")
