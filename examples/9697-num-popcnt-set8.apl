# مثال 9697 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 8)
# popcnt (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9697-num-popcnt-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(1593), 6, "حالة 1")
تأكد_يساوي(ف(3514), 8, "حالة 2")
تأكد_يساوي(ف(3047), 9, "حالة 3")
تأكد_يساوي(ف(417), 4, "حالة 4")
تأكد_يساوي(ف(4705), 5, "حالة 5")
