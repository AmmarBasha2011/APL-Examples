# مثال 4625 — أصغر نتيجة باقي قسمتها على 10 للأعداد الغير الصفرية
# Smallest (or 0) of last digit mod 10 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4625-pipeline-notzero-mod10-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ % 10]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 4, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 0, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 0, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 2, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
