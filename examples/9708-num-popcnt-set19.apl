# مثال 9708 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 19)
# popcnt (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9708-num-popcnt-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(480), 4, "حالة 1")
تأكد_يساوي(ف(303), 6, "حالة 2")
تأكد_يساوي(ف(2587), 6, "حالة 3")
تأكد_يساوي(ف(1188), 4, "حالة 4")
تأكد_يساوي(ف(4319), 8, "حالة 5")
