# مثال 4967 — تحقق توازن الأقواس curly
# Balanced curly brackets
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4967-balanced-curly.apl

# عداد يزيد عند الفتح وينقص عند الإغلاق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = 0
  لكل ح في ن:
    لو ح == "{":
      د = د + 1
    والا_لو ح == "}":
      د = د - 1
      لو د < 0:
        ارجع خطأ
  ارجع د == 0

تأكد_يساوي(ف("{{}}"), صواب, "حالة 1")
تأكد_يساوي(ف("{}}"), خطأ, "حالة 2")
تأكد_يساوي(ف(""), صواب, "حالة 3")
تأكد_يساوي(ف("{{{}}"), خطأ, "حالة 4")
تأكد_يساوي(ف("}{"), خطأ, "حالة 5")
