# مثال 4468 — ترتيب نتيجة مكعبها للأعداد الزوجية
# Sorted list of cube over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4468-pipeline-even-cube-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ * خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [8, 512], "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), [0, 0, 64, 4096], "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [-64, 0, 1728], "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [64, 216, 8000], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
