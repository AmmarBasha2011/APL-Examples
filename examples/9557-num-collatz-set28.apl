# مثال 9557 — خطوات كولاتز (مجموعة اختبار 28)
# collatz (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9557-num-collatz-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(196), 26, "حالة 1")
تأكد_يساوي(ف(62), 107, "حالة 2")
تأكد_يساوي(ف(54), 112, "حالة 3")
تأكد_يساوي(ف(101), 25, "حالة 4")
تأكد_يساوي(ف(191), 44, "حالة 5")
