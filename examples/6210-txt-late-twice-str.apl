# مثال 6210 — النص الناتج بعد أخذ حروف آخر الأبجدية وتحويلها إلى (حرف مكرر)
# str of twice applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6210-txt-late-twice-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + خ + خ
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "oowwoorr", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "ppssuunn", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "ttqquurroowwnnooxx", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "zzzzzzyyyyyyxxxxxx", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "ttssnn", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "pprroorrnnnnrr", "حالة 8")
