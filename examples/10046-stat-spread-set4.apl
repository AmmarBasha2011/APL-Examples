# مثال 10046 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 4)
# spread (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10046-stat-spread-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([28, 5, 56, 2, 9, 11]), 28, "حالة 1")
تأكد_يساوي(ف([-9, 12, 29, 47]), 21, "حالة 2")
تأكد_يساوي(ف([48, -9, 59, 42, 5, 33, 58, 55]), 28, "حالة 3")
تأكد_يساوي(ف([27, 29, 7, -1]), 20, "حالة 4")
