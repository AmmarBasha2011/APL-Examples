# مثال 9337 — هل العدد أولي (مجموعة اختبار 8)
# prime (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9337-num-prime-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(95), خطأ, "حالة 1")
تأكد_يساوي(ف(81), خطأ, "حالة 2")
تأكد_يساوي(ف(173), صواب, "حالة 3")
تأكد_يساوي(ف(102), خطأ, "حالة 4")
تأكد_يساوي(ف(53), صواب, "حالة 5")
