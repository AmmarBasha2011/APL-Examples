# مثال 4671 — أول موضع (مسافة) في نص
# String: first position of space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4671-string-first-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  لكل خ في س:
    لو خ == " ":
      ارجع ر
    ر = ر + 1
  ارجع -1

تأكد_يساوي(ف("apple PIE 7 and 9"), 5, "حالة 1")
تأكد_يساوي(ف("Hello World 42"), 5, "حالة 2")
تأكد_يساوي(ف("  spaced   out  text "), 0, "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), -1, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
