# مثال 4616 — أكبر نتيجة نصفها بالقسمة الصحيحة للأعداد الغير الصفرية
# Largest (or 0) of integer half over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4616-pipeline-notzero-half-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ // 2]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 10, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 15, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 6, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 4, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
