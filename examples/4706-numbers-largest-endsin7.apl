# مثال 4706 — أكبر الأعداد الينتهي بالرقم 7 حتى حد معين
# Numbers up to a limit: largest of the ends in 7 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4706-numbers-largest-endsin7.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 10 == 7:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(18), 17, "حالة 1")
تأكد_يساوي(ف(51), 47, "حالة 2")
تأكد_يساوي(ف(96), 87, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
