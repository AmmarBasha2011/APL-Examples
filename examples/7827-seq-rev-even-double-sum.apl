# مثال 7827 — المجموع: من عكسية نأخذ الزوجي ثم (ضعف)
# sum over rev sequence, keep even, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7827-seq-rev-even-double-sum.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ % 2 == 0:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 40, "حالة 2")
تأكد_يساوي(ف(5), 160, "حالة 3")
تأكد_يساوي(ف(10), 220, "حالة 4")
تأكد_يساوي(ف(15), 180, "حالة 5")
