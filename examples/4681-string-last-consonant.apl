# مثال 4681 — آخر موضع (حرف ساكن) في نص
# String: last position of consonant
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4681-string-last-consonant.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  ل = -1
  لكل خ في س:
    لو ord(خ.lower()) >= 97 و ord(خ.lower()) <= 122 و "aeiou".find(خ.lower()) == -1:
      ل = ر
    ر = ر + 1
  ارجع ل

تأكد_يساوي(ف("  spaced   out  text "), 19, "حالة 1")
تأكد_يساوي(ف("Hello World 42"), 10, "حالة 2")
تأكد_يساوي(ف("2026-11-28 launch"), 16, "حالة 3")
تأكد_يساوي(ف("aeiou AEIOU xyz"), 14, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
