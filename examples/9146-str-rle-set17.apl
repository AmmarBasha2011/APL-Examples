# مثال 9146 — ضغط التكرار (مجموعة اختبار 17)
# rle (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9146-str-rle-set17.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("silent"), "s1i1l1e1n1t1", "حالة 1")
تأكد_يساوي(ف("river"), "r1i1v1e1r1", "حالة 2")
تأكد_يساوي(ف("civic"), "c1i1v1i1c1", "حالة 3")
تأكد_يساوي(ف("earth"), "e1a1r1t1h1", "حالة 4")
تأكد_يساوي(ف("loop"), "l1o2p1", "حالة 5")
