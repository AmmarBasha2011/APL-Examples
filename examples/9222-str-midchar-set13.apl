# مثال 9222 — الحرف الأوسط (مجموعة اختبار 13)
# midchar (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9222-str-midchar-set13.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("kayak"), "y", "حالة 1")
تأكد_يساوي(ف("array"), "r", "حالة 2")
تأكد_يساوي(ف("code"), "d", "حالة 3")
تأكد_يساوي(ف("moon"), "o", "حالة 4")
تأكد_يساوي(ف("galaxy"), "a", "حالة 5")
