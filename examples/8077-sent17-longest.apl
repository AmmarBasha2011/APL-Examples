# مثال 8077 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 18
# longest for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8077-sent17-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("bread milk bread eggs milk bread"), "bread", "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), "bird", "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), "rose", "حالة 3")
