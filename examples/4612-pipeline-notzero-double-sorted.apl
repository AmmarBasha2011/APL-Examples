# مثال 4612 — ترتيب نتيجة ضعفها للأعداد الغير الصفرية
# Sorted list of double over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4612-pipeline-notzero-double-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ * 2]
  ارجع sorted(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [2, 2, 4, 6, 10, 16, 26], "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [14, 28, 42, 56, 70, 84], "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [-10, 4, 4, 20, 50], "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [2, 6, 8, 12, 22, 40], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
