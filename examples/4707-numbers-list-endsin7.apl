# مثال 4707 — قائمة الأعداد الينتهي بالرقم 7 حتى حد معين
# Numbers up to a limit: list of the ends in 7 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4707-numbers-list-endsin7.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 10 == 7:
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(16), [7], "حالة 1")
تأكد_يساوي(ف(37), [7, 17, 27, 37], "حالة 2")
تأكد_يساوي(ف(109), [7, 17, 27, 37, 47, 57, 67, 77, 87, 97, 107], "حالة 3")
تأكد_يساوي(ف(1), [], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
