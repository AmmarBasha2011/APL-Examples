# مثال 9745 — الجذر التربيعي الصحيح (مجموعة اختبار 16)
# sqrtint (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9745-num-sqrtint-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(3158), 56, "حالة 1")
تأكد_يساوي(ف(3841), 61, "حالة 2")
تأكد_يساوي(ف(3354), 57, "حالة 3")
تأكد_يساوي(ف(1622), 40, "حالة 4")
تأكد_يساوي(ف(1605), 40, "حالة 5")
