# مثال 7474 — آخر عنصر: من المكعبات نأخذ مضاعفات 3 ثم (زيادة واحد)
# last over cubes sequence, keep m3, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7474-seq-cubes-m3-inc-last.apl

# نولّد أول ن حد من: المكعبات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي * ي
    لو خ % 3 == 0:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 28, "حالة 3")
تأكد_يساوي(ف(10), 730, "حالة 4")
تأكد_يساوي(ف(15), 1729, "حالة 5")
