# مثال 9145 — ضغط التكرار (مجموعة اختبار 16)
# rle (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9145-str-rle-set16.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("stats"), "s1t1a1t1s1", "حالة 1")
تأكد_يساوي(ف("kayak"), "k1a1y1a1k1", "حالة 2")
تأكد_يساوي(ف("sun"), "s1u1n1", "حالة 3")
تأكد_يساوي(ف("listen"), "l1i1s1t1e1n1", "حالة 4")
تأكد_يساوي(ف("river"), "r1i1v1e1r1", "حالة 5")
