# مثال 9951 — المدى (مجموعة 9)
# range (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9951-stat-range-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([48, 28, 32, -2, 9, -12, 37]), 60, "حالة 1")
تأكد_يساوي(ف([-2, 15, 43]), 45, "حالة 2")
تأكد_يساوي(ف([50, -18, 20, 9, 6]), 68, "حالة 3")
تأكد_يساوي(ف([33, 31, 13]), 20, "حالة 4")
