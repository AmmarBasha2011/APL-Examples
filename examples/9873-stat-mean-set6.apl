# مثال 9873 — المتوسط الصحيح (مجموعة 6)
# mean (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9873-stat-mean-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([1, 37, 11, 46, 5, 59]), 26, "حالة 1")
تأكد_يساوي(ف([-18, 42, 28, -16]), 9, "حالة 2")
تأكد_يساوي(ف([29, 8, 40, 32, 17]), 25, "حالة 3")
تأكد_يساوي(ف([12, 20, 10, -17, 54]), 15, "حالة 4")
