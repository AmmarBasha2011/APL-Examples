# مثال 9193 — عكس حالة الأحرف (مجموعة اختبار 24)
# swapcase (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9193-str-swapcase-set24.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("racecar"), "RACECAR", "حالة 1")
تأكد_يساوي(ف("venus"), "VENUS", "حالة 2")
تأكد_يساوي(ف("array"), "ARRAY", "حالة 3")
تأكد_يساوي(ف("saturn"), "SATURN", "حالة 4")
تأكد_يساوي(ف("mars"), "MARS", "حالة 5")
