# مثال 4617 — آخر نتيجة نصفها بالقسمة الصحيحة للأعداد الغير الصفرية
# Last (or -1) of integer half over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4617-pipeline-notzero-half-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ // 2]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 1, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 0, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 7, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 2, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
