# مثال 5271 — مقارنة العدد مع 13
# Compare number with 13
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5271-triple-compare-13.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 13:
    ارجع "اصغر"
  والا_لو ن > 13:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(12), "اصغر", "حالة 1")
تأكد_يساوي(ف(13), "يساوي", "حالة 2")
تأكد_يساوي(ف(14), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
