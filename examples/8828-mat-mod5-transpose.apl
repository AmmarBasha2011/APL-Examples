# مثال 8828 — المنقولة لمصفوفة قيمها (i*j) % 5
# Matrix transpose for cell formula (i*j) % 5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8828-mat-mod5-transpose.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [(ي * ك) % 5]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل ك في range(len(ق)):
    س = []
    لكل ي في range(len(ق)):
      س = س + [ق[ي][ك]]
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [[0]], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [[0, 0], [0, 1]], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [[0, 0, 0], [0, 1, 2], [0, 2, 4]], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [[0, 0, 0, 0, 0], [0, 1, 2, 3, 4], [0, 2, 4, 1, 3], [0, 3, 1, 4, 2], [0, 4, 3, 2, 1]], "حجم 5")
