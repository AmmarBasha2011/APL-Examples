# مثال 9230 — الحرف الأوسط (مجموعة اختبار 21)
# midchar (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9230-str-midchar-set21.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("data"), "t", "حالة 1")
تأكد_يساوي(ف("moon"), "o", "حالة 2")
تأكد_يساوي(ف("orbit"), "b", "حالة 3")
تأكد_يساوي(ف("array"), "r", "حالة 4")
تأكد_يساوي(ف("enlist"), "i", "حالة 5")
