# مثال 6769 — مولّد أرقام عشوائية خطي (17,0,101)
# LCG a=17 c=0 m=101
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6769-lcg-17-0-101.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (17 * س + 0) % 101
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [17, 87, 65, 95, 100], "حالة 1")
تأكد_يساوي(ف(0, 8), [0, 0, 0, 0, 0, 0, 0, 0], "حالة 2")
تأكد_يساوي(ف(7, 10), [18, 3, 51, 59, 94, 83, 98, 50, 42, 7], "حالة 3")
