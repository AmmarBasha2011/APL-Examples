# مثال 4666 — عدّ (مسافة) في نص
# String: count space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4666-string-count-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ع = 0
  لكل خ في س:
    لو خ == " ":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("a1b2c3d4"), 0, "حالة 1")
تأكد_يساوي(ف("apple PIE 7 and 9"), 4, "حالة 2")
تأكد_يساوي(ف("Hello World 42"), 2, "حالة 3")
تأكد_يساوي(ف("MixedCASE123abc"), 0, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
