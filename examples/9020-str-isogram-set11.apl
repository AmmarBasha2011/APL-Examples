# مثال 9020 — هل لا يتكرر أي حرف (مجموعة اختبار 11)
# isogram (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9020-str-isogram-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("racecar"), خطأ, "حالة 1")
تأكد_يساوي(ف("google"), خطأ, "حالة 2")
تأكد_يساوي(ف("river"), خطأ, "حالة 3")
تأكد_يساوي(ف("bob"), خطأ, "حالة 4")
تأكد_يساوي(ف("civic"), خطأ, "حالة 5")
