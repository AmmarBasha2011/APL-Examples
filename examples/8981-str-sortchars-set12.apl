# مثال 8981 — حروف الكلمة مرتبة (مجموعة اختبار 12)
# sortchars (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8981-str-sortchars-set12.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("apple"), "aelpp", "حالة 1")
تأكد_يساوي(ف("saturn"), "anrstu", "حالة 2")
تأكد_يساوي(ف("google"), "eggloo", "حالة 3")
تأكد_يساوي(ف("level"), "eellv", "حالة 4")
تأكد_يساوي(ف("radar"), "aadrr", "حالة 5")
