# مثال 8546 — المجموع من المدى 0 إلى 64 بخطوة 4 بعد (نصف صحيح)
# sum over range(0,64,4) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8546-range-0-64-4-half-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [خ // 2]
    خ = خ + (4)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 240, "المدى كله")
