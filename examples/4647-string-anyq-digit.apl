# مثال 4647 — هل يوجد (رقم) في نص
# String: is there any digit
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4647-string-anyq-digit.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو خ.isdigit():
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(ف("Data Science 101"), صواب, "حالة 1")
تأكد_يساوي(ف("apple PIE 7 and 9"), صواب, "حالة 2")
تأكد_يساوي(ف("2026-11-28 launch"), صواب, "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), صواب, "حالة 4")
تأكد_يساوي(ف(""), خطأ, "حالة 5")
