# مثال 9432 — عكس الأرقام (مجموعة اختبار 23)
# revnum (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9432-num-revnum-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(18971), 17981, "حالة 1")
تأكد_يساوي(ف(38317), 71383, "حالة 2")
تأكد_يساوي(ف(19660), 6691, "حالة 3")
تأكد_يساوي(ف(87162), 26178, "حالة 4")
تأكد_يساوي(ف(42581), 18524, "حالة 5")
