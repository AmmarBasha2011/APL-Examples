# مثال 9974 — التباين الصحيح (مجموعة 7)
# variance (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9974-stat-variance-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([57, -12, 54, -1, 25, 29, 12, 35, 36]), 478, "حالة 1")
تأكد_يساوي(ف([35, 32, 27, -2, -7, 60, 1]), 513, "حالة 2")
تأكد_يساوي(ف([33, -5, 60, 52, 7, 50, -7, 51]), 669, "حالة 3")
تأكد_يساوي(ف([25, 39, 15, -9]), 307, "حالة 4")
