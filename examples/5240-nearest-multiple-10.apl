# مثال 5240 — أقرب مضاعف للعدد 10
# Nearest multiple of 10
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5240-nearest-multiple-10.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 10
  لو ب * 2 < 10:
    ارجع ن - ب
  ارجع ن - ب + 10

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 10, "حالة 2")
تأكد_يساوي(ف(13), 10, "حالة 3")
تأكد_يساوي(ف(100), 100, "حالة 4")
تأكد_يساوي(ف(11), 10, "حالة 5")
