# مثال 9995 — عدد العناصر فوق المتوسط (مجموعة 3)
# above_mean (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9995-stat-above_mean-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([56, 3, 24]), 1, "حالة 1")
تأكد_يساوي(ف([49, 59, 27, 19, 56, -4, 23, 9]), 3, "حالة 2")
تأكد_يساوي(ف([-2, -17, 8, 38, -19, 37]), 3, "حالة 3")
تأكد_يساوي(ف([17, -9, 44]), 1, "حالة 4")
