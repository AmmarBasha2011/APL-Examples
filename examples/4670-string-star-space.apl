# مثال 4670 — استبدال بنجمة (مسافة) في نص
# String: replace with star space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4670-string-star-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو خ == " ":
      ن = ن + "*"
    والا:
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("aeiou AEIOU xyz"), "aeiou*AEIOU*xyz", "حالة 1")
تأكد_يساوي(ف("MixedCASE123abc"), "MixedCASE123abc", "حالة 2")
تأكد_يساوي(ف("quick brown fox"), "quick*brown*fox", "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), "apple*PIE*7*and*9", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
