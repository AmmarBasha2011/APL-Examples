# مثال 8997 — حروف الكلمة مرتبة (مجموعة اختبار 28)
# sortchars (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8997-str-sortchars-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("banana"), "aaabnn", "حالة 1")
تأكد_يساوي(ف("pluto"), "loptu", "حالة 2")
تأكد_يساوي(ف("comet"), "cemot", "حالة 3")
تأكد_يساوي(ف("python"), "hnopty", "حالة 4")
تأكد_يساوي(ف("galaxy"), "aaglxy", "حالة 5")
