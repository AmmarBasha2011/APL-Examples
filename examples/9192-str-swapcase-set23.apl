# مثال 9192 — عكس حالة الأحرف (مجموعة اختبار 23)
# swapcase (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9192-str-swapcase-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("banana"), "BANANA", "حالة 1")
تأكد_يساوي(ف("rotor"), "ROTOR", "حالة 2")
تأكد_يساوي(ف("mars"), "MARS", "حالة 3")
تأكد_يساوي(ف("river"), "RIVER", "حالة 4")
تأكد_يساوي(ف("star"), "STAR", "حالة 5")
