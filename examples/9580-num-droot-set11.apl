# مثال 9580 — الجذر الرقمي (مجموعة اختبار 11)
# droot (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9580-num-droot-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(87757), 7, "حالة 1")
تأكد_يساوي(ف(48966), 6, "حالة 2")
تأكد_يساوي(ف(81981), 9, "حالة 3")
تأكد_يساوي(ف(84318), 6, "حالة 4")
تأكد_يساوي(ف(76385), 2, "حالة 5")
