# مثال 10329 — تحويل 32 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 32 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10329-temp-c-32.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 32) * 9 // 5 + 32

تأكد_يساوي(ف(0), 89, "حالة 1")
تأكد_يساوي(ف(10), 107, "حالة 2")
تأكد_يساوي(ف(37), 156, "حالة 3")
تأكد_يساوي(ف(-5), 80, "حالة 4")
