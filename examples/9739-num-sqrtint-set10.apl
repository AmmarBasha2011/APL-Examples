# مثال 9739 — الجذر التربيعي الصحيح (مجموعة اختبار 10)
# sqrtint (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9739-num-sqrtint-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2275), 47, "حالة 1")
تأكد_يساوي(ف(4491), 67, "حالة 2")
تأكد_يساوي(ف(46), 6, "حالة 3")
تأكد_يساوي(ف(1450), 38, "حالة 4")
تأكد_يساوي(ف(485), 22, "حالة 5")
