# مثال 9679 — هل العدد أرمسترونغ (مجموعة اختبار 30)
# arm (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9679-num-arm-set30.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(945), خطأ, "حالة 1")
تأكد_يساوي(ف(136), خطأ, "حالة 2")
تأكد_يساوي(ف(338), خطأ, "حالة 3")
تأكد_يساوي(ف(801), خطأ, "حالة 4")
تأكد_يساوي(ف(579), خطأ, "حالة 5")
