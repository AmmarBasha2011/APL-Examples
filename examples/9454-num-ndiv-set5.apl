# مثال 9454 — عدد القواسم (مجموعة اختبار 5)
# ndiv (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9454-num-ndiv-set5.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(287), 4, "حالة 1")
تأكد_يساوي(ف(6), 4, "حالة 2")
تأكد_يساوي(ف(243), 6, "حالة 3")
تأكد_يساوي(ف(268), 6, "حالة 4")
تأكد_يساوي(ف(155), 4, "حالة 5")
