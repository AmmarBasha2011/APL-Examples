# مثال 9407 — مجموع الأرقام (مجموعة اختبار 38)
# digsum (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9407-num-digsum-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(79028), 26, "حالة 1")
تأكد_يساوي(ف(48731), 23, "حالة 2")
تأكد_يساوي(ف(41249), 20, "حالة 3")
تأكد_يساوي(ف(5282), 17, "حالة 4")
تأكد_يساوي(ف(24429), 21, "حالة 5")
