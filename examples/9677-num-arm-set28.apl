# مثال 9677 — هل العدد أرمسترونغ (مجموعة اختبار 28)
# arm (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9677-num-arm-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(220), خطأ, "حالة 1")
تأكد_يساوي(ف(203), خطأ, "حالة 2")
تأكد_يساوي(ف(89), خطأ, "حالة 3")
تأكد_يساوي(ف(686), خطأ, "حالة 4")
تأكد_يساوي(ف(99), خطأ, "حالة 5")
