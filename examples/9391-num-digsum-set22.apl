# مثال 9391 — مجموع الأرقام (مجموعة اختبار 22)
# digsum (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9391-num-digsum-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(53797), 31, "حالة 1")
تأكد_يساوي(ف(46551), 21, "حالة 2")
تأكد_يساوي(ف(6834), 21, "حالة 3")
تأكد_يساوي(ف(64251), 18, "حالة 4")
تأكد_يساوي(ف(24523), 16, "حالة 5")
