# مثال 8540 — المجموع من المدى 0 إلى 64 بخطوة 4 بعد (سالب)
# sum over range(0,64,4) mapped by neg
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8540-range-0-64-4-neg-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [0 - خ]
    خ = خ + (4)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), -480, "المدى كله")
