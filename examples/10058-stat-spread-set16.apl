# مثال 10058 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 16)
# spread (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10058-stat-spread-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([-12, 18, 39, 21, 25, 11, 49, 26]), 23, "حالة 1")
تأكد_يساوي(ف([-11, 43, 47, -13, 46, 15, 52, 53]), 28, "حالة 2")
تأكد_يساوي(ف([35, 30, 31, 41, 7, 26, 7, 12, -16]), 23, "حالة 3")
تأكد_يساوي(ف([33, 15, 2, 43, 55, -3, 1, 10]), 18, "حالة 4")
