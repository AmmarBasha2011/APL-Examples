# مثال 8057 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 16
# longest for sentence 16
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8057-sent15-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("stars and moon and stars again"), "stars", "حالة 1")
تأكد_يساوي(ف("left right left left right"), "right", "حالة 2")
تأكد_يساوي(ف("apl code is easy code is fun"), "code", "حالة 3")
