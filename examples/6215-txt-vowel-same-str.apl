# مثال 6215 — النص الناتج بعد أخذ حروف العلة وتحويلها إلى (كما هو)
# str of same applied to vowel chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6215-txt-vowel-same-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف العلة فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "aeiou":
      ر = ر + خ
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "eoo", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "aiu", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "a", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "euioo", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "aaiee", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "oaiiaai", "حالة 8")
