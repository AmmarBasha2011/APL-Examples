# مثال 9199 — عكس حالة الأحرف (مجموعة اختبار 30)
# swapcase (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9199-str-swapcase-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("pluto"), "PLUTO", "حالة 1")
تأكد_يساوي(ف("deed"), "DEED", "حالة 2")
تأكد_يساوي(ف("bob"), "BOB", "حالة 3")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 4")
تأكد_يساوي(ف("google"), "GOOGLE", "حالة 5")
