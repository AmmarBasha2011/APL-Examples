# مثال 8261 — أصغر قيمة من المدى 5 إلى 50 بخطوة 5 بعد (مكعب)
# min over range(5,50,5) mapped by cube
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8261-range-5-50-5-cube-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ * خ * خ]
    خ = خ + (5)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 125, "المدى كله")
