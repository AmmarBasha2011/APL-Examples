# مثال 9748 — الجذر التربيعي الصحيح (مجموعة اختبار 19)
# sqrtint (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9748-num-sqrtint-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(4372), 66, "حالة 1")
تأكد_يساوي(ف(849), 29, "حالة 2")
تأكد_يساوي(ف(2900), 53, "حالة 3")
تأكد_يساوي(ف(527), 22, "حالة 4")
تأكد_يساوي(ف(1934), 43, "حالة 5")
