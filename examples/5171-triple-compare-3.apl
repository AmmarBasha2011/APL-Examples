# مثال 5171 — مقارنة العدد مع 3
# Compare number with 3
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5171-triple-compare-3.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 3:
    ارجع "اصغر"
  والا_لو ن > 3:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(2), "اصغر", "حالة 1")
تأكد_يساوي(ف(3), "يساوي", "حالة 2")
تأكد_يساوي(ف(4), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
