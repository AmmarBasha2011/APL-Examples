# مثال 9683 — هل العدد أرمسترونغ (مجموعة اختبار 34)
# arm (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9683-num-arm-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(598), خطأ, "حالة 1")
تأكد_يساوي(ف(663), خطأ, "حالة 2")
تأكد_يساوي(ف(681), خطأ, "حالة 3")
تأكد_يساوي(ف(499), خطأ, "حالة 4")
تأكد_يساوي(ف(66), خطأ, "حالة 5")
