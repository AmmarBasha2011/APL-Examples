# مثال 6305 — النص الناتج بعد أخذ غير المسافات وتحويلها إلى (الحرف التالي)
# str of shift1 applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6305-txt-nospace-shift1-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: الحرف التالي
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + chr(ord(خ) + 1)
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "ifmmpxpsme53", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "bqmjtgvo", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "b2c3d4", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "uifrvjdlcspxogpy", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "{{{zzzyyy", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "ebub3137tdjfodf", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "qsphsbnnjohjobsbcjd", "حالة 8")
