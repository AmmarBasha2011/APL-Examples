# مثال 6255 — النص الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (حرف مع شرطة)
# str of dash applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6255-txt-cons-dash-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ + "-"
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "h-l-l-w-r-l-d-", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "p-l-s-f-n-", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "b-c-", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "t-h-q-c-k-b-r-w-n-f-x-", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "z-z-z-y-y-y-x-x-x-", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "d-t-s-c-n-c-", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "p-r-g-r-m-m-n-g-n-r-b-c-", "حالة 8")
