# مثال 8088 — مجموع حروف الكلمات في الجملة رقم 19
# totalchars for sentence 19
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8088-sent18-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("left right left left right"), 22, "حالة 1")
تأكد_يساوي(ف("to be or not to be"), 13, "حالة 2")
تأكد_يساوي(ف("we love data and data loves us"), 24, "حالة 3")
