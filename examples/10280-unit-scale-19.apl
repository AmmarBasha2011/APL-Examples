# مثال 10280 — تحويل وحدة إلى 19 وحدات صغرى والعكس
# Convert units with factor 19
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10280-unit-scale-19.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 19, ن // 19, ن % 19]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [19, 0, 1], "حالة 2")
تأكد_يساوي(ف(19), [361, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [19000, 52, 12], "حالة 4")
