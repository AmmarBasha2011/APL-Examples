# مثال 9216 — الحرف الأوسط (مجموعة اختبار 7)
# midchar (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9216-str-midchar-set7.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("radar"), "d", "حالة 1")
تأكد_يساوي(ف("deed"), "e", "حالة 2")
تأكد_يساوي(ف("star"), "a", "حالة 3")
تأكد_يساوي(ف("civic"), "v", "حالة 4")
تأكد_يساوي(ف("google"), "g", "حالة 5")
