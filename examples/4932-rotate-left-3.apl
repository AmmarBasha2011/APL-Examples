# مثال 4932 — تدوير القائمة 3 خانات لليسار
# Rotate list left by 3
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4932-rotate-left-3.apl

# نقسم القائمة ونعيد ترتيبها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لو len(ق) == 0:
    ارجع ق
  ك = 3 % len(ق)
  ارجع ق[ك:] + ق[:ك]

تأكد_يساوي(ف([1, 2, 3, 4, 5, 6, 7]), [4, 5, 6, 7, 1, 2, 3], "حالة 1")
تأكد_يساوي(ف([1, 2]), [2, 1], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
تأكد_يساوي(ف(["a", "b", "c", "d", "e", "f"]), ["d", "e", "f", "a", "b", "c"], "حالة 4")
