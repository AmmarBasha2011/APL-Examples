# مثال 10341 — تحويل 56 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 56 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10341-temp-c-56.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 56) * 9 // 5 + 32

تأكد_يساوي(ف(0), 132, "حالة 1")
تأكد_يساوي(ف(10), 150, "حالة 2")
تأكد_يساوي(ف(37), 199, "حالة 3")
تأكد_يساوي(ف(-5), 123, "حالة 4")
