# مثال 4866 — مساحة مستطيل طوله 7 أضعاف عرضه
# Area of rectangle with length 7x width
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4866-rect-area-ratio-7.apl

# المساحة = العرض × الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ع):
  ارجع ع * (ع * 7)

تأكد_يساوي(ف(1), 7, "حالة 1")
تأكد_يساوي(ف(2), 28, "حالة 2")
تأكد_يساوي(ف(5), 175, "حالة 3")
تأكد_يساوي(ف(10), 700, "حالة 4")
