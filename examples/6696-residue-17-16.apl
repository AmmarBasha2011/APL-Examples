# مثال 6696 — الأعداد التي باقيها 16 عند القسمة على 17
# Numbers with remainder 16 mod 17
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6696-residue-17-16.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 17 == 16:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [], "حالة 2")
تأكد_يساوي(ف(40), [16, 33], "حالة 3")
تأكد_يساوي(ف(75), [16, 33, 50, 67], "حالة 4")
