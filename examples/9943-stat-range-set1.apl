# مثال 9943 — المدى (مجموعة 1)
# range (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9943-stat-range-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([12, 25, 47, -17, 39, 11, -14]), 64, "حالة 1")
تأكد_يساوي(ف([-6, 27, 40, 11]), 46, "حالة 2")
تأكد_يساوي(ف([49, -7, 53, 11, -19, 7]), 72, "حالة 3")
تأكد_يساوي(ف([15, 3, 29, 0, -11, -3]), 40, "حالة 4")
