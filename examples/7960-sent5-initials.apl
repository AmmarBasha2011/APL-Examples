# مثال 7960 — الحروف الأولى في الجملة رقم 6
# initials for sentence 6
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7960-sent5-initials.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    ر = ر + ك[0]
  ارجع ر

تأكد_يساوي(ف("we love data and data loves us"), "wldadlu", "حالة 1")
تأكد_يساوي(ف("a b c a b a"), "abcaba", "حالة 2")
تأكد_يساوي(ف("cairo is big and cairo is old"), "cibacio", "حالة 3")
