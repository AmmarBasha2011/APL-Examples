# مثال 9464 — عدد القواسم (مجموعة اختبار 15)
# ndiv (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9464-num-ndiv-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(176), 10, "حالة 1")
تأكد_يساوي(ف(213), 4, "حالة 2")
تأكد_يساوي(ف(281), 2, "حالة 3")
تأكد_يساوي(ف(230), 8, "حالة 4")
تأكد_يساوي(ف(56), 8, "حالة 5")
