# مثال 5281 — مقارنة العدد مع 14
# Compare number with 14
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5281-triple-compare-14.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 14:
    ارجع "اصغر"
  والا_لو ن > 14:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(13), "اصغر", "حالة 1")
تأكد_يساوي(ف(14), "يساوي", "حالة 2")
تأكد_يساوي(ف(15), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
