# مثال 9783 — قلب الخانة رقم 3
# Flip bit 3
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9783-bits-flip-3.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 3)

تأكد_يساوي(ف(0), 8, "حالة 1")
تأكد_يساوي(ف(255), 247, "حالة 2")
تأكد_يساوي(ف(1000), 992, "حالة 3")
تأكد_يساوي(ف(12345), 12337, "حالة 4")
