# مثال 8918 — هل الكلمة متناظرة (مجموعة اختبار 29)
# palin (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8918-str-palin-set29.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("radar"), صواب, "حالة 1")
تأكد_يساوي(ف("google"), خطأ, "حالة 2")
تأكد_يساوي(ف("star"), خطأ, "حالة 3")
تأكد_يساوي(ف("level"), صواب, "حالة 4")
تأكد_يساوي(ف("silent"), خطأ, "حالة 5")
