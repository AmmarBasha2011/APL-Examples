# مثال 9675 — هل العدد أرمسترونغ (مجموعة اختبار 26)
# arm (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9675-num-arm-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(658), خطأ, "حالة 1")
تأكد_يساوي(ف(515), خطأ, "حالة 2")
تأكد_يساوي(ف(772), خطأ, "حالة 3")
تأكد_يساوي(ف(336), خطأ, "حالة 4")
تأكد_يساوي(ف(477), خطأ, "حالة 5")
