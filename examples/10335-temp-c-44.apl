# مثال 10335 — تحويل 44 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 44 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10335-temp-c-44.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 44) * 9 // 5 + 32

تأكد_يساوي(ف(0), 111, "حالة 1")
تأكد_يساوي(ف(10), 129, "حالة 2")
تأكد_يساوي(ف(37), 177, "حالة 3")
تأكد_يساوي(ف(-5), 102, "حالة 4")
