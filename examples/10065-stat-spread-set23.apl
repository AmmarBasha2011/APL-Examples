# مثال 10065 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 23)
# spread (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10065-stat-spread-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([14, 21, 30, 11, 45, -1, 12, 4, -11]), 15, "حالة 1")
تأكد_يساوي(ف([38, -5, -4]), 42, "حالة 2")
تأكد_يساوي(ف([44, 39, 19, 43, 38, 24]), 14, "حالة 3")
تأكد_يساوي(ف([20, 13, 1, -12, 42, 47, 50]), 22, "حالة 4")
