# مثال 9650 — هل العدد أرمسترونغ (مجموعة اختبار 1)
# arm (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9650-num-arm-set1.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(244), خطأ, "حالة 1")
تأكد_يساوي(ف(607), خطأ, "حالة 2")
تأكد_يساوي(ف(558), خطأ, "حالة 3")
تأكد_يساوي(ف(134), خطأ, "حالة 4")
تأكد_يساوي(ف(379), خطأ, "حالة 5")
