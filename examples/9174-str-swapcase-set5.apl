# مثال 9174 — عكس حالة الأحرف (مجموعة اختبار 5)
# swapcase (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9174-str-swapcase-set5.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("loop"), "LOOP", "حالة 1")
تأكد_يساوي(ف("banana"), "BANANA", "حالة 2")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 3")
تأكد_يساوي(ف("silent"), "SILENT", "حالة 4")
تأكد_يساوي(ف("kayak"), "KAYAK", "حالة 5")
