# مثال 9878 — المتوسط الصحيح (مجموعة 11)
# mean (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9878-stat-mean-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([38, -6, 2, -20]), 3, "حالة 1")
تأكد_يساوي(ف([60, 17, 9, 31, 6, 31, 49, 37]), 30, "حالة 2")
تأكد_يساوي(ف([60, 2, -4]), 19, "حالة 3")
تأكد_يساوي(ف([11, -17, 10]), 1, "حالة 4")
