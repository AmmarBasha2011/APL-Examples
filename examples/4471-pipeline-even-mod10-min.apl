# مثال 4471 — أصغر نتيجة باقي قسمتها على 10 للأعداد الزوجية
# Smallest (or 0) of last digit mod 10 over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4471-pipeline-even-mod10-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ % 10]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 0, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 2, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 0, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 2, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
