# مثال 4628 — عدد نتيجة ناقص 3 للأعداد الغير الصفرية
# Count of minus 3 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4628-pipeline-notzero-minus3-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ - 3]
  ارجع len(ن)

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 6, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 7, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 6, "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 5, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
