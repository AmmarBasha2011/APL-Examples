# مثال 4529 — أصغر نتيجة سالبها للأعداد التقبل القسمة على 3
# Smallest (or 0) of negated over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4529-pipeline-div3-negate-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), -3, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), -15, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), -9, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -6, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
