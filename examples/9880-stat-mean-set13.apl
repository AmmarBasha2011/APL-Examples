# مثال 9880 — المتوسط الصحيح (مجموعة 13)
# mean (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9880-stat-mean-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([31, 40, 17, 0, 46, -8, 34, 29]), 23, "حالة 1")
تأكد_يساوي(ف([54, -20, 37, 21]), 23, "حالة 2")
تأكد_يساوي(ف([18, 60, 58, 57]), 48, "حالة 3")
تأكد_يساوي(ف([9, 37, -9]), 12, "حالة 4")
