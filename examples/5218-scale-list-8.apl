# مثال 5218 — ضرب كل عنصر في 8
# Scale list by 8
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5218-scale-list-8.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 8]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [8, 16, 24], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -32, 80], "حالة 3")
