# مثال 6644 — الأعداد التي باقيها 2 عند القسمة على 7
# Numbers with remainder 2 mod 7
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6644-residue-7-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 7 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2, 9], "حالة 2")
تأكد_يساوي(ف(40), [2, 9, 16, 23, 30, 37], "حالة 3")
تأكد_يساوي(ف(75), [2, 9, 16, 23, 30, 37, 44, 51, 58, 65, 72], "حالة 4")
