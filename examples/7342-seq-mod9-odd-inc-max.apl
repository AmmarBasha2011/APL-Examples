# مثال 7342 — أكبر قيمة: من ي * 4 باقي 9 نأخذ الفردي ثم (زيادة واحد)
# max over mod9 sequence, keep odd, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7342-seq-mod9-odd-inc-max.apl

# نولّد أول ن حد من: ي * 4 باقي 9
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي * 4) % 9
    لو خ % 2 == 1:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 8, "حالة 3")
تأكد_يساوي(ف(10), 8, "حالة 4")
تأكد_يساوي(ف(15), 8, "حالة 5")
