# مثال 4715 — قائمة الأعداد الباقي قسمته على 7 يساوي 3 حتى حد معين
# Numbers up to a limit: list of the remainder 3 mod 7 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4715-numbers-list-mod7is3.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 7 == 3:
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(10), [3, 10], "حالة 1")
تأكد_يساوي(ف(66), [3, 10, 17, 24, 31, 38, 45, 52, 59, 66], "حالة 2")
تأكد_يساوي(ف(111), [3, 10, 17, 24, 31, 38, 45, 52, 59, 66, 73, 80, 87, 94, 101, 108], "حالة 3")
تأكد_يساوي(ف(1), [], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
