# مثال 4565 — أصغر نتيجة مربعها للأعداد الأقل من 5
# Smallest (or 0) of square over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4565-pipeline-small-square-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 0, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 4, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 0, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 81, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
