# مثال 5339 — قابل للقسمة على 20 وزوجي؟
# Divisible by 20 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5339-is-multiple-and-even-20.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 20 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(20), صواب, "حالة 2")
تأكد_يساوي(ف(40), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(80), صواب, "حالة 5")
