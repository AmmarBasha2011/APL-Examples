# مثال 9484 — عدد القواسم (مجموعة اختبار 35)
# ndiv (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9484-num-ndiv-set35.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(245), 6, "حالة 1")
تأكد_يساوي(ف(278), 4, "حالة 2")
تأكد_يساوي(ف(111), 4, "حالة 3")
تأكد_يساوي(ف(96), 12, "حالة 4")
تأكد_يساوي(ف(72), 12, "حالة 5")
