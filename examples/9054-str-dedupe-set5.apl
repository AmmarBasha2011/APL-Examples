# مثال 9054 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 5)
# dedupe (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9054-str-dedupe-set5.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("venus"), "venus", "حالة 1")
تأكد_يساوي(ف("deed"), "de", "حالة 2")
تأكد_يساوي(ف("apple"), "aple", "حالة 3")
تأكد_يساوي(ف("tenet"), "ten", "حالة 4")
تأكد_يساوي(ف("sun"), "sun", "حالة 5")
