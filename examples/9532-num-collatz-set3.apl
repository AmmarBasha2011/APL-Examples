# مثال 9532 — خطوات كولاتز (مجموعة اختبار 3)
# collatz (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9532-num-collatz-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(147), 116, "حالة 1")
تأكد_يساوي(ف(43), 29, "حالة 2")
تأكد_يساوي(ف(162), 23, "حالة 3")
تأكد_يساوي(ف(60), 19, "حالة 4")
تأكد_يساوي(ف(71), 102, "حالة 5")
