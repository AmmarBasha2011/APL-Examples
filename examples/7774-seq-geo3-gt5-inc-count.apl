# مثال 7774 — العدد: من قوى 3 نأخذ الأكبر من 5 ثم (زيادة واحد)
# count over geo3 sequence, keep gt5, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7774-seq-geo3-gt5-inc-count.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ > 5:
      ر = ر + [خ + 1]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 3, "حالة 3")
تأكد_يساوي(ف(10), 8, "حالة 4")
تأكد_يساوي(ف(15), 13, "حالة 5")
