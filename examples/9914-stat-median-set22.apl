# مثال 9914 — الوسيط (بعد الترتيب) (مجموعة 22)
# median (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9914-stat-median-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([20, 12, 20, 12, 16, 35, -20]), 16, "حالة 1")
تأكد_يساوي(ف([41, 42, 41, 42, -14, -13, -20, 12, -5]), 12, "حالة 2")
تأكد_يساوي(ف([-15, 52, 37]), 37, "حالة 3")
تأكد_يساوي(ف([53, 16, 52, 32, 50]), 50, "حالة 4")
