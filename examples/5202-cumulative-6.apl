# مثال 5202 — مجموع تراكمي مع زيادة 6
# Running total plus 6 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5202-cumulative-6.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 6
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [7, 15, 24], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [11, 22, 33, 44], "حالة 3")
