# مثال 8519 — أصغر قيمة من المدى 20 إلى 2 بخطوة -2 بعد (ناقص 3)
# min over range(20,2,-2) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8519-range-20-2-n2-dec3-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [خ - 3]
    خ = خ + (-2)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 1, "المدى كله")
