# مثال 5018 — قوى العدد 11 حتى 6
# Powers of 11 up to 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/5018-power-table-11.apl

# نضرب في العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  ق = 1
  لكل ي في range(ن + 1):
    ر = ر + [ق]
    ق = ق * 11
  ارجع ر

تأكد_يساوي(ف(0), [1], "حالة 1")
تأكد_يساوي(ف(3), [1, 11, 121, 1331], "حالة 2")
تأكد_يساوي(ف(6), [1, 11, 121, 1331, 14641, 161051, 1771561], "حالة 3")
