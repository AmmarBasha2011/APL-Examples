# مثال 9742 — الجذر التربيعي الصحيح (مجموعة اختبار 13)
# sqrtint (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9742-num-sqrtint-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(4435), 66, "حالة 1")
تأكد_يساوي(ف(3744), 61, "حالة 2")
تأكد_يساوي(ف(4786), 69, "حالة 3")
تأكد_يساوي(ف(1416), 37, "حالة 4")
تأكد_يساوي(ف(4036), 63, "حالة 5")
