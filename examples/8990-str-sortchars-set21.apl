# مثال 8990 — حروف الكلمة مرتبة (مجموعة اختبار 21)
# sortchars (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8990-str-sortchars-set21.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("radar"), "aadrr", "حالة 1")
تأكد_يساوي(ف("python"), "hnopty", "حالة 2")
تأكد_يساوي(ف("racecar"), "aaccerr", "حالة 3")
تأكد_يساوي(ف("sun"), "nsu", "حالة 4")
تأكد_يساوي(ف("stats"), "asstt", "حالة 5")
