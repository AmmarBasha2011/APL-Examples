# مثال 9168 — ضغط التكرار (مجموعة اختبار 39)
# rle (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9168-str-rle-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("noon"), "n1o2n1", "حالة 1")
تأكد_يساوي(ف("apple"), "a1p2l1e1", "حالة 2")
تأكد_يساوي(ف("radar"), "r1a1d1a1r1", "حالة 3")
تأكد_يساوي(ف("enlist"), "e1n1l1i1s1t1", "حالة 4")
تأكد_يساوي(ف("river"), "r1i1v1e1r1", "حالة 5")
