# مثال 8248 — أكبر قيمة من المدى 5 إلى 50 بخطوة 5 بعد (نصف صحيح)
# max over range(5,50,5) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8248-range-5-50-5-half-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ // 2]
    خ = خ + (5)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 22, "المدى كله")
