# مثال 4822 — فائدة بسيطة بنسبة 4%
# Simple interest at 4 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4822-simple-interest-4.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 4 * س // 100

تأكد_يساوي(ف(1000, 1), 40, "حالة 1")
تأكد_يساوي(ف(2500, 3), 300, "حالة 2")
تأكد_يساوي(ف(100, 10), 40, "حالة 3")
تأكد_يساوي(ف(8000, 2), 640, "حالة 4")
