# مثال 10240 — شريط بعرض 12 من الرمز #
# Bar of width 12 using #
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10240-bar-12-35.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "#"
  ارجع ر + "|" + str(12)

تأكد_يساوي(ف(0), "|12", "حالة 1")
تأكد_يساوي(ف(3), "###|12", "حالة 2")
تأكد_يساوي(ف(12), "############|12", "حالة 3")
