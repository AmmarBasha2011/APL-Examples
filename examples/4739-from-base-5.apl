# مثال 4739 — قراءة عدد مكتوب بالأساس 5
# Read a number written in base 5
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4739-from-base-5.apl

# نمر على الأرقام من اليسار
# ونضرب الناتج في الأساس ونضيف الرقم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = 0
  لكل خ في س:
    ن = ن * 5 + int(خ)
  ارجع ن

تأكد_يساوي(ف("0"), 0, "حالة 1")
تأكد_يساوي(ف("1"), 1, "حالة 2")
تأكد_يساوي(ف("14"), 9, "حالة 3")
تأكد_يساوي(ف("110"), 30, "حالة 4")
تأكد_يساوي(ف("302"), 77, "حالة 5")
