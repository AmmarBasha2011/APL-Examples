# مثال 9909 — الوسيط (بعد الترتيب) (مجموعة 17)
# median (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9909-stat-median-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([26, 1, 60, 25, 1, 34, -15]), 25, "حالة 1")
تأكد_يساوي(ف([28, 44, -11, 11, 20, 5, -7, 21, 48]), 20, "حالة 2")
تأكد_يساوي(ف([11, 53, -12, 60]), 32, "حالة 3")
تأكد_يساوي(ف([-12, -9, 58]), -9, "حالة 4")
