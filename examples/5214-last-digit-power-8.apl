# مثال 5214 — آخر رقم للعدد 8 أس ن
# Last digit of 8^n
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5214-last-digit-power-8.apl

# نستخدم الباقي على 10 في كل ضرب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 1
  لكل ي في range(ن):
    ر = ر * 8 % 10
  ارجع ر

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(5), 8, "حالة 3")
تأكد_يساوي(ف(13), 8, "حالة 4")
تأكد_يساوي(ف(100), 6, "حالة 5")
