# مثال 4459 — ترتيب نتيجة زائد 7 للأعداد الزوجية
# Sorted list of plus 7 over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4459-pipeline-even-plus7-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ + 7]
  ارجع sorted(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), [7, 7, 11, 23], "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [13, 15, 19, 37], "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [11, 13, 27], "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [9, 15], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
