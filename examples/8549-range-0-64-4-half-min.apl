# مثال 8549 — أصغر قيمة من المدى 0 إلى 64 بخطوة 4 بعد (نصف صحيح)
# min over range(0,64,4) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8549-range-0-64-4-half-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [خ // 2]
    خ = خ + (4)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 0, "المدى كله")
