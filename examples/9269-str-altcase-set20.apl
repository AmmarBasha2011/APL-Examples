# مثال 9269 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 20)
# altcase (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9269-str-altcase-set20.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("python"), "PyThOn", "حالة 1")
تأكد_يساوي(ف("apple"), "ApPlE", "حالة 2")
تأكد_يساوي(ف("listen"), "LiStEn", "حالة 3")
تأكد_يساوي(ف("earth"), "EaRtH", "حالة 4")
تأكد_يساوي(ف("banana"), "BaNaNa", "حالة 5")
