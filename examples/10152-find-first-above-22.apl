# مثال 10152 — موضع أول عنصر أكبر من 22
# Index of first item above 22
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10152-find-first-above-22.apl

# نرجع -1 إن لم نجد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ي في range(len(ق)):
    لو ق[ي] > 22:
      ارجع ي
  ارجع -1

تأكد_يساوي(ف([1, 5, 9, 14, 20, 31, 40]), 5, "حالة 1")
تأكد_يساوي(ف([0, 0, 0]), -1, "حالة 2")
تأكد_يساوي(ف([100]), 0, "حالة 3")
تأكد_يساوي(ف([]), -1, "حالة 4")
