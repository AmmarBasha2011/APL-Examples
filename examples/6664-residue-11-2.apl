# مثال 6664 — الأعداد التي باقيها 2 عند القسمة على 11
# Numbers with remainder 2 mod 11
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6664-residue-11-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 11 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2], "حالة 2")
تأكد_يساوي(ف(40), [2, 13, 24, 35], "حالة 3")
تأكد_يساوي(ف(75), [2, 13, 24, 35, 46, 57, 68], "حالة 4")
