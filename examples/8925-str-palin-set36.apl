# مثال 8925 — هل الكلمة متناظرة (مجموعة اختبار 36)
# palin (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8925-str-palin-set36.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("sun"), خطأ, "حالة 1")
تأكد_يساوي(ف("moon"), خطأ, "حالة 2")
تأكد_يساوي(ف("code"), خطأ, "حالة 3")
تأكد_يساوي(ف("saturn"), خطأ, "حالة 4")
تأكد_يساوي(ف("radar"), صواب, "حالة 5")
