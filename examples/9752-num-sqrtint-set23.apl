# مثال 9752 — الجذر التربيعي الصحيح (مجموعة اختبار 23)
# sqrtint (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9752-num-sqrtint-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(3912), 62, "حالة 1")
تأكد_يساوي(ف(3847), 62, "حالة 2")
تأكد_يساوي(ف(935), 30, "حالة 3")
تأكد_يساوي(ف(1892), 43, "حالة 4")
تأكد_يساوي(ف(4099), 64, "حالة 5")
