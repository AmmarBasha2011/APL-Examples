# مثال 9232 — الحرف الأوسط (مجموعة اختبار 23)
# midchar (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9232-str-midchar-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("venus"), "n", "حالة 1")
تأكد_يساوي(ف("rotor"), "t", "حالة 2")
تأكد_يساوي(ف("saturn"), "u", "حالة 3")
تأكد_يساوي(ف("code"), "d", "حالة 4")
تأكد_يساوي(ف("tenet"), "n", "حالة 5")
