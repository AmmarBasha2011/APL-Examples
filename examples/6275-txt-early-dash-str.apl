# مثال 6275 — النص الناتج بعد أخذ حروف أول الأبجدية وتحويلها إلى (حرف مع شرطة)
# str of dash applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6275-txt-early-dash-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + خ + "-"
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "h-e-l-l-l-d-", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "a-l-i-f-", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "a-b-c-", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "h-e-i-c-k-b-f-", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "d-a-a-c-i-e-c-e-", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "g-a-m-m-i-g-i-a-a-b-i-c-", "حالة 8")
