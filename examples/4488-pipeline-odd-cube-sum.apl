# مثال 4488 — مجموع نتيجة مكعبها للأعداد الفردية
# Sum of cube over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4488-pipeline-odd-cube-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ * خ * خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 1359, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 15500, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 4309, "حالة 3")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 52479, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
