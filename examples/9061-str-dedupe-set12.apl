# مثال 9061 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 12)
# dedupe (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9061-str-dedupe-set12.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("rocket"), "rocket", "حالة 1")
تأكد_يساوي(ف("galaxy"), "galxy", "حالة 2")
تأكد_يساوي(ف("kayak"), "kay", "حالة 3")
تأكد_يساوي(ف("stats"), "sta", "حالة 4")
تأكد_يساوي(ف("sun"), "sun", "حالة 5")
