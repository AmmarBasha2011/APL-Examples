# مثال 9003 — حروف الكلمة مرتبة (مجموعة اختبار 34)
# sortchars (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9003-str-sortchars-set34.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("banana"), "aaabnn", "حالة 1")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 2")
تأكد_يساوي(ف("google"), "eggloo", "حالة 3")
تأكد_يساوي(ف("data"), "aadt", "حالة 4")
تأكد_يساوي(ف("venus"), "ensuv", "حالة 5")
