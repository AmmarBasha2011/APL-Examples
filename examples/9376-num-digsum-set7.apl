# مثال 9376 — مجموع الأرقام (مجموعة اختبار 7)
# digsum (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9376-num-digsum-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(95883), 33, "حالة 1")
تأكد_يساوي(ف(37170), 18, "حالة 2")
تأكد_يساوي(ف(4892), 23, "حالة 3")
تأكد_يساوي(ف(64111), 13, "حالة 4")
تأكد_يساوي(ف(575), 17, "حالة 5")
