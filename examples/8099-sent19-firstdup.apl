# مثال 8099 — أول كلمة تتكرر في الجملة رقم 20
# firstdup for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8099-sent19-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("yes no yes yes no maybe"), "yes", "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), "code", "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), "two", "حالة 3")
