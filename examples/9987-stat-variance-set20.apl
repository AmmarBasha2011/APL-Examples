# مثال 9987 — التباين الصحيح (مجموعة 20)
# variance (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9987-stat-variance-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-1, 12, 34]), 208, "حالة 1")
تأكد_يساوي(ف([48, 30, 14]), 193, "حالة 2")
تأكد_يساوي(ف([14, 31, 40, 57, 29, 39, 49]), 169, "حالة 3")
تأكد_يساوي(ف([44, 42, -17, 48]), 717, "حالة 4")
