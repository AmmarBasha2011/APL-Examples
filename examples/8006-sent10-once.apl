# مثال 8006 — عدد الكلمات التي ظهرت مرة واحدة في الجملة رقم 11
# once for sentence 11
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8006-sent10-once.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] == 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("red blue green red blue red"), 1, "حالة 1")
تأكد_يساوي(ف("nile river nile delta river"), 1, "حالة 2")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), 1, "حالة 3")
