# مثال 9415 — عكس الأرقام (مجموعة اختبار 6)
# revnum (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9415-num-revnum-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(42434), 43424, "حالة 1")
تأكد_يساوي(ف(66645), 54666, "حالة 2")
تأكد_يساوي(ف(81268), 86218, "حالة 3")
تأكد_يساوي(ف(1111), 1111, "حالة 4")
تأكد_يساوي(ف(34725), 52743, "حالة 5")
