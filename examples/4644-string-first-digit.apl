# مثال 4644 — أول موضع (رقم) في نص
# String: first position of digit
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4644-string-first-digit.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  لكل خ في س:
    لو خ.isdigit():
      ارجع ر
    ر = ر + 1
  ارجع -1

تأكد_يساوي(ف("quick brown fox"), -1, "حالة 1")
تأكد_يساوي(ف("Hello World 42"), 12, "حالة 2")
تأكد_يساوي(ف("ZZtop and the Beatles"), -1, "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), 10, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
