# مثال 6327 — الناتج معكوس بعد أخذ الحروف الساكنة وتحويلها إلى (رقم الحرف)
# rev of code applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6327-txt-cons-code-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + str(ord(خ))+","
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), ",001,801,411,911,801,801,401", "حالة 1")
تأكد_يساوي(ف("apl is fun"), ",011,201,511,801,211", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), ",99,89", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), ",021,201,011,911,411,89,701,99,311,401,611", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), ",021,021,021,121,121,121,221,221,221", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), ",99,011,99,511,611,001", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), ",99,89,411,011,301,011,901,901,411,301,411,211", "حالة 8")
