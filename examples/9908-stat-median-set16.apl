# مثال 9908 — الوسيط (بعد الترتيب) (مجموعة 16)
# median (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9908-stat-median-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([-12, 18, 39, 21, 25, 11, 49, 26]), 23, "حالة 1")
تأكد_يساوي(ف([-11, 43, 47, -13, 46, 15, 52, 53]), 44, "حالة 2")
تأكد_يساوي(ف([35, 30, 31, 41, 7, 26, 7, 12, -16]), 26, "حالة 3")
تأكد_يساوي(ف([33, 15, 2, 43, 55, -3, 1, 10]), 12, "حالة 4")
