# مثال 8987 — حروف الكلمة مرتبة (مجموعة اختبار 18)
# sortchars (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8987-str-sortchars-set18.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("bob"), "bbo", "حالة 1")
تأكد_يساوي(ف("moon"), "mnoo", "حالة 2")
تأكد_يساوي(ف("mars"), "amrs", "حالة 3")
تأكد_يساوي(ف("refer"), "eefrr", "حالة 4")
تأكد_يساوي(ف("stats"), "asstt", "حالة 5")
