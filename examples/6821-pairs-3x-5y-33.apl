# مثال 6821 — عدد حلول 3س + 5ص = 33
# Count solutions of 3x+5y=33
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6821-pairs-3x-5y-33.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 3 * س + 5 * ص == 33:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 2, "حالة 3")
تأكد_يساوي(ف(33), 3, "حالة 4")
