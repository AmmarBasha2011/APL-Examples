# مثال 7917 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 2
# longest for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7917-sent1-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("to be or not to be"), "not", "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), "rose", "حالة 2")
تأكد_يساوي(ف("a b c a b a"), "a", "حالة 3")
