# مثال 9225 — الحرف الأوسط (مجموعة اختبار 16)
# midchar (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9225-str-midchar-set16.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("comet"), "m", "حالة 1")
تأكد_يساوي(ف("enlist"), "i", "حالة 2")
تأكد_يساوي(ف("galaxy"), "a", "حالة 3")
تأكد_يساوي(ف("star"), "a", "حالة 4")
تأكد_يساوي(ف("code"), "d", "حالة 5")
