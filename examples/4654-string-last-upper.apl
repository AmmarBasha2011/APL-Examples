# مثال 4654 — آخر موضع (حرف كبير) في نص
# String: last position of uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4654-string-last-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  ل = -1
  لكل خ في س:
    لو خ.isupper():
      ل = ر
    ر = ر + 1
  ارجع ل

تأكد_يساوي(ف("aeiou AEIOU xyz"), 10, "حالة 1")
تأكد_يساوي(ف("Hello World 42"), 6, "حالة 2")
تأكد_يساوي(ف("quick brown fox"), -1, "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), -1, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
