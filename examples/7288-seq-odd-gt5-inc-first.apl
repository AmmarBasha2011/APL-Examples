# مثال 7288 — أول عنصر: من الأعداد الفردية نأخذ الأكبر من 5 ثم (زيادة واحد)
# first over odd sequence, keep gt5, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7288-seq-odd-gt5-inc-first.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ > 5:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 8, "حالة 3")
تأكد_يساوي(ف(10), 8, "حالة 4")
تأكد_يساوي(ف(15), 8, "حالة 5")
