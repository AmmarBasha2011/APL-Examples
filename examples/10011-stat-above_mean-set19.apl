# مثال 10011 — عدد العناصر فوق المتوسط (مجموعة 19)
# above_mean (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10011-stat-above_mean-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-16, 48, 42]), 2, "حالة 1")
تأكد_يساوي(ف([14, 31, 6, -12, 36, 21, 35, 21]), 5, "حالة 2")
تأكد_يساوي(ف([21, -6, 29, -16, -20, 17, 0, 3, 39]), 4, "حالة 3")
تأكد_يساوي(ف([11, 20, 9, 52]), 1, "حالة 4")
