# مثال 4910 — جمع 11 ساعات على الساعة (نظام 12)
# Add 11 hours on 12h clock
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4910-clock-add-11.apl

# نستخدم باقي القسمة على 12
# والصفر نحوله إلى 12

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = (ح + 11) % 12
  لو ن == 0:
    ارجع 12
  ارجع ن

تأكد_يساوي(ف(1), 12, "حالة 1")
تأكد_يساوي(ف(5), 4, "حالة 2")
تأكد_يساوي(ف(10), 9, "حالة 3")
تأكد_يساوي(ف(12), 11, "حالة 4")
