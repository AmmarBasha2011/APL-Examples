# مثال 10305 — تحويل وحدة إلى 44 وحدات صغرى والعكس
# Convert units with factor 44
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10305-unit-scale-44.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 44, ن // 44, ن % 44]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [44, 0, 1], "حالة 2")
تأكد_يساوي(ف(44), [1936, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [44000, 22, 32], "حالة 4")
