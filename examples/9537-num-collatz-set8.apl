# مثال 9537 — خطوات كولاتز (مجموعة اختبار 8)
# collatz (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9537-num-collatz-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(92), 17, "حالة 1")
تأكد_يساوي(ف(148), 23, "حالة 2")
تأكد_يساوي(ف(12), 9, "حالة 3")
تأكد_يساوي(ف(91), 92, "حالة 4")
تأكد_يساوي(ف(108), 113, "حالة 5")
