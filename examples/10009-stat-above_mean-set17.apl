# مثال 10009 — عدد العناصر فوق المتوسط (مجموعة 17)
# above_mean (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10009-stat-above_mean-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([42, 14, 29, 53, 33, 14, 10, 47, 2]), 5, "حالة 1")
تأكد_يساوي(ف([34, 24, 42, -2, -7, -17, 28, -4, -15]), 4, "حالة 2")
تأكد_يساوي(ف([-2, 5, 1, -17, 7, 54, -17]), 3, "حالة 3")
تأكد_يساوي(ف([49, 39, -8]), 2, "حالة 4")
