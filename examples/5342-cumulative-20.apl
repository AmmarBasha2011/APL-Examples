# مثال 5342 — مجموع تراكمي مع زيادة 20
# Running total plus 20 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5342-cumulative-20.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 20
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [21, 43, 66], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [25, 50, 75, 100], "حالة 3")
