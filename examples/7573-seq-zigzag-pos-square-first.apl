# مثال 7573 — أول عنصر: من متناوبة الإشارة نأخذ الموجب ثم (مربع)
# first over zigzag sequence, keep pos, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7573-seq-zigzag-pos-square-first.apl

# نولّد أول ن حد من: متناوبة الإشارة
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (1 - 2 * (ي % 2))
    لو خ > 0:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 4, "حالة 3")
تأكد_يساوي(ف(10), 4, "حالة 4")
تأكد_يساوي(ف(15), 4, "حالة 5")
