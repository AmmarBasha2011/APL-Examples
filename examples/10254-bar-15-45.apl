# مثال 10254 — شريط بعرض 15 من الرمز -
# Bar of width 15 using -
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10254-bar-15-45.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "-"
  ارجع ر + "|" + str(15)

تأكد_يساوي(ف(0), "|15", "حالة 1")
تأكد_يساوي(ف(3), "---|15", "حالة 2")
تأكد_يساوي(ف(15), "---------------|15", "حالة 3")
