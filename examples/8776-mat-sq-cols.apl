# مثال 8776 — مجموع كل عمود لمصفوفة قيمها i*i+j
# Matrix cols for cell formula i*i+j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8776-mat-sq-cols.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي + ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل ك في range(len(ق)):
    م = 0
    لكل س في ق:
      م = م + س[ك]
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [1, 3], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [5, 8, 11], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [30, 35, 40, 45, 50], "حجم 5")
