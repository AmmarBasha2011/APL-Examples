# مثال 6639 — الأعداد التي باقيها 3 عند القسمة على 6
# Numbers with remainder 3 mod 6
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6639-residue-6-3.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 6 == 3:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [3, 9], "حالة 2")
تأكد_يساوي(ف(40), [3, 9, 15, 21, 27, 33, 39], "حالة 3")
تأكد_يساوي(ف(75), [3, 9, 15, 21, 27, 33, 39, 45, 51, 57, 63, 69], "حالة 4")
