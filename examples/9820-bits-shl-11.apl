# مثال 9820 — إزاحة لليسار 11 خانات
# Shift left by 11
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9820-bits-shl-11.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 11

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2048, "حالة 2")
تأكد_يساوي(ف(5), 10240, "حالة 3")
تأكد_يساوي(ف(100), 204800, "حالة 4")
