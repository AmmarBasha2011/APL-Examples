# مثال 7969 — أول كلمة تتكرر في الجملة رقم 7
# firstdup for sentence 7
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7969-sent6-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("tea for two and two for tea"), "two", "حالة 1")
تأكد_يساوي(ف("in the end the end is the start"), "the", "حالة 2")
تأكد_يساوي(ف("nile river nile delta river"), "nile", "حالة 3")
