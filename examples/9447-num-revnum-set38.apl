# مثال 9447 — عكس الأرقام (مجموعة اختبار 38)
# revnum (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9447-num-revnum-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(79028), 82097, "حالة 1")
تأكد_يساوي(ف(48731), 13784, "حالة 2")
تأكد_يساوي(ف(41249), 94214, "حالة 3")
تأكد_يساوي(ف(5282), 2825, "حالة 4")
تأكد_يساوي(ف(24429), 92442, "حالة 5")
