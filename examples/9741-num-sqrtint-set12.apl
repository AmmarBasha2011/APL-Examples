# مثال 9741 — الجذر التربيعي الصحيح (مجموعة اختبار 12)
# sqrtint (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9741-num-sqrtint-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2673), 51, "حالة 1")
تأكد_يساوي(ف(3268), 57, "حالة 2")
تأكد_يساوي(ف(1539), 39, "حالة 3")
تأكد_يساوي(ف(1863), 43, "حالة 4")
تأكد_يساوي(ف(2489), 49, "حالة 5")
