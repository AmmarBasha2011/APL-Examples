# مثال 8092 — تكرار كل كلمة في الجملة رقم 20
# freq for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8092-sent19-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("yes no yes yes no maybe"), {"yes": 3, "no": 2, "maybe": 1}, "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), {"apl": 1, "code": 2, "is": 2, "easy": 1, "fun": 1}, "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), {"tea": 2, "for": 2, "two": 2, "and": 1}, "حالة 3")
