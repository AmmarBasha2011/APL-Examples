# مثال 9766 — الجذر التربيعي الصحيح (مجموعة اختبار 37)
# sqrtint (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9766-num-sqrtint-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(531), 23, "حالة 1")
تأكد_يساوي(ف(3), 1, "حالة 2")
تأكد_يساوي(ف(4604), 67, "حالة 3")
تأكد_يساوي(ف(3616), 60, "حالة 4")
تأكد_يساوي(ف(2670), 51, "حالة 5")
