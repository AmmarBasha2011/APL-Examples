# مثال 9911 — الوسيط (بعد الترتيب) (مجموعة 19)
# median (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9911-stat-median-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([5, 22, -13, 19, 35]), 19, "حالة 1")
تأكد_يساوي(ف([25, 15, -3, 2, -9, 2, 41, 9]), 5, "حالة 2")
تأكد_يساوي(ف([-18, 3, 0, 54, 32]), 3, "حالة 3")
تأكد_يساوي(ف([44, 26, 38, 45, 25, 14, 51, -10, 6]), 26, "حالة 4")
