# مثال 10067 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 25)
# spread (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10067-stat-spread-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([34, -3, 10, 39, 54]), 24, "حالة 1")
تأكد_يساوي(ف([-15, -7, 60]), 67, "حالة 2")
تأكد_يساوي(ف([19, 59, 25, 12, -7, 32, 32, 29]), 27, "حالة 3")
تأكد_يساوي(ف([42, 56, 2]), 40, "حالة 4")
