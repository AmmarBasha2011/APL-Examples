# مثال 9980 — التباين الصحيح (مجموعة 13)
# variance (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9980-stat-variance-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([22, 52, 32, 50]), 157, "حالة 1")
تأكد_يساوي(ف([36, 8, 54, 5, 58, 47, 13, 38, 59]), 414, "حالة 2")
تأكد_يساوي(ف([29, 14, 58, 51, 59]), 315, "حالة 3")
تأكد_يساوي(ف([-1, 50, 49, 0, 58, 11, 60, 28, 28]), 517, "حالة 4")
