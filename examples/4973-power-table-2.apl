# مثال 4973 — قوى العدد 2 حتى 6
# Powers of 2 up to 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4973-power-table-2.apl

# نضرب في العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  ق = 1
  لكل ي في range(ن + 1):
    ر = ر + [ق]
    ق = ق * 2
  ارجع ر

تأكد_يساوي(ف(0), [1], "حالة 1")
تأكد_يساوي(ف(3), [1, 2, 4, 8], "حالة 2")
تأكد_يساوي(ف(6), [1, 2, 4, 8, 16, 32, 64], "حالة 3")
