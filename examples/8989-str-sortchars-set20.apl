# مثال 8989 — حروف الكلمة مرتبة (مجموعة اختبار 20)
# sortchars (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8989-str-sortchars-set20.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("rocket"), "cekort", "حالة 1")
تأكد_يساوي(ف("code"), "cdeo", "حالة 2")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 3")
تأكد_يساوي(ف("deed"), "ddee", "حالة 4")
تأكد_يساوي(ف("racecar"), "aaccerr", "حالة 5")
