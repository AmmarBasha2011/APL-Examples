# مثال 9626 — الأصفار في نهاية العاملي (مجموعة اختبار 17)
# tzeros (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9626-num-tzeros-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(264), 64, "حالة 1")
تأكد_يساوي(ف(373), 90, "حالة 2")
تأكد_يساوي(ف(181), 44, "حالة 3")
تأكد_يساوي(ف(212), 51, "حالة 4")
تأكد_يساوي(ف(153), 37, "حالة 5")
