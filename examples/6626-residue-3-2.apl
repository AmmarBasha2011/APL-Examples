# مثال 6626 — الأعداد التي باقيها 2 عند القسمة على 3
# Numbers with remainder 2 mod 3
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6626-residue-3-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 3 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2, 5, 8], "حالة 2")
تأكد_يساوي(ف(40), [2, 5, 8, 11, 14, 17, 20, 23, 26, 29, 32, 35, 38], "حالة 3")
تأكد_يساوي(ف(75), [2, 5, 8, 11, 14, 17, 20, 23, 26, 29, 32, 35, 38, 41, 44, 47, 50, 53, 56, 59, 62, 65, 68, 71, 74], "حالة 4")
