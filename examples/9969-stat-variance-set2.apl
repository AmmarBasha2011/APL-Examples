# مثال 9969 — التباين الصحيح (مجموعة 2)
# variance (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9969-stat-variance-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([13, 29, -17, 4]), 276, "حالة 1")
تأكد_يساوي(ف([30, 52, -20, 12]), 695, "حالة 2")
تأكد_يساوي(ف([25, 2, -17, 17, -11, 26, -19, -7]), 297, "حالة 3")
تأكد_يساوي(ف([24, 34, -8, 30, 45, 54]), 383, "حالة 4")
