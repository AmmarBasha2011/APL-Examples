# مثال 10331 — تحويل 36 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 36 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10331-temp-c-36.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 36) * 9 // 5 + 32

تأكد_يساوي(ف(0), 96, "حالة 1")
تأكد_يساوي(ف(10), 114, "حالة 2")
تأكد_يساوي(ف(37), 163, "حالة 3")
تأكد_يساوي(ف(-5), 87, "حالة 4")
