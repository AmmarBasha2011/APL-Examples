# مثال 10321 — تحويل 16 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 16 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10321-temp-c-16.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 16) * 9 // 5 + 32

تأكد_يساوي(ف(0), 60, "حالة 1")
تأكد_يساوي(ف(10), 78, "حالة 2")
تأكد_يساوي(ف(37), 127, "حالة 3")
تأكد_يساوي(ف(-5), 51, "حالة 4")
