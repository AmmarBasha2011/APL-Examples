# مثال 9568 — خطوات كولاتز (مجموعة اختبار 39)
# collatz (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9568-num-collatz-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(164), 111, "حالة 1")
تأكد_يساوي(ف(73), 115, "حالة 2")
تأكد_يساوي(ف(161), 98, "حالة 3")
تأكد_يساوي(ف(91), 92, "حالة 4")
تأكد_يساوي(ف(62), 107, "حالة 5")
