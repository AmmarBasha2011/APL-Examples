# مثال 9720 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 31)
# popcnt (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9720-num-popcnt-set31.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(413), 6, "حالة 1")
تأكد_يساوي(ف(2293), 7, "حالة 2")
تأكد_يساوي(ف(2137), 5, "حالة 3")
تأكد_يساوي(ف(4556), 6, "حالة 4")
تأكد_يساوي(ف(1172), 4, "حالة 5")
