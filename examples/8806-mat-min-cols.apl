# مثال 8806 — مجموع كل عمود لمصفوفة قيمها min(i,j)
# Matrix cols for cell formula min(i,j)
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8806-mat-min-cols.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [min(ي, ك)]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل ك في range(len(ق)):
    م = 0
    لكل س في ق:
      م = م + س[ك]
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [0, 1], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [0, 2, 3], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [0, 4, 7, 9, 10], "حجم 5")
