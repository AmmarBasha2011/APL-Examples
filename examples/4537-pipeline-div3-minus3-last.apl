# مثال 4537 — آخر نتيجة ناقص 3 للأعداد التقبل القسمة على 3
# Last (or -1) of minus 3 over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4537-pipeline-div3-minus3-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 0, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), -3, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 0, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 0, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
