# مثال 8671 — أول عنصر من المدى 2 إلى 26 بخطوة 3 بعد (نصف صحيح)
# first over range(2,26,3) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8671-range-2-26-3-half-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [خ // 2]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 1, "المدى كله")
