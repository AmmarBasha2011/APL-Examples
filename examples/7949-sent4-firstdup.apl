# مثال 7949 — أول كلمة تتكرر في الجملة رقم 5
# firstdup for sentence 5
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7949-sent4-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("a rose is a rose is a rose"), "a", "حالة 1")
تأكد_يساوي(ف("run run run fast fast slow"), "run", "حالة 2")
تأكد_يساوي(ف("up down up down up up down"), "up", "حالة 3")
