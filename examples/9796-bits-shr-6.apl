# مثال 9796 — إزاحة لليمين 6 خانات
# Shift right by 6
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9796-bits-shr-6.apl

# الإزاحة لليمين تقسم وتقتطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 6

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(4096), 64, "حالة 3")
تأكد_يساوي(ف(100000), 1562, "حالة 4")
