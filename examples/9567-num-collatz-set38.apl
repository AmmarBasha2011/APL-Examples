# مثال 9567 — خطوات كولاتز (مجموعة اختبار 38)
# collatz (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9567-num-collatz-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(29), 18, "حالة 1")
تأكد_يساوي(ف(131), 28, "حالة 2")
تأكد_يساوي(ف(186), 18, "حالة 3")
تأكد_يساوي(ف(190), 106, "حالة 4")
تأكد_يساوي(ف(81), 22, "حالة 5")
