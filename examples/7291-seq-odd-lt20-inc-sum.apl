# مثال 7291 — المجموع: من الأعداد الفردية نأخذ الأصغر من 20 ثم (زيادة واحد)
# sum over odd sequence, keep lt20, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7291-seq-odd-lt20-inc-sum.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ < 20:
      ر = ر + [خ + 1]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 30, "حالة 3")
تأكد_يساوي(ف(10), 110, "حالة 4")
تأكد_يساوي(ف(15), 110, "حالة 5")
