# مثال 9182 — عكس حالة الأحرف (مجموعة اختبار 13)
# swapcase (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9182-str-swapcase-set13.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("star"), "STAR", "حالة 1")
تأكد_يساوي(ف("venus"), "VENUS", "حالة 2")
تأكد_يساوي(ف("pluto"), "PLUTO", "حالة 3")
تأكد_يساوي(ف("saturn"), "SATURN", "حالة 4")
تأكد_يساوي(ف("listen"), "LISTEN", "حالة 5")
