# مثال 9722 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 33)
# popcnt (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9722-num-popcnt-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(3161), 6, "حالة 1")
تأكد_يساوي(ف(2393), 6, "حالة 2")
تأكد_يساوي(ف(50), 3, "حالة 3")
تأكد_يساوي(ف(2622), 7, "حالة 4")
تأكد_يساوي(ف(4127), 6, "حالة 5")
