# مثال 6666 — الأعداد التي باقيها 6 عند القسمة على 11
# Numbers with remainder 6 mod 11
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6666-residue-11-6.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 11 == 6:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [6], "حالة 2")
تأكد_يساوي(ف(40), [6, 17, 28, 39], "حالة 3")
تأكد_يساوي(ف(75), [6, 17, 28, 39, 50, 61, 72], "حالة 4")
