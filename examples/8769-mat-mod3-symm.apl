# مثال 8769 — هل المصفوفة متماثلة لمصفوفة قيمها (i*2+j) % 3
# Matrix symm for cell formula (i*2+j) % 3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8769-mat-mod3-symm.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [(ي * 2 + ك) % 3]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  لكل ي في range(len(ق)):
    لكل ك في range(len(ق)):
      لو ق[ي][ك] != ق[ك][ي]:
        ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(بناء(1)), صواب, "حجم 1")
تأكد_يساوي(ف(بناء(2)), خطأ, "حجم 2")
تأكد_يساوي(ف(بناء(3)), خطأ, "حجم 3")
تأكد_يساوي(ف(بناء(5)), خطأ, "حجم 5")
