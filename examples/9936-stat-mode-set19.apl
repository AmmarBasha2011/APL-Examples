# مثال 9936 — المنوال (الأصغر عند التساوي) (مجموعة 19)
# mode (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9936-stat-mode-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([27, -5, -13, 5, -6, 28, 3, 25]), -13, "حالة 1")
تأكد_يساوي(ف([37, -13, 38, 43, 32, 59]), -13, "حالة 2")
تأكد_يساوي(ف([33, 18, -19]), -19, "حالة 3")
تأكد_يساوي(ف([51, -9, 59, -20, -14, 11]), -20, "حالة 4")
