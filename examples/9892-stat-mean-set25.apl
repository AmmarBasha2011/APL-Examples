# مثال 9892 — المتوسط الصحيح (مجموعة 25)
# mean (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9892-stat-mean-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([3, 21, 19]), 14, "حالة 1")
تأكد_يساوي(ف([29, -15, 22, 36, 22, 32, 51, 54, -19]), 23, "حالة 2")
تأكد_يساوي(ف([40, -5, -14, 60, -17, 55, -15, 6]), 13, "حالة 3")
تأكد_يساوي(ف([21, 44, 25, -10, 30, 30, 58, 24]), 27, "حالة 4")
