# مثال 5111 — سعر متدرج بحد 5
# Tiered price with cutoff 5
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5111-tier-price-5.apl

# أول 5 وحدات بسعر 3 والباقي بسعر 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن <= 5:
    ارجع ن * 3
  ارجع 5 * 3 + (ن - 5) * 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 3, "حالة 2")
تأكد_يساوي(ف(5), 15, "حالة 3")
تأكد_يساوي(ف(10), 25, "حالة 4")
تأكد_يساوي(ف(15), 35, "حالة 5")
