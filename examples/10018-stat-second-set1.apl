# مثال 10018 — ثاني أكبر قيمة مختلفة (مجموعة 1)
# second (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10018-stat-second-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([53, -10, 42, 13, -16, -20, -2, 55, 40]), 53, "حالة 1")
تأكد_يساوي(ف([27, 20, -18, 14, 42, 5, 32, 48, 49]), 48, "حالة 2")
تأكد_يساوي(ف([-8, 4, 52, 50, 13, 58, -9, 34]), 52, "حالة 3")
تأكد_يساوي(ف([-9, 26, 32, 12, 36]), 32, "حالة 4")
