# مثال 7072 — آخر عنصر: من المربعات نأخذ الموجب ثم (سالب)
# last over squares sequence, keep pos, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7072-seq-squares-pos-neg-last.apl

# نولّد أول ن حد من: المربعات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي
    لو خ > 0:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -16, "حالة 3")
تأكد_يساوي(ف(10), -81, "حالة 4")
تأكد_يساوي(ف(15), -196, "حالة 5")
