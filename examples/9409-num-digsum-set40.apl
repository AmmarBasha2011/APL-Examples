# مثال 9409 — مجموع الأرقام (مجموعة اختبار 40)
# digsum (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9409-num-digsum-set40.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(2157), 15, "حالة 1")
تأكد_يساوي(ف(26866), 28, "حالة 2")
تأكد_يساوي(ف(17271), 18, "حالة 3")
تأكد_يساوي(ف(80977), 31, "حالة 4")
تأكد_يساوي(ف(23779), 28, "حالة 5")
