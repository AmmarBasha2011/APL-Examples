# مثال 7532 — المجموع: من متناوبة الإشارة نأخذ الأصغر من 20 ثم (سالب)
# sum over zigzag sequence, keep lt20, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7532-seq-zigzag-lt20-neg-sum.apl

# نولّد أول ن حد من: متناوبة الإشارة
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (1 - 2 * (ي % 2))
    لو خ < 20:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -2, "حالة 3")
تأكد_يساوي(ف(10), 5, "حالة 4")
تأكد_يساوي(ف(15), -7, "حالة 5")
