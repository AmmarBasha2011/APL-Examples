# مثال 5104 — اقتطاع النص إلى 4 حروف مع نقاط
# Truncate to 4 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5104-truncate-4.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 4:
    ارجع ن
  ارجع ن[:4] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hell...", "حالة 2")
تأكد_يساوي(ف("xxxx"), "xxxx", "حالة 3")
تأكد_يساوي(ف("yyyyy"), "yyyy...", "حالة 4")
