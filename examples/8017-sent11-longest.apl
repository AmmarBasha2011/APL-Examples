# مثال 8017 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 12
# longest for sentence 12
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8017-sent11-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("up down up down up up down"), "down", "حالة 1")
تأكد_يساوي(ف("learn code learn more code more"), "learn", "حالة 2")
تأكد_يساوي(ف("left right left left right"), "right", "حالة 3")
