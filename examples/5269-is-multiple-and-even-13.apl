# مثال 5269 — قابل للقسمة على 13 وزوجي؟
# Divisible by 13 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5269-is-multiple-and-even-13.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 13 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(13), خطأ, "حالة 2")
تأكد_يساوي(ف(26), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(52), صواب, "حالة 5")
