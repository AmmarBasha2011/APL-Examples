# مثال 9240 — الحرف الأوسط (مجموعة اختبار 31)
# midchar (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9240-str-midchar-set31.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("silent"), "e", "حالة 1")
تأكد_يساوي(ف("bob"), "o", "حالة 2")
تأكد_يساوي(ف("array"), "r", "حالة 3")
تأكد_يساوي(ف("racecar"), "e", "حالة 4")
تأكد_يساوي(ف("civic"), "v", "حالة 5")
