# مثال 4909 — اليوم بعد 10 أيام
# Weekday 10 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4909-week-day-shift-10.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 10) % 7

تأكد_يساوي(ف(0), 3, "حالة 1")
تأكد_يساوي(ف(3), 6, "حالة 2")
تأكد_يساوي(ف(6), 2, "حالة 3")
تأكد_يساوي(ف(4), 0, "حالة 4")
