# مثال 5272 — مجموع تراكمي مع زيادة 13
# Running total plus 13 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5272-cumulative-13.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 13
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [14, 29, 45], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [18, 36, 54, 72], "حالة 3")
