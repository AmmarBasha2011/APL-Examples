# مثال 4821 — إجمالي مع ضريبة 3%
# Total with 3 percent tax
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4821-tax-3.apl

# الإجمالي = السعر + الضريبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س + س * 3 // 100

تأكد_يساوي(ف(100), 103, "حالة 1")
تأكد_يساوي(ف(200), 206, "حالة 2")
تأكد_يساوي(ف(1500), 1545, "حالة 3")
تأكد_يساوي(ف(80), 82, "حالة 4")
