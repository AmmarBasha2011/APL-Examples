# مثال 5220 — أقرب مضاعف للعدد 8
# Nearest multiple of 8
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5220-nearest-multiple-8.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 8
  لو ب * 2 < 8:
    ارجع ن - ب
  ارجع ن - ب + 8

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 8, "حالة 2")
تأكد_يساوي(ف(13), 16, "حالة 3")
تأكد_يساوي(ف(100), 104, "حالة 4")
تأكد_يساوي(ف(9), 8, "حالة 5")
