# مثال 8059 — أول كلمة تتكرر في الجملة رقم 16
# firstdup for sentence 16
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8059-sent15-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("stars and moon and stars again"), "and", "حالة 1")
تأكد_يساوي(ف("left right left left right"), "left", "حالة 2")
تأكد_يساوي(ف("apl code is easy code is fun"), "code", "حالة 3")
