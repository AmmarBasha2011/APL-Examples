# مثال 9993 — عدد العناصر فوق المتوسط (مجموعة 1)
# above_mean (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9993-stat-above_mean-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-16, 34, 41, 53, -19, 6, 39]), 4, "حالة 1")
تأكد_يساوي(ف([42, 15, 0, -16, 46, 42, 21, -11, 11]), 4, "حالة 2")
تأكد_يساوي(ف([26, -15, 33, -3, 57, 25, 28, 33]), 6, "حالة 3")
تأكد_يساوي(ف([13, 38, 2, 18, 26]), 2, "حالة 4")
