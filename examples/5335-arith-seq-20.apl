# مثال 5335 — الحد ن في متتالية حسابية فرقها 20
# Nth term of arithmetic sequence, step 20
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5335-arith-seq-20.apl

# الحد = الأول + (ن-1) × الفرق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ارجع أ + (ن - 1) * 20

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 10), 181, "حالة 2")
تأكد_يساوي(ف(5, 7), 125, "حالة 3")
تأكد_يساوي(ف(-3, 4), 57, "حالة 4")
