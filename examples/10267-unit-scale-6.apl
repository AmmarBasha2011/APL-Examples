# مثال 10267 — تحويل وحدة إلى 6 وحدات صغرى والعكس
# Convert units with factor 6
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10267-unit-scale-6.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 6, ن // 6, ن % 6]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [6, 0, 1], "حالة 2")
تأكد_يساوي(ف(6), [36, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [6000, 166, 4], "حالة 4")
