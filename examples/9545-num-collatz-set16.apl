# مثال 9545 — خطوات كولاتز (مجموعة اختبار 16)
# collatz (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9545-num-collatz-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(196), 26, "حالة 1")
تأكد_يساوي(ف(99), 25, "حالة 2")
تأكد_يساوي(ف(166), 111, "حالة 3")
تأكد_يساوي(ف(121), 95, "حالة 4")
تأكد_يساوي(ف(105), 38, "حالة 5")
