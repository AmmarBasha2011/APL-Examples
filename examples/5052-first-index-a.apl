# مثال 5052 — موضع أول ظهور للحرف a
# Index of first a
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5052-first-index-a.apl

# نرجع -1 إن لم يوجد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لكل ي في range(len(ن)):
    لو ن[ي] == "a":
      ارجع ي
  ارجع -1

تأكد_يساوي(ف("banana"), 1, "حالة 1")
تأكد_يساوي(ف("education"), 4, "حالة 2")
تأكد_يساوي(ف(""), -1, "حالة 3")
تأكد_يساوي(ف("sky"), -1, "حالة 4")
