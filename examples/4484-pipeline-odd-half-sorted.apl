# مثال 4484 — ترتيب نتيجة نصفها بالقسمة الصحيحة للأعداد الفردية
# Sorted list of integer half over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4484-pipeline-odd-half-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ // 2]
  ارجع sorted(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [0, 0, 1, 2, 6], "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [3, 10, 17], "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), [4], "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), [0, 1, 2], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
