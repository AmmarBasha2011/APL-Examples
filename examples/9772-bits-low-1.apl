# مثال 9772 — آخر 1 خانات ثنائية
# Low 1 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9772-bits-low-1.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 1

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 1, "حالة 2")
تأكد_يساوي(ف(1000), 0, "حالة 3")
تأكد_يساوي(ف(12345), 1, "حالة 4")
