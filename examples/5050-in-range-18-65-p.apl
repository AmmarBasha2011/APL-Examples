# مثال 5050 — هل القيمة داخل المدى [18, 65]؟
# Is value in range [18,65]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5050-in-range-18-65-p.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= 18 و ن <= 65

تأكد_يساوي(ف(18), صواب, "حالة 1")
تأكد_يساوي(ف(65), صواب, "حالة 2")
تأكد_يساوي(ف(17), خطأ, "حالة 3")
تأكد_يساوي(ف(66), خطأ, "حالة 4")
تأكد_يساوي(ف(41), صواب, "حالة 5")
