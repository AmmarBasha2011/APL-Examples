# مثال 9933 — المنوال (الأصغر عند التساوي) (مجموعة 16)
# mode (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9933-stat-mode-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([18, 12, 33, 28, -13]), -13, "حالة 1")
تأكد_يساوي(ف([12, -15, 7]), -15, "حالة 2")
تأكد_يساوي(ف([46, 10, -7, -14, -19, 4, 24, 51]), -19, "حالة 3")
تأكد_يساوي(ف([31, 60, 36, 34, 20, 26, 15, 44]), 15, "حالة 4")
