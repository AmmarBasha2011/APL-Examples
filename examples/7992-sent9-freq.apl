# مثال 7992 — تكرار كل كلمة في الجملة رقم 10
# freq for sentence 10
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7992-sent9-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("in the end the end is the start"), {"in": 1, "the": 3, "end": 2, "is": 1, "start": 1}, "حالة 1")
تأكد_يساوي(ف("cairo is big and cairo is old"), {"cairo": 2, "is": 2, "big": 1, "and": 1, "old": 1}, "حالة 2")
تأكد_يساوي(ف("sun sand sea sun sand sun"), {"sun": 3, "sand": 2, "sea": 1}, "حالة 3")
