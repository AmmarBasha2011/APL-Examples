# مثال 10119 — قص كل عنصر عند 13
# Clip every item at 13
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10119-clip-list-13.apl

# نأخذ الأصغر بين العنصر والحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [min(خ, 13)]
  ارجع ر

تأكد_يساوي(ف([0, 5, 10, 15, 20, 25, 30, 35]), [0, 5, 10, 13, 13, 13, 13, 13], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([13, 14, 12]), [13, 13, 12], "حالة 3")
