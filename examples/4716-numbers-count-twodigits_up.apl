# مثال 4716 — عدد الأعداد الأرقامه تصاعدية حتى حد معين
# Numbers up to a limit: how many the digits strictly increasing ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4716-numbers-count-twodigits_up.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو list(str(ر)) == sorted(set(str(ر))):
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(14), 12, "حالة 1")
تأكد_يساوي(ف(43), 30, "حالة 2")
تأكد_يساوي(ف(140), 58, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
