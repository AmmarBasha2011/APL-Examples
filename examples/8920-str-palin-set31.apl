# مثال 8920 — هل الكلمة متناظرة (مجموعة اختبار 31)
# palin (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8920-str-palin-set31.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("noon"), صواب, "حالة 1")
تأكد_يساوي(ف("loop"), خطأ, "حالة 2")
تأكد_يساوي(ف("python"), خطأ, "حالة 3")
تأكد_يساوي(ف("silent"), خطأ, "حالة 4")
تأكد_يساوي(ف("bob"), صواب, "حالة 5")
