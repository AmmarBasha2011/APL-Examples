# مثال 8591 — أصغر قيمة من المدى 7 إلى 70 بخطوة 7 بعد (مربع)
# min over range(7,70,7) mapped by square
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8591-range-7-70-7-square-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ * خ]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 49, "المدى كله")
