# مثال 9823 — قلب الخانة رقم 11
# Flip bit 11
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9823-bits-flip-11.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 11)

تأكد_يساوي(ف(0), 2048, "حالة 1")
تأكد_يساوي(ف(255), 2303, "حالة 2")
تأكد_يساوي(ف(1000), 3048, "حالة 3")
تأكد_يساوي(ف(12345), 14393, "حالة 4")
