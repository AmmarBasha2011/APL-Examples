# مثال 9762 — الجذر التربيعي الصحيح (مجموعة اختبار 33)
# sqrtint (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9762-num-sqrtint-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2646), 51, "حالة 1")
تأكد_يساوي(ف(1339), 36, "حالة 2")
تأكد_يساوي(ف(4425), 66, "حالة 3")
تأكد_يساوي(ف(4675), 68, "حالة 4")
تأكد_يساوي(ف(4217), 64, "حالة 5")
