# مثال 6937 — العدد: من متتالية حسابية بخطوة 3 نأخذ الفردي ثم (مربع)
# count over arith3 sequence, keep odd, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/6937-seq-arith3-odd-square-count.apl

# نولّد أول ن حد من: متتالية حسابية بخطوة 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 1 + ي * 3
    لو خ % 2 == 1:
      ر = ر + [خ * خ]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 3, "حالة 3")
تأكد_يساوي(ف(10), 5, "حالة 4")
تأكد_يساوي(ف(15), 8, "حالة 5")
