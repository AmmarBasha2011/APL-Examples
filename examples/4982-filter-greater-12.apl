# مثال 4982 — العناصر الأكبر من 12
# Items greater than 12
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4982-filter-greater-12.apl

# نبني قائمة جديدة بالشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    لو خ > 12:
      ر = ر + [خ]
  ارجع ر

تأكد_يساوي(ف([0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39]), [15, 18, 21, 24, 27, 30, 33, 36, 39], "حالة 1")
تأكد_يساوي(ف([1, 2]), [], "حالة 2")
تأكد_يساوي(ف([100, 5, 50]), [100, 50], "حالة 3")
