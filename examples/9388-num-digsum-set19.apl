# مثال 9388 — مجموع الأرقام (مجموعة اختبار 19)
# digsum (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9388-num-digsum-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(80793), 27, "حالة 1")
تأكد_يساوي(ف(7688), 29, "حالة 2")
تأكد_يساوي(ف(4853), 20, "حالة 3")
تأكد_يساوي(ف(41404), 13, "حالة 4")
تأكد_يساوي(ف(19013), 14, "حالة 5")
