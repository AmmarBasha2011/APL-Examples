# مثال 6826 — عدد حلول 4س + 3ص = 11
# Count solutions of 4x+3y=11
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6826-pairs-4x-3y-11.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 4 * س + 3 * ص == 11:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 1, "حالة 2")
تأكد_يساوي(ف(10), 1, "حالة 3")
تأكد_يساوي(ف(11), 1, "حالة 4")
