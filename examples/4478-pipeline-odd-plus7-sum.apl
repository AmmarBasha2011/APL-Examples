# مثال 4478 — مجموع نتيجة زائد 7 للأعداد الفردية
# Sum of plus 7 over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4478-pipeline-odd-plus7-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ + 7]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 34, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 52, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 84, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 16, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
