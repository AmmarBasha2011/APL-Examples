# مثال 9440 — عكس الأرقام (مجموعة اختبار 31)
# revnum (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9440-num-revnum-set31.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(6615), 5166, "حالة 1")
تأكد_يساوي(ف(36694), 49663, "حالة 2")
تأكد_يساوي(ف(85915), 51958, "حالة 3")
تأكد_يساوي(ف(34200), 243, "حالة 4")
تأكد_يساوي(ف(72904), 40927, "حالة 5")
