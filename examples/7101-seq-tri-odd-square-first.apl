# مثال 7101 — أول عنصر: من الأعداد المثلثية نأخذ الفردي ثم (مربع)
# first over tri sequence, keep odd, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7101-seq-tri-odd-square-first.apl

# نولّد أول ن حد من: الأعداد المثلثية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (ي + 1) // 2
    لو خ % 2 == 1:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 1, "حالة 3")
تأكد_يساوي(ف(10), 1, "حالة 4")
تأكد_يساوي(ف(15), 1, "حالة 5")
