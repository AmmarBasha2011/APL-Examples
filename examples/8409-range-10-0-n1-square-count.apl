# مثال 8409 — العدد من المدى 10 إلى 0 بخطوة -1 بعد (مربع)
# count over range(10,0,-1) mapped by square
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8409-range-10-0-n1-square-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 10
  طالما خ > 0:
    ر = ر + [خ * خ]
    خ = خ + (-1)
  ارجع len(ر)

تأكد_يساوي(ف(), 10, "المدى كله")
