# مثال 10040 — ثاني أكبر قيمة مختلفة (مجموعة 23)
# second (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10040-stat-second-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([14, 21, 30, 11, 45, -1, 12, 4, -11]), 30, "حالة 1")
تأكد_يساوي(ف([38, -5, -4]), -4, "حالة 2")
تأكد_يساوي(ف([44, 39, 19, 43, 38, 24]), 43, "حالة 3")
تأكد_يساوي(ف([20, 13, 1, -12, 42, 47, 50]), 47, "حالة 4")
