# مثال 6745 — القوة بالباقي على 36
# Modular power mod 36
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6745-modpow-36.apl

# نضرب ونأخذ الباقي في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ب, أ):
  ر = 1
  لكل ي في range(أ):
    ر = ر * ب % 36
  ارجع ر

تأكد_يساوي(ف(2, 0), 1, "حالة 1")
تأكد_يساوي(ف(2, 10), 16, "حالة 2")
تأكد_يساوي(ف(3, 7), 27, "حالة 3")
تأكد_يساوي(ف(7, 13), 7, "حالة 4")
تأكد_يساوي(ف(10, 20), 28, "حالة 5")
