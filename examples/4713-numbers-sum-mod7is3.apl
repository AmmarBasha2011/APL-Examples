# مثال 4713 — مجموع الأعداد الباقي قسمته على 7 يساوي 3 حتى حد معين
# Numbers up to a limit: sum of the remainder 3 mod 7 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4713-numbers-sum-mod7is3.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 7 == 3:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(19), 30, "حالة 1")
تأكد_يساوي(ف(33), 85, "حالة 2")
تأكد_يساوي(ف(133), 1254, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
