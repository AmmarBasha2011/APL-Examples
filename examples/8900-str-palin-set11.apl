# مثال 8900 — هل الكلمة متناظرة (مجموعة اختبار 11)
# palin (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8900-str-palin-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("orbit"), خطأ, "حالة 1")
تأكد_يساوي(ف("planet"), خطأ, "حالة 2")
تأكد_يساوي(ف("galaxy"), خطأ, "حالة 3")
تأكد_يساوي(ف("noon"), صواب, "حالة 4")
تأكد_يساوي(ف("mars"), خطأ, "حالة 5")
