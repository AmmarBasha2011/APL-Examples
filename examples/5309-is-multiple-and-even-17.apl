# مثال 5309 — قابل للقسمة على 17 وزوجي؟
# Divisible by 17 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5309-is-multiple-and-even-17.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 17 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(17), خطأ, "حالة 2")
تأكد_يساوي(ف(34), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(68), صواب, "حالة 5")
