# مثال 9087 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 38)
# dedupe (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9087-str-dedupe-set38.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("moon"), "mon", "حالة 1")
تأكد_يساوي(ف("comet"), "comet", "حالة 2")
تأكد_يساوي(ف("google"), "gole", "حالة 3")
تأكد_يساوي(ف("venus"), "venus", "حالة 4")
تأكد_يساوي(ف("rotor"), "rot", "حالة 5")
