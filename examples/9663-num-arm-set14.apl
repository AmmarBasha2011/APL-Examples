# مثال 9663 — هل العدد أرمسترونغ (مجموعة اختبار 14)
# arm (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9663-num-arm-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(361), خطأ, "حالة 1")
تأكد_يساوي(ف(199), خطأ, "حالة 2")
تأكد_يساوي(ف(220), خطأ, "حالة 3")
تأكد_يساوي(ف(307), خطأ, "حالة 4")
تأكد_يساوي(ف(869), خطأ, "حالة 5")
