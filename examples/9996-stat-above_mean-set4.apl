# مثال 9996 — عدد العناصر فوق المتوسط (مجموعة 4)
# above_mean (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9996-stat-above_mean-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([38, 7, -11, 57, -5, 28, 39, 23]), 5, "حالة 1")
تأكد_يساوي(ف([-5, 42, -10, -4, 8, 54, -17, -15, 8]), 4, "حالة 2")
تأكد_يساوي(ف([-4, 57, 46]), 2, "حالة 3")
تأكد_يساوي(ف([3, 32, 54, 33, 9]), 3, "حالة 4")
