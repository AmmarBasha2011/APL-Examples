# مثال 9620 — الأصفار في نهاية العاملي (مجموعة اختبار 11)
# tzeros (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9620-num-tzeros-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(294), 71, "حالة 1")
تأكد_يساوي(ف(219), 52, "حالة 2")
تأكد_يساوي(ف(270), 66, "حالة 3")
تأكد_يساوي(ف(31), 7, "حالة 4")
تأكد_يساوي(ف(221), 53, "حالة 5")
