# مثال 10007 — عدد العناصر فوق المتوسط (مجموعة 15)
# above_mean (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10007-stat-above_mean-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([16, -19, 19, 42, 15]), 4, "حالة 1")
تأكد_يساوي(ف([18, 45, 36, 49, 19, 43, -11, 32, 54]), 6, "حالة 2")
تأكد_يساوي(ف([59, 43, -20, -5]), 2, "حالة 3")
تأكد_يساوي(ف([-5, 52, -18]), 1, "حالة 4")
