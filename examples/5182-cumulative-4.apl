# مثال 5182 — مجموع تراكمي مع زيادة 4
# Running total plus 4 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5182-cumulative-4.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 4
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [5, 11, 18], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [9, 18, 27, 36], "حالة 3")
