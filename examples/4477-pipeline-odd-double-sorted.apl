# مثال 4477 — ترتيب نتيجة ضعفها للأعداد الفردية
# Sorted list of double over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4477-pipeline-odd-double-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ * 2]
  ارجع sorted(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [-10, 50], "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), [2, 6, 10], "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [2, 2, 6, 10, 26], "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [-18, 10, 34], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
