# مثال 9461 — عدد القواسم (مجموعة اختبار 12)
# ndiv (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9461-num-ndiv-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(77), 4, "حالة 1")
تأكد_يساوي(ف(202), 4, "حالة 2")
تأكد_يساوي(ف(226), 4, "حالة 3")
تأكد_يساوي(ف(230), 8, "حالة 4")
تأكد_يساوي(ف(94), 4, "حالة 5")
