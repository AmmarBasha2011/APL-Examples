# مثال 9802 — آخر 7 خانات ثنائية
# Low 7 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9802-bits-low-7.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 127

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 127, "حالة 2")
تأكد_يساوي(ف(1000), 104, "حالة 3")
تأكد_يساوي(ف(12345), 57, "حالة 4")
