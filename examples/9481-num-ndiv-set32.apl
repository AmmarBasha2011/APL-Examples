# مثال 9481 — عدد القواسم (مجموعة اختبار 32)
# ndiv (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9481-num-ndiv-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(54), 8, "حالة 1")
تأكد_يساوي(ف(147), 6, "حالة 2")
تأكد_يساوي(ف(278), 4, "حالة 3")
تأكد_يساوي(ف(208), 10, "حالة 4")
تأكد_يساوي(ف(188), 6, "حالة 5")
