# مثال 9901 — الوسيط (بعد الترتيب) (مجموعة 9)
# median (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9901-stat-median-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([44, 12, 32, 23, 7]), 23, "حالة 1")
تأكد_يساوي(ف([44, 21, 41]), 41, "حالة 2")
تأكد_يساوي(ف([54, 2, 37, -18, -12, 7, 11, 58]), 9, "حالة 3")
تأكد_يساوي(ف([17, -5, 23, 47, -16, -20, 29, -7]), 6, "حالة 4")
