# مثال 8916 — هل الكلمة متناظرة (مجموعة اختبار 27)
# palin (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8916-str-palin-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("deed"), صواب, "حالة 1")
تأكد_يساوي(ف("comet"), خطأ, "حالة 2")
تأكد_يساوي(ف("data"), خطأ, "حالة 3")
تأكد_يساوي(ف("apple"), خطأ, "حالة 4")
تأكد_يساوي(ف("saturn"), خطأ, "حالة 5")
