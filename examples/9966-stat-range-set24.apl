# مثال 9966 — المدى (مجموعة 24)
# range (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9966-stat-range-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([60, 8, 41, 35, -4]), 64, "حالة 1")
تأكد_يساوي(ف([32, 49, 16, 40, 49, 27]), 33, "حالة 2")
تأكد_يساوي(ف([56, 38, 45, 32, -20, 8, -17, 27]), 76, "حالة 3")
تأكد_يساوي(ف([-6, 26, 10, 60, -15, -19, 35]), 79, "حالة 4")
