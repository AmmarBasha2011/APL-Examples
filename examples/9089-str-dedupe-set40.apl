# مثال 9089 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 40)
# dedupe (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9089-str-dedupe-set40.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("star"), "star", "حالة 1")
تأكد_يساوي(ف("deed"), "de", "حالة 2")
تأكد_يساوي(ف("banana"), "ban", "حالة 3")
تأكد_يساوي(ف("rocket"), "rocket", "حالة 4")
تأكد_يساوي(ف("array"), "ary", "حالة 5")
