# مثال 4731 — قائمة الأعداد القوة للعدد 2 حتى حد معين
# Numbers up to a limit: list of the power of two ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4731-numbers-list-power2.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر > 0 و (ر & (ر - 1)) == 0:
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(14), [1, 2, 4, 8], "حالة 1")
تأكد_يساوي(ف(70), [1, 2, 4, 8, 16, 32, 64], "حالة 2")
تأكد_يساوي(ف(116), [1, 2, 4, 8, 16, 32, 64], "حالة 3")
تأكد_يساوي(ف(1), [1], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
