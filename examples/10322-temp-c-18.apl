# مثال 10322 — تحويل 18 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 18 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10322-temp-c-18.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 18) * 9 // 5 + 32

تأكد_يساوي(ف(0), 64, "حالة 1")
تأكد_يساوي(ف(10), 82, "حالة 2")
تأكد_يساوي(ف(37), 131, "حالة 3")
تأكد_يساوي(ف(-5), 55, "حالة 4")
