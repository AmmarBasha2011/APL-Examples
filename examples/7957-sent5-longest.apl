# مثال 7957 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 6
# longest for sentence 6
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7957-sent5-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("we love data and data loves us"), "loves", "حالة 1")
تأكد_يساوي(ف("a b c a b a"), "a", "حالة 2")
تأكد_يساوي(ف("cairo is big and cairo is old"), "cairo", "حالة 3")
