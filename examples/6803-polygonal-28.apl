# مثال 6803 — العدد المضلّع ذو 28 أضلاع
# 28-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6803-polygonal-28.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((28 - 2) * ن * ن - (28 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 28, "حالة 2")
تأكد_يساوي(ف(5), 265, "حالة 3")
تأكد_يساوي(ف(10), 1180, "حالة 4")
