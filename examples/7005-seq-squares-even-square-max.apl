# مثال 7005 — أكبر قيمة: من المربعات نأخذ الزوجي ثم (مربع)
# max over squares sequence, keep even, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7005-seq-squares-even-square-max.apl

# نولّد أول ن حد من: المربعات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي
    لو خ % 2 == 0:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 256, "حالة 3")
تأكد_يساوي(ف(10), 4096, "حالة 4")
تأكد_يساوي(ف(15), 38416, "حالة 5")
