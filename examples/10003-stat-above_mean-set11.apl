# مثال 10003 — عدد العناصر فوق المتوسط (مجموعة 11)
# above_mean (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10003-stat-above_mean-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([45, 60, -9, 36, 49, 21]), 4, "حالة 1")
تأكد_يساوي(ف([33, 14, -9]), 2, "حالة 2")
تأكد_يساوي(ف([45, 25, 59, 59, 10, 51, 41, 1]), 5, "حالة 3")
تأكد_يساوي(ف([41, 10, 43, 7, -17, 40]), 3, "حالة 4")
