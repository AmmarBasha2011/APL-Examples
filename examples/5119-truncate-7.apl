# مثال 5119 — اقتطاع النص إلى 7 حروف مع نقاط
# Truncate to 7 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5119-truncate-7.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 7:
    ارجع ن
  ارجع ن[:7] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello w...", "حالة 2")
تأكد_يساوي(ف("xxxxxxx"), "xxxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyyy"), "yyyyyyy...", "حالة 4")
