# مثال 10316 — تحويل 6 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 6 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10316-temp-c-6.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 6) * 9 // 5 + 32

تأكد_يساوي(ف(0), 42, "حالة 1")
تأكد_يساوي(ف(10), 60, "حالة 2")
تأكد_يساوي(ف(37), 109, "حالة 3")
تأكد_يساوي(ف(-5), 33, "حالة 4")
