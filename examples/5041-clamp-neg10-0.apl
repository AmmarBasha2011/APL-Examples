# مثال 5041 — حصر القيمة بين -10 و 0
# Clamp value into [-10,0]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5041-clamp-neg10-0.apl

# إن كانت أقل من الحد الأدنى نرجع الحد الأدنى
# وإن زادت نرجع الحد الأعلى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < -10:
    ارجع -10
  لو ن > 0:
    ارجع 0
  ارجع ن

تأكد_يساوي(ف(-15), -10, "حالة 1")
تأكد_يساوي(ف(5), 0, "حالة 2")
تأكد_يساوي(ف(-5), -5, "حالة 3")
تأكد_يساوي(ف(-10), -10, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
