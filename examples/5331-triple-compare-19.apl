# مثال 5331 — مقارنة العدد مع 19
# Compare number with 19
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5331-triple-compare-19.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 19:
    ارجع "اصغر"
  والا_لو ن > 19:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(18), "اصغر", "حالة 1")
تأكد_يساوي(ف(19), "يساوي", "حالة 2")
تأكد_يساوي(ف(20), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
