# مثال 10012 — عدد العناصر فوق المتوسط (مجموعة 20)
# above_mean (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10012-stat-above_mean-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-16, 23, -5, 54, 35, -13, 18, -4]), 4, "حالة 1")
تأكد_يساوي(ف([13, -8, -14, 3, -6, 18, -10, 52, 21]), 4, "حالة 2")
تأكد_يساوي(ف([-12, -19, 3, 31, 3, -18, 22, 49]), 3, "حالة 3")
تأكد_يساوي(ف([51, 50, 24, 16, -7]), 2, "حالة 4")
