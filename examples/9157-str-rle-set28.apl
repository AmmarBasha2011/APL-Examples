# مثال 9157 — ضغط التكرار (مجموعة اختبار 28)
# rle (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9157-str-rle-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("refer"), "r1e1f1e1r1", "حالة 1")
تأكد_يساوي(ف("enlist"), "e1n1l1i1s1t1", "حالة 2")
تأكد_يساوي(ف("kayak"), "k1a1y1a1k1", "حالة 3")
تأكد_يساوي(ف("galaxy"), "g1a1l1a1x1y1", "حالة 4")
تأكد_يساوي(ف("planet"), "p1l1a1n1e1t1", "حالة 5")
