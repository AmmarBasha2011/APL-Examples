# مثال 9638 — الأصفار في نهاية العاملي (مجموعة اختبار 29)
# tzeros (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9638-num-tzeros-set29.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(63), 14, "حالة 1")
تأكد_يساوي(ف(320), 78, "حالة 2")
تأكد_يساوي(ف(425), 105, "حالة 3")
تأكد_يساوي(ف(465), 114, "حالة 4")
تأكد_يساوي(ف(394), 96, "حالة 5")
