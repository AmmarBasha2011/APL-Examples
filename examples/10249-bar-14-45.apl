# مثال 10249 — شريط بعرض 14 من الرمز -
# Bar of width 14 using -
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10249-bar-14-45.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "-"
  ارجع ر + "|" + str(14)

تأكد_يساوي(ف(0), "|14", "حالة 1")
تأكد_يساوي(ف(3), "---|14", "حالة 2")
تأكد_يساوي(ف(14), "--------------|14", "حالة 3")
