# مثال 9595 — الجذر الرقمي (مجموعة اختبار 26)
# droot (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9595-num-droot-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(80903), 2, "حالة 1")
تأكد_يساوي(ف(9349), 7, "حالة 2")
تأكد_يساوي(ف(6425), 8, "حالة 3")
تأكد_يساوي(ف(52687), 1, "حالة 4")
تأكد_يساوي(ف(73487), 2, "حالة 5")
