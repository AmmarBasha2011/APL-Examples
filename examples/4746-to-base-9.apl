# مثال 4746 — تحويل عدد إلى الأساس 9
# Convert a number to base 9
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4746-to-base-9.apl

# نقسم على الأساس ونجمع البواقي من الآخر
# لحد ما يبقى الناتج صفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  ر = ""
  لكل ي في range(100):
    لو ن == 0:
      ارجع ر
    ر = str(ن % 9) + ر
    ن = ن // 9
  ارجع ر

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(5), "5", "حالة 2")
تأكد_يساوي(ف(17), "18", "حالة 3")
تأكد_يساوي(ف(100), "121", "حالة 4")
تأكد_يساوي(ف(255), "313", "حالة 5")
