# مثال 4486 — عدد نتيجة سالبها للأعداد الفردية
# Count of negated over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4486-pipeline-odd-negate-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [0 - خ]
  ارجع len(ن)

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 3, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 3, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 3, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 1, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
