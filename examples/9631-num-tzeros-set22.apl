# مثال 9631 — الأصفار في نهاية العاملي (مجموعة اختبار 22)
# tzeros (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9631-num-tzeros-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(210), 51, "حالة 1")
تأكد_يساوي(ف(181), 44, "حالة 2")
تأكد_يساوي(ف(403), 99, "حالة 3")
تأكد_يساوي(ف(473), 115, "حالة 4")
تأكد_يساوي(ف(26), 6, "حالة 5")
