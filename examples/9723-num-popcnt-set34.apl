# مثال 9723 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 34)
# popcnt (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9723-num-popcnt-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(1579), 6, "حالة 1")
تأكد_يساوي(ف(4231), 5, "حالة 2")
تأكد_يساوي(ف(3984), 6, "حالة 3")
تأكد_يساوي(ف(2546), 7, "حالة 4")
تأكد_يساوي(ف(426), 5, "حالة 5")
