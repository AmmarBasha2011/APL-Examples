# مثال 9257 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 8)
# altcase (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9257-str-altcase-set8.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("saturn"), "SaTuRn", "حالة 1")
تأكد_يساوي(ف("level"), "LeVeL", "حالة 2")
تأكد_يساوي(ف("comet"), "CoMeT", "حالة 3")
تأكد_يساوي(ف("venus"), "VeNuS", "حالة 4")
تأكد_يساوي(ف("enlist"), "EnLiSt", "حالة 5")
