# مثال 9548 — خطوات كولاتز (مجموعة اختبار 19)
# collatz (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9548-num-collatz-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(177), 31, "حالة 1")
تأكد_يساوي(ف(137), 90, "حالة 2")
تأكد_يساوي(ف(193), 119, "حالة 3")
تأكد_يساوي(ف(27), 111, "حالة 4")
تأكد_يساوي(ف(91), 92, "حالة 5")
