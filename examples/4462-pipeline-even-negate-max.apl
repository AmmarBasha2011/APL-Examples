# مثال 4462 — أكبر نتيجة سالبها للأعداد الزوجية
# Largest (or 0) of negated over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4462-pipeline-even-negate-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), -6, "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), -2, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -4, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 0, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
