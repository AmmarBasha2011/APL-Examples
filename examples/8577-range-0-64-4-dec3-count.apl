# مثال 8577 — العدد من المدى 0 إلى 64 بخطوة 4 بعد (ناقص 3)
# count over range(0,64,4) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8577-range-0-64-4-dec3-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [خ - 3]
    خ = خ + (4)
  ارجع len(ر)

تأكد_يساوي(ف(), 16, "المدى كله")
