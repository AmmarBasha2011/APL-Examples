# مثال 6797 — العدد المضلّع ذو 22 أضلاع
# 22-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6797-polygonal-22.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((22 - 2) * ن * ن - (22 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 22, "حالة 2")
تأكد_يساوي(ف(5), 205, "حالة 3")
تأكد_يساوي(ف(10), 910, "حالة 4")
