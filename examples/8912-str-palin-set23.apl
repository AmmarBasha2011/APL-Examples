# مثال 8912 — هل الكلمة متناظرة (مجموعة اختبار 23)
# palin (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8912-str-palin-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("moon"), خطأ, "حالة 1")
تأكد_يساوي(ف("code"), خطأ, "حالة 2")
تأكد_يساوي(ف("orbit"), خطأ, "حالة 3")
تأكد_يساوي(ف("bob"), صواب, "حالة 4")
تأكد_يساوي(ف("venus"), خطأ, "حالة 5")
