# مثال 9435 — عكس الأرقام (مجموعة اختبار 26)
# revnum (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9435-num-revnum-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(95932), 23959, "حالة 1")
تأكد_يساوي(ف(42089), 98024, "حالة 2")
تأكد_يساوي(ف(22445), 54422, "حالة 3")
تأكد_يساوي(ف(32496), 69423, "حالة 4")
تأكد_يساوي(ف(82823), 32828, "حالة 5")
