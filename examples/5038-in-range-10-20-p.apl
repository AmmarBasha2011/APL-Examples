# مثال 5038 — هل القيمة داخل المدى [10, 20]؟
# Is value in range [10,20]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5038-in-range-10-20-p.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= 10 و ن <= 20

تأكد_يساوي(ف(10), صواب, "حالة 1")
تأكد_يساوي(ف(20), صواب, "حالة 2")
تأكد_يساوي(ف(9), خطأ, "حالة 3")
تأكد_يساوي(ف(21), خطأ, "حالة 4")
تأكد_يساوي(ف(15), صواب, "حالة 5")
