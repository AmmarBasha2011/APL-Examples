# مثال 4450 — مجموع نتيجة مربعها للأعداد الزوجية
# Sum of square over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4450-pipeline-even-square-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 452, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 2744, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 68, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 1144, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
