# مثال 6250 — النص الناتج بعد أخذ حروف العلة وتحويلها إلى (حرف مع شرطة)
# str of dash applied to vowel chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6250-txt-vowel-dash-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف العلة فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "aeiou":
      ر = ر + خ + "-"
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "e-o-o-", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "a-i-u-", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "a-", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "e-u-i-o-o-", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "a-a-i-e-e-", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "o-a-i-i-a-a-i-", "حالة 8")
