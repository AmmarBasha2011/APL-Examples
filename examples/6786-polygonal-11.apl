# مثال 6786 — العدد المضلّع ذو 11 أضلاع
# 11-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6786-polygonal-11.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((11 - 2) * ن * ن - (11 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 11, "حالة 2")
تأكد_يساوي(ف(5), 95, "حالة 3")
تأكد_يساوي(ف(10), 415, "حالة 4")
