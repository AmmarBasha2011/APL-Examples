# مثال 7934 — أعلى تكرار في الجملة رقم 4
# maxcount for sentence 4
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7934-sent3-maxcount.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  م = 0
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
    م = max(م, د[ك])
  ارجع م

تأكد_يساوي(ف("one fish two fish red fish blue fish"), 4, "حالة 1")
تأكد_يساوي(ف("tea for two and two for tea"), 2, "حالة 2")
تأكد_يساوي(ف("red blue green red blue red"), 3, "حالة 3")
