# مثال 9366 — هل العدد أولي (مجموعة اختبار 37)
# prime (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9366-num-prime-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(87), خطأ, "حالة 1")
تأكد_يساوي(ف(88), خطأ, "حالة 2")
تأكد_يساوي(ف(14), خطأ, "حالة 3")
تأكد_يساوي(ف(2), صواب, "حالة 4")
تأكد_يساوي(ف(96), خطأ, "حالة 5")
