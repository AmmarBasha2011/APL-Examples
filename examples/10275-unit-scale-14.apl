# مثال 10275 — تحويل وحدة إلى 14 وحدات صغرى والعكس
# Convert units with factor 14
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10275-unit-scale-14.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 14, ن // 14, ن % 14]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [14, 0, 1], "حالة 2")
تأكد_يساوي(ف(14), [196, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [14000, 71, 6], "حالة 4")
