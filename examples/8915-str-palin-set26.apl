# مثال 8915 — هل الكلمة متناظرة (مجموعة اختبار 26)
# palin (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8915-str-palin-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("data"), خطأ, "حالة 1")
تأكد_يساوي(ف("kayak"), صواب, "حالة 2")
تأكد_يساوي(ف("level"), صواب, "حالة 3")
تأكد_يساوي(ف("racecar"), صواب, "حالة 4")
تأكد_يساوي(ف("civic"), صواب, "حالة 5")
