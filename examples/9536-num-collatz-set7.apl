# مثال 9536 — خطوات كولاتز (مجموعة اختبار 7)
# collatz (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9536-num-collatz-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(52), 11, "حالة 1")
تأكد_يساوي(ف(180), 18, "حالة 2")
تأكد_يساوي(ف(158), 36, "حالة 3")
تأكد_يساوي(ف(28), 18, "حالة 4")
تأكد_يساوي(ف(83), 110, "حالة 5")
