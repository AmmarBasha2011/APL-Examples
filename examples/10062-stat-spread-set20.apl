# مثال 10062 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 20)
# spread (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10062-stat-spread-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([24, 45, 33, -19, 8]), 27, "حالة 1")
تأكد_يساوي(ف([41, 32, 21, -4, 32, 55, 49]), 25, "حالة 2")
تأكد_يساوي(ف([33, 34, -2, -11, 24, 41, 41, 51, 3]), 21, "حالة 3")
تأكد_يساوي(ف([29, -5, 6, 11, 20, 2, 60, 59]), 30, "حالة 4")
