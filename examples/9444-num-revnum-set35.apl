# مثال 9444 — عكس الأرقام (مجموعة اختبار 35)
# revnum (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9444-num-revnum-set35.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(36749), 94763, "حالة 1")
تأكد_يساوي(ف(32646), 64623, "حالة 2")
تأكد_يساوي(ف(15463), 36451, "حالة 3")
تأكد_يساوي(ف(38536), 63583, "حالة 4")
تأكد_يساوي(ف(20649), 94602, "حالة 5")
