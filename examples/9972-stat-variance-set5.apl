# مثال 9972 — التباين الصحيح (مجموعة 5)
# variance (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9972-stat-variance-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-1, 32, -13, 1, -15, 19]), 282, "حالة 1")
تأكد_يساوي(ف([49, -17, 11]), 731, "حالة 2")
تأكد_يساوي(ف([13, 5, 37, 1, 53, 31]), 344, "حالة 3")
تأكد_يساوي(ف([43, 59, 48, 59]), 48, "حالة 4")
