# مثال 8926 — هل الكلمة متناظرة (مجموعة اختبار 37)
# palin (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8926-str-palin-set37.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("google"), خطأ, "حالة 1")
تأكد_يساوي(ف("star"), خطأ, "حالة 2")
تأكد_يساوي(ف("python"), خطأ, "حالة 3")
تأكد_يساوي(ف("listen"), خطأ, "حالة 4")
تأكد_يساوي(ف("earth"), خطأ, "حالة 5")
