# مثال 9947 — المدى (مجموعة 5)
# range (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9947-stat-range-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([46, 14, -15, 31, 60, 8, 22]), 75, "حالة 1")
تأكد_يساوي(ف([9, -6, 50, -1, -3, 15, 52, 9, -3]), 58, "حالة 2")
تأكد_يساوي(ف([56, 38, -3, -7, 13, -11]), 67, "حالة 3")
تأكد_يساوي(ف([13, -9, 34, -15, 10, 54, 2, -8, 10]), 69, "حالة 4")
