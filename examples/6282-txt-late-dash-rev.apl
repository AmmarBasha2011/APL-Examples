# مثال 6282 — الناتج معكوس بعد أخذ حروف آخر الأبجدية وتحويلها إلى (حرف مع شرطة)
# rev of dash applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6282-txt-late-dash-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + خ + "-"
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "-r-o-w-o", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "-n-u-s-p", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "-x-o-n-w-o-r-u-q-t", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "-x-x-x-y-y-y-z-z-z", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "-n-s-t", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "-r-n-n-r-o-r-p", "حالة 8")
