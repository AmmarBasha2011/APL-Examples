# مثال 7453 — أكبر قيمة: من المكعبات نأخذ الأصغر من 20 ثم (ضعف)
# max over cubes sequence, keep lt20, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7453-seq-cubes-lt20-double-max.apl

# نولّد أول ن حد من: المكعبات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي * ي
    لو خ < 20:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 16, "حالة 3")
تأكد_يساوي(ف(10), 16, "حالة 4")
تأكد_يساوي(ف(15), 16, "حالة 5")
