# مثال 4656 — هل يوجد (حرف كبير) في نص
# String: is there any uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4656-string-anyq-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو خ.isupper():
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(ف("2026-11-28 launch"), خطأ, "حالة 1")
تأكد_يساوي(ف("  spaced   out  text "), خطأ, "حالة 2")
تأكد_يساوي(ف("ZZtop and the Beatles"), صواب, "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), صواب, "حالة 4")
تأكد_يساوي(ف(""), خطأ, "حالة 5")
