# مثال 4773 — عكس 5 بتات
# Reverse the lowest 5 bits
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4773-bit-reverse-5.apl

# نقرأ البتات من اليمين ونبني الناتج من اليسار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  لكل ي في range(5):
    ر = ر * 2 + (ن % 2)
    ن = ن // 2
  ارجع ر

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 16, "حالة 2")
تأكد_يساوي(ف(5), 20, "حالة 3")
تأكد_يساوي(ف(31), 31, "حالة 4")
تأكد_يساوي(ف(17), 17, "حالة 5")
