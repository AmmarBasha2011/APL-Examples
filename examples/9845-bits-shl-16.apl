# مثال 9845 — إزاحة لليسار 16 خانات
# Shift left by 16
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9845-bits-shl-16.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 16

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 65536, "حالة 2")
تأكد_يساوي(ف(5), 327680, "حالة 3")
تأكد_يساوي(ف(100), 6553600, "حالة 4")
