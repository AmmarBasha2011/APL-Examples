# مثال 6320 — النص الناتج بعد أخذ حروف العلة وتحويلها إلى (رقم الحرف)
# str of code applied to vowel chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6320-txt-vowel-code-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف العلة فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "aeiou":
      ر = ر + str(ord(خ))+","
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "101,111,111,", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "97,105,117,", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "97,", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "101,117,105,111,111,", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "97,97,105,101,101,", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "111,97,105,105,97,97,105,", "حالة 8")
