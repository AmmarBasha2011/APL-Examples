# مثال 7929 — أول كلمة تتكرر في الجملة رقم 3
# firstdup for sentence 3
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7929-sent2-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("apl code is easy code is fun"), "code", "حالة 1")
تأكد_يساوي(ف("we love data and data loves us"), "data", "حالة 2")
تأكد_يساوي(ف("in the end the end is the start"), "the", "حالة 3")
