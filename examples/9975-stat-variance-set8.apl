# مثال 9975 — التباين الصحيح (مجموعة 8)
# variance (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9975-stat-variance-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([10, 2, 57, -3, 4, 27, -2, -19]), 469, "حالة 1")
تأكد_يساوي(ف([3, -17, 48, 15, 45, 10, 7]), 463, "حالة 2")
تأكد_يساوي(ف([17, 16, -8, 34, 37, -3, 55]), 434, "حالة 3")
تأكد_يساوي(ف([17, 33, 27]), 44, "حالة 4")
