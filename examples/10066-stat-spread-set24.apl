# مثال 10066 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 24)
# spread (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10066-stat-spread-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([-6, 3, 45, 15, 59]), 30, "حالة 1")
تأكد_يساوي(ف([22, 34, 49, 49, 45, 60]), 12, "حالة 2")
تأكد_يساوي(ف([59, 32, 12, 11, 6]), 27, "حالة 3")
تأكد_يساوي(ف([-17, 27, 27, 5, 30, -3, 42]), 22, "حالة 4")
