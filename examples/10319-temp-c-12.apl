# مثال 10319 — تحويل 12 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 12 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10319-temp-c-12.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 12) * 9 // 5 + 32

تأكد_يساوي(ف(0), 53, "حالة 1")
تأكد_يساوي(ف(10), 71, "حالة 2")
تأكد_يساوي(ف(37), 120, "حالة 3")
تأكد_يساوي(ف(-5), 44, "حالة 4")
