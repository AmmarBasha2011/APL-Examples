# مثال 6796 — العدد المضلّع ذو 21 أضلاع
# 21-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6796-polygonal-21.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((21 - 2) * ن * ن - (21 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 21, "حالة 2")
تأكد_يساوي(ف(5), 195, "حالة 3")
تأكد_يساوي(ف(10), 865, "حالة 4")
