# مثال 6260 — النص الناتج بعد أخذ الحروف فقط وتحويلها إلى (حرف مع شرطة)
# str of dash applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6260-txt-alpha-dash-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + خ + "-"
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "h-e-l-l-o-w-o-r-l-d-", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "a-p-l-i-s-f-u-n-", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "a-b-c-", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "t-h-e-q-u-i-c-k-b-r-o-w-n-f-o-x-", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "z-z-z-y-y-y-x-x-x-", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "d-a-t-a-s-c-i-e-n-c-e-", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "p-r-o-g-r-a-m-m-i-n-g-i-n-a-r-a-b-i-c-", "حالة 8")
