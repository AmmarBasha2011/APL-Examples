# مثال 9372 — مجموع الأرقام (مجموعة اختبار 3)
# digsum (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9372-num-digsum-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(10147), 13, "حالة 1")
تأكد_يساوي(ف(27999), 36, "حالة 2")
تأكد_يساوي(ف(18958), 31, "حالة 3")
تأكد_يساوي(ف(39731), 23, "حالة 4")
تأكد_يساوي(ف(91534), 22, "حالة 5")
