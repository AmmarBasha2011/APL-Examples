# مثال 10320 — تحويل 14 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 14 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10320-temp-c-14.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 14) * 9 // 5 + 32

تأكد_يساوي(ف(0), 57, "حالة 1")
تأكد_يساوي(ف(10), 75, "حالة 2")
تأكد_يساوي(ف(37), 123, "حالة 3")
تأكد_يساوي(ف(-5), 48, "حالة 4")
