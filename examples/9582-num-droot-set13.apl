# مثال 9582 — الجذر الرقمي (مجموعة اختبار 13)
# droot (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9582-num-droot-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(67922), 8, "حالة 1")
تأكد_يساوي(ف(26760), 3, "حالة 2")
تأكد_يساوي(ف(72133), 7, "حالة 3")
تأكد_يساوي(ف(22023), 9, "حالة 4")
تأكد_يساوي(ف(30089), 2, "حالة 5")
