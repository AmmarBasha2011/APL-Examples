# مثال 9889 — المتوسط الصحيح (مجموعة 22)
# mean (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9889-stat-mean-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([-16, 4, 16, -20, -18, 5, 37, -17, 48]), 4, "حالة 1")
تأكد_يساوي(ف([21, -4, -4, -9, 33, 51, 24]), 16, "حالة 2")
تأكد_يساوي(ف([59, 51, 49, 46, 46, 51, -13]), 41, "حالة 3")
تأكد_يساوي(ف([14, 53, 6, 24, 41, -1, 39, -20, -1]), 17, "حالة 4")
