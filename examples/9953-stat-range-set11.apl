# مثال 9953 — المدى (مجموعة 11)
# range (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9953-stat-range-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([32, 22, -19, 27, 54, -14]), 73, "حالة 1")
تأكد_يساوي(ف([-1, 12, -2]), 14, "حالة 2")
تأكد_يساوي(ف([13, -8, 44, -17, -9, 44, 5, 6]), 61, "حالة 3")
تأكد_يساوي(ف([-8, 17, 58, 30, -12, 32, 25]), 70, "حالة 4")
