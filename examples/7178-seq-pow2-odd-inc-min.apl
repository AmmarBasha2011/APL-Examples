# مثال 7178 — أصغر قيمة: من قوى 2 نأخذ الفردي ثم (زيادة واحد)
# min over pow2 sequence, keep odd, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7178-seq-pow2-odd-inc-min.apl

# نولّد أول ن حد من: قوى 2
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 ** ي
    لو خ % 2 == 1:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 2, "حالة 3")
تأكد_يساوي(ف(10), 2, "حالة 4")
تأكد_يساوي(ف(15), 2, "حالة 5")
