# مثال 5190 — أقرب مضاعف للعدد 5
# Nearest multiple of 5
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5190-nearest-multiple-5.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 5
  لو ب * 2 < 5:
    ارجع ن - ب
  ارجع ن - ب + 5

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 5, "حالة 2")
تأكد_يساوي(ف(13), 15, "حالة 3")
تأكد_يساوي(ف(100), 100, "حالة 4")
تأكد_يساوي(ف(6), 5, "حالة 5")
