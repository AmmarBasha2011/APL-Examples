# مثال 6170 — النص الناتج بعد أخذ حروف أول الأبجدية وتحويلها إلى (حرف كبير)
# str of upper applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6170-txt-early-upper-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + خ.upper()
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "HELLLD", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "ALIF", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "ABC", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "HEICKBF", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "DAACIECE", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "GAMMIGIAABIC", "حالة 8")
