# مثال 8556 — آخر عنصر من المدى 0 إلى 64 بخطوة 4 بعد (باقي على 7)
# last over range(0,64,4) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8556-range-0-64-4-mod7-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [خ % 7]
    خ = خ + (4)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 4, "المدى كله")
