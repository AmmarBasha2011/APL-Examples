# مثال 8383 — أول عنصر من المدى 3 إلى 40 بخطوة 3 بعد (مكعب)
# first over range(3,40,3) mapped by cube
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8383-range-3-40-3-cube-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ * خ * خ]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 27, "المدى كله")
