# مثال 4649 — الاحتفاظ بـ (حرف كبير) في نص
# String: keep only uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4649-string-keep-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو خ.isupper():
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("Data Science 101"), "DS", "حالة 1")
تأكد_يساوي(ف("  spaced   out  text "), "", "حالة 2")
تأكد_يساوي(ف("apple PIE 7 and 9"), "PIE", "حالة 3")
تأكد_يساوي(ف("aeiou AEIOU xyz"), "AEIOU", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
