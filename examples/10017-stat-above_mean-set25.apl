# مثال 10017 — عدد العناصر فوق المتوسط (مجموعة 25)
# above_mean (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10017-stat-above_mean-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([43, -3, 60, 2]), 2, "حالة 1")
تأكد_يساوي(ف([-5, -17, 11]), 1, "حالة 2")
تأكد_يساوي(ف([44, -9, 7, 39]), 2, "حالة 3")
تأكد_يساوي(ف([35, -17, 32]), 2, "حالة 4")
