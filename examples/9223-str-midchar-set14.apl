# مثال 9223 — الحرف الأوسط (مجموعة اختبار 14)
# midchar (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9223-str-midchar-set14.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("deed"), "e", "حالة 1")
تأكد_يساوي(ف("pluto"), "u", "حالة 2")
تأكد_يساوي(ف("noon"), "o", "حالة 3")
تأكد_يساوي(ف("star"), "a", "حالة 4")
تأكد_يساوي(ف("banana"), "a", "حالة 5")
