# مثال 4832 — سعر بعد خصم 30%
# Price after 30 percent discount
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4832-discount-30.apl

# السعر × (100 - الخصم) ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س * (100 - 30) // 100

تأكد_يساوي(ف(100), 70, "حالة 1")
تأكد_يساوي(ف(250), 175, "حالة 2")
تأكد_يساوي(ف(999), 699, "حالة 3")
تأكد_يساوي(ف(40), 28, "حالة 4")
