# مثال 10337 — تحويل 48 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 48 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10337-temp-c-48.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 48) * 9 // 5 + 32

تأكد_يساوي(ف(0), 118, "حالة 1")
تأكد_يساوي(ف(10), 136, "حالة 2")
تأكد_يساوي(ف(37), 185, "حالة 3")
تأكد_يساوي(ف(-5), 109, "حالة 4")
