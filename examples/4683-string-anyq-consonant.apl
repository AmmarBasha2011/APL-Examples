# مثال 4683 — هل يوجد (حرف ساكن) في نص
# String: is there any consonant
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4683-string-anyq-consonant.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو ord(خ.lower()) >= 97 و ord(خ.lower()) <= 122 و "aeiou".find(خ.lower()) == -1:
      ارجع صواب
  ارجع خطأ

تأكد_يساوي(ف("Data Science 101"), صواب, "حالة 1")
تأكد_يساوي(ف("2026-11-28 launch"), صواب, "حالة 2")
تأكد_يساوي(ف("  spaced   out  text "), صواب, "حالة 3")
تأكد_يساوي(ف("quick brown fox"), صواب, "حالة 4")
تأكد_يساوي(ف(""), خطأ, "حالة 5")
