# مثال 8929 — هل الكلمة متناظرة (مجموعة اختبار 40)
# palin (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8929-str-palin-set40.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("silent"), خطأ, "حالة 1")
تأكد_يساوي(ف("rocket"), خطأ, "حالة 2")
تأكد_يساوي(ف("listen"), خطأ, "حالة 3")
تأكد_يساوي(ف("noon"), صواب, "حالة 4")
تأكد_يساوي(ف("comet"), خطأ, "حالة 5")
