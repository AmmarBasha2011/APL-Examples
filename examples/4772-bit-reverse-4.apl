# مثال 4772 — عكس 4 بتات
# Reverse the lowest 4 bits
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4772-bit-reverse-4.apl

# نقرأ البتات من اليمين ونبني الناتج من اليسار

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  لكل ي في range(4):
    ر = ر * 2 + (ن % 2)
    ن = ن // 2
  ارجع ر

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 8, "حالة 2")
تأكد_يساوي(ف(5), 10, "حالة 3")
تأكد_يساوي(ف(15), 15, "حالة 4")
تأكد_يساوي(ف(9), 9, "حالة 5")
