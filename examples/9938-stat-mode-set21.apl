# مثال 9938 — المنوال (الأصغر عند التساوي) (مجموعة 21)
# mode (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9938-stat-mode-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([-16, 11, 7, 17]), -16, "حالة 1")
تأكد_يساوي(ف([15, 23, 19, 46, 55, -14, 20]), -14, "حالة 2")
تأكد_يساوي(ف([58, 40, 20, 17, 9, 31]), 9, "حالة 3")
تأكد_يساوي(ف([44, 60, 55]), 44, "حالة 4")
