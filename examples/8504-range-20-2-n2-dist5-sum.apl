# مثال 8504 — المجموع من المدى 20 إلى 2 بخطوة -2 بعد (البعد عن 5)
# sum over range(20,2,-2) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8504-range-20-2-n2-dist5-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [abs(خ - 5)]
    خ = خ + (-2)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 65, "المدى كله")
