# مثال 9970 — التباين الصحيح (مجموعة 3)
# variance (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9970-stat-variance-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([17, 38, 37]), 94, "حالة 1")
تأكد_يساوي(ف([21, -7, -1, 56]), 609, "حالة 2")
تأكد_يساوي(ف([32, 28, 10, 31]), 79, "حالة 3")
تأكد_يساوي(ف([-11, 44, 20, 15, 28, 37, -8, -9]), 412, "حالة 4")
