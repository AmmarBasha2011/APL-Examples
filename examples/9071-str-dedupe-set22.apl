# مثال 9071 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 22)
# dedupe (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9071-str-dedupe-set22.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("rocket"), "rocket", "حالة 1")
تأكد_يساوي(ف("radar"), "rad", "حالة 2")
تأكد_يساوي(ف("noon"), "no", "حالة 3")
تأكد_يساوي(ف("racecar"), "race", "حالة 4")
تأكد_يساوي(ف("star"), "star", "حالة 5")
