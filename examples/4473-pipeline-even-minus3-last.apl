# مثال 4473 — آخر نتيجة ناقص 3 للأعداد الزوجية
# Last (or -1) of minus 3 over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4473-pipeline-even-minus3-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 5, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), -7, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 39, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 3, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
