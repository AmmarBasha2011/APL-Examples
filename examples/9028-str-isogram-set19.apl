# مثال 9028 — هل لا يتكرر أي حرف (مجموعة اختبار 19)
# isogram (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9028-str-isogram-set19.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("rocket"), صواب, "حالة 1")
تأكد_يساوي(ف("deed"), خطأ, "حالة 2")
تأكد_يساوي(ف("comet"), صواب, "حالة 3")
تأكد_يساوي(ف("google"), خطأ, "حالة 4")
تأكد_يساوي(ف("loop"), خطأ, "حالة 5")
