# مثال 9551 — خطوات كولاتز (مجموعة اختبار 22)
# collatz (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9551-num-collatz-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(80), 9, "حالة 1")
تأكد_يساوي(ف(115), 33, "حالة 2")
تأكد_يساوي(ف(168), 10, "حالة 3")
تأكد_يساوي(ف(192), 13, "حالة 4")
تأكد_يساوي(ف(22), 15, "حالة 5")
