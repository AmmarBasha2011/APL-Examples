# مثال 7978 — مجموع حروف الكلمات في الجملة رقم 8
# totalchars for sentence 8
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7978-sent7-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("run run run fast fast slow"), 21, "حالة 1")
تأكد_يساوي(ف("red blue green red blue red"), 22, "حالة 2")
تأكد_يساوي(ف("learn code learn more code more"), 26, "حالة 3")
