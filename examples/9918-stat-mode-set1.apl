# مثال 9918 — المنوال (الأصغر عند التساوي) (مجموعة 1)
# mode (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9918-stat-mode-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([18, -7, 30, 41]), -7, "حالة 1")
تأكد_يساوي(ف([-9, -12, -18, 31]), -18, "حالة 2")
تأكد_يساوي(ف([17, -13, 8, 46, 48, 26, 15]), -13, "حالة 3")
تأكد_يساوي(ف([2, -7, 13, 7, -17, 13, 14, 4, 1]), 13, "حالة 4")
