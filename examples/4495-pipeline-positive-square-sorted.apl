# مثال 4495 — ترتيب نتيجة مربعها للأعداد الموجبة
# Sorted list of square over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4495-pipeline-positive-square-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ * خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [4, 4, 100, 625], "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [49, 196, 441, 784, 1225, 1764], "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [1, 9, 16, 36, 121, 400], "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [25, 36, 64, 144, 289, 900], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
