# مثال 9544 — خطوات كولاتز (مجموعة اختبار 15)
# collatz (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9544-num-collatz-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(124), 108, "حالة 1")
تأكد_يساوي(ف(191), 44, "حالة 2")
تأكد_يساوي(ف(71), 102, "حالة 3")
تأكد_يساوي(ف(37), 21, "حالة 4")
تأكد_يساوي(ف(148), 23, "حالة 5")
