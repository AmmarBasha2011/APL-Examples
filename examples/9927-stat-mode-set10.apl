# مثال 9927 — المنوال (الأصغر عند التساوي) (مجموعة 10)
# mode (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9927-stat-mode-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([-18, -3, 47, 13, 38, 60, 29, 35]), -18, "حالة 1")
تأكد_يساوي(ف([53, -2, 53, 4]), 53, "حالة 2")
تأكد_يساوي(ف([-19, 51, 3, 42, 32, 34, 40, 4, 19]), -19, "حالة 3")
تأكد_يساوي(ف([27, 32, 4, -1, 28, 51, -12]), -12, "حالة 4")
