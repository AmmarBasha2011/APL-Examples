# مثال 7339 — العدد: من ي * 4 باقي 9 نأخذ الفردي ثم (مربع)
# count over mod9 sequence, keep odd, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7339-seq-mod9-odd-square-count.apl

# نولّد أول ن حد من: ي * 4 باقي 9
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي * 4) % 9
    لو خ % 2 == 1:
      ر = ر + [خ * خ]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 2, "حالة 3")
تأكد_يساوي(ف(10), 4, "حالة 4")
تأكد_يساوي(ف(15), 6, "حالة 5")
