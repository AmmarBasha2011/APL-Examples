# مثال 4698 — أكبر الأعداد المجموع أرقامه زوجي حتى حد معين
# Numbers up to a limit: largest of the even digit sum ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4698-numbers-largest-digsum_even.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو sum([int(د) for د in str(ر)]) % 2 == 0:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(11), 11, "حالة 1")
تأكد_يساوي(ف(37), 37, "حالة 2")
تأكد_يساوي(ف(92), 91, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
