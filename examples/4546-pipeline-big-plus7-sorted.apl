# مثال 4546 — ترتيب نتيجة زائد 7 للأعداد الأكبر من 10
# Sorted list of plus 7 over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4546-pipeline-big-plus7-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ + 7]
  ارجع sorted(ن)

تأكد_يساوي(ف([3, 1, 2, 8, 5]), [], "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [19, 22], "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [21, 28, 35, 42, 49], "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [18, 27], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
