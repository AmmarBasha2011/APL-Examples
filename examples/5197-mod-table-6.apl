# مثال 5197 — باقي القسمة على 6 لكل عنصر
# Remainders mod 6
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5197-mod-table-6.apl

# نطبق % على كل عنصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ % 6]
  ارجع ر

تأكد_يساوي(ف([0, 3, 6, 9, 12, 15, 18, 21, 24, 27]), [0, 3, 0, 3, 0, 3, 0, 3, 0, 3], "حالة 1")
تأكد_يساوي(ف([-1, -5, 7]), [5, 1, 1], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
