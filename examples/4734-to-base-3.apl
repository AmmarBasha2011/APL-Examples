# مثال 4734 — تحويل عدد إلى الأساس 3
# Convert a number to base 3
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4734-to-base-3.apl

# نقسم على الأساس ونجمع البواقي من الآخر
# لحد ما يبقى الناتج صفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  ر = ""
  لكل ي في range(100):
    لو ن == 0:
      ارجع ر
    ر = str(ن % 3) + ر
    ن = ن // 3
  ارجع ر

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(5), "12", "حالة 2")
تأكد_يساوي(ف(17), "122", "حالة 3")
تأكد_يساوي(ف(100), "10201", "حالة 4")
تأكد_يساوي(ف(255), "100110", "حالة 5")
