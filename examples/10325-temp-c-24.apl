# مثال 10325 — تحويل 24 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 24 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10325-temp-c-24.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 24) * 9 // 5 + 32

تأكد_يساوي(ف(0), 75, "حالة 1")
تأكد_يساوي(ف(10), 93, "حالة 2")
تأكد_يساوي(ف(37), 141, "حالة 3")
تأكد_يساوي(ف(-5), 66, "حالة 4")
