# مثال 5270 — أقرب مضاعف للعدد 13
# Nearest multiple of 13
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5270-nearest-multiple-13.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 13
  لو ب * 2 < 13:
    ارجع ن - ب
  ارجع ن - ب + 13

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 13, "حالة 2")
تأكد_يساوي(ف(13), 13, "حالة 3")
تأكد_يساوي(ف(100), 104, "حالة 4")
تأكد_يساوي(ف(14), 13, "حالة 5")
