# مثال 5078 — عدد مرات الحرف l
# Count occurrences of letter l
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5078-count-char-l.apl

# نمر على النص ونعد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح == "l":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("banana"), 0, "حالة 1")
تأكد_يساوي(ف("education"), 0, "حالة 2")
تأكد_يساوي(ف(""), 0, "حالة 3")
تأكد_يساوي(ف("rhythm"), 0, "حالة 4")
تأكد_يساوي(ف("mississippi cat"), 0, "حالة 5")
