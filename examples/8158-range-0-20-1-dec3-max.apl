# مثال 8158 — أكبر قيمة من المدى 0 إلى 20 بخطوة 1 بعد (ناقص 3)
# max over range(0,20,1) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8158-range-0-20-1-dec3-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 20:
    ر = ر + [خ - 3]
    خ = خ + (1)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 16, "المدى كله")
