# مثال 8618 — المجموع من المدى 7 إلى 70 بخطوة 7 بعد (مكعب)
# sum over range(7,70,7) mapped by cube
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8618-range-7-70-7-cube-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ * خ * خ]
    خ = خ + (7)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 694575, "المدى كله")
