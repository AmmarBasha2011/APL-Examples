# مثال 4704 — عدد الأعداد الينتهي بالرقم 7 حتى حد معين
# Numbers up to a limit: how many the ends in 7 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4704-numbers-count-endsin7.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 10 == 7:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(24), 2, "حالة 1")
تأكد_يساوي(ف(68), 7, "حالة 2")
تأكد_يساوي(ف(126), 12, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
