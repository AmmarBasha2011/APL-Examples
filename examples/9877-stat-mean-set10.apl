# مثال 9877 — المتوسط الصحيح (مجموعة 10)
# mean (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9877-stat-mean-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([-18, -3, 47, 13, 38, 60, 29, 35]), 25, "حالة 1")
تأكد_يساوي(ف([53, -2, 53, 4]), 27, "حالة 2")
تأكد_يساوي(ف([-19, 51, 3, 42, 32, 34, 40, 4, 19]), 22, "حالة 3")
تأكد_يساوي(ف([27, 32, 4, -1, 28, 51, -12]), 18, "حالة 4")
