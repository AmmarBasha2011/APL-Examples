# مثال 9163 — ضغط التكرار (مجموعة اختبار 34)
# rle (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9163-str-rle-set34.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("loop"), "l1o2p1", "حالة 1")
تأكد_يساوي(ف("racecar"), "r1a1c1e1c1a1r1", "حالة 2")
تأكد_يساوي(ف("banana"), "b1a1n1a1n1a1", "حالة 3")
تأكد_يساوي(ف("star"), "s1t1a1r1", "حالة 4")
تأكد_يساوي(ف("mars"), "m1a1r1s1", "حالة 5")
