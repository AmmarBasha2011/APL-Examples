# مثال 4603 — أصغر نتيجة باقي قسمتها على 10 للأعداد الباقي قسمتها على 4 يساوي 1
# Smallest (or 0) of last digit mod 10 over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4603-pipeline-mod4one-mod10-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ % 10]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 1, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 5, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 9, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 1, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
