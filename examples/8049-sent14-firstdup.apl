# مثال 8049 — أول كلمة تتكرر في الجملة رقم 15
# firstdup for sentence 15
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8049-sent14-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("learn code learn more code more"), "learn", "حالة 1")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), "bread", "حالة 2")
تأكد_يساوي(ف("to be or not to be"), "to", "حالة 3")
