# مثال 4897 — اليوم بعد 4 أيام
# Weekday 4 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4897-week-day-shift-4.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 4) % 7

تأكد_يساوي(ف(0), 4, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(6), 3, "حالة 3")
تأكد_يساوي(ف(4), 1, "حالة 4")
