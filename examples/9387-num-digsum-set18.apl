# مثال 9387 — مجموع الأرقام (مجموعة اختبار 18)
# digsum (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9387-num-digsum-set18.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(52305), 15, "حالة 1")
تأكد_يساوي(ف(90050), 14, "حالة 2")
تأكد_يساوي(ف(48434), 23, "حالة 3")
تأكد_يساوي(ف(10644), 15, "حالة 4")
تأكد_يساوي(ف(58440), 21, "حالة 5")
