# مثال 4700 — عدد الأعداد المتماثل الأرقام حتى حد معين
# Numbers up to a limit: how many the palindromic ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4700-numbers-count-palindrome.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو str(ر) == str(ر)[::-1]:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(20), 10, "حالة 1")
تأكد_يساوي(ف(63), 14, "حالة 2")
تأكد_يساوي(ف(150), 23, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
