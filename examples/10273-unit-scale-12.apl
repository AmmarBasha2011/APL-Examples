# مثال 10273 — تحويل وحدة إلى 12 وحدات صغرى والعكس
# Convert units with factor 12
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10273-unit-scale-12.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 12, ن // 12, ن % 12]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [12, 0, 1], "حالة 2")
تأكد_يساوي(ف(12), [144, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [12000, 83, 4], "حالة 4")
