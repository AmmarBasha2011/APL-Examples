# مثال 4855 — مجموع الأعداد من 1 إلى ضعف 3 وزيادة
# Sum 1..n for scaled n (k=3)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4855-triangle-number-3.apl

# مجموع الأعداد المتتالية = ن(ن+1)/2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ن = ن * 3
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 6, "حالة 1")
تأكد_يساوي(ف(2), 21, "حالة 2")
تأكد_يساوي(ف(3), 45, "حالة 3")
تأكد_يساوي(ف(10), 465, "حالة 4")
