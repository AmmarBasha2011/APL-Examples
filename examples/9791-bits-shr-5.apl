# مثال 9791 — إزاحة لليمين 5 خانات
# Shift right by 5
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9791-bits-shr-5.apl

# الإزاحة لليمين تقسم وتقتطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 5

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(4096), 128, "حالة 3")
تأكد_يساوي(ف(100000), 3125, "حالة 4")
