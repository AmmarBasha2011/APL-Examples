# مثال 6764 — مولّد أرقام عشوائية خطي (7,1,32)
# LCG a=7 c=1 m=32
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6764-lcg-7-1-32.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (7 * س + 1) % 32
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [8, 25, 16, 17, 24], "حالة 1")
تأكد_يساوي(ف(0, 8), [1, 8, 25, 16, 17, 24, 9, 0], "حالة 2")
تأكد_يساوي(ف(7, 10), [18, 31, 26, 23, 2, 15, 10, 7, 18, 31], "حالة 3")
