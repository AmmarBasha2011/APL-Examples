# مثال 8907 — هل الكلمة متناظرة (مجموعة اختبار 18)
# palin (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8907-str-palin-set18.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("listen"), خطأ, "حالة 1")
تأكد_يساوي(ف("saturn"), خطأ, "حالة 2")
تأكد_يساوي(ف("level"), صواب, "حالة 3")
تأكد_يساوي(ف("array"), خطأ, "حالة 4")
تأكد_يساوي(ف("banana"), خطأ, "حالة 5")
