# مثال 8108 — المجموع من المدى 0 إلى 20 بخطوة 1 بعد (مربع)
# sum over range(0,20,1) mapped by square
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8108-range-0-20-1-square-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 20:
    ر = ر + [خ * خ]
    خ = خ + (1)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 2470, "المدى كله")
