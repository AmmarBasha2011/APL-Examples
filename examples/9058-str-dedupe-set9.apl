# مثال 9058 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 9)
# dedupe (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9058-str-dedupe-set9.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("pluto"), "pluto", "حالة 1")
تأكد_يساوي(ف("array"), "ary", "حالة 2")
تأكد_يساوي(ف("radar"), "rad", "حالة 3")
تأكد_يساوي(ف("bob"), "bo", "حالة 4")
تأكد_يساوي(ف("galaxy"), "galxy", "حالة 5")
