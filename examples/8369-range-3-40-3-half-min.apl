# مثال 8369 — أصغر قيمة من المدى 3 إلى 40 بخطوة 3 بعد (نصف صحيح)
# min over range(3,40,3) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8369-range-3-40-3-half-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ // 2]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 1, "المدى كله")
