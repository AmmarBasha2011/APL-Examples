# مثال 9807 — آخر 8 خانات ثنائية
# Low 8 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9807-bits-low-8.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 255

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 255, "حالة 2")
تأكد_يساوي(ف(1000), 232, "حالة 3")
تأكد_يساوي(ف(12345), 57, "حالة 4")
