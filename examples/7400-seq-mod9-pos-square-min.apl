# مثال 7400 — أصغر قيمة: من ي * 4 باقي 9 نأخذ الموجب ثم (مربع)
# min over mod9 sequence, keep pos, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7400-seq-mod9-pos-square-min.apl

# نولّد أول ن حد من: ي * 4 باقي 9
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي * 4) % 9
    لو خ > 0:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 9, "حالة 3")
تأكد_يساوي(ف(10), 1, "حالة 4")
تأكد_يساوي(ف(15), 1, "حالة 5")
