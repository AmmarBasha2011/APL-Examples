# مثال 6638 — الأعداد التي باقيها 2 عند القسمة على 6
# Numbers with remainder 2 mod 6
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6638-residue-6-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 6 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2, 8], "حالة 2")
تأكد_يساوي(ف(40), [2, 8, 14, 20, 26, 32, 38], "حالة 3")
تأكد_يساوي(ف(75), [2, 8, 14, 20, 26, 32, 38, 44, 50, 56, 62, 68, 74], "حالة 4")
