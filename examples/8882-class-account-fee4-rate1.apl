# مثال 8882 — حساب بنكي برسم سحب 4 وفائدة 1%
# Bank account, withdraw fee 4, interest 1%
# Demonstrates: البرمجة الكائنية
#
# Run:  python apl.py examples/8882-class-account-fee4-rate1.apl

# إيداع وسحب برسم ثابت
# وفائدة بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف حساب:
    دالة_إنشاء(ذات, رصيد):
        ذات.رصيد = رصيد

    دالة ايداع(ذات, م):
        ذات.رصيد = ذات.رصيد + م
        ارجع ذات.رصيد

    دالة سحب(ذات, م):
        ذات.رصيد = ذات.رصيد - م - 4
        ارجع ذات.رصيد

    دالة فائدة(ذات):
        ذات.رصيد = ذات.رصيد + ذات.رصيد * 1 // 100
        ارجع ذات.رصيد

ح = حساب(1000)
تأكد_يساوي(ح.ايداع(200), 1200, "عملية 1")
تأكد_يساوي(ح.سحب(100), 1096, "عملية 2")
تأكد_يساوي(ح.ايداع(50), 1146, "عملية 3")
تأكد_يساوي(ح.سحب(500), 642, "عملية 4")
تأكد_يساوي(ح.فائدة(), 648, "عملية 5")
