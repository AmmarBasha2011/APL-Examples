# مثال 9793 — قلب الخانة رقم 5
# Flip bit 5
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9793-bits-flip-5.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 5)

تأكد_يساوي(ف(0), 32, "حالة 1")
تأكد_يساوي(ف(255), 223, "حالة 2")
تأكد_يساوي(ف(1000), 968, "حالة 3")
تأكد_يساوي(ف(12345), 12313, "حالة 4")
