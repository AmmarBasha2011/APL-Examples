# مثال 9960 — المدى (مجموعة 18)
# range (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9960-stat-range-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([59, -2, -9, 42]), 68, "حالة 1")
تأكد_يساوي(ف([-19, -8, -3, 40, 25]), 59, "حالة 2")
تأكد_يساوي(ف([-1, 12, 54, 26, 3, 55, 10, 27, 39]), 56, "حالة 3")
تأكد_يساوي(ف([17, 56, 47, 13]), 43, "حالة 4")
