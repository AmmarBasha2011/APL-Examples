# مثال 8053 — عدد الكلمات المختلفة في الجملة رقم 16
# unique for sentence 16
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8053-sent15-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("stars and moon and stars again"), 4, "حالة 1")
تأكد_يساوي(ف("left right left left right"), 2, "حالة 2")
تأكد_يساوي(ف("apl code is easy code is fun"), 5, "حالة 3")
