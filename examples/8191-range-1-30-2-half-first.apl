# مثال 8191 — أول عنصر من المدى 1 إلى 30 بخطوة 2 بعد (نصف صحيح)
# first over range(1,30,2) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8191-range-1-30-2-half-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [خ // 2]
    خ = خ + (2)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 0, "المدى كله")
