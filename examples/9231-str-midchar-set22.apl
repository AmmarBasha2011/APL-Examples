# مثال 9231 — الحرف الأوسط (مجموعة اختبار 22)
# midchar (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9231-str-midchar-set22.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("rotor"), "t", "حالة 1")
تأكد_يساوي(ف("sun"), "u", "حالة 2")
تأكد_يساوي(ف("rocket"), "k", "حالة 3")
تأكد_يساوي(ف("orbit"), "b", "حالة 4")
تأكد_يساوي(ف("mars"), "r", "حالة 5")
