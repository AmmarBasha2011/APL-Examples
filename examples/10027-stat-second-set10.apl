# مثال 10027 — ثاني أكبر قيمة مختلفة (مجموعة 10)
# second (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10027-stat-second-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([16, 29, 52, 55, 38, -9, 12]), 52, "حالة 1")
تأكد_يساوي(ف([30, 38, -14, 26, 41]), 38, "حالة 2")
تأكد_يساوي(ف([-2, 60, 3, 14, 31, -20, -5, 26, 48]), 48, "حالة 3")
تأكد_يساوي(ف([9, 6, -16, 16, -20]), 9, "حالة 4")
