# مثال 8058 — مجموع حروف الكلمات في الجملة رقم 16
# totalchars for sentence 16
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8058-sent15-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("stars and moon and stars again"), 25, "حالة 1")
تأكد_يساوي(ف("left right left left right"), 22, "حالة 2")
تأكد_يساوي(ف("apl code is easy code is fun"), 22, "حالة 3")
