# مثال 9997 — عدد العناصر فوق المتوسط (مجموعة 5)
# above_mean (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9997-stat-above_mean-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([46, 5, 51, -4, -17, 42]), 3, "حالة 1")
تأكد_يساوي(ف([29, 8, 42]), 2, "حالة 2")
تأكد_يساوي(ف([56, 49, 38, -17]), 3, "حالة 3")
تأكد_يساوي(ف([16, 46, 15]), 1, "حالة 4")
