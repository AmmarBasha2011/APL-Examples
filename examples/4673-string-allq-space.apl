# مثال 4673 — هل كل الأحرف (مسافة) في نص
# String: are all characters space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4673-string-allq-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو ليس (خ == " "):
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("aeiou AEIOU xyz"), خطأ, "حالة 1")
تأكد_يساوي(ف("ZZtop and the Beatles"), خطأ, "حالة 2")
تأكد_يساوي(ف("apple PIE 7 and 9"), خطأ, "حالة 3")
تأكد_يساوي(ف("2026-11-28 launch"), خطأ, "حالة 4")
تأكد_يساوي(ف(""), صواب, "حالة 5")
