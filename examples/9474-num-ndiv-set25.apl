# مثال 9474 — عدد القواسم (مجموعة اختبار 25)
# ndiv (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9474-num-ndiv-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(14), 4, "حالة 1")
تأكد_يساوي(ف(7), 2, "حالة 2")
تأكد_يساوي(ف(164), 6, "حالة 3")
تأكد_يساوي(ف(6), 4, "حالة 4")
تأكد_يساوي(ف(116), 6, "حالة 5")
