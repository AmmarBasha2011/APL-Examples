# مثال 9849 — هل الخانة رقم 16 مضاءة
# Is bit 16 set
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9849-bits-test-16.apl

# نمرر الخانة إلى الموضع الأول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن >> 16) & 1 == 1

تأكد_يساوي(ف(0), خطأ, "حالة 1")
تأكد_يساوي(ف(255), خطأ, "حالة 2")
تأكد_يساوي(ف(1000), خطأ, "حالة 3")
تأكد_يساوي(ف(12345), خطأ, "حالة 4")
