# مثال 6782 — العدد المضلّع ذو 7 أضلاع
# 7-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6782-polygonal-7.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((7 - 2) * ن * ن - (7 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 7, "حالة 2")
تأكد_يساوي(ف(5), 55, "حالة 3")
تأكد_يساوي(ف(10), 235, "حالة 4")
