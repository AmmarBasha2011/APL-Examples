# مثال 5149 — اقتطاع النص إلى 13 حروف مع نقاط
# Truncate to 13 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5149-truncate-13.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 13:
    ارجع ن
  ارجع ن[:13] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello world, ...", "حالة 2")
تأكد_يساوي(ف("xxxxxxxxxxxxx"), "xxxxxxxxxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyyyyyyyyy"), "yyyyyyyyyyyyy...", "حالة 4")
