# مثال 8654 — المجموع من المدى 2 إلى 26 بخطوة 3 بعد (زيادة واحد)
# sum over range(2,26,3) mapped by inc
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8654-range-2-26-3-inc-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [خ + 1]
    خ = خ + (3)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 108, "المدى كله")
