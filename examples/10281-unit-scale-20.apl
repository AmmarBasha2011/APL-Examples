# مثال 10281 — تحويل وحدة إلى 20 وحدات صغرى والعكس
# Convert units with factor 20
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10281-unit-scale-20.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 20, ن // 20, ن % 20]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [20, 0, 1], "حالة 2")
تأكد_يساوي(ف(20), [400, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [20000, 50, 0], "حالة 4")
