# مثال 7873 — المجموع: من عكسية نأخذ مضاعفات 3 ثم (مربع)
# sum over rev sequence, keep m3, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7873-seq-rev-m3-square-sum.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ % 3 == 0:
      ر = ر + [خ * خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 468, "حالة 3")
تأكد_يساوي(ف(10), 504, "حالة 4")
تأكد_يساوي(ف(15), 540, "حالة 5")
