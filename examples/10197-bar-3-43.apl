# مثال 10197 — شريط بعرض 3 من الرمز +
# Bar of width 3 using +
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10197-bar-3-43.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "+"
  ارجع ر + "|" + str(3)

تأكد_يساوي(ف(0), "|3", "حالة 1")
تأكد_يساوي(ف(3), "+++|3", "حالة 2")
تأكد_يساوي(ف(3), "+++|3", "حالة 3")
