# مثال 5125 — مجموع الأرقام ثم الباقي على 8
# Digit sum mod 8
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5125-digit-sum-mod-8.apl

# نفصل الأرقام بالقسمة على 10

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م % 8

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(9), 1, "حالة 2")
تأكد_يساوي(ف(123), 6, "حالة 3")
تأكد_يساوي(ف(99999), 5, "حالة 4")
تأكد_يساوي(ف(40507), 0, "حالة 5")
