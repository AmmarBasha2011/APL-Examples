# مثال 6637 — الأعداد التي باقيها 1 عند القسمة على 6
# Numbers with remainder 1 mod 6
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6637-residue-6-1.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 6 == 1:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [1, 7], "حالة 2")
تأكد_يساوي(ف(40), [1, 7, 13, 19, 25, 31, 37], "حالة 3")
تأكد_يساوي(ف(75), [1, 7, 13, 19, 25, 31, 37, 43, 49, 55, 61, 67, 73], "حالة 4")
