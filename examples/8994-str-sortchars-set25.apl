# مثال 8994 — حروف الكلمة مرتبة (مجموعة اختبار 25)
# sortchars (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8994-str-sortchars-set25.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("rotor"), "oorrt", "حالة 1")
تأكد_يساوي(ف("rocket"), "cekort", "حالة 2")
تأكد_يساوي(ف("star"), "arst", "حالة 3")
تأكد_يساوي(ف("river"), "eirrv", "حالة 4")
تأكد_يساوي(ف("moon"), "mnoo", "حالة 5")
