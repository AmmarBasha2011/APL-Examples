# مثال 6731 — القوة بالباقي على 22
# Modular power mod 22
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6731-modpow-22.apl

# نضرب ونأخذ الباقي في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ب, أ):
  ر = 1
  لكل ي في range(أ):
    ر = ر * ب % 22
  ارجع ر

تأكد_يساوي(ف(2, 0), 1, "حالة 1")
تأكد_يساوي(ف(2, 10), 12, "حالة 2")
تأكد_يساوي(ف(3, 7), 9, "حالة 3")
تأكد_يساوي(ف(7, 13), 13, "حالة 4")
تأكد_يساوي(ف(10, 20), 12, "حالة 5")
