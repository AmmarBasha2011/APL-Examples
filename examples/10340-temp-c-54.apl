# مثال 10340 — تحويل 54 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 54 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10340-temp-c-54.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 54) * 9 // 5 + 32

تأكد_يساوي(ف(0), 129, "حالة 1")
تأكد_يساوي(ف(10), 147, "حالة 2")
تأكد_يساوي(ف(37), 195, "حالة 3")
تأكد_يساوي(ف(-5), 120, "حالة 4")
