# مثال 9730 — الجذر التربيعي الصحيح (مجموعة اختبار 1)
# sqrtint (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9730-num-sqrtint-set1.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2652), 51, "حالة 1")
تأكد_يساوي(ف(1235), 35, "حالة 2")
تأكد_يساوي(ف(3234), 56, "حالة 3")
تأكد_يساوي(ف(395), 19, "حالة 4")
تأكد_يساوي(ف(593), 24, "حالة 5")
