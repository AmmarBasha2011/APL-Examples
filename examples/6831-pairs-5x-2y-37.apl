# مثال 6831 — عدد حلول 5س + 2ص = 37
# Count solutions of 5x+2y=37
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6831-pairs-5x-2y-37.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 5 * س + 2 * ص == 37:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 2, "حالة 3")
تأكد_يساوي(ف(37), 4, "حالة 4")
