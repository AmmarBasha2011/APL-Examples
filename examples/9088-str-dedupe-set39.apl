# مثال 9088 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 39)
# dedupe (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9088-str-dedupe-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("comet"), "comet", "حالة 1")
تأكد_يساوي(ف("deed"), "de", "حالة 2")
تأكد_يساوي(ف("radar"), "rad", "حالة 3")
تأكد_يساوي(ف("rocket"), "rocket", "حالة 4")
تأكد_يساوي(ف("loop"), "lop", "حالة 5")
