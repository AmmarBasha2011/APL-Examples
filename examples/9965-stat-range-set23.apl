# مثال 9965 — المدى (مجموعة 23)
# range (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9965-stat-range-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([-3, 58, 41, 60, -19, -7]), 79, "حالة 1")
تأكد_يساوي(ف([8, -20, 33, 43, 31, -5, 43]), 63, "حالة 2")
تأكد_يساوي(ف([-1, 14, 27]), 28, "حالة 3")
تأكد_يساوي(ف([20, 22, -7, 28, 58]), 65, "حالة 4")
