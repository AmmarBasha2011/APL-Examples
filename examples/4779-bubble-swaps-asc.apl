# مثال 4779 — عدد التبديلات في ترتيب الفقاعات (تصاعدي)
# Bubble sort swap count (ascending)
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4779-bubble-swaps-asc.apl

# نقارن كل عنصرين متجاورين
# ونبدّلهم لو ترتيبهم غلط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ق = ق + []
  ع = 0
  لكل ر في range(len(ق)):
    لكل ي في range(len(ق) - 1 - ر):
      لو ق[ي] > ق[ي + 1]:
        ق[ي], ق[ي + 1] = ق[ي + 1], ق[ي]
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([3, 1, 2]), 2, "حالة 1")
تأكد_يساوي(ف([1, 2, 3, 4]), 0, "حالة 2")
تأكد_يساوي(ف([5, 4, 3, 2, 1]), 10, "حالة 3")
تأكد_يساوي(ف([2, 2, 1, 1]), 4, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
