# مثال 5242 — مجموع تراكمي مع زيادة 10
# Running total plus 10 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5242-cumulative-10.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 10
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [11, 23, 36], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [15, 30, 45, 60], "حالة 3")
