# مثال 9888 — المتوسط الصحيح (مجموعة 21)
# mean (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9888-stat-mean-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([-16, 11, 7, 17]), 4, "حالة 1")
تأكد_يساوي(ف([15, 23, 19, 46, 55, -14, 20]), 23, "حالة 2")
تأكد_يساوي(ف([58, 40, 20, 17, 9, 31]), 29, "حالة 3")
تأكد_يساوي(ف([44, 60, 55]), 53, "حالة 4")
