# مثال 8056 — عدد الكلمات التي ظهرت مرة واحدة في الجملة رقم 16
# once for sentence 16
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8056-sent15-once.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] == 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("stars and moon and stars again"), 2, "حالة 1")
تأكد_يساوي(ف("left right left left right"), 0, "حالة 2")
تأكد_يساوي(ف("apl code is easy code is fun"), 3, "حالة 3")
