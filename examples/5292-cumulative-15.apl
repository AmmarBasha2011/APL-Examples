# مثال 5292 — مجموع تراكمي مع زيادة 15
# Running total plus 15 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5292-cumulative-15.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 15
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [16, 33, 51], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [20, 40, 60, 80], "حالة 3")
