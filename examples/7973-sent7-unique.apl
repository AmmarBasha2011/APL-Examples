# مثال 7973 — عدد الكلمات المختلفة في الجملة رقم 8
# unique for sentence 8
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7973-sent7-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("run run run fast fast slow"), 3, "حالة 1")
تأكد_يساوي(ف("red blue green red blue red"), 3, "حالة 2")
تأكد_يساوي(ف("learn code learn more code more"), 3, "حالة 3")
