# مثال 9039 — هل لا يتكرر أي حرف (مجموعة اختبار 30)
# isogram (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9039-str-isogram-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("sun"), صواب, "حالة 1")
تأكد_يساوي(ف("level"), خطأ, "حالة 2")
تأكد_يساوي(ف("moon"), خطأ, "حالة 3")
تأكد_يساوي(ف("code"), صواب, "حالة 4")
تأكد_يساوي(ف("apple"), خطأ, "حالة 5")
