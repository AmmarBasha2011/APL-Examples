# مثال 10036 — ثاني أكبر قيمة مختلفة (مجموعة 19)
# second (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10036-stat-second-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([5, 22, -13, 19, 35]), 22, "حالة 1")
تأكد_يساوي(ف([25, 15, -3, 2, -9, 2, 41, 9]), 25, "حالة 2")
تأكد_يساوي(ف([-18, 3, 0, 54, 32]), 32, "حالة 3")
تأكد_يساوي(ف([44, 26, 38, 45, 25, 14, 51, -10, 6]), 45, "حالة 4")
