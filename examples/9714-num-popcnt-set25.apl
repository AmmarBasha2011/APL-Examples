# مثال 9714 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 25)
# popcnt (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9714-num-popcnt-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(384), 2, "حالة 1")
تأكد_يساوي(ف(3718), 6, "حالة 2")
تأكد_يساوي(ف(3281), 6, "حالة 3")
تأكد_يساوي(ف(3439), 9, "حالة 4")
تأكد_يساوي(ف(1353), 5, "حالة 5")
