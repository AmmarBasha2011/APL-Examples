# مثال 9674 — هل العدد أرمسترونغ (مجموعة اختبار 25)
# arm (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9674-num-arm-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(420), خطأ, "حالة 1")
تأكد_يساوي(ف(709), خطأ, "حالة 2")
تأكد_يساوي(ف(424), خطأ, "حالة 3")
تأكد_يساوي(ف(344), خطأ, "حالة 4")
تأكد_يساوي(ف(16), خطأ, "حالة 5")
