# مثال 9066 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 17)
# dedupe (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9066-str-dedupe-set17.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("array"), "ary", "حالة 1")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 2")
تأكد_يساوي(ف("python"), "python", "حالة 3")
تأكد_يساوي(ف("refer"), "ref", "حالة 4")
تأكد_يساوي(ف("silent"), "silent", "حالة 5")
