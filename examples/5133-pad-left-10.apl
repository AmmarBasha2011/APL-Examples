# مثال 5133 — ملء النص من اليسار حتى عرض 10
# Left pad to width 10
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5133-pad-left-10.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 10:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "0000000007", "حالة 1")
تأكد_يساوي(ف("123"), "0000000123", "حالة 2")
تأكد_يساوي(ف("1111111111"), "1111111111", "حالة 3")
تأكد_يساوي(ف(""), "0000000000", "حالة 4")
