# مثال 10061 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 19)
# spread (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10061-stat-spread-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([5, 22, -13, 19, 35]), 18, "حالة 1")
تأكد_يساوي(ف([25, 15, -3, 2, -9, 2, 41, 9]), 16, "حالة 2")
تأكد_يساوي(ف([-18, 3, 0, 54, 32]), 29, "حالة 3")
تأكد_يساوي(ف([44, 26, 38, 45, 25, 14, 51, -10, 6]), 16, "حالة 4")
