# مثال 5114 — اقتطاع النص إلى 6 حروف مع نقاط
# Truncate to 6 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5114-truncate-6.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 6:
    ارجع ن
  ارجع ن[:6] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello ...", "حالة 2")
تأكد_يساوي(ف("xxxxxx"), "xxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyy"), "yyyyyy...", "حالة 4")
