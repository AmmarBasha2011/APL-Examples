# مثال 9593 — الجذر الرقمي (مجموعة اختبار 24)
# droot (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9593-num-droot-set24.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(17547), 6, "حالة 1")
تأكد_يساوي(ف(27163), 1, "حالة 2")
تأكد_يساوي(ف(55955), 2, "حالة 3")
تأكد_يساوي(ف(65879), 8, "حالة 4")
تأكد_يساوي(ف(59167), 1, "حالة 5")
