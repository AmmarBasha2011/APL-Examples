# مثال 4938 — تدوير القائمة 5 خانات لليسار
# Rotate list left by 5
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4938-rotate-left-5.apl

# نقسم القائمة ونعيد ترتيبها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لو len(ق) == 0:
    ارجع ق
  ك = 5 % len(ق)
  ارجع ق[ك:] + ق[:ك]

تأكد_يساوي(ف([1, 2, 3, 4, 5, 6, 7]), [6, 7, 1, 2, 3, 4, 5], "حالة 1")
تأكد_يساوي(ف([1, 2]), [2, 1], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
تأكد_يساوي(ف(["a", "b", "c", "d", "e", "f"]), ["f", "a", "b", "c", "d", "e"], "حالة 4")
