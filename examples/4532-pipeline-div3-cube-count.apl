# مثال 4532 — عدد نتيجة مكعبها للأعداد التقبل القسمة على 3
# Count of cube over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4532-pipeline-div3-cube-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [خ * خ * خ]
  ارجع len(ن)

تأكد_يساوي(ف([3, 1, 2, 8, 5]), 1, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 4, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 4, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 3, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
