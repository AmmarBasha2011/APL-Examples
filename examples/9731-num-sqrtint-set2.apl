# مثال 9731 — الجذر التربيعي الصحيح (مجموعة اختبار 2)
# sqrtint (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9731-num-sqrtint-set2.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(1238), 35, "حالة 1")
تأكد_يساوي(ف(2128), 46, "حالة 2")
تأكد_يساوي(ف(831), 28, "حالة 3")
تأكد_يساوي(ف(2682), 51, "حالة 4")
تأكد_يساوي(ف(4693), 68, "حالة 5")
