# مثال 8379 — العدد من المدى 3 إلى 40 بخطوة 3 بعد (مكعب)
# count over range(3,40,3) mapped by cube
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8379-range-3-40-3-cube-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ * خ * خ]
    خ = خ + (3)
  ارجع len(ر)

تأكد_يساوي(ف(), 13, "المدى كله")
