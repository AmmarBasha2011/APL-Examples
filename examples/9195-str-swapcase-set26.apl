# مثال 9195 — عكس حالة الأحرف (مجموعة اختبار 26)
# swapcase (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9195-str-swapcase-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("python"), "PYTHON", "حالة 1")
تأكد_يساوي(ف("kayak"), "KAYAK", "حالة 2")
تأكد_يساوي(ف("level"), "LEVEL", "حالة 3")
تأكد_يساوي(ف("deed"), "DEED", "حالة 4")
تأكد_يساوي(ف("enlist"), "ENLIST", "حالة 5")
