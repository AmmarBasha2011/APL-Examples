# مثال 5046 — هل القيمة داخل المدى [50, 75]؟
# Is value in range [50,75]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5046-in-range-50-75-p.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= 50 و ن <= 75

تأكد_يساوي(ف(50), صواب, "حالة 1")
تأكد_يساوي(ف(75), صواب, "حالة 2")
تأكد_يساوي(ف(49), خطأ, "حالة 3")
تأكد_يساوي(ف(76), خطأ, "حالة 4")
تأكد_يساوي(ف(62), صواب, "حالة 5")
