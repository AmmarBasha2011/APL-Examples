# مثال 6334 — أول 3 حروف من الناتج بعد أخذ الحروف فقط وتحويلها إلى (رقم الحرف)
# head of code applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6334-txt-alpha-code-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + str(ord(خ))+","
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "104", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "97,", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "97,", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "116", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "122", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "100", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "112", "حالة 8")
