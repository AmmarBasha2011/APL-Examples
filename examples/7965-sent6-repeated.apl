# مثال 7965 — عدد الكلمات المكررة في الجملة رقم 7
# repeated for sentence 7
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7965-sent6-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("tea for two and two for tea"), 3, "حالة 1")
تأكد_يساوي(ف("in the end the end is the start"), 2, "حالة 2")
تأكد_يساوي(ف("nile river nile delta river"), 2, "حالة 3")
