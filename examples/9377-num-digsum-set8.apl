# مثال 9377 — مجموع الأرقام (مجموعة اختبار 8)
# digsum (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9377-num-digsum-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(25498), 28, "حالة 1")
تأكد_يساوي(ف(56225), 20, "حالة 2")
تأكد_يساوي(ف(48766), 31, "حالة 3")
تأكد_يساوي(ف(6677), 26, "حالة 4")
تأكد_يساوي(ف(75280), 22, "حالة 5")
