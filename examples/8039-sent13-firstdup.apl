# مثال 8039 — أول كلمة تتكرر في الجملة رقم 14
# firstdup for sentence 14
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8039-sent13-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("nile river nile delta river"), "nile", "حالة 1")
تأكد_يساوي(ف("sun sand sea sun sand sun"), "sun", "حالة 2")
تأكد_يساوي(ف("the cat and the dog and the bird"), "the", "حالة 3")
