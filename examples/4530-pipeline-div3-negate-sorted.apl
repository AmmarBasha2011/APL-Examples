# مثال 4530 — ترتيب نتيجة سالبها للأعداد التقبل القسمة على 3
# Sorted list of negated over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4530-pipeline-div3-negate-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [0 - خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [-3], "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [], "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [-30, -12, -6, 9], "حالة 3")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [-42, -21], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
