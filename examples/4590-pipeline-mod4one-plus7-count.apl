# مثال 4590 — عدد نتيجة زائد 7 للأعداد الباقي قسمتها على 4 يساوي 1
# Count of plus 7 over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4590-pipeline-mod4one-plus7-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ + 7]
  ارجع len(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 1, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 1, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 1, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 2, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
