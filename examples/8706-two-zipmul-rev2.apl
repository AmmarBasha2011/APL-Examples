# مثال 8706 — حاصل ضرب كل عنصرين (الثانية معكوسة)
# two lists zipmul, rev2
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8706-two-zipmul-rev2.apl

# دالة تأخذ قائمتين
# وتعالجهما معاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ب):
  ب = ب[::-1]
  ر = []
  لكل ي في range(min(len(أ), len(ب))):
    ر = ر + [أ[ي] * ب[ي]]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]), [1, 4, 9, 16, 25], "حالة 1")
تأكد_يساوي(ف([5, 3, 8, 3], [3, 3, 9, 8]), [40, 27, 24, 9], "حالة 2")
تأكد_يساوي(ف([10, 20, 30], [10, 0, 30, 40]), [400, 600, 0], "حالة 3")
تأكد_يساوي(ف([2, 4, 6, 8, 10, 12], [1, 2, 3]), [6, 8, 6], "حالة 4")
تأكد_يساوي(ف([7, 7, 7, 1], [7, 1, 7, 7]), [49, 49, 7, 7], "حالة 5")
تأكد_يساوي(ف([9, 8, 7, 6, 5, 4, 3], [4, 5, 6, 7, 8]), [72, 56, 42, 30, 20], "حالة 6")
