# مثال 10030 — ثاني أكبر قيمة مختلفة (مجموعة 13)
# second (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10030-stat-second-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([17, 31, 38]), 31, "حالة 1")
تأكد_يساوي(ف([36, 34, -17, -2]), 34, "حالة 2")
تأكد_يساوي(ف([23, -8, 56, 40]), 40, "حالة 3")
تأكد_يساوي(ف([-11, 38, 14]), 14, "حالة 4")
