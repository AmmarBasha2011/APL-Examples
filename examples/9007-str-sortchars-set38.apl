# مثال 9007 — حروف الكلمة مرتبة (مجموعة اختبار 38)
# sortchars (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9007-str-sortchars-set38.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("earth"), "aehrt", "حالة 1")
تأكد_يساوي(ف("saturn"), "anrstu", "حالة 2")
تأكد_يساوي(ف("google"), "eggloo", "حالة 3")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 4")
تأكد_يساوي(ف("star"), "arst", "حالة 5")
