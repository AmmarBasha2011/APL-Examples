# مثال 9639 — الأصفار في نهاية العاملي (مجموعة اختبار 30)
# tzeros (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9639-num-tzeros-set30.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(264), 64, "حالة 1")
تأكد_يساوي(ف(441), 108, "حالة 2")
تأكد_يساوي(ف(271), 66, "حالة 3")
تأكد_يساوي(ف(206), 50, "حالة 4")
تأكد_يساوي(ف(74), 16, "حالة 5")
