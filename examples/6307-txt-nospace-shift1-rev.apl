# مثال 6307 — الناتج معكوس بعد أخذ غير المسافات وتحويلها إلى (الحرف التالي)
# rev of shift1 applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6307-txt-nospace-shift1-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: الحرف التالي
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + chr(ord(خ) + 1)
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "35emspxpmmfi", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "ovgtjmqb", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "4d3c2b", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "ypgoxpscldjvrfiu", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "yyyzzz{{{", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "fdofjdt7313bube", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "djcbsbojhojnnbshpsq", "حالة 8")
