# مثال 4876 — مجموع الأعداد من 1 إلى ضعف 10 وزيادة
# Sum 1..n for scaled n (k=10)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4876-triangle-number-10.apl

# مجموع الأعداد المتتالية = ن(ن+1)/2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ن = ن * 10
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 55, "حالة 1")
تأكد_يساوي(ف(2), 210, "حالة 2")
تأكد_يساوي(ف(3), 465, "حالة 3")
تأكد_يساوي(ف(10), 5050, "حالة 4")
