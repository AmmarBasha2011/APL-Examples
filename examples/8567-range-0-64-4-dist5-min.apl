# مثال 8567 — أصغر قيمة من المدى 0 إلى 64 بخطوة 4 بعد (البعد عن 5)
# min over range(0,64,4) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8567-range-0-64-4-dist5-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 64:
    ر = ر + [abs(خ - 5)]
    خ = خ + (4)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 1, "المدى كله")
