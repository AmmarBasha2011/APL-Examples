# مثال 8663 — أصغر قيمة من المدى 2 إلى 26 بخطوة 3 بعد (سالب)
# min over range(2,26,3) mapped by neg
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8663-range-2-26-3-neg-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [0 - خ]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), -23, "المدى كله")
