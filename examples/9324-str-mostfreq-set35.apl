# مثال 9324 — الحرف الأكثر تكراراً (الأول عند التساوي) (مجموعة اختبار 35)
# mostfreq (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9324-str-mostfreq-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ح في ن:
    د[ح] = د.get(ح, 0) + 1
  ب = ن[0]
  لكل ح في ن:
    لو د[ح] > د[ب]:
      ب = ح
  ارجع ب

تأكد_يساوي(ف("banana"), "a", "حالة 1")
تأكد_يساوي(ف("venus"), "v", "حالة 2")
تأكد_يساوي(ف("sun"), "s", "حالة 3")
تأكد_يساوي(ف("deed"), "d", "حالة 4")
تأكد_يساوي(ف("radar"), "r", "حالة 5")
