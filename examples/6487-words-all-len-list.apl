# مثال 6487 — قائمة: كل الكلمات ثم (طول الكلمة)
# list of len over words all
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6487-words-all-len-list.apl

# نقسم النص إلى كلمات
# نصفّي ثم نحوّل كل كلمة
# ونرجع: قائمة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ك في ن.split(" "):
    لو 1 == 1:
      ر = ر + [len(ك)]
  ارجع ر

تأكد_يساوي(ف("the cat sat on the mat"), [3, 3, 3, 2, 3, 3], "حالة 1")
تأكد_يساوي(ف("apl makes code simple and fun"), [3, 5, 4, 6, 3, 3], "حالة 2")
تأكد_يساوي(ف("one two three four five six"), [3, 3, 5, 4, 4, 3], "حالة 3")
تأكد_يساوي(ف("a bb ccc dddd eeeee"), [1, 2, 3, 4, 5], "حالة 4")
تأكد_يساوي(ف("to be or not to be that is the question"), [2, 2, 2, 3, 2, 2, 4, 2, 3, 8], "حالة 5")
تأكد_يساوي(ف("data data data code code apl"), [4, 4, 4, 4, 4, 3], "حالة 6")
تأكد_يساوي(ف("learning to program is learning to think"), [8, 2, 7, 2, 8, 2, 5], "حالة 7")
تأكد_يساوي(ف("hello"), [5], "حالة 8")
