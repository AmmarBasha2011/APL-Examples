# مثال 9986 — التباين الصحيح (مجموعة 19)
# variance (data set 19)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9986-stat-variance-set19.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([42, 51, 19, -4, 35, -11, 30, -13, 45]), 555, "حالة 1")
تأكد_يساوي(ف([26, 23, -11, -8, 26, 5, -6, 17, 38]), 279, "حالة 2")
تأكد_يساوي(ف([2, -1, 7, 6, 28, 29, 20, 39, 59]), 349, "حالة 3")
تأكد_يساوي(ف([-15, 4, 47, 48, 17, -9, 4]), 546, "حالة 4")
