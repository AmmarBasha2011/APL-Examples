# مثال 9276 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 27)
# altcase (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9276-str-altcase-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("comet"), "CoMeT", "حالة 1")
تأكد_يساوي(ف("listen"), "LiStEn", "حالة 2")
تأكد_يساوي(ف("data"), "DaTa", "حالة 3")
تأكد_يساوي(ف("pluto"), "PlUtO", "حالة 4")
تأكد_يساوي(ف("saturn"), "SaTuRn", "حالة 5")
