# مثال 4575 — أصغر نتيجة سالبها للأعداد الأقل من 5
# Smallest (or 0) of negated over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4575-pipeline-small-negate-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), -3, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), -3, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -2, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), -4, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
