# مثال 6670 — الأعداد التي باقيها 3 عند القسمة على 12
# Numbers with remainder 3 mod 12
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6670-residue-12-3.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 12 == 3:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [3], "حالة 2")
تأكد_يساوي(ف(40), [3, 15, 27, 39], "حالة 3")
تأكد_يساوي(ف(75), [3, 15, 27, 39, 51, 63], "حالة 4")
