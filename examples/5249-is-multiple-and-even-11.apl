# مثال 5249 — قابل للقسمة على 11 وزوجي؟
# Divisible by 11 and even
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5249-is-multiple-and-even-11.apl

# شرطان معاً بـ و

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن % 11 == 0 و ن % 2 == 0

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(11), خطأ, "حالة 2")
تأكد_يساوي(ف(22), صواب, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(44), صواب, "حالة 5")
