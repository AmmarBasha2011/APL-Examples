# مثال 4601 — ترتيب نتيجة مكعبها للأعداد الباقي قسمتها على 4 يساوي 1
# Sorted list of cube over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4601-pipeline-mod4one-cube-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ * خ * خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [729], "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [125, 4913], "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [9261], "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [1], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
