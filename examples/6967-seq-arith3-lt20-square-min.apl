# مثال 6967 — أصغر قيمة: من متتالية حسابية بخطوة 3 نأخذ الأصغر من 20 ثم (مربع)
# min over arith3 sequence, keep lt20, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/6967-seq-arith3-lt20-square-min.apl

# نولّد أول ن حد من: متتالية حسابية بخطوة 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 1 + ي * 3
    لو خ < 20:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 1, "حالة 3")
تأكد_يساوي(ف(10), 1, "حالة 4")
تأكد_يساوي(ف(15), 1, "حالة 5")
