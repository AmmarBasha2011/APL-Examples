# مثال 9332 — هل العدد أولي (مجموعة اختبار 3)
# prime (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9332-num-prime-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(4), خطأ, "حالة 1")
تأكد_يساوي(ف(121), خطأ, "حالة 2")
تأكد_يساوي(ف(29), صواب, "حالة 3")
تأكد_يساوي(ف(196), خطأ, "حالة 4")
تأكد_يساوي(ف(101), صواب, "حالة 5")
