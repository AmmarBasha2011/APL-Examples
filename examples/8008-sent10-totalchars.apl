# مثال 8008 — مجموع حروف الكلمات في الجملة رقم 11
# totalchars for sentence 11
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8008-sent10-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("red blue green red blue red"), 22, "حالة 1")
تأكد_يساوي(ف("nile river nile delta river"), 23, "حالة 2")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), 27, "حالة 3")
