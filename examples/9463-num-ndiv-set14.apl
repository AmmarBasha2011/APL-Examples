# مثال 9463 — عدد القواسم (مجموعة اختبار 14)
# ndiv (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9463-num-ndiv-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(166), 4, "حالة 1")
تأكد_يساوي(ف(250), 8, "حالة 2")
تأكد_يساوي(ف(261), 6, "حالة 3")
تأكد_يساوي(ف(188), 6, "حالة 4")
تأكد_يساوي(ف(126), 12, "حالة 5")
