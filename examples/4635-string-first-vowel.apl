# مثال 4635 — أول موضع (حرف علة) في نص
# String: first position of vowel
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4635-string-first-vowel.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  لكل خ في س:
    لو "aeiou".find(خ.lower()) != -1:
      ارجع ر
    ر = ر + 1
  ارجع -1

تأكد_يساوي(ف("a1b2c3d4"), 0, "حالة 1")
تأكد_يساوي(ف("apple PIE 7 and 9"), 0, "حالة 2")
تأكد_يساوي(ف("2026-11-28 launch"), 12, "حالة 3")
تأكد_يساوي(ف("aeiou AEIOU xyz"), 0, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
