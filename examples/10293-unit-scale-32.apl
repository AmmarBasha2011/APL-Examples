# مثال 10293 — تحويل وحدة إلى 32 وحدات صغرى والعكس
# Convert units with factor 32
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10293-unit-scale-32.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 32, ن // 32, ن % 32]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [32, 0, 1], "حالة 2")
تأكد_يساوي(ف(32), [1024, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [32000, 31, 8], "حالة 4")
