# مثال 4609 — عدد نتيجة ضعفها للأعداد الغير الصفرية
# Count of double over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4609-pipeline-notzero-double-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ * 2]
  ارجع len(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 3, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 5, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 5, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 6, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
