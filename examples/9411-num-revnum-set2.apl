# مثال 9411 — عكس الأرقام (مجموعة اختبار 2)
# revnum (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9411-num-revnum-set2.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(88752), 25788, "حالة 1")
تأكد_يساوي(ف(5669), 9665, "حالة 2")
تأكد_يساوي(ف(68218), 81286, "حالة 3")
تأكد_يساوي(ف(15818), 81851, "حالة 4")
تأكد_يساوي(ف(67042), 24076, "حالة 5")
