# مثال 7919 — أول كلمة تتكرر في الجملة رقم 2
# firstdup for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7919-sent1-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("to be or not to be"), "to", "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), "a", "حالة 2")
تأكد_يساوي(ف("a b c a b a"), "a", "حالة 3")
