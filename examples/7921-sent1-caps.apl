# مثال 7921 — أول حرف كبير لكل كلمة في الجملة رقم 2
# caps for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7921-sent1-caps.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ك في ن.split(" "):
    ر = ر + [ك[0].upper() + ك[1:]]
  ارجع " ".join(ر)

تأكد_يساوي(ف("to be or not to be"), "To Be Or Not To Be", "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), "A Rose Is A Rose Is A Rose", "حالة 2")
تأكد_يساوي(ف("a b c a b a"), "A B C A B A", "حالة 3")
