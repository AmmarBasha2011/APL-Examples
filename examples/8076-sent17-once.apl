# مثال 8076 — عدد الكلمات التي ظهرت مرة واحدة في الجملة رقم 18
# once for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8076-sent17-once.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] == 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("bread milk bread eggs milk bread"), 1, "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), 3, "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), 0, "حالة 3")
