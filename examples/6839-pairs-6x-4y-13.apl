# مثال 6839 — عدد حلول 6س + 4ص = 13
# Count solutions of 6x+4y=13
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6839-pairs-6x-4y-13.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 6 * س + 4 * ص == 13:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 0, "حالة 3")
تأكد_يساوي(ف(13), 0, "حالة 4")
