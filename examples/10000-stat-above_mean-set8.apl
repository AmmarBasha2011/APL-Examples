# مثال 10000 — عدد العناصر فوق المتوسط (مجموعة 8)
# above_mean (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10000-stat-above_mean-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([27, -10, 37, 10, 33, 32]), 4, "حالة 1")
تأكد_يساوي(ف([-8, 15, 3]), 1, "حالة 2")
تأكد_يساوي(ف([10, -11, 10, 42, -17, 10, 24, 26]), 3, "حالة 3")
تأكد_يساوي(ف([38, 11, 39, 54, 10, 18, -15, 37, 42]), 5, "حالة 4")
