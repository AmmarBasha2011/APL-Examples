# مثال 10060 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 18)
# spread (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10060-stat-spread-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([1, 27, 13, 32, -14, 42]), 15, "حالة 1")
تأكد_يساوي(ف([16, 3, 28, -3, 56]), 28, "حالة 2")
تأكد_يساوي(ف([-6, 25, -17, 18, 50, -5, 6, 59, 44]), 19, "حالة 3")
تأكد_يساوي(ف([-2, 51, 13, -8, -20, -3, -20, 10]), 38, "حالة 4")
