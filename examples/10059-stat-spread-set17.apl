# مثال 10059 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 17)
# spread (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10059-stat-spread-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([26, 1, 60, 25, 1, 34, -15]), 26, "حالة 1")
تأكد_يساوي(ف([28, 44, -11, 11, 20, 5, -7, 21, 48]), 16, "حالة 2")
تأكد_يساوي(ف([11, 53, -12, 60]), 42, "حالة 3")
تأكد_يساوي(ف([-12, -9, 58]), 67, "حالة 4")
