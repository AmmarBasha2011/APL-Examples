# مثال 8072 — تكرار كل كلمة في الجملة رقم 18
# freq for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8072-sent17-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("bread milk bread eggs milk bread"), {"bread": 3, "milk": 2, "eggs": 1}, "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), {"the": 3, "cat": 1, "and": 2, "dog": 1, "bird": 1}, "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), {"a": 3, "rose": 3, "is": 2}, "حالة 3")
