# مثال 8015 — عدد الكلمات المكررة في الجملة رقم 12
# repeated for sentence 12
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8015-sent11-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("up down up down up up down"), 2, "حالة 1")
تأكد_يساوي(ف("learn code learn more code more"), 3, "حالة 2")
تأكد_يساوي(ف("left right left left right"), 2, "حالة 3")
