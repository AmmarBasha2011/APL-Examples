# مثال 4694 — أكبر الأعداد المربع كامل حتى حد معين
# Numbers up to a limit: largest of the perfect square ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4694-numbers-largest-square.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو int(ر ** 0.5) * int(ر ** 0.5) == ر:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(23), 16, "حالة 1")
تأكد_يساوي(ف(49), 49, "حالة 2")
تأكد_يساوي(ف(107), 100, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
