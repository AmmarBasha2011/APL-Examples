# مثال 9690 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 1)
# popcnt (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9690-num-popcnt-set1.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(4700), 6, "حالة 1")
تأكد_يساوي(ف(660), 4, "حالة 2")
تأكد_يساوي(ف(3973), 7, "حالة 3")
تأكد_يساوي(ف(2143), 7, "حالة 4")
تأكد_يساوي(ف(301), 5, "حالة 5")
