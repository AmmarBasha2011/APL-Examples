# مثال 7064 — العدد: من المربعات نأخذ الموجب ثم (زيادة واحد)
# count over squares sequence, keep pos, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7064-seq-squares-pos-inc-count.apl

# نولّد أول ن حد من: المربعات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي
    لو خ > 0:
      ر = ر + [خ + 1]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 4, "حالة 3")
تأكد_يساوي(ف(10), 9, "حالة 4")
تأكد_يساوي(ف(15), 14, "حالة 5")
