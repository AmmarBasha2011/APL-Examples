# مثال 9990 — التباين الصحيح (مجموعة 23)
# variance (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9990-stat-variance-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([39, 2, 40, -12, -3]), 481, "حالة 1")
تأكد_يساوي(ف([19, -16, 57, 59, 42, -11, 7]), 823, "حالة 2")
تأكد_يساوي(ف([54, 33, -8, 49, 30, 43, 1, -7, -20]), 696, "حالة 3")
تأكد_يساوي(ف([8, -14, 21]), 208, "حالة 4")
