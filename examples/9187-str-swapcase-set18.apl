# مثال 9187 — عكس حالة الأحرف (مجموعة اختبار 18)
# swapcase (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9187-str-swapcase-set18.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("noon"), "NOON", "حالة 1")
تأكد_يساوي(ف("pluto"), "PLUTO", "حالة 2")
تأكد_يساوي(ف("python"), "PYTHON", "حالة 3")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 4")
تأكد_يساوي(ف("listen"), "LISTEN", "حالة 5")
