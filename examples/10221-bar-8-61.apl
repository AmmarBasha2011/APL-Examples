# مثال 10221 — شريط بعرض 8 من الرمز =
# Bar of width 8 using =
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10221-bar-8-61.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "="
  ارجع ر + "|" + str(8)

تأكد_يساوي(ف(0), "|8", "حالة 1")
تأكد_يساوي(ف(3), "===|8", "حالة 2")
تأكد_يساوي(ف(8), "========|8", "حالة 3")
