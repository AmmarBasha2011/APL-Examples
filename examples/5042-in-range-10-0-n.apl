# مثال 5042 — هل القيمة داخل المدى [-10, 0]؟
# Is value in range [-10,0]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5042-in-range-10-0-n.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= -10 و ن <= 0

تأكد_يساوي(ف(-10), صواب, "حالة 1")
تأكد_يساوي(ف(0), صواب, "حالة 2")
تأكد_يساوي(ف(-11), خطأ, "حالة 3")
تأكد_يساوي(ف(1), خطأ, "حالة 4")
تأكد_يساوي(ف(-5), صواب, "حالة 5")
