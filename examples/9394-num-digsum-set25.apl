# مثال 9394 — مجموع الأرقام (مجموعة اختبار 25)
# digsum (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9394-num-digsum-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(91571), 23, "حالة 1")
تأكد_يساوي(ف(85723), 25, "حالة 2")
تأكد_يساوي(ف(6148), 19, "حالة 3")
تأكد_يساوي(ف(59492), 29, "حالة 4")
تأكد_يساوي(ف(52502), 14, "حالة 5")
