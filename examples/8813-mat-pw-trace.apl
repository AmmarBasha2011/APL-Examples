# مثال 8813 — مجموع القطر لمصفوفة قيمها i**2 - j
# Matrix trace for cell formula i**2 - j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8813-mat-pw-trace.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي - ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  م = 0
  لكل ي في range(len(ق)):
    م = م + ق[ي][ي]
  ارجع م

تأكد_يساوي(ف(بناء(1)), 0, "حجم 1")
تأكد_يساوي(ف(بناء(2)), 0, "حجم 2")
تأكد_يساوي(ف(بناء(3)), 2, "حجم 3")
تأكد_يساوي(ف(بناء(5)), 20, "حجم 5")
