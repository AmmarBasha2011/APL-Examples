# مثال 6818 — عدد حلول 3س + 1ص = 17
# Count solutions of 3x+1y=17
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6818-pairs-3x-1y-17.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 3 * س + 1 * ص == 17:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 3, "حالة 3")
تأكد_يساوي(ف(17), 6, "حالة 4")
