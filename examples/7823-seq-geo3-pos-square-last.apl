# مثال 7823 — آخر عنصر: من قوى 3 نأخذ الموجب ثم (مربع)
# last over geo3 sequence, keep pos, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7823-seq-geo3-pos-square-last.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ > 0:
      ر = ر + [خ * خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 6561, "حالة 3")
تأكد_يساوي(ف(10), 387420489, "حالة 4")
تأكد_يساوي(ف(15), 22876792454961, "حالة 5")
