# مثال 9686 — هل العدد أرمسترونغ (مجموعة اختبار 37)
# arm (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9686-num-arm-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(695), خطأ, "حالة 1")
تأكد_يساوي(ف(961), خطأ, "حالة 2")
تأكد_يساوي(ف(951), خطأ, "حالة 3")
تأكد_يساوي(ف(69), خطأ, "حالة 4")
تأكد_يساوي(ف(672), خطأ, "حالة 5")
