# مثال 4877 — محيط مضلع منتظم عدد أضلاعه 11
# Perimeter of regular 11-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4877-polygon-perimeter-11.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 11 * ض

تأكد_يساوي(ف(1), 11, "حالة 1")
تأكد_يساوي(ف(5), 55, "حالة 2")
تأكد_يساوي(ف(12), 132, "حالة 3")
تأكد_يساوي(ف(7), 77, "حالة 4")
