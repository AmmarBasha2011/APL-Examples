# مثال 8449 — أول عنصر من المدى 10 إلى 0 بخطوة -1 بعد (البعد عن 5)
# first over range(10,0,-1) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8449-range-10-0-n1-dist5-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 10
  طالما خ > 0:
    ر = ر + [abs(خ - 5)]
    خ = خ + (-1)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 5, "المدى كله")
