# مثال 8945 — عدد حروف العلة (مجموعة اختبار 16)
# vowels (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8945-str-vowels-set16.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح في "aeiou":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("rotor"), 2, "حالة 1")
تأكد_يساوي(ف("google"), 3, "حالة 2")
تأكد_يساوي(ف("rocket"), 2, "حالة 3")
تأكد_يساوي(ف("river"), 2, "حالة 4")
تأكد_يساوي(ف("moon"), 2, "حالة 5")
