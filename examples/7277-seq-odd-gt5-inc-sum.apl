# مثال 7277 — المجموع: من الأعداد الفردية نأخذ الأكبر من 5 ثم (زيادة واحد)
# sum over odd sequence, keep gt5, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7277-seq-odd-gt5-inc-sum.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ > 5:
      ر = ر + [خ + 1]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 18, "حالة 3")
تأكد_يساوي(ف(10), 98, "حالة 4")
تأكد_يساوي(ف(15), 228, "حالة 5")
