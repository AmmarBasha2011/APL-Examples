# مثال 9400 — مجموع الأرقام (مجموعة اختبار 31)
# digsum (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9400-num-digsum-set31.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(6615), 18, "حالة 1")
تأكد_يساوي(ف(36694), 28, "حالة 2")
تأكد_يساوي(ف(85915), 28, "حالة 3")
تأكد_يساوي(ف(34200), 9, "حالة 4")
تأكد_يساوي(ف(72904), 22, "حالة 5")
