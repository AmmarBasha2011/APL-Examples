# مثال 9775 — إزاحة لليسار 2 خانات
# Shift left by 2
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9775-bits-shl-2.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 4, "حالة 2")
تأكد_يساوي(ف(5), 20, "حالة 3")
تأكد_يساوي(ف(100), 400, "حالة 4")
