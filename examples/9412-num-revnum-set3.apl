# مثال 9412 — عكس الأرقام (مجموعة اختبار 3)
# revnum (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9412-num-revnum-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(10147), 74101, "حالة 1")
تأكد_يساوي(ف(27999), 99972, "حالة 2")
تأكد_يساوي(ف(18958), 85981, "حالة 3")
تأكد_يساوي(ف(39731), 13793, "حالة 4")
تأكد_يساوي(ف(91534), 43519, "حالة 5")
