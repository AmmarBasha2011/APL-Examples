# مثال 9937 — المنوال (الأصغر عند التساوي) (مجموعة 20)
# mode (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9937-stat-mode-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([26, 24, -10, 42, 29]), -10, "حالة 1")
تأكد_يساوي(ف([33, 59, -20, 2, -1, 28, 15, -16]), -20, "حالة 2")
تأكد_يساوي(ف([6, -10, 33, 53]), -10, "حالة 3")
تأكد_يساوي(ف([-8, -12, -19, 14, 44, 2, 24, 34, -15]), -19, "حالة 4")
