# مثال 4502 — أكبر نتيجة زائد 7 للأعداد الموجبة
# Largest (or 0) of plus 7 over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4502-pipeline-positive-plus7-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ + 7]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 32, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 27, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 37, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 22, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
