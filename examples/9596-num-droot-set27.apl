# مثال 9596 — الجذر الرقمي (مجموعة اختبار 27)
# droot (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9596-num-droot-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(24582), 3, "حالة 1")
تأكد_يساوي(ف(65456), 8, "حالة 2")
تأكد_يساوي(ف(99677), 2, "حالة 3")
تأكد_يساوي(ف(20906), 8, "حالة 4")
تأكد_يساوي(ف(59457), 3, "حالة 5")
