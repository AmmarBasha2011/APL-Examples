# مثال 4905 — اليوم بعد 8 أيام
# Weekday 8 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4905-week-day-shift-8.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 8) % 7

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(3), 4, "حالة 2")
تأكد_يساوي(ف(6), 0, "حالة 3")
تأكد_يساوي(ف(4), 5, "حالة 4")
