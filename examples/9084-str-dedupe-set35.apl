# مثال 9084 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 35)
# dedupe (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9084-str-dedupe-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("star"), "star", "حالة 1")
تأكد_يساوي(ف("sun"), "sun", "حالة 2")
تأكد_يساوي(ف("galaxy"), "galxy", "حالة 3")
تأكد_يساوي(ف("radar"), "rad", "حالة 4")
تأكد_يساوي(ف("deed"), "de", "حالة 5")
