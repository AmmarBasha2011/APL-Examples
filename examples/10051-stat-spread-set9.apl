# مثال 10051 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 9)
# spread (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10051-stat-spread-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([44, 12, 32, 23, 7]), 12, "حالة 1")
تأكد_يساوي(ف([44, 21, 41]), 20, "حالة 2")
تأكد_يساوي(ف([54, 2, 37, -18, -12, 7, 11, 58]), 26, "حالة 3")
تأكد_يساوي(ف([17, -5, 23, 47, -16, -20, 29, -7]), 22, "حالة 4")
