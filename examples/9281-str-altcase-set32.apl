# مثال 9281 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 32)
# altcase (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9281-str-altcase-set32.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("radar"), "RaDaR", "حالة 1")
تأكد_يساوي(ف("river"), "RiVeR", "حالة 2")
تأكد_يساوي(ف("galaxy"), "GaLaXy", "حالة 3")
تأكد_يساوي(ف("earth"), "EaRtH", "حالة 4")
تأكد_يساوي(ف("tenet"), "TeNeT", "حالة 5")
