# مثال 6746 — القوة بالباقي على 37
# Modular power mod 37
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6746-modpow-37.apl

# نضرب ونأخذ الباقي في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ب, أ):
  ر = 1
  لكل ي في range(أ):
    ر = ر * ب % 37
  ارجع ر

تأكد_يساوي(ف(2, 0), 1, "حالة 1")
تأكد_يساوي(ف(2, 10), 25, "حالة 2")
تأكد_يساوي(ف(3, 7), 4, "حالة 3")
تأكد_يساوي(ف(7, 13), 33, "حالة 4")
تأكد_يساوي(ف(10, 20), 26, "حالة 5")
