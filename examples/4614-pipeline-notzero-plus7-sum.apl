# مثال 4614 — مجموع نتيجة زائد 7 للأعداد الغير الصفرية
# Sum of plus 7 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4614-pipeline-notzero-plus7-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ + 7]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 50, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 189, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 69, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 87, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
