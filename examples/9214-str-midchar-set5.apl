# مثال 9214 — الحرف الأوسط (مجموعة اختبار 5)
# midchar (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9214-str-midchar-set5.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("saturn"), "u", "حالة 1")
تأكد_يساوي(ف("loop"), "o", "حالة 2")
تأكد_يساوي(ف("stats"), "a", "حالة 3")
تأكد_يساوي(ف("data"), "t", "حالة 4")
تأكد_يساوي(ف("silent"), "e", "حالة 5")
