# مثال 9533 — خطوات كولاتز (مجموعة اختبار 4)
# collatz (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9533-num-collatz-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(20), 7, "حالة 1")
تأكد_يساوي(ف(103), 87, "حالة 2")
تأكد_يساوي(ف(11), 14, "حالة 3")
تأكد_يساوي(ف(151), 15, "حالة 4")
تأكد_يساوي(ف(151), 15, "حالة 5")
