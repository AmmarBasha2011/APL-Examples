# مثال 9835 — إزاحة لليسار 14 خانات
# Shift left by 14
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9835-bits-shl-14.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 14

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 16384, "حالة 2")
تأكد_يساوي(ف(5), 81920, "حالة 3")
تأكد_يساوي(ف(100), 1638400, "حالة 4")
