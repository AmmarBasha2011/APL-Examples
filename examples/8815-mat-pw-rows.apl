# مثال 8815 — مجموع كل صف لمصفوفة قيمها i**2 - j
# Matrix rows for cell formula i**2 - j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8815-mat-pw-rows.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي - ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل س في ق:
    م = 0
    لكل خ في س:
      م = م + خ
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [-1, 1], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [-3, 0, 9], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [-10, -5, 10, 35, 70], "حجم 5")
