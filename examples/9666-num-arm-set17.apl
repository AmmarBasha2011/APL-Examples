# مثال 9666 — هل العدد أرمسترونغ (مجموعة اختبار 17)
# arm (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9666-num-arm-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(579), خطأ, "حالة 1")
تأكد_يساوي(ف(366), خطأ, "حالة 2")
تأكد_يساوي(ف(759), خطأ, "حالة 3")
تأكد_يساوي(ف(248), خطأ, "حالة 4")
تأكد_يساوي(ف(22), خطأ, "حالة 5")
