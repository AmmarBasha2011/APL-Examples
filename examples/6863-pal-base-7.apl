# مثال 6863 — هل العدد متناظر في الأساس 7؟
# Palindrome in base 7
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6863-pal-base-7.apl

# نستخرج أرقام العدد في الأساس
# ونقارنها بمعكوسها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = []
  لو ن == 0:
    د = [0]
  طالما ن > 0:
    د = [ن % 7] + د
    ن = ن // 7
  ارجع د == د[::-1]

تأكد_يساوي(ف(0), صواب, "حالة 1")
تأكد_يساوي(ف(1), صواب, "حالة 2")
تأكد_يساوي(ف(5), صواب, "حالة 3")
تأكد_يساوي(ف(9), خطأ, "حالة 4")
تأكد_يساوي(ف(33), خطأ, "حالة 5")
تأكد_يساوي(ف(121), صواب, "حالة 6")
تأكد_يساوي(ف(585), خطأ, "حالة 7")
تأكد_يساوي(ف(100), صواب, "حالة 8")
