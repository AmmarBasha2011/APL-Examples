# مثال 7123 — آخر عنصر: من الأعداد المثلثية نأخذ الأصغر من 20 ثم (ضعف)
# last over tri sequence, keep lt20, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7123-seq-tri-lt20-double-last.apl

# نولّد أول ن حد من: الأعداد المثلثية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (ي + 1) // 2
    لو خ < 20:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 20, "حالة 3")
تأكد_يساوي(ف(10), 30, "حالة 4")
تأكد_يساوي(ف(15), 30, "حالة 5")
