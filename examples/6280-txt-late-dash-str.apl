# مثال 6280 — النص الناتج بعد أخذ حروف آخر الأبجدية وتحويلها إلى (حرف مع شرطة)
# str of dash applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6280-txt-late-dash-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + خ + "-"
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "o-w-o-r-", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "p-s-u-n-", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "t-q-u-r-o-w-n-o-x-", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "z-z-z-y-y-y-x-x-x-", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "t-s-n-", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "p-r-o-r-n-n-r-", "حالة 8")
