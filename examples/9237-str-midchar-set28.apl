# مثال 9237 — الحرف الأوسط (مجموعة اختبار 28)
# midchar (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9237-str-midchar-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("mars"), "r", "حالة 1")
تأكد_يساوي(ف("apple"), "p", "حالة 2")
تأكد_يساوي(ف("rotor"), "t", "حالة 3")
تأكد_يساوي(ف("planet"), "n", "حالة 4")
تأكد_يساوي(ف("google"), "g", "حالة 5")
