# مثال 6633 — الأعداد التي باقيها 2 عند القسمة على 5
# Numbers with remainder 2 mod 5
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6633-residue-5-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 5 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2, 7], "حالة 2")
تأكد_يساوي(ف(40), [2, 7, 12, 17, 22, 27, 32, 37], "حالة 3")
تأكد_يساوي(ف(75), [2, 7, 12, 17, 22, 27, 32, 37, 42, 47, 52, 57, 62, 67, 72], "حالة 4")
