# مثال 8970 — حروف الكلمة مرتبة (مجموعة اختبار 1)
# sortchars (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8970-str-sortchars-set1.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("galaxy"), "aaglxy", "حالة 1")
تأكد_يساوي(ف("refer"), "eefrr", "حالة 2")
تأكد_يساوي(ف("listen"), "eilnst", "حالة 3")
تأكد_يساوي(ف("stats"), "asstt", "حالة 4")
تأكد_يساوي(ف("array"), "aarry", "حالة 5")
