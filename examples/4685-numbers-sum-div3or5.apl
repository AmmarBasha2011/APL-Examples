# مثال 4685 — مجموع الأعداد التقبل القسمة على 3 أو 5 حتى حد معين
# Numbers up to a limit: sum of the divisible by 3 or 5 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4685-numbers-sum-div3or5.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 3 == 0 أو ر % 5 == 0:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(27), 195, "حالة 1")
تأكد_يساوي(ف(31), 225, "حالة 2")
تأكد_يساوي(ف(131), 4053, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
