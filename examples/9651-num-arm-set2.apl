# مثال 9651 — هل العدد أرمسترونغ (مجموعة اختبار 2)
# arm (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9651-num-arm-set2.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(371), صواب, "حالة 1")
تأكد_يساوي(ف(481), خطأ, "حالة 2")
تأكد_يساوي(ف(493), خطأ, "حالة 3")
تأكد_يساوي(ف(292), خطأ, "حالة 4")
تأكد_يساوي(ف(427), خطأ, "حالة 5")
