# مثال 9647 — الأصفار في نهاية العاملي (مجموعة اختبار 38)
# tzeros (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9647-num-tzeros-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(419), 102, "حالة 1")
تأكد_يساوي(ف(450), 111, "حالة 2")
تأكد_يساوي(ف(431), 106, "حالة 3")
تأكد_يساوي(ف(462), 113, "حالة 4")
تأكد_يساوي(ف(308), 75, "حالة 5")
