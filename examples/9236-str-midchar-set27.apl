# مثال 9236 — الحرف الأوسط (مجموعة اختبار 27)
# midchar (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9236-str-midchar-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("comet"), "m", "حالة 1")
تأكد_يساوي(ف("listen"), "t", "حالة 2")
تأكد_يساوي(ف("data"), "t", "حالة 3")
تأكد_يساوي(ف("pluto"), "u", "حالة 4")
تأكد_يساوي(ف("saturn"), "u", "حالة 5")
