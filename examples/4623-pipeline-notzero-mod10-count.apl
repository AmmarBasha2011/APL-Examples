# مثال 4623 — عدد نتيجة باقي قسمتها على 10 للأعداد الغير الصفرية
# Count of last digit mod 10 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4623-pipeline-notzero-mod10-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ % 10]
  ارجع len(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 7, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 5, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 7, "حالة 3")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 6, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
