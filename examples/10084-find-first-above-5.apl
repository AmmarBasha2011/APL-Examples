# مثال 10084 — موضع أول عنصر أكبر من 5
# Index of first item above 5
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10084-find-first-above-5.apl

# نرجع -1 إن لم نجد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لكل ي في range(len(ق)):
    لو ق[ي] > 5:
      ارجع ي
  ارجع -1

تأكد_يساوي(ف([1, 5, 9, 14, 20, 31, 40]), 2, "حالة 1")
تأكد_يساوي(ف([0, 0, 0]), -1, "حالة 2")
تأكد_يساوي(ف([100]), 0, "حالة 3")
تأكد_يساوي(ف([]), -1, "حالة 4")
