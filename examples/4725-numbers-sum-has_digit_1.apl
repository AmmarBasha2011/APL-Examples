# مثال 4725 — مجموع الأعداد اليحتوي على الرقم 1 حتى حد معين
# Numbers up to a limit: sum of the contains digit 1 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4725-numbers-sum-has_digit_1.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو str(ر).find("1") != -1:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(21), 167, "حالة 1")
تأكد_يساوي(ف(51), 290, "حالة 2")
تأكد_يساوي(ف(121), 3025, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
