# مثال 5037 — حصر القيمة بين 10 و 20
# Clamp value into [10,20]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5037-clamp-10-20.apl

# إن كانت أقل من الحد الأدنى نرجع الحد الأدنى
# وإن زادت نرجع الحد الأعلى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 10:
    ارجع 10
  لو ن > 20:
    ارجع 20
  ارجع ن

تأكد_يساوي(ف(5), 10, "حالة 1")
تأكد_يساوي(ف(25), 20, "حالة 2")
تأكد_يساوي(ف(15), 15, "حالة 3")
تأكد_يساوي(ف(10), 10, "حالة 4")
تأكد_يساوي(ف(20), 20, "حالة 5")
