# مثال 9402 — مجموع الأرقام (مجموعة اختبار 33)
# digsum (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9402-num-digsum-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(50587), 25, "حالة 1")
تأكد_يساوي(ف(38291), 23, "حالة 2")
تأكد_يساوي(ف(811), 10, "حالة 3")
تأكد_يساوي(ف(41960), 20, "حالة 4")
تأكد_يساوي(ف(66033), 18, "حالة 5")
