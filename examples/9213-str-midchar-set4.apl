# مثال 9213 — الحرف الأوسط (مجموعة اختبار 4)
# midchar (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9213-str-midchar-set4.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("civic"), "v", "حالة 1")
تأكد_يساوي(ف("stats"), "a", "حالة 2")
تأكد_يساوي(ف("earth"), "r", "حالة 3")
تأكد_يساوي(ف("array"), "r", "حالة 4")
تأكد_يساوي(ف("tenet"), "n", "حالة 5")
