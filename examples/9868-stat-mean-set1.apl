# مثال 9868 — المتوسط الصحيح (مجموعة 1)
# mean (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9868-stat-mean-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([18, -7, 30, 41]), 20, "حالة 1")
تأكد_يساوي(ف([-9, -12, -18, 31]), -2, "حالة 2")
تأكد_يساوي(ف([17, -13, 8, 46, 48, 26, 15]), 21, "حالة 3")
تأكد_يساوي(ف([2, -7, 13, 7, -17, 13, 14, 4, 1]), 3, "حالة 4")
