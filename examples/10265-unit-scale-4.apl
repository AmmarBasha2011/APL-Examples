# مثال 10265 — تحويل وحدة إلى 4 وحدات صغرى والعكس
# Convert units with factor 4
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10265-unit-scale-4.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 4, ن // 4, ن % 4]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [4, 0, 1], "حالة 2")
تأكد_يساوي(ف(4), [16, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [4000, 250, 0], "حالة 4")
