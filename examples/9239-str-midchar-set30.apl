# مثال 9239 — الحرف الأوسط (مجموعة اختبار 30)
# midchar (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9239-str-midchar-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("sun"), "u", "حالة 1")
تأكد_يساوي(ف("level"), "v", "حالة 2")
تأكد_يساوي(ف("moon"), "o", "حالة 3")
تأكد_يساوي(ف("code"), "d", "حالة 4")
تأكد_يساوي(ف("apple"), "p", "حالة 5")
