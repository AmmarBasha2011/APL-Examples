# مثال 9952 — المدى (مجموعة 10)
# range (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9952-stat-range-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([15, 27, -7]), 34, "حالة 1")
تأكد_يساوي(ف([38, 18, 44, -2, 40, -4, 2, -11, 21]), 55, "حالة 2")
تأكد_يساوي(ف([-4, -13, 59, 7, 9]), 72, "حالة 3")
تأكد_يساوي(ف([20, 45, 17, -2, 0, 28, 22, 39]), 47, "حالة 4")
