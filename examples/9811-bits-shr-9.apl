# مثال 9811 — إزاحة لليمين 9 خانات
# Shift right by 9
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9811-bits-shr-9.apl

# الإزاحة لليمين تقسم وتقتطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 9

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(4096), 8, "حالة 3")
تأكد_يساوي(ف(100000), 195, "حالة 4")
