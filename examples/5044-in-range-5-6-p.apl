# مثال 5044 — هل القيمة داخل المدى [5, 6]؟
# Is value in range [5,6]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5044-in-range-5-6-p.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= 5 و ن <= 6

تأكد_يساوي(ف(5), صواب, "حالة 1")
تأكد_يساوي(ف(6), صواب, "حالة 2")
تأكد_يساوي(ف(4), خطأ, "حالة 3")
تأكد_يساوي(ف(7), خطأ, "حالة 4")
تأكد_يساوي(ف(5), صواب, "حالة 5")
