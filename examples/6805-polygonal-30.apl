# مثال 6805 — العدد المضلّع ذو 30 أضلاع
# 30-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6805-polygonal-30.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((30 - 2) * ن * ن - (30 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 30, "حالة 2")
تأكد_يساوي(ف(5), 285, "حالة 3")
تأكد_يساوي(ف(10), 1270, "حالة 4")
