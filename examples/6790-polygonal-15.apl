# مثال 6790 — العدد المضلّع ذو 15 أضلاع
# 15-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6790-polygonal-15.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((15 - 2) * ن * ن - (15 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 15, "حالة 2")
تأكد_يساوي(ف(5), 135, "حالة 3")
تأكد_يساوي(ف(10), 595, "حالة 4")
