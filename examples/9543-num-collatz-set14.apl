# مثال 9543 — خطوات كولاتز (مجموعة اختبار 14)
# collatz (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9543-num-collatz-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(8), 3, "حالة 1")
تأكد_يساوي(ف(15), 17, "حالة 2")
تأكد_يساوي(ف(197), 26, "حالة 3")
تأكد_يساوي(ف(58), 19, "حالة 4")
تأكد_يساوي(ف(200), 26, "حالة 5")
