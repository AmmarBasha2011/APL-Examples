# مثال 9735 — الجذر التربيعي الصحيح (مجموعة اختبار 6)
# sqrtint (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9735-num-sqrtint-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(601), 24, "حالة 1")
تأكد_يساوي(ف(4869), 69, "حالة 2")
تأكد_يساوي(ف(1525), 39, "حالة 3")
تأكد_يساوي(ف(2817), 53, "حالة 4")
تأكد_يساوي(ف(4456), 66, "حالة 5")
