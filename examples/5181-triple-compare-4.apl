# مثال 5181 — مقارنة العدد مع 4
# Compare number with 4
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5181-triple-compare-4.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 4:
    ارجع "اصغر"
  والا_لو ن > 4:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(3), "اصغر", "حالة 1")
تأكد_يساوي(ف(4), "يساوي", "حالة 2")
تأكد_يساوي(ف(5), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
