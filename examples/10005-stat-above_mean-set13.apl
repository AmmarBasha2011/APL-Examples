# مثال 10005 — عدد العناصر فوق المتوسط (مجموعة 13)
# above_mean (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10005-stat-above_mean-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([13, -3, 23]), 2, "حالة 1")
تأكد_يساوي(ف([45, -15, 23, 54]), 2, "حالة 2")
تأكد_يساوي(ف([42, 52, 1, 23, 20, -16, 37, 7, 60]), 4, "حالة 3")
تأكد_يساوي(ف([2, 35, 26, 52, 3, 22, 4, 9]), 4, "حالة 4")
