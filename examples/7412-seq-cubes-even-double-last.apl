# مثال 7412 — آخر عنصر: من المكعبات نأخذ الزوجي ثم (ضعف)
# last over cubes sequence, keep even, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7412-seq-cubes-even-double-last.apl

# نولّد أول ن حد من: المكعبات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي * ي
    لو خ % 2 == 0:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 128, "حالة 3")
تأكد_يساوي(ف(10), 1024, "حالة 4")
تأكد_يساوي(ف(15), 5488, "حالة 5")
