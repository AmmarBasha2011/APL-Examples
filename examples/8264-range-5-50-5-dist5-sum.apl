# مثال 8264 — المجموع من المدى 5 إلى 50 بخطوة 5 بعد (البعد عن 5)
# sum over range(5,50,5) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8264-range-5-50-5-dist5-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [abs(خ - 5)]
    خ = خ + (5)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 180, "المدى كله")
