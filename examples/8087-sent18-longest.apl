# مثال 8087 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 19
# longest for sentence 19
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8087-sent18-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("left right left left right"), "right", "حالة 1")
تأكد_يساوي(ف("to be or not to be"), "not", "حالة 2")
تأكد_يساوي(ف("we love data and data loves us"), "loves", "حالة 3")
