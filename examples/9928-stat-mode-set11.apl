# مثال 9928 — المنوال (الأصغر عند التساوي) (مجموعة 11)
# mode (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9928-stat-mode-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([38, -6, 2, -20]), -20, "حالة 1")
تأكد_يساوي(ف([60, 17, 9, 31, 6, 31, 49, 37]), 31, "حالة 2")
تأكد_يساوي(ف([60, 2, -4]), -4, "حالة 3")
تأكد_يساوي(ف([11, -17, 10]), -17, "حالة 4")
