# مثال 10042 — ثاني أكبر قيمة مختلفة (مجموعة 25)
# second (data set 25)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10042-stat-second-set25.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([34, -3, 10, 39, 54]), 39, "حالة 1")
تأكد_يساوي(ف([-15, -7, 60]), -7, "حالة 2")
تأكد_يساوي(ف([19, 59, 25, 12, -7, 32, 32, 29]), 32, "حالة 3")
تأكد_يساوي(ف([42, 56, 2]), 42, "حالة 4")
