# مثال 9381 — مجموع الأرقام (مجموعة اختبار 12)
# digsum (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9381-num-digsum-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(9320), 14, "حالة 1")
تأكد_يساوي(ف(12859), 25, "حالة 2")
تأكد_يساوي(ف(32993), 26, "حالة 3")
تأكد_يساوي(ف(49442), 23, "حالة 4")
تأكد_يساوي(ف(18183), 21, "حالة 5")
