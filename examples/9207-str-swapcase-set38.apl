# مثال 9207 — عكس حالة الأحرف (مجموعة اختبار 38)
# swapcase (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9207-str-swapcase-set38.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("river"), "RIVER", "حالة 1")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 2")
تأكد_يساوي(ف("orbit"), "ORBIT", "حالة 3")
تأكد_يساوي(ف("loop"), "LOOP", "حالة 4")
تأكد_يساوي(ف("python"), "PYTHON", "حالة 5")
