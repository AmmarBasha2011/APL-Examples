# مثال 9008 — حروف الكلمة مرتبة (مجموعة اختبار 39)
# sortchars (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9008-str-sortchars-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("civic"), "cciiv", "حالة 1")
تأكد_يساوي(ف("pluto"), "loptu", "حالة 2")
تأكد_يساوي(ف("refer"), "eefrr", "حالة 3")
تأكد_يساوي(ف("saturn"), "anrstu", "حالة 4")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 5")
