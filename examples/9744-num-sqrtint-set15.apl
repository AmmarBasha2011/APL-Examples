# مثال 9744 — الجذر التربيعي الصحيح (مجموعة اختبار 15)
# sqrtint (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9744-num-sqrtint-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(3960), 62, "حالة 1")
تأكد_يساوي(ف(2251), 47, "حالة 2")
تأكد_يساوي(ف(1171), 34, "حالة 3")
تأكد_يساوي(ف(4719), 68, "حالة 4")
تأكد_يساوي(ف(4504), 67, "حالة 5")
