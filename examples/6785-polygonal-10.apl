# مثال 6785 — العدد المضلّع ذو 10 أضلاع
# 10-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6785-polygonal-10.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((10 - 2) * ن * ن - (10 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 10, "حالة 2")
تأكد_يساوي(ف(5), 85, "حالة 3")
تأكد_يساوي(ف(10), 370, "حالة 4")
