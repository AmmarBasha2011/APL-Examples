# مثال 8277 — العدد من المدى 5 إلى 50 بخطوة 5 بعد (ناقص 3)
# count over range(5,50,5) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8277-range-5-50-5-dec3-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ - 3]
    خ = خ + (5)
  ارجع len(ر)

تأكد_يساوي(ف(), 9, "المدى كله")
