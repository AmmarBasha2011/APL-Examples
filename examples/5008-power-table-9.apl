# مثال 5008 — قوى العدد 9 حتى 6
# Powers of 9 up to 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/5008-power-table-9.apl

# نضرب في العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  ق = 1
  لكل ي في range(ن + 1):
    ر = ر + [ق]
    ق = ق * 9
  ارجع ر

تأكد_يساوي(ف(0), [1], "حالة 1")
تأكد_يساوي(ف(3), [1, 9, 81, 729], "حالة 2")
تأكد_يساوي(ف(6), [1, 9, 81, 729, 6561, 59049, 531441], "حالة 3")
