# مثال 7315 — أول عنصر: من الأعداد الفردية نأخذ مضاعفات 3 ثم (سالب)
# first over odd sequence, keep m3, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7315-seq-odd-m3-neg-first.apl

# نولّد أول ن حد من: الأعداد الفردية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 * ي + 1
    لو خ % 3 == 0:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -3, "حالة 3")
تأكد_يساوي(ف(10), -3, "حالة 4")
تأكد_يساوي(ف(15), -3, "حالة 5")
