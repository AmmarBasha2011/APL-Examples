# مثال 4514 — ترتيب نتيجة باقي قسمتها على 10 للأعداد الموجبة
# Sorted list of last digit mod 10 over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4514-pipeline-positive-mod10-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ % 10]
  ارجع sorted(ن)

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [2, 5, 7, 9], "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [0, 2, 5, 6, 7, 8], "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [0, 2, 2, 5], "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [0, 1, 1, 3, 4, 6], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
