# مثال 9726 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 37)
# popcnt (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9726-num-popcnt-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(570), 5, "حالة 1")
تأكد_يساوي(ف(402), 4, "حالة 2")
تأكد_يساوي(ف(3340), 5, "حالة 3")
تأكد_يساوي(ف(1144), 5, "حالة 4")
تأكد_يساوي(ف(2443), 6, "حالة 5")
