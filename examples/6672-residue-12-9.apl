# مثال 6672 — الأعداد التي باقيها 9 عند القسمة على 12
# Numbers with remainder 9 mod 12
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6672-residue-12-9.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 12 == 9:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [9], "حالة 2")
تأكد_يساوي(ف(40), [9, 21, 33], "حالة 3")
تأكد_يساوي(ف(75), [9, 21, 33, 45, 57, 69], "حالة 4")
