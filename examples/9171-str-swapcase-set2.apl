# مثال 9171 — عكس حالة الأحرف (مجموعة اختبار 2)
# swapcase (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9171-str-swapcase-set2.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("rotor"), "ROTOR", "حالة 1")
تأكد_يساوي(ف("level"), "LEVEL", "حالة 2")
تأكد_يساوي(ف("venus"), "VENUS", "حالة 3")
تأكد_يساوي(ف("noon"), "NOON", "حالة 4")
تأكد_يساوي(ف("code"), "CODE", "حالة 5")
