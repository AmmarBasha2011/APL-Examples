# مثال 7667 — المجموع: من ي + 10 باقي 7 نأخذ الفردي ثم (سالب)
# sum over mixed sequence, keep odd, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7667-seq-mixed-odd-neg-sum.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ % 2 == 1:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), -3, "حالة 2")
تأكد_يساوي(ف(5), -8, "حالة 3")
تأكد_يساوي(ف(10), -17, "حالة 4")
تأكد_يساوي(ف(15), -21, "حالة 5")
