# مثال 6686 — الأعداد التي باقيها 9 عند القسمة على 15
# Numbers with remainder 9 mod 15
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6686-residue-15-9.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 15 == 9:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [9], "حالة 2")
تأكد_يساوي(ف(40), [9, 24, 39], "حالة 3")
تأكد_يساوي(ف(75), [9, 24, 39, 54, 69], "حالة 4")
