# مثال 8430 — آخر عنصر من المدى 10 إلى 0 بخطوة -1 بعد (نصف صحيح)
# last over range(10,0,-1) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8430-range-10-0-n1-half-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 10
  طالما خ > 0:
    ر = ر + [خ // 2]
    خ = خ + (-1)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 0, "المدى كله")
