# مثال 4831 — مبلغ بعد فائدة مركبة 6%
# Compound balance at 6 percent (integer)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4831-compound-6.apl

# كل سنة نضيف الفائدة على الرصيد
# القسمة صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  لكل ي في range(س):
    م = م + م * 6 // 100
  ارجع م

تأكد_يساوي(ف(1000, 1), 1060, "حالة 1")
تأكد_يساوي(ف(1000, 5), 1336, "حالة 2")
تأكد_يساوي(ف(500, 3), 594, "حالة 3")
تأكد_يساوي(ف(20000, 2), 22472, "حالة 4")
