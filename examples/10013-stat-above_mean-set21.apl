# مثال 10013 — عدد العناصر فوق المتوسط (مجموعة 21)
# above_mean (data set 21)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10013-stat-above_mean-set21.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-1, 44, -10, 57, 26, 7]), 3, "حالة 1")
تأكد_يساوي(ف([1, 28, 57, 28, 54]), 2, "حالة 2")
تأكد_يساوي(ف([7, 6, 28]), 1, "حالة 3")
تأكد_يساوي(ف([44, 13, 0, 30, -18, -15]), 3, "حالة 4")
