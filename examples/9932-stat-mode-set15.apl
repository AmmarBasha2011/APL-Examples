# مثال 9932 — المنوال (الأصغر عند التساوي) (مجموعة 15)
# mode (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9932-stat-mode-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([51, 53, 44, -10]), -10, "حالة 1")
تأكد_يساوي(ف([16, 48, 55, 35, -14, -20, -3, 28]), -20, "حالة 2")
تأكد_يساوي(ف([9, -3, -13, 12, -2, 7]), -13, "حالة 3")
تأكد_يساوي(ف([3, -7, 23, 30, 51, -3]), -7, "حالة 4")
