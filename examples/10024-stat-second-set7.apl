# مثال 10024 — ثاني أكبر قيمة مختلفة (مجموعة 7)
# second (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10024-stat-second-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([18, -9, 39, 19, 34]), 34, "حالة 1")
تأكد_يساوي(ف([34, 15, 9, 27, 3]), 27, "حالة 2")
تأكد_يساوي(ف([-4, 30, 3, 1, 14, 38, 5, 13, 23]), 30, "حالة 3")
تأكد_يساوي(ف([16, 43, 30, 60, 10, 9, 12, 45]), 45, "حالة 4")
