# مثال 4714 — أكبر الأعداد الباقي قسمته على 7 يساوي 3 حتى حد معين
# Numbers up to a limit: largest of the remainder 3 mod 7 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4714-numbers-largest-mod7is3.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 7 == 3:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(16), 10, "حالة 1")
تأكد_يساوي(ف(70), 66, "حالة 2")
تأكد_يساوي(ف(84), 80, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
