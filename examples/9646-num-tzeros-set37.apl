# مثال 9646 — الأصفار في نهاية العاملي (مجموعة اختبار 37)
# tzeros (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9646-num-tzeros-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(35), 8, "حالة 1")
تأكد_يساوي(ف(497), 121, "حالة 2")
تأكد_يساوي(ف(25), 6, "حالة 3")
تأكد_يساوي(ف(208), 50, "حالة 4")
تأكد_يساوي(ف(403), 99, "حالة 5")
