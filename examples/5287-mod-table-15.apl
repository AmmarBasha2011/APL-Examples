# مثال 5287 — باقي القسمة على 15 لكل عنصر
# Remainders mod 15
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5287-mod-table-15.apl

# نطبق % على كل عنصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ % 15]
  ارجع ر

تأكد_يساوي(ف([0, 3, 6, 9, 12, 15, 18, 21, 24, 27]), [0, 3, 6, 9, 12, 0, 3, 6, 9, 12], "حالة 1")
تأكد_يساوي(ف([-1, -5, 7]), [14, 10, 7], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
