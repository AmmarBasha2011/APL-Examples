# مثال 9687 — هل العدد أرمسترونغ (مجموعة اختبار 38)
# arm (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9687-num-arm-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(586), خطأ, "حالة 1")
تأكد_يساوي(ف(161), خطأ, "حالة 2")
تأكد_يساوي(ف(454), خطأ, "حالة 3")
تأكد_يساوي(ف(333), خطأ, "حالة 4")
تأكد_يساوي(ف(42), خطأ, "حالة 5")
