# مثال 9903 — الوسيط (بعد الترتيب) (مجموعة 11)
# median (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9903-stat-median-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([-19, 20, -19]), -19, "حالة 1")
تأكد_يساوي(ف([8, 11, 42, -19, 38, 47, -12, 41, 44]), 38, "حالة 2")
تأكد_يساوي(ف([8, 9, -16, -1, 21, 5, 49, 43]), 8, "حالة 3")
تأكد_يساوي(ف([44, 40, 27, 35, -15, 13, -1, 53]), 31, "حالة 4")
