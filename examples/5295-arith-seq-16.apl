# مثال 5295 — الحد ن في متتالية حسابية فرقها 16
# Nth term of arithmetic sequence, step 16
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5295-arith-seq-16.apl

# الحد = الأول + (ن-1) × الفرق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ارجع أ + (ن - 1) * 16

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 10), 145, "حالة 2")
تأكد_يساوي(ف(5, 7), 101, "حالة 3")
تأكد_يساوي(ف(-3, 4), 45, "حالة 4")
