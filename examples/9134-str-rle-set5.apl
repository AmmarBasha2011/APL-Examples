# مثال 9134 — ضغط التكرار (مجموعة اختبار 5)
# rle (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9134-str-rle-set5.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("level"), "l1e1v1e1l1", "حالة 1")
تأكد_يساوي(ف("comet"), "c1o1m1e1t1", "حالة 2")
تأكد_يساوي(ف("civic"), "c1i1v1i1c1", "حالة 3")
تأكد_يساوي(ف("moon"), "m1o2n1", "حالة 4")
تأكد_يساوي(ف("data"), "d1a1t1a1", "حالة 5")
