# مثال 5095 — مجموع الأرقام ثم الباقي على 2
# Digit sum mod 2
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5095-digit-sum-mod-2.apl

# نفصل الأرقام بالقسمة على 10

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م % 2

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(9), 1, "حالة 2")
تأكد_يساوي(ف(123), 0, "حالة 3")
تأكد_يساوي(ف(99999), 1, "حالة 4")
تأكد_يساوي(ف(40507), 0, "حالة 5")
