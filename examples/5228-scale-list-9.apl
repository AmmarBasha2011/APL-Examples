# مثال 5228 — ضرب كل عنصر في 9
# Scale list by 9
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5228-scale-list-9.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 9]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [9, 18, 27], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -36, 90], "حالة 3")
