# مثال 9349 — هل العدد أولي (مجموعة اختبار 20)
# prime (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9349-num-prime-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(199), صواب, "حالة 1")
تأكد_يساوي(ف(160), خطأ, "حالة 2")
تأكد_يساوي(ف(5), صواب, "حالة 3")
تأكد_يساوي(ف(176), خطأ, "حالة 4")
تأكد_يساوي(ف(75), خطأ, "حالة 5")
