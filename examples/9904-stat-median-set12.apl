# مثال 9904 — الوسيط (بعد الترتيب) (مجموعة 12)
# median (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9904-stat-median-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([56, 40, 15, 43, 4]), 40, "حالة 1")
تأكد_يساوي(ف([10, 22, 13, 1, 35, -13, -15, -19]), 5, "حالة 2")
تأكد_يساوي(ف([-18, 22, 40, 8, 48, -3]), 15, "حالة 3")
تأكد_يساوي(ف([46, 34, 35, 49]), 40, "حالة 4")
