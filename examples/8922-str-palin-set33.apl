# مثال 8922 — هل الكلمة متناظرة (مجموعة اختبار 33)
# palin (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8922-str-palin-set33.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("venus"), خطأ, "حالة 1")
تأكد_يساوي(ف("stats"), صواب, "حالة 2")
تأكد_يساوي(ف("tenet"), صواب, "حالة 3")
تأكد_يساوي(ف("earth"), خطأ, "حالة 4")
تأكد_يساوي(ف("planet"), خطأ, "حالة 5")
