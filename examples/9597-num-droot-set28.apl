# مثال 9597 — الجذر الرقمي (مجموعة اختبار 28)
# droot (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9597-num-droot-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(85184), 8, "حالة 1")
تأكد_يساوي(ف(5409), 9, "حالة 2")
تأكد_يساوي(ف(61787), 2, "حالة 3")
تأكد_يساوي(ف(33344), 8, "حالة 4")
تأكد_يساوي(ف(53742), 3, "حالة 5")
