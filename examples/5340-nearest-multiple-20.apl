# مثال 5340 — أقرب مضاعف للعدد 20
# Nearest multiple of 20
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5340-nearest-multiple-20.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 20
  لو ب * 2 < 20:
    ارجع ن - ب
  ارجع ن - ب + 20

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 0, "حالة 2")
تأكد_يساوي(ف(13), 20, "حالة 3")
تأكد_يساوي(ف(100), 100, "حالة 4")
تأكد_يساوي(ف(21), 20, "حالة 5")
