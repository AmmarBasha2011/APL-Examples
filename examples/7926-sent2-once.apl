# مثال 7926 — عدد الكلمات التي ظهرت مرة واحدة في الجملة رقم 3
# once for sentence 3
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7926-sent2-once.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] == 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("apl code is easy code is fun"), 3, "حالة 1")
تأكد_يساوي(ف("we love data and data loves us"), 5, "حالة 2")
تأكد_يساوي(ف("in the end the end is the start"), 3, "حالة 3")
