# مثال 6297 — الناتج معكوس بعد أخذ الحروف فقط وتحويلها إلى (الحرف التالي)
# rev of shift1 applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6297-txt-alpha-shift1-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: الحرف التالي
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + chr(ord(خ) + 1)
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "emspxpmmfi", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "ovgtjmqb", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "dcb", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "ypgoxpscldjvrfiu", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "yyyzzz{{{", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "fdofjdtbube", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "djcbsbojhojnnbshpsq", "حالة 8")
