# مثال 7525 — أصغر قيمة: من متناوبة الإشارة نأخذ الأكبر من 5 ثم (زيادة واحد)
# min over zigzag sequence, keep gt5, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7525-seq-zigzag-gt5-inc-min.apl

# نولّد أول ن حد من: متناوبة الإشارة
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (1 - 2 * (ي % 2))
    لو خ > 5:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 0, "حالة 3")
تأكد_يساوي(ف(10), 7, "حالة 4")
تأكد_يساوي(ف(15), 7, "حالة 5")
