# مثال 6788 — العدد المضلّع ذو 13 أضلاع
# 13-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6788-polygonal-13.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((13 - 2) * ن * ن - (13 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 13, "حالة 2")
تأكد_يساوي(ف(5), 115, "حالة 3")
تأكد_يساوي(ف(10), 505, "حالة 4")
