# مثال 9795 — إزاحة لليسار 6 خانات
# Shift left by 6
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9795-bits-shl-6.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 6

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 64, "حالة 2")
تأكد_يساوي(ف(5), 320, "حالة 3")
تأكد_يساوي(ف(100), 6400, "حالة 4")
