# مثال 8644 — أكبر قيمة من المدى 2 إلى 26 بخطوة 3 بعد (ضعف)
# max over range(2,26,3) mapped by double
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8644-range-2-26-3-double-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [خ * 2]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 46, "المدى كله")
