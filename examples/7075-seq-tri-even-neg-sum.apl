# مثال 7075 — المجموع: من الأعداد المثلثية نأخذ الزوجي ثم (سالب)
# sum over tri sequence, keep even, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7075-seq-tri-even-neg-sum.apl

# نولّد أول ن حد من: الأعداد المثلثية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (ي + 1) // 2
    لو خ % 2 == 0:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -16, "حالة 3")
تأكد_يساوي(ف(10), -80, "حالة 4")
تأكد_يساوي(ف(15), -224, "حالة 5")
