# مثال 4606 — أكبر نتيجة مربعها للأعداد الغير الصفرية
# Largest (or 0) of square over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4606-pipeline-notzero-square-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 400, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 256, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 169, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 225, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
