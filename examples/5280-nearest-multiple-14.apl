# مثال 5280 — أقرب مضاعف للعدد 14
# Nearest multiple of 14
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5280-nearest-multiple-14.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 14
  لو ب * 2 < 14:
    ارجع ن - ب
  ارجع ن - ب + 14

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 14, "حالة 2")
تأكد_يساوي(ف(13), 14, "حالة 3")
تأكد_يساوي(ف(100), 98, "حالة 4")
تأكد_يساوي(ف(15), 14, "حالة 5")
