# مثال 8999 — حروف الكلمة مرتبة (مجموعة اختبار 30)
# sortchars (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8999-str-sortchars-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("moon"), "mnoo", "حالة 1")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 2")
تأكد_يساوي(ف("banana"), "aaabnn", "حالة 3")
تأكد_يساوي(ف("enlist"), "eilnst", "حالة 4")
تأكد_يساوي(ف("saturn"), "anrstu", "حالة 5")
