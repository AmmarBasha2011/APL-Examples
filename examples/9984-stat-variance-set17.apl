# مثال 9984 — التباين الصحيح (مجموعة 17)
# variance (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9984-stat-variance-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([53, 26, -19, 4, -14, -1]), 609, "حالة 1")
تأكد_يساوي(ف([27, 44, 58, 53]), 139, "حالة 2")
تأكد_يساوي(ف([18, -7, 22, -16, 10, 32, 19]), 247, "حالة 3")
تأكد_يساوي(ف([-2, 3, -6, 33, -5, -13, 37]), 341, "حالة 4")
