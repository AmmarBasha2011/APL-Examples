# مثال 9994 — عدد العناصر فوق المتوسط (مجموعة 2)
# above_mean (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9994-stat-above_mean-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([22, 9, 1, 29, 53, 16]), 3, "حالة 1")
تأكد_يساوي(ف([15, 29, 53, -19, 11, -18, 36]), 3, "حالة 2")
تأكد_يساوي(ف([-1, 20, 1, 12]), 2, "حالة 3")
تأكد_يساوي(ف([59, 54, -13, -5, 55, -16, 35, 16]), 4, "حالة 4")
