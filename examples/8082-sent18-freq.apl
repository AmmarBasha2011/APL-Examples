# مثال 8082 — تكرار كل كلمة في الجملة رقم 19
# freq for sentence 19
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8082-sent18-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("left right left left right"), {"left": 3, "right": 2}, "حالة 1")
تأكد_يساوي(ف("to be or not to be"), {"to": 2, "be": 2, "or": 1, "not": 1}, "حالة 2")
تأكد_يساوي(ف("we love data and data loves us"), {"we": 1, "love": 1, "data": 2, "and": 1, "loves": 1, "us": 1}, "حالة 3")
