# مثال 9710 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 21)
# popcnt (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9710-num-popcnt-set21.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(571), 6, "حالة 1")
تأكد_يساوي(ف(4438), 6, "حالة 2")
تأكد_يساوي(ف(822), 6, "حالة 3")
تأكد_يساوي(ف(3651), 6, "حالة 4")
تأكد_يساوي(ف(1596), 6, "حالة 5")
