# مثال 6791 — العدد المضلّع ذو 16 أضلاع
# 16-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6791-polygonal-16.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((16 - 2) * ن * ن - (16 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 16, "حالة 2")
تأكد_يساوي(ف(5), 145, "حالة 3")
تأكد_يساوي(ف(10), 640, "حالة 4")
