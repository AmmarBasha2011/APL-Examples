# مثال 10032 — ثاني أكبر قيمة مختلفة (مجموعة 15)
# second (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10032-stat-second-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([-10, 18, 17]), 17, "حالة 1")
تأكد_يساوي(ف([6, 5, -13, 21]), 6, "حالة 2")
تأكد_يساوي(ف([60, 52, 10, 57, 28, -3, 9]), 57, "حالة 3")
تأكد_يساوي(ف([30, -17, -10, 32, 11, -8, 39]), 32, "حالة 4")
