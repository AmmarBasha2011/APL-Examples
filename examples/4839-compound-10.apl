# مثال 4839 — مبلغ بعد فائدة مركبة 10%
# Compound balance at 10 percent (integer)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4839-compound-10.apl

# كل سنة نضيف الفائدة على الرصيد
# القسمة صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  لكل ي في range(س):
    م = م + م * 10 // 100
  ارجع م

تأكد_يساوي(ف(1000, 1), 1100, "حالة 1")
تأكد_يساوي(ف(1000, 5), 1610, "حالة 2")
تأكد_يساوي(ف(500, 3), 665, "حالة 3")
تأكد_يساوي(ف(20000, 2), 24200, "حالة 4")
