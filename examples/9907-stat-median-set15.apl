# مثال 9907 — الوسيط (بعد الترتيب) (مجموعة 15)
# median (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9907-stat-median-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([-10, 18, 17]), 17, "حالة 1")
تأكد_يساوي(ف([6, 5, -13, 21]), 5, "حالة 2")
تأكد_يساوي(ف([60, 52, 10, 57, 28, -3, 9]), 28, "حالة 3")
تأكد_يساوي(ف([30, -17, -10, 32, 11, -8, 39]), 11, "حالة 4")
