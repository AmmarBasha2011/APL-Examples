# مثال 5221 — مقارنة العدد مع 8
# Compare number with 8
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5221-triple-compare-8.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 8:
    ارجع "اصغر"
  والا_لو ن > 8:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(7), "اصغر", "حالة 1")
تأكد_يساوي(ف(8), "يساوي", "حالة 2")
تأكد_يساوي(ف(9), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
