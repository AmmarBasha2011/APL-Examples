# مثال 5033 — حصر القيمة بين 1 و 5
# Clamp value into [1,5]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5033-clamp-1-5.apl

# إن كانت أقل من الحد الأدنى نرجع الحد الأدنى
# وإن زادت نرجع الحد الأعلى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 1:
    ارجع 1
  لو ن > 5:
    ارجع 5
  ارجع ن

تأكد_يساوي(ف(-4), 1, "حالة 1")
تأكد_يساوي(ف(10), 5, "حالة 2")
تأكد_يساوي(ف(3), 3, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(5), 5, "حالة 5")
