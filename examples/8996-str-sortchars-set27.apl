# مثال 8996 — حروف الكلمة مرتبة (مجموعة اختبار 27)
# sortchars (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8996-str-sortchars-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("venus"), "ensuv", "حالة 1")
تأكد_يساوي(ف("saturn"), "anrstu", "حالة 2")
تأكد_يساوي(ف("mars"), "amrs", "حالة 3")
تأكد_يساوي(ف("data"), "aadt", "حالة 4")
تأكد_يساوي(ف("moon"), "mnoo", "حالة 5")
