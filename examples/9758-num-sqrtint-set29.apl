# مثال 9758 — الجذر التربيعي الصحيح (مجموعة اختبار 29)
# sqrtint (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9758-num-sqrtint-set29.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2545), 50, "حالة 1")
تأكد_يساوي(ف(4904), 70, "حالة 2")
تأكد_يساوي(ف(3395), 58, "حالة 3")
تأكد_يساوي(ف(3368), 58, "حالة 4")
تأكد_يساوي(ف(788), 28, "حالة 5")
