# مثال 8682 — آخر عنصر من المدى 2 إلى 26 بخطوة 3 بعد (مكعب)
# last over range(2,26,3) mapped by cube
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8682-range-2-26-3-cube-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [خ * خ * خ]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 12167, "المدى كله")
