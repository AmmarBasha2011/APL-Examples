# مثال 4492 — عدد نتيجة ناقص 3 للأعداد الفردية
# Count of minus 3 over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4492-pipeline-odd-minus3-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ - 3]
  ارجع len(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), 1, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 3, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 3, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 5, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
