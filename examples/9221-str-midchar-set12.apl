# مثال 9221 — الحرف الأوسط (مجموعة اختبار 12)
# midchar (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9221-str-midchar-set12.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("silent"), "e", "حالة 1")
تأكد_يساوي(ف("noon"), "o", "حالة 2")
تأكد_يساوي(ف("rocket"), "k", "حالة 3")
تأكد_يساوي(ف("level"), "v", "حالة 4")
تأكد_يساوي(ف("venus"), "n", "حالة 5")
