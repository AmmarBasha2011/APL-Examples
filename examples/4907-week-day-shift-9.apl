# مثال 4907 — اليوم بعد 9 أيام
# Weekday 9 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4907-week-day-shift-9.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 9) % 7

تأكد_يساوي(ف(0), 2, "حالة 1")
تأكد_يساوي(ف(3), 5, "حالة 2")
تأكد_يساوي(ف(6), 1, "حالة 3")
تأكد_يساوي(ف(4), 6, "حالة 4")
