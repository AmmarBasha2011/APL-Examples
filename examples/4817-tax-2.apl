# مثال 4817 — إجمالي مع ضريبة 2%
# Total with 2 percent tax
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4817-tax-2.apl

# الإجمالي = السعر + الضريبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س + س * 2 // 100

تأكد_يساوي(ف(100), 102, "حالة 1")
تأكد_يساوي(ف(200), 204, "حالة 2")
تأكد_يساوي(ف(1500), 1530, "حالة 3")
تأكد_يساوي(ف(80), 81, "حالة 4")
