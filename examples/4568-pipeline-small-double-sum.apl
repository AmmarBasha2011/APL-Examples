# مثال 4568 — مجموع نتيجة ضعفها للأعداد الأقل من 5
# Sum of double over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4568-pipeline-small-double-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ * 2]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), -18, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 16, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 12, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 8, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
