# مثال 9740 — الجذر التربيعي الصحيح (مجموعة اختبار 11)
# sqrtint (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9740-num-sqrtint-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(592), 24, "حالة 1")
تأكد_يساوي(ف(1487), 38, "حالة 2")
تأكد_يساوي(ف(3359), 57, "حالة 3")
تأكد_يساوي(ف(2667), 51, "حالة 4")
تأكد_يساوي(ف(1576), 39, "حالة 5")
