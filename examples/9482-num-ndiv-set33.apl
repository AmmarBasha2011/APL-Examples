# مثال 9482 — عدد القواسم (مجموعة اختبار 33)
# ndiv (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9482-num-ndiv-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(14), 4, "حالة 1")
تأكد_يساوي(ف(187), 4, "حالة 2")
تأكد_يساوي(ف(140), 12, "حالة 3")
تأكد_يساوي(ف(207), 6, "حالة 4")
تأكد_يساوي(ف(49), 3, "حالة 5")
