# مثال 10231 — شريط بعرض 10 من الرمز =
# Bar of width 10 using =
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10231-bar-10-61.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "="
  ارجع ر + "|" + str(10)

تأكد_يساوي(ف(0), "|10", "حالة 1")
تأكد_يساوي(ف(3), "===|10", "حالة 2")
تأكد_يساوي(ف(10), "==========|10", "حالة 3")
