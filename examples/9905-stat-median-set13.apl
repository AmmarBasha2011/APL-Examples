# مثال 9905 — الوسيط (بعد الترتيب) (مجموعة 13)
# median (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9905-stat-median-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([17, 31, 38]), 31, "حالة 1")
تأكد_يساوي(ف([36, 34, -17, -2]), 16, "حالة 2")
تأكد_يساوي(ف([23, -8, 56, 40]), 31, "حالة 3")
تأكد_يساوي(ف([-11, 38, 14]), 14, "حالة 4")
