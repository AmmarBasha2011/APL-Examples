# مثال 6212 — الناتج معكوس بعد أخذ حروف آخر الأبجدية وتحويلها إلى (حرف مكرر)
# rev of twice applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6212-txt-late-twice-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + خ + خ
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "rroowwoo", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "nnuusspp", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "xxoonnwwoorruuqqtt", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "xxxxxxyyyyyyzzzzzz", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "nnsstt", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "rrnnnnrroorrpp", "حالة 8")
