# مثال 9607 — الجذر الرقمي (مجموعة اختبار 38)
# droot (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9607-num-droot-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(22601), 2, "حالة 1")
تأكد_يساوي(ف(22825), 1, "حالة 2")
تأكد_يساوي(ف(64155), 3, "حالة 3")
تأكد_يساوي(ف(32948), 8, "حالة 4")
تأكد_يساوي(ف(23527), 1, "حالة 5")
