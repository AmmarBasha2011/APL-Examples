# مثال 6962 — المجموع: من متتالية حسابية بخطوة 3 نأخذ الأصغر من 20 ثم (سالب)
# sum over arith3 sequence, keep lt20, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/6962-seq-arith3-lt20-neg-sum.apl

# نولّد أول ن حد من: متتالية حسابية بخطوة 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 1 + ي * 3
    لو خ < 20:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -35, "حالة 3")
تأكد_يساوي(ف(10), -70, "حالة 4")
تأكد_يساوي(ف(15), -70, "حالة 5")
