# مثال 10334 — تحويل 42 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 42 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10334-temp-c-42.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 42) * 9 // 5 + 32

تأكد_يساوي(ف(0), 107, "حالة 1")
تأكد_يساوي(ف(10), 125, "حالة 2")
تأكد_يساوي(ف(37), 174, "حالة 3")
تأكد_يساوي(ف(-5), 98, "حالة 4")
