# مثال 8611 — أول عنصر من المدى 7 إلى 70 بخطوة 7 بعد (نصف صحيح)
# first over range(7,70,7) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8611-range-7-70-7-half-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ // 2]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 3, "المدى كله")
