# مثال 4825 — إجمالي مع ضريبة 4%
# Total with 4 percent tax
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4825-tax-4.apl

# الإجمالي = السعر + الضريبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س + س * 4 // 100

تأكد_يساوي(ف(100), 104, "حالة 1")
تأكد_يساوي(ف(200), 208, "حالة 2")
تأكد_يساوي(ف(1500), 1560, "حالة 3")
تأكد_يساوي(ف(80), 83, "حالة 4")
