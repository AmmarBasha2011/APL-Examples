# مثال 6643 — الأعداد التي باقيها 1 عند القسمة على 7
# Numbers with remainder 1 mod 7
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6643-residue-7-1.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 7 == 1:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [1, 8], "حالة 2")
تأكد_يساوي(ف(40), [1, 8, 15, 22, 29, 36], "حالة 3")
تأكد_يساوي(ف(75), [1, 8, 15, 22, 29, 36, 43, 50, 57, 64, 71], "حالة 4")
