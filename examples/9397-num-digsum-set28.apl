# مثال 9397 — مجموع الأرقام (مجموعة اختبار 28)
# digsum (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9397-num-digsum-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(24122), 11, "حالة 1")
تأكد_يساوي(ف(48897), 36, "حالة 2")
تأكد_يساوي(ف(91667), 29, "حالة 3")
تأكد_يساوي(ف(8202), 12, "حالة 4")
تأكد_يساوي(ف(20682), 18, "حالة 5")
