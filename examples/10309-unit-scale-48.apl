# مثال 10309 — تحويل وحدة إلى 48 وحدات صغرى والعكس
# Convert units with factor 48
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10309-unit-scale-48.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 48, ن // 48, ن % 48]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [48, 0, 1], "حالة 2")
تأكد_يساوي(ف(48), [2304, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [48000, 20, 40], "حالة 4")
