# مثال 6632 — الأعداد التي باقيها 1 عند القسمة على 5
# Numbers with remainder 1 mod 5
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6632-residue-5-1.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 5 == 1:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [1, 6], "حالة 2")
تأكد_يساوي(ف(40), [1, 6, 11, 16, 21, 26, 31, 36], "حالة 3")
تأكد_يساوي(ف(75), [1, 6, 11, 16, 21, 26, 31, 36, 41, 46, 51, 56, 61, 66, 71], "حالة 4")
