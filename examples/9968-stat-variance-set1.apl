# مثال 9968 — التباين الصحيح (مجموعة 1)
# variance (data set 1)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9968-stat-variance-set1.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([27, 28, -4, 4]), 197, "حالة 1")
تأكد_يساوي(ف([-15, -10, -3, 11, 44, 6, 31, -17]), 425, "حالة 2")
تأكد_يساوي(ف([42, 38, 29, 43, 53, 4]), 241, "حالة 3")
تأكد_يساوي(ف([31, -9, 42, 9, -18, 14, 46, 32, 40]), 474, "حالة 4")
