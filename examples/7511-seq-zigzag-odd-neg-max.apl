# مثال 7511 — أكبر قيمة: من متناوبة الإشارة نأخذ الفردي ثم (سالب)
# max over zigzag sequence, keep odd, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7511-seq-zigzag-odd-neg-max.apl

# نولّد أول ن حد من: متناوبة الإشارة
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (1 - 2 * (ي % 2))
    لو خ % 2 == 1:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 3, "حالة 3")
تأكد_يساوي(ف(10), 9, "حالة 4")
تأكد_يساوي(ف(15), 13, "حالة 5")
