# مثال 6799 — العدد المضلّع ذو 24 أضلاع
# 24-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6799-polygonal-24.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((24 - 2) * ن * ن - (24 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 24, "حالة 2")
تأكد_يساوي(ف(5), 225, "حالة 3")
تأكد_يساوي(ف(10), 1000, "حالة 4")
