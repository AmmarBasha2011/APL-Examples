# مثال 5338 — ضرب كل عنصر في 20
# Scale list by 20
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5338-scale-list-20.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 20]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [20, 40, 60], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -80, 200], "حالة 3")
