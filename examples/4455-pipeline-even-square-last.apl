# مثال 4455 — آخر نتيجة مربعها للأعداد الزوجية
# Last (or -1) of square over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4455-pipeline-even-square-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 16, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 4, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 16, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 64, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
