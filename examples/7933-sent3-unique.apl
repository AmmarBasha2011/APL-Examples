# مثال 7933 — عدد الكلمات المختلفة في الجملة رقم 4
# unique for sentence 4
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7933-sent3-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("one fish two fish red fish blue fish"), 5, "حالة 1")
تأكد_يساوي(ف("tea for two and two for tea"), 4, "حالة 2")
تأكد_يساوي(ف("red blue green red blue red"), 3, "حالة 3")
