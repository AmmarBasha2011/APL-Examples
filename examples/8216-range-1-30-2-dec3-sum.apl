# مثال 8216 — المجموع من المدى 1 إلى 30 بخطوة 2 بعد (ناقص 3)
# sum over range(1,30,2) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8216-range-1-30-2-dec3-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [خ - 3]
    خ = خ + (2)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 180, "المدى كله")
