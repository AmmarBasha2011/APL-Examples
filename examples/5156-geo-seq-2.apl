# مثال 5156 — الحد ن في متتالية هندسية أساسها 2
# Nth term of geometric sequence, ratio 2
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5156-geo-seq-2.apl

# كل حد = السابق × الأساس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ر = أ
  لكل ي في range(ن - 1):
    ر = ر * 2
  ارجع ر

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 5), 16, "حالة 2")
تأكد_يساوي(ف(3, 4), 24, "حالة 3")
تأكد_يساوي(ف(2, 6), 64, "حالة 4")
