# مثال 4667 — الاحتفاظ بـ (مسافة) في نص
# String: keep only space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4667-string-keep-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو خ == " ":
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("aeiou AEIOU xyz"), "  ", "حالة 1")
تأكد_يساوي(ف("a1b2c3d4"), "", "حالة 2")
تأكد_يساوي(ف("apple PIE 7 and 9"), "    ", "حالة 3")
تأكد_يساوي(ف("Hello World 42"), "  ", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
