# مثال 5059 — حذف الحرف i من النص
# Remove letter i
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5059-remove-char-i.apl

# نبني نصاً جديداً بدون الحرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح != "i":
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("banana"), "banana", "حالة 1")
تأكد_يساوي(ف("education"), "educaton", "حالة 2")
تأكد_يساوي(ف(""), "", "حالة 3")
تأكد_يساوي(ف("mississippi"), "msssspp", "حالة 4")
