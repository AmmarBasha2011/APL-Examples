# مثال 4709 — مجموع الأعداد الأولي حتى حد معين
# Numbers up to a limit: sum of the prime ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4709-numbers-sum-prime.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر > 1 و len([د for د in range(2, ر) if ر % د == 0]) == 0:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(18), 58, "حالة 1")
تأكد_يساوي(ف(56), 381, "حالة 2")
تأكد_يساوي(ف(140), 2127, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
