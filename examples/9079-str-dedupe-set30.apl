# مثال 9079 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 30)
# dedupe (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9079-str-dedupe-set30.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("saturn"), "saturn", "حالة 1")
تأكد_يساوي(ف("apple"), "aple", "حالة 2")
تأكد_يساوي(ف("code"), "code", "حالة 3")
تأكد_يساوي(ف("pluto"), "pluto", "حالة 4")
تأكد_يساوي(ف("silent"), "silent", "حالة 5")
