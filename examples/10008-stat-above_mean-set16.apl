# مثال 10008 — عدد العناصر فوق المتوسط (مجموعة 16)
# above_mean (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10008-stat-above_mean-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-20, 51, 36]), 2, "حالة 1")
تأكد_يساوي(ف([21, -7, -6, 27, 38, -2, -9, 27, 57]), 5, "حالة 2")
تأكد_يساوي(ف([20, 15, 24, -20]), 3, "حالة 3")
تأكد_يساوي(ف([-1, -4, 49, 31, -6, 55, 41, 36]), 5, "حالة 4")
