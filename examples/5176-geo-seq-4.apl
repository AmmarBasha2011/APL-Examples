# مثال 5176 — الحد ن في متتالية هندسية أساسها 4
# Nth term of geometric sequence, ratio 4
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5176-geo-seq-4.apl

# كل حد = السابق × الأساس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ر = أ
  لكل ي في range(ن - 1):
    ر = ر * 4
  ارجع ر

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 5), 256, "حالة 2")
تأكد_يساوي(ف(3, 4), 192, "حالة 3")
تأكد_يساوي(ف(2, 6), 2048, "حالة 4")
