# مثال 8089 — أول كلمة تتكرر في الجملة رقم 19
# firstdup for sentence 19
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8089-sent18-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("left right left left right"), "left", "حالة 1")
تأكد_يساوي(ف("to be or not to be"), "to", "حالة 2")
تأكد_يساوي(ف("we love data and data loves us"), "data", "حالة 3")
