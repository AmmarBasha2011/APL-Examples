# مثال 10336 — تحويل 46 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 46 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10336-temp-c-46.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 46) * 9 // 5 + 32

تأكد_يساوي(ف(0), 114, "حالة 1")
تأكد_يساوي(ف(10), 132, "حالة 2")
تأكد_يساوي(ف(37), 181, "حالة 3")
تأكد_يساوي(ف(-5), 105, "حالة 4")
