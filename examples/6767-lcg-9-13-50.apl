# مثال 6767 — مولّد أرقام عشوائية خطي (9,13,50)
# LCG a=9 c=13 m=50
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6767-lcg-9-13-50.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (9 * س + 13) % 50
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [22, 11, 12, 21, 2], "حالة 1")
تأكد_يساوي(ف(0, 8), [13, 30, 33, 10, 3, 40, 23, 20], "حالة 2")
تأكد_يساوي(ف(7, 10), [26, 47, 36, 37, 46, 27, 6, 17, 16, 7], "حالة 3")
