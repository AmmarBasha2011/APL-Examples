# مثال 4485 — آخر نتيجة نصفها بالقسمة الصحيحة للأعداد الفردية
# Last (or -1) of integer half over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4485-pipeline-odd-half-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ // 2]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 7, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 4, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 17, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 2, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
