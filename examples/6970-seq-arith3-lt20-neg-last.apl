# مثال 6970 — آخر عنصر: من متتالية حسابية بخطوة 3 نأخذ الأصغر من 20 ثم (سالب)
# last over arith3 sequence, keep lt20, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/6970-seq-arith3-lt20-neg-last.apl

# نولّد أول ن حد من: متتالية حسابية بخطوة 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 1 + ي * 3
    لو خ < 20:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -13, "حالة 3")
تأكد_يساوي(ف(10), -19, "حالة 4")
تأكد_يساوي(ف(15), -19, "حالة 5")
