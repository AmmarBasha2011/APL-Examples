# مثال 10313 — تحويل 0 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 0 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10313-temp-c-0.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 0) * 9 // 5 + 32

تأكد_يساوي(ف(0), 32, "حالة 1")
تأكد_يساوي(ف(10), 50, "حالة 2")
تأكد_يساوي(ف(37), 98, "حالة 3")
تأكد_يساوي(ف(-5), 23, "حالة 4")
