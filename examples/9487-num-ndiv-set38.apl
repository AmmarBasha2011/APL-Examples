# مثال 9487 — عدد القواسم (مجموعة اختبار 38)
# ndiv (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9487-num-ndiv-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(72), 12, "حالة 1")
تأكد_يساوي(ف(76), 6, "حالة 2")
تأكد_يساوي(ف(81), 5, "حالة 3")
تأكد_يساوي(ف(248), 8, "حالة 4")
تأكد_يساوي(ف(175), 6, "حالة 5")
