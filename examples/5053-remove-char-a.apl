# مثال 5053 — حذف الحرف a من النص
# Remove letter a
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5053-remove-char-a.apl

# نبني نصاً جديداً بدون الحرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح != "a":
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("banana"), "bnn", "حالة 1")
تأكد_يساوي(ف("education"), "eduction", "حالة 2")
تأكد_يساوي(ف(""), "", "حالة 3")
تأكد_يساوي(ف("mississippi"), "mississippi", "حالة 4")
