# مثال 9959 — المدى (مجموعة 17)
# range (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9959-stat-range-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([16, 60, 25, 10, 21, 23, 47, 26]), 50, "حالة 1")
تأكد_يساوي(ف([23, 25, 37, 38]), 15, "حالة 2")
تأكد_يساوي(ف([27, 39, -18]), 57, "حالة 3")
تأكد_يساوي(ف([27, 7, -3, 38, -20, 39, -3, 4, 30]), 59, "حالة 4")
