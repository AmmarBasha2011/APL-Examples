# مثال 4465 — عدد نتيجة مكعبها للأعداد الزوجية
# Count of cube over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4465-pipeline-even-cube-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ * خ]
  ارجع len(ن)

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 3, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 4, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 4, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 3, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
