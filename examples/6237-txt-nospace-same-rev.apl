# مثال 6237 — الناتج معكوس بعد أخذ غير المسافات وتحويلها إلى (كما هو)
# rev of same applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6237-txt-nospace-same-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + خ
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "24dlrowolleh", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "nufsilpa", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "3c2b1a", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "xofnworbkciuqeht", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "xxxyyyzzz", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "ecneics6202atad", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "cibaranignimmargorp", "حالة 8")
