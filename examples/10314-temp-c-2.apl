# مثال 10314 — تحويل 2 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 2 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10314-temp-c-2.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 2) * 9 // 5 + 32

تأكد_يساوي(ف(0), 35, "حالة 1")
تأكد_يساوي(ف(10), 53, "حالة 2")
تأكد_يساوي(ف(37), 102, "حالة 3")
تأكد_يساوي(ف(-5), 26, "حالة 4")
