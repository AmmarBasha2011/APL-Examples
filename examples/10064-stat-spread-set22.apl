# مثال 10064 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 22)
# spread (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10064-stat-spread-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([20, 12, 20, 12, 16, 35, -20]), 32, "حالة 1")
تأكد_يساوي(ف([41, 42, 41, 42, -14, -13, -20, 12, -5]), 29, "حالة 2")
تأكد_يساوي(ف([-15, 52, 37]), 52, "حالة 3")
تأكد_يساوي(ف([53, 16, 52, 32, 50]), 18, "حالة 4")
