# مثال 4534 — مجموع نتيجة باقي قسمتها على 10 للأعداد التقبل القسمة على 3
# Sum of last digit mod 10 over the divisible by 3 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4534-pipeline-div3-mod10-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 3 == 0:
      ن = ن + [خ % 10]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 16, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 3, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 9, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 3, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
