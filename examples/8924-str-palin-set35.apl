# مثال 8924 — هل الكلمة متناظرة (مجموعة اختبار 35)
# palin (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8924-str-palin-set35.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("venus"), خطأ, "حالة 1")
تأكد_يساوي(ف("google"), خطأ, "حالة 2")
تأكد_يساوي(ف("planet"), خطأ, "حالة 3")
تأكد_يساوي(ف("banana"), خطأ, "حالة 4")
تأكد_يساوي(ف("orbit"), خطأ, "حالة 5")
