# مثال 5097 — عدد الأزواج التي مجموعها 2
# Count pairs summing to 2
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5097-pairs-sum-2.apl

# نجرب كل زوج مرة واحدة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل ي في range(len(ق)):
    لكل ك في range(ي + 1, len(ق)):
      لو ق[ي] + ق[ك] == 2:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([0, 1, 2]), 1, "حالة 1")
تأكد_يساوي(ف([1, 2, 3]), 0, "حالة 2")
تأكد_يساوي(ف([2, 0, 2]), 2, "حالة 3")
تأكد_يساوي(ف([]), 0, "حالة 4")
