# مثال 9754 — الجذر التربيعي الصحيح (مجموعة اختبار 25)
# sqrtint (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9754-num-sqrtint-set25.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(1457), 38, "حالة 1")
تأكد_يساوي(ف(332), 18, "حالة 2")
تأكد_يساوي(ف(4407), 66, "حالة 3")
تأكد_يساوي(ف(4910), 70, "حالة 4")
تأكد_يساوي(ف(3276), 57, "حالة 5")
