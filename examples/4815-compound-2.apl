# مثال 4815 — مبلغ بعد فائدة مركبة 2%
# Compound balance at 2 percent (integer)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4815-compound-2.apl

# كل سنة نضيف الفائدة على الرصيد
# القسمة صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  لكل ي في range(س):
    م = م + م * 2 // 100
  ارجع م

تأكد_يساوي(ف(1000, 1), 1020, "حالة 1")
تأكد_يساوي(ف(1000, 5), 1102, "حالة 2")
تأكد_يساوي(ف(500, 3), 530, "حالة 3")
تأكد_يساوي(ف(20000, 2), 20808, "حالة 4")
