# مثال 10261 — شريط بعرض 16 من الرمز =
# Bar of width 16 using =
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10261-bar-16-61.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "="
  ارجع ر + "|" + str(16)

تأكد_يساوي(ف(0), "|16", "حالة 1")
تأكد_يساوي(ف(3), "===|16", "حالة 2")
تأكد_يساوي(ف(16), "================|16", "حالة 3")
