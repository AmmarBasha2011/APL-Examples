# مثال 9736 — الجذر التربيعي الصحيح (مجموعة اختبار 7)
# sqrtint (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9736-num-sqrtint-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(1635), 40, "حالة 1")
تأكد_يساوي(ف(877), 29, "حالة 2")
تأكد_يساوي(ف(2628), 51, "حالة 3")
تأكد_يساوي(ف(1573), 39, "حالة 4")
تأكد_يساوي(ف(1822), 42, "حالة 5")
