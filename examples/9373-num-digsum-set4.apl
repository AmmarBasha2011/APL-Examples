# مثال 9373 — مجموع الأرقام (مجموعة اختبار 4)
# digsum (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9373-num-digsum-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(35635), 22, "حالة 1")
تأكد_يساوي(ف(54747), 27, "حالة 2")
تأكد_يساوي(ف(63966), 30, "حالة 3")
تأكد_يساوي(ف(33772), 22, "حالة 4")
تأكد_يساوي(ف(10732), 13, "حالة 5")
