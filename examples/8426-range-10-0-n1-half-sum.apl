# مثال 8426 — المجموع من المدى 10 إلى 0 بخطوة -1 بعد (نصف صحيح)
# sum over range(10,0,-1) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8426-range-10-0-n1-half-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 10
  طالما خ > 0:
    ر = ر + [خ // 2]
    خ = خ + (-1)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 25, "المدى كله")
