# مثال 9717 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 28)
# popcnt (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9717-num-popcnt-set28.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(1507), 7, "حالة 1")
تأكد_يساوي(ف(3056), 7, "حالة 2")
تأكد_يساوي(ف(512), 1, "حالة 3")
تأكد_يساوي(ف(1292), 4, "حالة 4")
تأكد_يساوي(ف(1977), 8, "حالة 5")
