# مثال 8711 — الجداء النقطي (كما هي)
# two lists dot, same
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8711-two-dot-same.apl

# دالة تأخذ قائمتين
# وتعالجهما معاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ب):
  م = 0
  لكل ي في range(min(len(أ), len(ب))):
    م = م + أ[ي] * ب[ي]
  ارجع م

تأكد_يساوي(ف([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]), 35, "حالة 1")
تأكد_يساوي(ف([5, 3, 8, 3], [3, 3, 9, 8]), 120, "حالة 2")
تأكد_يساوي(ف([10, 20, 30], [10, 0, 30, 40]), 1000, "حالة 3")
تأكد_يساوي(ف([2, 4, 6, 8, 10, 12], [1, 2, 3]), 28, "حالة 4")
تأكد_يساوي(ف([7, 7, 7, 1], [7, 1, 7, 7]), 112, "حالة 5")
تأكد_يساوي(ف([9, 8, 7, 6, 5, 4, 3], [4, 5, 6, 7, 8]), 200, "حالة 6")
