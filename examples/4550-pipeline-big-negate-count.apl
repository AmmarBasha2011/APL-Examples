# مثال 4550 — عدد نتيجة سالبها للأعداد الأكبر من 10
# Count of negated over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4550-pipeline-big-negate-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [0 - خ]
  ارجع len(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 5, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 2, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 0, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 3, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
