# مثال 6680 — الأعداد التي باقيها 6 عند القسمة على 14
# Numbers with remainder 6 mod 14
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6680-residue-14-6.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 14 == 6:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [6], "حالة 2")
تأكد_يساوي(ف(40), [6, 20, 34], "حالة 3")
تأكد_يساوي(ف(75), [6, 20, 34, 48, 62], "حالة 4")
