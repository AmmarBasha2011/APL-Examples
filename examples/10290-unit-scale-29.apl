# مثال 10290 — تحويل وحدة إلى 29 وحدات صغرى والعكس
# Convert units with factor 29
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10290-unit-scale-29.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 29, ن // 29, ن % 29]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [29, 0, 1], "حالة 2")
تأكد_يساوي(ف(29), [841, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [29000, 34, 14], "حالة 4")
