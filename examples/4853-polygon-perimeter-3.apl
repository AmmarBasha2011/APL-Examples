# مثال 4853 — محيط مضلع منتظم عدد أضلاعه 3
# Perimeter of regular 3-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4853-polygon-perimeter-3.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 3 * ض

تأكد_يساوي(ف(1), 3, "حالة 1")
تأكد_يساوي(ف(5), 15, "حالة 2")
تأكد_يساوي(ف(12), 36, "حالة 3")
تأكد_يساوي(ف(7), 21, "حالة 4")
