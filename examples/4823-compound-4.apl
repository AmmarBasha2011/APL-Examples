# مثال 4823 — مبلغ بعد فائدة مركبة 4%
# Compound balance at 4 percent (integer)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4823-compound-4.apl

# كل سنة نضيف الفائدة على الرصيد
# القسمة صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  لكل ي في range(س):
    م = م + م * 4 // 100
  ارجع م

تأكد_يساوي(ف(1000, 1), 1040, "حالة 1")
تأكد_يساوي(ف(1000, 5), 1214, "حالة 2")
تأكد_يساوي(ف(500, 3), 561, "حالة 3")
تأكد_يساوي(ف(20000, 2), 21632, "حالة 4")
