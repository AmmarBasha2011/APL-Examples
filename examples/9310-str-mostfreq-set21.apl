# مثال 9310 — الحرف الأكثر تكراراً (الأول عند التساوي) (مجموعة اختبار 21)
# mostfreq (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9310-str-mostfreq-set21.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ح في ن:
    د[ح] = د.get(ح, 0) + 1
  ب = ن[0]
  لكل ح في ن:
    لو د[ح] > د[ب]:
      ب = ح
  ارجع ب

تأكد_يساوي(ف("moon"), "o", "حالة 1")
تأكد_يساوي(ف("noon"), "n", "حالة 2")
تأكد_يساوي(ف("deed"), "d", "حالة 3")
تأكد_يساوي(ف("silent"), "s", "حالة 4")
تأكد_يساوي(ف("listen"), "l", "حالة 5")
