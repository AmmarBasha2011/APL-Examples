# مثال 8610 — آخر عنصر من المدى 7 إلى 70 بخطوة 7 بعد (نصف صحيح)
# last over range(7,70,7) mapped by half
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8610-range-7-70-7-half-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ // 2]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 31, "المدى كله")
