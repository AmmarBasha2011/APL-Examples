# مثال 9069 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 20)
# dedupe (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9069-str-dedupe-set20.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("level"), "lev", "حالة 1")
تأكد_يساوي(ف("earth"), "earth", "حالة 2")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 3")
تأكد_يساوي(ف("saturn"), "saturn", "حالة 4")
تأكد_يساوي(ف("venus"), "venus", "حالة 5")
