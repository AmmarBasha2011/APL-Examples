# مثال 8761 — التسطيح لمصفوفة قيمها |i-j|
# Matrix flat for cell formula |i-j|
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8761-mat-diff-flat.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [abs(ي - ك)]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل س في ق:
    ر = ر + س
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [0, 1, 1, 0], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [0, 1, 2, 1, 0, 1, 2, 1, 0], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [0, 1, 2, 3, 4, 1, 0, 1, 2, 3, 2, 1, 0, 1, 2, 3, 2, 1, 0, 1, 4, 3, 2, 1, 0], "حجم 5")
