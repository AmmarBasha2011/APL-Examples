# مثال 8350 — أكبر قيمة من المدى 3 إلى 40 بخطوة 3 بعد (مربع)
# max over range(3,40,3) mapped by square
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8350-range-3-40-3-square-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ * خ]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 1521, "المدى كله")
