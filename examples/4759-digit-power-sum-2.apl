# مثال 4759 — مجموع قوى الأرقام (القوة 2)
# Sum of digits raised to 2
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4759-digit-power-sum-2.apl

# نرفع كل رقم لقوة ثابتة
# ونجمع النتائج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ج = 0
  لكل د في str(ن):
    ج = ج + int(د) ** 2
  ارجع ج

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(9), 81, "حالة 2")
تأكد_يساوي(ف(153), 35, "حالة 3")
تأكد_يساوي(ف(407), 65, "حالة 4")
تأكد_يساوي(ف(9474), 162, "حالة 5")
