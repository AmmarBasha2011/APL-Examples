# مثال 9352 — هل العدد أولي (مجموعة اختبار 23)
# prime (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9352-num-prime-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(169), خطأ, "حالة 1")
تأكد_يساوي(ف(122), خطأ, "حالة 2")
تأكد_يساوي(ف(188), خطأ, "حالة 3")
تأكد_يساوي(ف(163), صواب, "حالة 4")
تأكد_يساوي(ف(129), خطأ, "حالة 5")
