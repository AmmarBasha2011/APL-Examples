# مثال 9059 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 10)
# dedupe (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9059-str-dedupe-set10.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("noon"), "no", "حالة 1")
تأكد_يساوي(ف("python"), "python", "حالة 2")
تأكد_يساوي(ف("code"), "code", "حالة 3")
تأكد_يساوي(ف("radar"), "rad", "حالة 4")
تأكد_يساوي(ف("deed"), "de", "حالة 5")
