# مثال 7691 — أصغر قيمة: من ي + 10 باقي 7 نأخذ الأكبر من 5 ثم (سالب)
# min over mixed sequence, keep gt5, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7691-seq-mixed-gt5-neg-min.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ > 5:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -6, "حالة 3")
تأكد_يساوي(ف(10), -6, "حالة 4")
تأكد_يساوي(ف(15), -6, "حالة 5")
