# مثال 4684 — عدد الأعداد التقبل القسمة على 3 أو 5 حتى حد معين
# Numbers up to a limit: how many the divisible by 3 or 5 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4684-numbers-count-div3or5.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 3 == 0 أو ر % 5 == 0:
      ن = ن + [ر]
  ارجع len(ن)

تأكد_يساوي(ف(12), 6, "حالة 1")
تأكد_يساوي(ف(43), 20, "حالة 2")
تأكد_يساوي(ف(90), 42, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
