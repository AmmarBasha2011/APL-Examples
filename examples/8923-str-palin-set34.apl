# مثال 8923 — هل الكلمة متناظرة (مجموعة اختبار 34)
# palin (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8923-str-palin-set34.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("refer"), صواب, "حالة 1")
تأكد_يساوي(ف("rocket"), خطأ, "حالة 2")
تأكد_يساوي(ف("deed"), صواب, "حالة 3")
تأكد_يساوي(ف("kayak"), صواب, "حالة 4")
تأكد_يساوي(ف("sun"), خطأ, "حالة 5")
