# مثال 10207 — شريط بعرض 5 من الرمز +
# Bar of width 5 using +
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10207-bar-5-43.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "+"
  ارجع ر + "|" + str(5)

تأكد_يساوي(ف(0), "|5", "حالة 1")
تأكد_يساوي(ف(3), "+++|5", "حالة 2")
تأكد_يساوي(ف(5), "+++++|5", "حالة 3")
