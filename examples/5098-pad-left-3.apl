# مثال 5098 — ملء النص من اليسار حتى عرض 3
# Left pad to width 3
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5098-pad-left-3.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 3:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "007", "حالة 1")
تأكد_يساوي(ف("123"), "123", "حالة 2")
تأكد_يساوي(ف("111"), "111", "حالة 3")
تأكد_يساوي(ف(""), "000", "حالة 4")
