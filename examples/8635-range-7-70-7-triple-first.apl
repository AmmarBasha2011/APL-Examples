# مثال 8635 — أول عنصر من المدى 7 إلى 70 بخطوة 7 بعد (ثلاثة أضعاف)
# first over range(7,70,7) mapped by triple
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8635-range-7-70-7-triple-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ * 3]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 21, "المدى كله")
