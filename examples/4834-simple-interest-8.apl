# مثال 4834 — فائدة بسيطة بنسبة 8%
# Simple interest at 8 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4834-simple-interest-8.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 8 * س // 100

تأكد_يساوي(ف(1000, 1), 80, "حالة 1")
تأكد_يساوي(ف(2500, 3), 600, "حالة 2")
تأكد_يساوي(ف(100, 10), 80, "حالة 3")
تأكد_يساوي(ف(8000, 2), 1280, "حالة 4")
