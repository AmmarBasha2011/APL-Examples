# مثال 8818 — المنقولة لمصفوفة قيمها i**2 - j
# Matrix transpose for cell formula i**2 - j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8818-mat-pw-transpose.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي - ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل ك في range(len(ق)):
    س = []
    لكل ي في range(len(ق)):
      س = س + [ق[ي][ك]]
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [[0]], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [[0, 1], [-1, 0]], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [[0, 1, 4], [-1, 0, 3], [-2, -1, 2]], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [[0, 1, 4, 9, 16], [-1, 0, 3, 8, 15], [-2, -1, 2, 7, 14], [-3, -2, 1, 6, 13], [-4, -3, 0, 5, 12]], "حجم 5")
