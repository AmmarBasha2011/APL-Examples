# مثال 9421 — عكس الأرقام (مجموعة اختبار 12)
# revnum (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9421-num-revnum-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(9320), 239, "حالة 1")
تأكد_يساوي(ف(12859), 95821, "حالة 2")
تأكد_يساوي(ف(32993), 39923, "حالة 3")
تأكد_يساوي(ف(49442), 24494, "حالة 4")
تأكد_يساوي(ف(18183), 38181, "حالة 5")
