# مثال 4464 — مجموع نتيجة مكعبها للأعداد الزوجية
# Sum of cube over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4464-pipeline-even-cube-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ * خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([3, 1, 2, 8, 5]), 520, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 1016, "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 29456, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 4160, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
