# مثال 9218 — الحرف الأوسط (مجموعة اختبار 9)
# midchar (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9218-str-midchar-set9.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("orbit"), "b", "حالة 1")
تأكد_يساوي(ف("silent"), "e", "حالة 2")
تأكد_يساوي(ف("racecar"), "e", "حالة 3")
تأكد_يساوي(ف("comet"), "m", "حالة 4")
تأكد_يساوي(ف("kayak"), "y", "حالة 5")
