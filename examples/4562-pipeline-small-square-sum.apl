# مثال 4562 — مجموع نتيجة مربعها للأعداد الأقل من 5
# Sum of square over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4562-pipeline-small-square-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ * خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 16, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 26, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 15, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 14, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
