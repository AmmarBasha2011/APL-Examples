# مثال 9659 — هل العدد أرمسترونغ (مجموعة اختبار 10)
# arm (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9659-num-arm-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(528), خطأ, "حالة 1")
تأكد_يساوي(ف(254), خطأ, "حالة 2")
تأكد_يساوي(ف(194), خطأ, "حالة 3")
تأكد_يساوي(ف(968), خطأ, "حالة 4")
تأكد_يساوي(ف(976), خطأ, "حالة 5")
