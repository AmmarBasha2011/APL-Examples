# مثال 4719 — قائمة الأعداد الأرقامه تصاعدية حتى حد معين
# Numbers up to a limit: list of the digits strictly increasing ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4719-numbers-list-twodigits_up.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو list(str(ر)) == sorted(set(str(ر))):
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(16), [1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 13, 14, 15, 16], "حالة 1")
تأكد_يساوي(ف(36), [1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 13, 14, 15, 16, 17, 18, 19, 23, 24, 25, 26, 27, 28, 29, 34, 35, 36], "حالة 2")
تأكد_يساوي(ف(132), [1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 13, 14, 15, 16, 17, 18, 19, 23, 24, 25, 26, 27, 28, 29, 34, 35, 36, 37, 38, 39, 45, 46, 47, 48, 49, 56, 57, 58, 59, 67, 68, 69, 78, 79, 89, 123, 124, 125, 126, 127, 128, 129], "حالة 3")
تأكد_يساوي(ف(1), [1], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
