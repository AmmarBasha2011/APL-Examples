# مثال 9929 — المنوال (الأصغر عند التساوي) (مجموعة 12)
# mode (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9929-stat-mode-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([16, -20, 1, 32, -7, 4, 27, -1, 16]), 16, "حالة 1")
تأكد_يساوي(ف([17, -14, 23, -2, -9, 58]), -14, "حالة 2")
تأكد_يساوي(ف([-20, 23, -2, 18, 42]), -20, "حالة 3")
تأكد_يساوي(ف([36, -4, 2, 55, 13, 60, 14, 37, 10]), -4, "حالة 4")
