# مثال 10282 — تحويل وحدة إلى 21 وحدات صغرى والعكس
# Convert units with factor 21
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10282-unit-scale-21.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 21, ن // 21, ن % 21]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [21, 0, 1], "حالة 2")
تأكد_يساوي(ف(21), [441, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [21000, 47, 13], "حالة 4")
