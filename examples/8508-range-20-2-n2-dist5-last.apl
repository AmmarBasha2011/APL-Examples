# مثال 8508 — آخر عنصر من المدى 20 إلى 2 بخطوة -2 بعد (البعد عن 5)
# last over range(20,2,-2) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8508-range-20-2-n2-dist5-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [abs(خ - 5)]
    خ = خ + (-2)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 1, "المدى كله")
