# مثال 6773 — مولّد أرقام عشوائية خطي (6,7,19)
# LCG a=6 c=7 m=19
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6773-lcg-6-7-19.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (6 * س + 7) % 19
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [13, 9, 4, 12, 3], "حالة 1")
تأكد_يساوي(ف(0, 8), [7, 11, 16, 8, 17, 14, 15, 2], "حالة 2")
تأكد_يساوي(ف(7, 10), [11, 16, 8, 17, 14, 15, 2, 0, 7, 11], "حالة 3")
