# مثال 9416 — عكس الأرقام (مجموعة اختبار 7)
# revnum (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9416-num-revnum-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(95883), 38859, "حالة 1")
تأكد_يساوي(ف(37170), 7173, "حالة 2")
تأكد_يساوي(ف(4892), 2984, "حالة 3")
تأكد_يساوي(ف(64111), 11146, "حالة 4")
تأكد_يساوي(ف(575), 575, "حالة 5")
