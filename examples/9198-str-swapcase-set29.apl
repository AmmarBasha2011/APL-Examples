# مثال 9198 — عكس حالة الأحرف (مجموعة اختبار 29)
# swapcase (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9198-str-swapcase-set29.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("moon"), "MOON", "حالة 1")
تأكد_يساوي(ف("kayak"), "KAYAK", "حالة 2")
تأكد_يساوي(ف("rotor"), "ROTOR", "حالة 3")
تأكد_يساوي(ف("stats"), "STATS", "حالة 4")
تأكد_يساوي(ف("star"), "STAR", "حالة 5")
