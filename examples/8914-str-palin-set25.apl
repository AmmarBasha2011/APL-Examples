# مثال 8914 — هل الكلمة متناظرة (مجموعة اختبار 25)
# palin (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8914-str-palin-set25.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("google"), خطأ, "حالة 1")
تأكد_يساوي(ف("rocket"), خطأ, "حالة 2")
تأكد_يساوي(ف("mars"), خطأ, "حالة 3")
تأكد_يساوي(ف("refer"), صواب, "حالة 4")
تأكد_يساوي(ف("bob"), صواب, "حالة 5")
