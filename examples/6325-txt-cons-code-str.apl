# مثال 6325 — النص الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (رقم الحرف)
# str of code applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6325-txt-cons-code-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + str(ord(خ))+","
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "104,108,108,119,114,108,100,", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "112,108,115,102,110,", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "98,99,", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "116,104,113,99,107,98,114,119,110,102,120,", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "122,122,122,121,121,121,120,120,120,", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "100,116,115,99,110,99,", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "112,114,103,114,109,109,110,103,110,114,98,99,", "حالة 8")
