# مثال 4761 — مجموع قوى الأرقام (القوة 4)
# Sum of digits raised to 4
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4761-digit-power-sum-4.apl

# نرفع كل رقم لقوة ثابتة
# ونجمع النتائج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ج = 0
  لكل د في str(ن):
    ج = ج + int(د) ** 4
  ارجع ج

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(9), 6561, "حالة 2")
تأكد_يساوي(ف(153), 707, "حالة 3")
تأكد_يساوي(ف(407), 2657, "حالة 4")
تأكد_يساوي(ف(9474), 9474, "حالة 5")
