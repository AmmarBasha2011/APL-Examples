# مثال 6800 — العدد المضلّع ذو 25 أضلاع
# 25-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6800-polygonal-25.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((25 - 2) * ن * ن - (25 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 25, "حالة 2")
تأكد_يساوي(ف(5), 235, "حالة 3")
تأكد_يساوي(ف(10), 1045, "حالة 4")
