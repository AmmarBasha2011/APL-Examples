# مثال 6624 — الأعداد التي باقيها 0 عند القسمة على 3
# Numbers with remainder 0 mod 3
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6624-residue-3-0.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 3 == 0:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [0, 3, 6, 9], "حالة 2")
تأكد_يساوي(ف(40), [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39], "حالة 3")
تأكد_يساوي(ف(75), [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39, 42, 45, 48, 51, 54, 57, 60, 63, 66, 69, 72], "حالة 4")
