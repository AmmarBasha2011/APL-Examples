# مثال 8975 — حروف الكلمة مرتبة (مجموعة اختبار 6)
# sortchars (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8975-str-sortchars-set6.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("star"), "arst", "حالة 1")
تأكد_يساوي(ف("venus"), "ensuv", "حالة 2")
تأكد_يساوي(ف("earth"), "aehrt", "حالة 3")
تأكد_يساوي(ف("civic"), "cciiv", "حالة 4")
تأكد_يساوي(ف("array"), "aarry", "حالة 5")
