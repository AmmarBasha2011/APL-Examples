# مثال 9476 — عدد القواسم (مجموعة اختبار 27)
# ndiv (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9476-num-ndiv-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(62), 4, "حالة 1")
تأكد_يساوي(ف(108), 12, "حالة 2")
تأكد_يساوي(ف(299), 4, "حالة 3")
تأكد_يساوي(ف(38), 4, "حالة 4")
تأكد_يساوي(ف(36), 9, "حالة 5")
