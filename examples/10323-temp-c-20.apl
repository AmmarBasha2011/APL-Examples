# مثال 10323 — تحويل 20 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 20 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10323-temp-c-20.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 20) * 9 // 5 + 32

تأكد_يساوي(ف(0), 68, "حالة 1")
تأكد_يساوي(ف(10), 86, "حالة 2")
تأكد_يساوي(ف(37), 134, "حالة 3")
تأكد_يساوي(ف(-5), 59, "حالة 4")
