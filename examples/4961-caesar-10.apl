# مثال 4961 — شيفرة قيصر بإزاحة 10
# Caesar cipher shift 10
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4961-caesar-10.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 10) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "klm", "حالة 1")
تأكد_يساوي(ف("hello world"), "rovvy gybvn", "حالة 2")
تأكد_يساوي(ف("xyz"), "hij", "حالة 3")
تأكد_يساوي(ف("a b-c"), "k l-m", "حالة 4")
