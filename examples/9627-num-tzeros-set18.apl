# مثال 9627 — الأصفار في نهاية العاملي (مجموعة اختبار 18)
# tzeros (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9627-num-tzeros-set18.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(204), 49, "حالة 1")
تأكد_يساوي(ف(465), 114, "حالة 2")
تأكد_يساوي(ف(417), 102, "حالة 3")
تأكد_يساوي(ف(489), 119, "حالة 4")
تأكد_يساوي(ف(351), 86, "حالة 5")
