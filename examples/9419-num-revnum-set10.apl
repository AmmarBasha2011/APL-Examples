# مثال 9419 — عكس الأرقام (مجموعة اختبار 10)
# revnum (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9419-num-revnum-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(6863), 3686, "حالة 1")
تأكد_يساوي(ف(35084), 48053, "حالة 2")
تأكد_يساوي(ف(11427), 72411, "حالة 3")
تأكد_يساوي(ف(53377), 77335, "حالة 4")
تأكد_يساوي(ف(34937), 73943, "حالة 5")
