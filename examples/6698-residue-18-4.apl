# مثال 6698 — الأعداد التي باقيها 4 عند القسمة على 18
# Numbers with remainder 4 mod 18
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6698-residue-18-4.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 18 == 4:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [4], "حالة 2")
تأكد_يساوي(ف(40), [4, 22], "حالة 3")
تأكد_يساوي(ف(75), [4, 22, 40, 58], "حالة 4")
