# مثال 9035 — هل لا يتكرر أي حرف (مجموعة اختبار 26)
# isogram (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9035-str-isogram-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("orbit"), صواب, "حالة 1")
تأكد_يساوي(ف("deed"), خطأ, "حالة 2")
تأكد_يساوي(ف("tenet"), خطأ, "حالة 3")
تأكد_يساوي(ف("google"), خطأ, "حالة 4")
تأكد_يساوي(ف("silent"), صواب, "حالة 5")
