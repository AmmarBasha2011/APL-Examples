# مثال 5322 — مجموع تراكمي مع زيادة 18
# Running total plus 18 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5322-cumulative-18.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 18
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [19, 39, 60], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [23, 46, 69, 92], "حالة 3")
