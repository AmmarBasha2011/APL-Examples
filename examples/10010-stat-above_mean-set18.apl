# مثال 10010 — عدد العناصر فوق المتوسط (مجموعة 18)
# above_mean (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10010-stat-above_mean-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([36, 11, 8, -15, 38, 46, 35, -3]), 4, "حالة 1")
تأكد_يساوي(ف([48, 15, 20, 52, -13, 54, 57, 33]), 4, "حالة 2")
تأكد_يساوي(ف([43, 25, 60, -12, -8, 14]), 3, "حالة 3")
تأكد_يساوي(ف([9, -2, 17, 28]), 2, "حالة 4")
