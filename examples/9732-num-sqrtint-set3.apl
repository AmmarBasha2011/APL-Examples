# مثال 9732 — الجذر التربيعي الصحيح (مجموعة اختبار 3)
# sqrtint (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9732-num-sqrtint-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(4672), 68, "حالة 1")
تأكد_يساوي(ف(1370), 37, "حالة 2")
تأكد_يساوي(ف(1910), 43, "حالة 3")
تأكد_يساوي(ف(2271), 47, "حالة 4")
تأكد_يساوي(ف(3923), 62, "حالة 5")
