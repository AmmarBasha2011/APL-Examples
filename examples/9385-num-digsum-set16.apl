# مثال 9385 — مجموع الأرقام (مجموعة اختبار 16)
# digsum (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9385-num-digsum-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(8795), 29, "حالة 1")
تأكد_يساوي(ف(93631), 22, "حالة 2")
تأكد_يساوي(ف(42676), 25, "حالة 3")
تأكد_يساوي(ف(55095), 24, "حالة 4")
تأكد_يساوي(ف(481), 13, "حالة 5")
