# مثال 6154 — أول 3 حروف من الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (حرف كبير)
# head of upper applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6154-txt-cons-upper-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ.upper()
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "HLL", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "PLS", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "BC", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "THQ", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "ZZZ", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "DTS", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "PRG", "حالة 8")
