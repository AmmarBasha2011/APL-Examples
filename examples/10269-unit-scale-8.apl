# مثال 10269 — تحويل وحدة إلى 8 وحدات صغرى والعكس
# Convert units with factor 8
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10269-unit-scale-8.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 8, ن // 8, ن % 8]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [8, 0, 1], "حالة 2")
تأكد_يساوي(ف(8), [64, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [8000, 125, 0], "حالة 4")
