# مثال 9895 — الوسيط (بعد الترتيب) (مجموعة 3)
# median (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9895-stat-median-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([39, 44, -6, 57, 54, 11, 35, 40]), 39, "حالة 1")
تأكد_يساوي(ف([22, 36, 50, 26, 1]), 26, "حالة 2")
تأكد_يساوي(ف([-5, -15, 49, 41, -7, 23, -13]), -5, "حالة 3")
تأكد_يساوي(ف([57, 2, 4]), 4, "حالة 4")
