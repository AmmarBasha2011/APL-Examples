# مثال 9788 — قلب الخانة رقم 4
# Flip bit 4
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9788-bits-flip-4.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 4)

تأكد_يساوي(ف(0), 16, "حالة 1")
تأكد_يساوي(ف(255), 239, "حالة 2")
تأكد_يساوي(ف(1000), 1016, "حالة 3")
تأكد_يساوي(ف(12345), 12329, "حالة 4")
