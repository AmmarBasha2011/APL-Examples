# مثال 9408 — مجموع الأرقام (مجموعة اختبار 39)
# digsum (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9408-num-digsum-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(60503), 14, "حالة 1")
تأكد_يساوي(ف(69038), 26, "حالة 2")
تأكد_يساوي(ف(75798), 36, "حالة 3")
تأكد_يساوي(ف(61411), 13, "حالة 4")
تأكد_يساوي(ف(33506), 17, "حالة 5")
