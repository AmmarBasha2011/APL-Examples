# مثال 4901 — اليوم بعد 6 أيام
# Weekday 6 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4901-week-day-shift-6.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 6) % 7

تأكد_يساوي(ف(0), 6, "حالة 1")
تأكد_يساوي(ف(3), 2, "حالة 2")
تأكد_يساوي(ف(6), 5, "حالة 3")
تأكد_يساوي(ف(4), 3, "حالة 4")
