# مثال 9833 — قلب الخانة رقم 13
# Flip bit 13
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9833-bits-flip-13.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 13)

تأكد_يساوي(ف(0), 8192, "حالة 1")
تأكد_يساوي(ف(255), 8447, "حالة 2")
تأكد_يساوي(ف(1000), 9192, "حالة 3")
تأكد_يساوي(ف(12345), 4153, "حالة 4")
