# مثال 9940 — المنوال (الأصغر عند التساوي) (مجموعة 23)
# mode (data set 23)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9940-stat-mode-set23.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([48, 17, 17, -12, 28, 35, 40]), 17, "حالة 1")
تأكد_يساوي(ف([-6, 51, 47, 46, -7]), -7, "حالة 2")
تأكد_يساوي(ف([-17, 14, 46, 60]), -17, "حالة 3")
تأكد_يساوي(ف([-12, 14, 14, 48, 25]), 14, "حالة 4")
