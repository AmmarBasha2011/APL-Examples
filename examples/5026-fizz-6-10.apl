# مثال 5026 — فيزباز بالعددين 6 و 10
# FizzBuzz variant with 6 and 10
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5026-fizz-6-10.apl

# A للقابل على الأول، B للثاني، AB للاثنين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    لو ي % 6 == 0 و ي % 10 == 0:
      ر = ر + ["AB"]
    والا_لو ي % 6 == 0:
      ر = ر + ["A"]
    والا_لو ي % 10 == 0:
      ر = ر + ["B"]
    والا:
      ر = ر + [str(ي)]
  ارجع ر

تأكد_يساوي(ف(1), ["1"], "حالة 1")
تأكد_يساوي(ف(10), ["1", "2", "3", "4", "5", "A", "7", "8", "9", "B"], "حالة 2")
تأكد_يساوي(ف(30), ["1", "2", "3", "4", "5", "A", "7", "8", "9", "B", "11", "A", "13", "14", "15", "16", "17", "A", "19", "B", "21", "22", "23", "A", "25", "26", "27", "28", "29", "AB"], "حالة 3")
تأكد_يساوي(ف(0), [], "حالة 4")
