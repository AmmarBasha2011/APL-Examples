# مثال 10327 — تحويل 28 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 28 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10327-temp-c-28.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 28) * 9 // 5 + 32

تأكد_يساوي(ف(0), 82, "حالة 1")
تأكد_يساوي(ف(10), 100, "حالة 2")
تأكد_يساوي(ف(37), 149, "حالة 3")
تأكد_يساوي(ف(-5), 73, "حالة 4")
