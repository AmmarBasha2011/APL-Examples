# مثال 9602 — الجذر الرقمي (مجموعة اختبار 33)
# droot (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9602-num-droot-set33.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(85778), 8, "حالة 1")
تأكد_يساوي(ف(80450), 8, "حالة 2")
تأكد_يساوي(ف(80124), 6, "حالة 3")
تأكد_يساوي(ف(33348), 3, "حالة 4")
تأكد_يساوي(ف(64745), 8, "حالة 5")
