# مثال 9141 — ضغط التكرار (مجموعة اختبار 12)
# rle (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9141-str-rle-set12.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("listen"), "l1i1s1t1e1n1", "حالة 1")
تأكد_يساوي(ف("moon"), "m1o2n1", "حالة 2")
تأكد_يساوي(ف("earth"), "e1a1r1t1h1", "حالة 3")
تأكد_يساوي(ف("star"), "s1t1a1r1", "حالة 4")
تأكد_يساوي(ف("refer"), "r1e1f1e1r1", "حالة 5")
