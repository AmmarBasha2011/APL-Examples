# مثال 6645 — الأعداد التي باقيها 3 عند القسمة على 7
# Numbers with remainder 3 mod 7
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6645-residue-7-3.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 7 == 3:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [3], "حالة 2")
تأكد_يساوي(ف(40), [3, 10, 17, 24, 31, 38], "حالة 3")
تأكد_يساوي(ف(75), [3, 10, 17, 24, 31, 38, 45, 52, 59, 66, 73], "حالة 4")
