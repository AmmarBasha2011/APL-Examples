# مثال 9983 — التباين الصحيح (مجموعة 16)
# variance (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9983-stat-variance-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([23, -14, -20, 27, -6]), 374, "حالة 1")
تأكد_يساوي(ف([18, 16, -1, 55, 38, -20, 2, 20]), 475, "حالة 2")
تأكد_يساوي(ف([38, 14, 40, 53, 43, 27]), 154, "حالة 3")
تأكد_يساوي(ف([-1, -6, -12, -3, 16]), 88, "حالة 4")
