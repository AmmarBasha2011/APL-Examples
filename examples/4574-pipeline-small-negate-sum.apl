# مثال 4574 — مجموع نتيجة سالبها للأعداد الأقل من 5
# Sum of negated over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4574-pipeline-small-negate-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [0 - خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([9, 0, 0, 4, 16]), -4, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 1, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -8, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 9, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
