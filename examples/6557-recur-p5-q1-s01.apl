# مثال 6557 — متتالية a(n) = 5·a(n-1) + 1·a(n-2) تبدأ بـ 0,1
# Linear recurrence p=5 q=1 start 0,1
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6557-recur-p5-q1-s01.apl

# كل حد يعتمد على الحدين السابقين
# نحدّث زوجاً من المتغيرات في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = 0
  ص = 1
  لكل ي في range(ن):
    ت = 5 * ص + 1 * س
    س = ص
    ص = ت
  ارجع س

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(2), 5, "حالة 3")
تأكد_يساوي(ف(5), 701, "حالة 4")
تأكد_يساوي(ف(8), 98145, "حالة 5")
تأكد_يساوي(ف(12), 71351280, "حالة 6")
