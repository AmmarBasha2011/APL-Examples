# مثال 7650 — المجموع: من ي + 10 باقي 7 نأخذ الزوجي ثم (زيادة واحد)
# sum over mixed sequence, keep even, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7650-seq-mixed-even-inc-sum.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ % 2 == 0:
      ر = ر + [خ + 1]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 13, "حالة 3")
تأكد_يساوي(ف(10), 21, "حالة 4")
تأكد_يساوي(ف(15), 32, "حالة 5")
