# مثال 7023 — أكبر قيمة: من المربعات نأخذ الأكبر من 5 ثم (سالب)
# max over squares sequence, keep gt5, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7023-seq-squares-gt5-neg-max.apl

# نولّد أول ن حد من: المربعات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي
    لو خ > 5:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -9, "حالة 3")
تأكد_يساوي(ف(10), -9, "حالة 4")
تأكد_يساوي(ف(15), -9, "حالة 5")
