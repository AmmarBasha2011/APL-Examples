# مثال 9617 — الأصفار في نهاية العاملي (مجموعة اختبار 8)
# tzeros (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9617-num-tzeros-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(99), 22, "حالة 1")
تأكد_يساوي(ف(219), 52, "حالة 2")
تأكد_يساوي(ف(412), 101, "حالة 3")
تأكد_يساوي(ف(190), 46, "حالة 4")
تأكد_يساوي(ف(469), 114, "حالة 5")
