# مثال 10087 — قص كل عنصر عند 5
# Clip every item at 5
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10087-clip-list-5.apl

# نأخذ الأصغر بين العنصر والحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [min(خ, 5)]
  ارجع ر

تأكد_يساوي(ف([0, 5, 10, 15, 20, 25, 30, 35]), [0, 5, 5, 5, 5, 5, 5, 5], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 6, 4]), [5, 5, 4], "حالة 3")
