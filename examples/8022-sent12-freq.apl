# مثال 8022 — تكرار كل كلمة في الجملة رقم 13
# freq for sentence 13
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8022-sent12-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("cairo is big and cairo is old"), {"cairo": 2, "is": 2, "big": 1, "and": 1, "old": 1}, "حالة 1")
تأكد_يساوي(ف("stars and moon and stars again"), {"stars": 2, "and": 2, "moon": 1, "again": 1}, "حالة 2")
تأكد_يساوي(ف("yes no yes yes no maybe"), {"yes": 3, "no": 2, "maybe": 1}, "حالة 3")
