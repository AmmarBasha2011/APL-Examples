# مثال 9074 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 25)
# dedupe (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9074-str-dedupe-set25.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("level"), "lev", "حالة 1")
تأكد_يساوي(ف("orbit"), "orbit", "حالة 2")
تأكد_يساوي(ف("apple"), "aple", "حالة 3")
تأكد_يساوي(ف("rocket"), "rocket", "حالة 4")
تأكد_يساوي(ف("refer"), "ref", "حالة 5")
