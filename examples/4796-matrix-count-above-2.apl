# مثال 4796 — عدد العناصر الأكبر من 2
# Cells greater than 2
# Demonstrates: مصفوفات وقوائم متداخلة
#
# Run:  python apl.py examples/4796-matrix-count-above-2.apl

# نعد الخلايا اللي قيمتها فوق حد معين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ع = 0
  لكل ص في م:
    لكل خ في ص:
      لو خ > 2:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([[1, 2], [3, 4]]), 2, "حالة 1")
تأكد_يساوي(ف([[5, 0, 2], [1, 9, 3], [4, 4, 4]]), 6, "حالة 2")
تأكد_يساوي(ف([[2, -1, 7], [0, 3, -5]]), 2, "حالة 3")
تأكد_يساوي(ف([[1], [2], [3]]), 1, "حالة 4")
تأكد_يساوي(ف([[6, 5, 4, 3], [2, 1, 0, -1]]), 4, "حالة 5")
