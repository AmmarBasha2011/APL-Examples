# مثال 9622 — الأصفار في نهاية العاملي (مجموعة اختبار 13)
# tzeros (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9622-num-tzeros-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(27), 6, "حالة 1")
تأكد_يساوي(ف(353), 86, "حالة 2")
تأكد_يساوي(ف(462), 113, "حالة 3")
تأكد_يساوي(ف(321), 78, "حالة 4")
تأكد_يساوي(ف(104), 24, "حالة 5")
