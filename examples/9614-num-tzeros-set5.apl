# مثال 9614 — الأصفار في نهاية العاملي (مجموعة اختبار 5)
# tzeros (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9614-num-tzeros-set5.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(297), 72, "حالة 1")
تأكد_يساوي(ف(100), 24, "حالة 2")
تأكد_يساوي(ف(105), 25, "حالة 3")
تأكد_يساوي(ف(378), 93, "حالة 4")
تأكد_يساوي(ف(328), 80, "حالة 5")
