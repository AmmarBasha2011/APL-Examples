# مثال 7935 — عدد الكلمات المكررة في الجملة رقم 4
# repeated for sentence 4
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7935-sent3-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("one fish two fish red fish blue fish"), 1, "حالة 1")
تأكد_يساوي(ف("tea for two and two for tea"), 3, "حالة 2")
تأكد_يساوي(ف("red blue green red blue red"), 2, "حالة 3")
