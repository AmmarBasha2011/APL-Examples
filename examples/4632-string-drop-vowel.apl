# مثال 4632 — حذف (حرف علة) في نص
# String: drop vowel
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4632-string-drop-vowel.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو ليس ("aeiou".find(خ.lower()) != -1):
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("quick brown fox"), "qck brwn fx", "حالة 1")
تأكد_يساوي(ف("ZZtop and the Beatles"), "ZZtp nd th Btls", "حالة 2")
تأكد_يساوي(ف("Data Science 101"), "Dt Scnc 101", "حالة 3")
تأكد_يساوي(ف("2026-11-28 launch"), "2026-11-28 lnch", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
