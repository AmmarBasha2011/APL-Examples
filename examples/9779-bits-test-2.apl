# مثال 9779 — هل الخانة رقم 2 مضاءة
# Is bit 2 set
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9779-bits-test-2.apl

# نمرر الخانة إلى الموضع الأول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع (ن >> 2) & 1 == 1

تأكد_يساوي(ف(0), خطأ, "حالة 1")
تأكد_يساوي(ف(255), صواب, "حالة 2")
تأكد_يساوي(ف(1000), خطأ, "حالة 3")
تأكد_يساوي(ف(12345), خطأ, "حالة 4")
