# مثال 9769 — الجذر التربيعي الصحيح (مجموعة اختبار 40)
# sqrtint (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9769-num-sqrtint-set40.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2933), 54, "حالة 1")
تأكد_يساوي(ف(899), 29, "حالة 2")
تأكد_يساوي(ف(1704), 41, "حالة 3")
تأكد_يساوي(ف(1273), 35, "حالة 4")
تأكد_يساوي(ف(3379), 58, "حالة 5")
