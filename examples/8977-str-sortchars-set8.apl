# مثال 8977 — حروف الكلمة مرتبة (مجموعة اختبار 8)
# sortchars (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8977-str-sortchars-set8.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("river"), "eirrv", "حالة 1")
تأكد_يساوي(ف("rotor"), "oorrt", "حالة 2")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 3")
تأكد_يساوي(ف("orbit"), "biort", "حالة 4")
تأكد_يساوي(ف("moon"), "mnoo", "حالة 5")
