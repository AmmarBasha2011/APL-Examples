# مثال 7140 — المجموع: من الأعداد المثلثية نأخذ الموجب ثم (ضعف)
# sum over tri sequence, keep pos, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7140-seq-tri-pos-double-sum.apl

# نولّد أول ن حد من: الأعداد المثلثية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * (ي + 1) // 2
    لو خ > 0:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 40, "حالة 3")
تأكد_يساوي(ف(10), 330, "حالة 4")
تأكد_يساوي(ف(15), 1120, "حالة 5")
