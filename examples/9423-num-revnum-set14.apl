# مثال 9423 — عكس الأرقام (مجموعة اختبار 14)
# revnum (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9423-num-revnum-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(58190), 9185, "حالة 1")
تأكد_يساوي(ف(30754), 45703, "حالة 2")
تأكد_يساوي(ف(6791), 1976, "حالة 3")
تأكد_يساوي(ف(94950), 5949, "حالة 4")
تأكد_يساوي(ف(75158), 85157, "حالة 5")
