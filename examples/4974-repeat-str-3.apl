# مثال 4974 — تكرار النص 3 مرات بفاصل
# Repeat text 3 times with separator
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4974-repeat-str-3.apl

# نبني النص بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(3):
    ر = ر + [ن]
  ارجع "-".join(ر)

تأكد_يساوي(ف("a"), "a-a-a", "حالة 1")
تأكد_يساوي(ف("xy"), "xy-xy-xy", "حالة 2")
تأكد_يساوي(ف(""), "--", "حالة 3")
