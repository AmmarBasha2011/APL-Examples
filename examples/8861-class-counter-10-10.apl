# مثال 8861 — صنف عداد يزيد 10 من 10
# Counter class step 10 from 10
# Demonstrates: البرمجة الكائنية
#
# Run:  python apl.py examples/8861-class-counter-10-10.apl

# صنف بحالة داخلية
# دالة تزيد القيمة وأخرى تصفّرها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف عداد:
    دالة_إنشاء(ذات, بداية):
        ذات.قيمة = بداية

    دالة زد(ذات):
        ذات.قيمة = ذات.قيمة + 10
        ارجع ذات.قيمة

    دالة صفر(ذات):
        ذات.قيمة = 10

ع = عداد(10)
تأكد_يساوي(ع.قيمة, 10, "البداية")
تأكد_يساوي(ع.زد(), 20, "خطوة 1")
تأكد_يساوي(ع.زد(), 30, "خطوة 2")
تأكد_يساوي(ع.زد(), 40, "خطوة 3")
تأكد_يساوي(ع.زد(), 50, "خطوة 4")
تأكد_يساوي(ع.زد(), 60, "خطوة 5")
ع.صفر()
تأكد_يساوي(ع.قيمة, 10, "بعد التصفير")
