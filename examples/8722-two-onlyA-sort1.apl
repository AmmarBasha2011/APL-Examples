# مثال 8722 — عناصر الأولى غير الموجودة في الثانية (الأولى مرتبة)
# two lists onlyA, sort1
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8722-two-onlyA-sort1.apl

# دالة تأخذ قائمتين
# وتعالجهما معاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ب):
  أ = sorted(أ)
  ر = []
  لكل خ في أ:
    لو ليس (خ في ب):
      ر = ر + [خ]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]), [], "حالة 1")
تأكد_يساوي(ف([5, 3, 8, 3], [3, 3, 9, 8]), [5], "حالة 2")
تأكد_يساوي(ف([10, 20, 30], [10, 0, 30, 40]), [20], "حالة 3")
تأكد_يساوي(ف([2, 4, 6, 8, 10, 12], [1, 2, 3]), [4, 6, 8, 10, 12], "حالة 4")
تأكد_يساوي(ف([7, 7, 7, 1], [7, 1, 7, 7]), [], "حالة 5")
تأكد_يساوي(ف([9, 8, 7, 6, 5, 4, 3], [4, 5, 6, 7, 8]), [3, 9], "حالة 6")
