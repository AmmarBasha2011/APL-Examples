# مثال 5284 — آخر رقم للعدد 15 أس ن
# Last digit of 15^n
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5284-last-digit-power-15.apl

# نستخدم الباقي على 10 في كل ضرب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 1
  لكل ي في range(ن):
    ر = ر * 15 % 10
  ارجع ر

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 5, "حالة 2")
تأكد_يساوي(ف(5), 5, "حالة 3")
تأكد_يساوي(ف(13), 5, "حالة 4")
تأكد_يساوي(ف(100), 5, "حالة 5")
