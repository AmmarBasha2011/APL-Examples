# مثال 9457 — عدد القواسم (مجموعة اختبار 8)
# ndiv (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9457-num-ndiv-set8.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(273), 8, "حالة 1")
تأكد_يساوي(ف(264), 16, "حالة 2")
تأكد_يساوي(ف(277), 2, "حالة 3")
تأكد_يساوي(ف(66), 8, "حالة 4")
تأكد_يساوي(ف(253), 4, "حالة 5")
