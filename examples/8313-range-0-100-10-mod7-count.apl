# مثال 8313 — العدد من المدى 0 إلى 100 بخطوة 10 بعد (باقي على 7)
# count over range(0,100,10) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8313-range-0-100-10-mod7-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 100:
    ر = ر + [خ % 7]
    خ = خ + (10)
  ارجع len(ر)

تأكد_يساوي(ف(), 10, "المدى كله")
