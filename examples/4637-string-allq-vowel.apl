# مثال 4637 — هل كل الأحرف (حرف علة) في نص
# String: are all characters vowel
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4637-string-allq-vowel.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو ليس ("aeiou".find(خ.lower()) != -1):
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("quick brown fox"), خطأ, "حالة 1")
تأكد_يساوي(ف("MixedCASE123abc"), خطأ, "حالة 2")
تأكد_يساوي(ف("aeiou AEIOU xyz"), خطأ, "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), خطأ, "حالة 4")
تأكد_يساوي(ف(""), صواب, "حالة 5")
