# مثال 4993 — قوى العدد 6 حتى 6
# Powers of 6 up to 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4993-power-table-6.apl

# نضرب في العدد في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  ق = 1
  لكل ي في range(ن + 1):
    ر = ر + [ق]
    ق = ق * 6
  ارجع ر

تأكد_يساوي(ف(0), [1], "حالة 1")
تأكد_يساوي(ف(3), [1, 6, 36, 216], "حالة 2")
تأكد_يساوي(ف(6), [1, 6, 36, 216, 1296, 7776, 46656], "حالة 3")
