# مثال 9705 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 16)
# popcnt (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9705-num-popcnt-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(549), 4, "حالة 1")
تأكد_يساوي(ف(2667), 7, "حالة 2")
تأكد_يساوي(ف(3443), 8, "حالة 3")
تأكد_يساوي(ف(30), 4, "حالة 4")
تأكد_يساوي(ف(2316), 4, "حالة 5")
