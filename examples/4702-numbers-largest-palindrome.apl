# مثال 4702 — أكبر الأعداد المتماثل الأرقام حتى حد معين
# Numbers up to a limit: largest of the palindromic ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4702-numbers-largest-palindrome.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو str(ر) == str(ر)[::-1]:
      ن = ن + [ر]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف(18), 11, "حالة 1")
تأكد_يساوي(ف(38), 33, "حالة 2")
تأكد_يساوي(ف(135), 131, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
