# مثال 6299 — أول 3 حروف من الناتج بعد أخذ الحروف فقط وتحويلها إلى (الحرف التالي)
# head of shift1 applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6299-txt-alpha-shift1-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: الحرف التالي
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + chr(ord(خ) + 1)
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "ifm", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "bqm", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "bcd", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "uif", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "{{{", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "ebu", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "qsp", "حالة 8")
