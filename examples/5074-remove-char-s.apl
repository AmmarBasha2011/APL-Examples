# مثال 5074 — حذف الحرف s من النص
# Remove letter s
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5074-remove-char-s.apl

# نبني نصاً جديداً بدون الحرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح != "s":
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("banana"), "banana", "حالة 1")
تأكد_يساوي(ف("education"), "education", "حالة 2")
تأكد_يساوي(ف(""), "", "حالة 3")
تأكد_يساوي(ف("mississippi"), "miiippi", "حالة 4")
