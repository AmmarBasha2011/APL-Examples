# مثال 8976 — حروف الكلمة مرتبة (مجموعة اختبار 7)
# sortchars (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8976-str-sortchars-set7.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("bob"), "bbo", "حالة 1")
تأكد_يساوي(ف("mars"), "amrs", "حالة 2")
تأكد_يساوي(ف("saturn"), "anrstu", "حالة 3")
تأكد_يساوي(ف("code"), "cdeo", "حالة 4")
تأكد_يساوي(ف("tenet"), "eentt", "حالة 5")
