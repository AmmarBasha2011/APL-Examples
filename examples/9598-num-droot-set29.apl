# مثال 9598 — الجذر الرقمي (مجموعة اختبار 29)
# droot (test set 29)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9598-num-droot-set29.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(48022), 7, "حالة 1")
تأكد_يساوي(ف(40855), 4, "حالة 2")
تأكد_يساوي(ف(93951), 9, "حالة 3")
تأكد_يساوي(ف(31336), 7, "حالة 4")
تأكد_يساوي(ف(80435), 2, "حالة 5")
