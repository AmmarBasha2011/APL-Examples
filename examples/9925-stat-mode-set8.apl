# مثال 9925 — المنوال (الأصغر عند التساوي) (مجموعة 8)
# mode (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9925-stat-mode-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([34, -9, 42, 15]), -9, "حالة 1")
تأكد_يساوي(ف([9, 25, 50, 37, 56, -12, -16]), -16, "حالة 2")
تأكد_يساوي(ف([14, 60, -10, 12, 60, 2, 33, 43, 11]), 60, "حالة 3")
تأكد_يساوي(ف([24, -7, 14]), -7, "حالة 4")
