# مثال 7975 — عدد الكلمات المكررة في الجملة رقم 8
# repeated for sentence 8
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7975-sent7-repeated.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ع = 0
  لكل ك في د:
    لو د[ك] > 1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("run run run fast fast slow"), 2, "حالة 1")
تأكد_يساوي(ف("red blue green red blue red"), 2, "حالة 2")
تأكد_يساوي(ف("learn code learn more code more"), 3, "حالة 3")
