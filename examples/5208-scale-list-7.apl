# مثال 5208 — ضرب كل عنصر في 7
# Scale list by 7
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5208-scale-list-7.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 7]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [7, 14, 21], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -28, 70], "حالة 3")
