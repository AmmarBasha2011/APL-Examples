# مثال 9782 — آخر 3 خانات ثنائية
# Low 3 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9782-bits-low-3.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 7, "حالة 2")
تأكد_يساوي(ف(1000), 0, "حالة 3")
تأكد_يساوي(ف(12345), 1, "حالة 4")
