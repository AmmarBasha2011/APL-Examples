# مثال 9691 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 2)
# popcnt (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9691-num-popcnt-set2.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(354), 4, "حالة 1")
تأكد_يساوي(ف(4263), 6, "حالة 2")
تأكد_يساوي(ف(988), 7, "حالة 3")
تأكد_يساوي(ف(4190), 6, "حالة 4")
تأكد_يساوي(ف(1634), 5, "حالة 5")
