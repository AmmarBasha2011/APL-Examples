# مثال 7904 — أعلى تكرار في الجملة رقم 1
# maxcount for sentence 1
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7904-sent0-maxcount.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  م = 0
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
    م = max(م, د[ك])
  ارجع م

تأكد_يساوي(ف("the cat and the dog and the bird"), 3, "حالة 1")
تأكد_يساوي(ف("one fish two fish red fish blue fish"), 4, "حالة 2")
تأكد_يساوي(ف("run run run fast fast slow"), 3, "حالة 3")
