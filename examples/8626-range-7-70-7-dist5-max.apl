# مثال 8626 — أكبر قيمة من المدى 7 إلى 70 بخطوة 7 بعد (البعد عن 5)
# max over range(7,70,7) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8626-range-7-70-7-dist5-max.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [abs(خ - 5)]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(), 58, "المدى كله")
