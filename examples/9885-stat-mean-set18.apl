# مثال 9885 — المتوسط الصحيح (مجموعة 18)
# mean (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9885-stat-mean-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([-4, 36, 54, 24, 35, 48, -9, -14]), 21, "حالة 1")
تأكد_يساوي(ف([-5, 16, 10, 5, 58, 0]), 14, "حالة 2")
تأكد_يساوي(ف([-2, 9, 46]), 17, "حالة 3")
تأكد_يساوي(ف([-13, 8, 29]), 8, "حالة 4")
