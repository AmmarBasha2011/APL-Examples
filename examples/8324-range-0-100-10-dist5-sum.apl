# مثال 8324 — المجموع من المدى 0 إلى 100 بخطوة 10 بعد (البعد عن 5)
# sum over range(0,100,10) mapped by dist5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8324-range-0-100-10-dist5-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 100:
    ر = ر + [abs(خ - 5)]
    خ = خ + (10)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 410, "المدى كله")
