# مثال 7344 — آخر عنصر: من ي * 4 باقي 9 نأخذ الفردي ثم (ضعف)
# last over mod9 sequence, keep odd, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7344-seq-mod9-odd-double-last.apl

# نولّد أول ن حد من: ي * 4 باقي 9
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي * 4) % 9
    لو خ % 2 == 1:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(0), -1, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), 14, "حالة 3")
تأكد_يساوي(ف(10), 10, "حالة 4")
تأكد_يساوي(ف(15), 14, "حالة 5")
