# مثال 7600 — المجموع: من مربع ناقص ي نأخذ الأكبر من 5 ثم (سالب)
# sum over sq_minus sequence, keep gt5, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7600-seq-sq_minus-gt5-neg-sum.apl

# نولّد أول ن حد من: مربع ناقص ي
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي - ي
    لو خ > 5:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -18, "حالة 3")
تأكد_يساوي(ف(10), -238, "حالة 4")
تأكد_يساوي(ف(15), -908, "حالة 5")
