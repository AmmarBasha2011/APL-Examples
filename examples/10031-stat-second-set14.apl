# مثال 10031 — ثاني أكبر قيمة مختلفة (مجموعة 14)
# second (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10031-stat-second-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([46, 50, 41, -1, 50, 33, -8, 35, 5]), 46, "حالة 1")
تأكد_يساوي(ف([-9, 47, 28, 4, 8, 13, -2]), 28, "حالة 2")
تأكد_يساوي(ف([54, -4, 3, 51, 40, -15, 2]), 51, "حالة 3")
تأكد_يساوي(ف([54, 55, 59, -18, 25, 5, -2, 25, -15]), 55, "حالة 4")
