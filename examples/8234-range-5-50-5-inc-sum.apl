# مثال 8234 — المجموع من المدى 5 إلى 50 بخطوة 5 بعد (زيادة واحد)
# sum over range(5,50,5) mapped by inc
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8234-range-5-50-5-inc-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ + 1]
    خ = خ + (5)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 234, "المدى كله")
