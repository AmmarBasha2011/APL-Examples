# مثال 4814 — فائدة بسيطة بنسبة 2%
# Simple interest at 2 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4814-simple-interest-2.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 2 * س // 100

تأكد_يساوي(ف(1000, 1), 20, "حالة 1")
تأكد_يساوي(ف(2500, 3), 150, "حالة 2")
تأكد_يساوي(ف(100, 10), 20, "حالة 3")
تأكد_يساوي(ف(8000, 2), 320, "حالة 4")
