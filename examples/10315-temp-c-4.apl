# مثال 10315 — تحويل 4 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 4 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10315-temp-c-4.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 4) * 9 // 5 + 32

تأكد_يساوي(ف(0), 39, "حالة 1")
تأكد_يساوي(ف(10), 57, "حالة 2")
تأكد_يساوي(ف(37), 105, "حالة 3")
تأكد_يساوي(ف(-5), 30, "حالة 4")
