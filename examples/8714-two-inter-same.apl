# مثال 8714 — دمج بالتناوب (كما هي)
# two lists inter, same
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8714-two-inter-same.apl

# دالة تأخذ قائمتين
# وتعالجهما معاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ب):
  ر = []
  لكل ي في range(min(len(أ), len(ب))):
    ر = ر + [أ[ي], ب[ي]]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]), [1, 5, 2, 4, 3, 3, 4, 2, 5, 1], "حالة 1")
تأكد_يساوي(ف([5, 3, 8, 3], [3, 3, 9, 8]), [5, 3, 3, 3, 8, 9, 3, 8], "حالة 2")
تأكد_يساوي(ف([10, 20, 30], [10, 0, 30, 40]), [10, 10, 20, 0, 30, 30], "حالة 3")
تأكد_يساوي(ف([2, 4, 6, 8, 10, 12], [1, 2, 3]), [2, 1, 4, 2, 6, 3], "حالة 4")
تأكد_يساوي(ف([7, 7, 7, 1], [7, 1, 7, 7]), [7, 7, 7, 1, 7, 7, 1, 7], "حالة 5")
تأكد_يساوي(ف([9, 8, 7, 6, 5, 4, 3], [4, 5, 6, 7, 8]), [9, 4, 8, 5, 7, 6, 6, 7, 5, 8], "حالة 6")
