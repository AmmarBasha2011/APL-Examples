# مثال 4941 — تدوير القائمة 6 خانات لليسار
# Rotate list left by 6
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4941-rotate-left-6.apl

# نقسم القائمة ونعيد ترتيبها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  لو len(ق) == 0:
    ارجع ق
  ك = 6 % len(ق)
  ارجع ق[ك:] + ق[:ك]

تأكد_يساوي(ف([1, 2, 3, 4, 5, 6, 7]), [7, 1, 2, 3, 4, 5, 6], "حالة 1")
تأكد_يساوي(ف([1, 2]), [1, 2], "حالة 2")
تأكد_يساوي(ف([]), [], "حالة 3")
تأكد_يساوي(ف(["a", "b", "c", "d", "e", "f"]), ["a", "b", "c", "d", "e", "f"], "حالة 4")
