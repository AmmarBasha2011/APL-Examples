# مثال 4560 — ترتيب نتيجة ناقص 3 للأعداد الأكبر من 10
# Sorted list of minus 3 over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4560-pipeline-big-minus3-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ - 3]
  ارجع sorted(ن)

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [9, 12], "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [9, 14, 27], "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [10], "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), [13], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
