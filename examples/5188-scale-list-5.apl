# مثال 5188 — ضرب كل عنصر في 5
# Scale list by 5
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5188-scale-list-5.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 5]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [5, 10, 15], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -20, 50], "حالة 3")
