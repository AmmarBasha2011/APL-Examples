# مثال 10016 — عدد العناصر فوق المتوسط (مجموعة 24)
# above_mean (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10016-stat-above_mean-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([2, 6, 14, 4, 12, 14, 53]), 1, "حالة 1")
تأكد_يساوي(ف([39, -13, 42, 34]), 3, "حالة 2")
تأكد_يساوي(ف([-17, 39, 6, -3, 25, 1, 55]), 3, "حالة 3")
تأكد_يساوي(ف([11, 13, 25, 13, -18, 39, -5, -5]), 5, "حالة 4")
