# مثال 6768 — مولّد أرقام عشوائية خطي (13,5,31)
# LCG a=13 c=5 m=31
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6768-lcg-13-5-31.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (13 * س + 5) % 31
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [18, 22, 12, 6, 21], "حالة 1")
تأكد_يساوي(ف(0, 8), [5, 8, 16, 27, 15, 14, 1, 18], "حالة 2")
تأكد_يساوي(ف(7, 10), [3, 13, 19, 4, 26, 2, 0, 5, 8, 16], "حالة 3")
