# مثال 9902 — الوسيط (بعد الترتيب) (مجموعة 10)
# median (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9902-stat-median-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([16, 29, 52, 55, 38, -9, 12]), 29, "حالة 1")
تأكد_يساوي(ف([30, 38, -14, 26, 41]), 30, "حالة 2")
تأكد_يساوي(ف([-2, 60, 3, 14, 31, -20, -5, 26, 48]), 14, "حالة 3")
تأكد_يساوي(ف([9, 6, -16, 16, -20]), 6, "حالة 4")
