# مثال 6654 — الأعداد التي باقيها 2 عند القسمة على 9
# Numbers with remainder 2 mod 9
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6654-residue-9-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 9 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2], "حالة 2")
تأكد_يساوي(ف(40), [2, 11, 20, 29, 38], "حالة 3")
تأكد_يساوي(ف(75), [2, 11, 20, 29, 38, 47, 56, 65, 74], "حالة 4")
