# مثال 9052 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 3)
# dedupe (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9052-str-dedupe-set3.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("data"), "dat", "حالة 1")
تأكد_يساوي(ف("racecar"), "race", "حالة 2")
تأكد_يساوي(ف("python"), "python", "حالة 3")
تأكد_يساوي(ف("google"), "gole", "حالة 4")
تأكد_يساوي(ف("pluto"), "pluto", "حالة 5")
