# مثال 9870 — المتوسط الصحيح (مجموعة 3)
# mean (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9870-stat-mean-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([19, 35, 11]), 21, "حالة 1")
تأكد_يساوي(ف([37, 17, 12, 51, -8, 43, 3, 39, 46]), 26, "حالة 2")
تأكد_يساوي(ف([-12, 26, 1, 32]), 11, "حالة 3")
تأكد_يساوي(ف([38, 44, -17, 47, -6, 29, -3, 27]), 19, "حالة 4")
