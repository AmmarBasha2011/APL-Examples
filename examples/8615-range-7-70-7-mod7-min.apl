# مثال 8615 — أصغر قيمة من المدى 7 إلى 70 بخطوة 7 بعد (باقي على 7)
# min over range(7,70,7) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8615-range-7-70-7-mod7-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ % 7]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 0, "المدى كله")
