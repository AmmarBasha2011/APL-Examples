# مثال 9692 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 3)
# popcnt (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9692-num-popcnt-set3.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(634), 6, "حالة 1")
تأكد_يساوي(ف(1749), 7, "حالة 2")
تأكد_يساوي(ف(1184), 3, "حالة 3")
تأكد_يساوي(ف(2483), 7, "حالة 4")
تأكد_يساوي(ف(1948), 7, "حالة 5")
