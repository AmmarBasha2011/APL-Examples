# مثال 5321 — مقارنة العدد مع 18
# Compare number with 18
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5321-triple-compare-18.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 18:
    ارجع "اصغر"
  والا_لو ن > 18:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(17), "اصغر", "حالة 1")
تأكد_يساوي(ف(18), "يساوي", "حالة 2")
تأكد_يساوي(ف(19), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
