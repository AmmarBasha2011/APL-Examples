# مثال 8985 — حروف الكلمة مرتبة (مجموعة اختبار 16)
# sortchars (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8985-str-sortchars-set16.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("bob"), "bbo", "حالة 1")
تأكد_يساوي(ف("pluto"), "loptu", "حالة 2")
تأكد_يساوي(ف("python"), "hnopty", "حالة 3")
تأكد_يساوي(ف("loop"), "loop", "حالة 4")
تأكد_يساوي(ف("banana"), "aaabnn", "حالة 5")
