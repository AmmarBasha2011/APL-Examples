# مثال 9286 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 37)
# altcase (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9286-str-altcase-set37.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("noon"), "NoOn", "حالة 1")
تأكد_يساوي(ف("saturn"), "SaTuRn", "حالة 2")
تأكد_يساوي(ف("kayak"), "KaYaK", "حالة 3")
تأكد_يساوي(ف("planet"), "PlAnEt", "حالة 4")
تأكد_يساوي(ف("rocket"), "RoCkEt", "حالة 5")
