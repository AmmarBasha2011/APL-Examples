# مثال 8103 — العدد من المدى 0 إلى 20 بخطوة 1 بعد (ضعف)
# count over range(0,20,1) mapped by double
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8103-range-0-20-1-double-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 20:
    ر = ر + [خ * 2]
    خ = خ + (1)
  ارجع len(ر)

تأكد_يساوي(ف(), 20, "المدى كله")
