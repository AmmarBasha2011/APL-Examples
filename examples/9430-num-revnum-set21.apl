# مثال 9430 — عكس الأرقام (مجموعة اختبار 21)
# revnum (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9430-num-revnum-set21.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(9148), 8419, "حالة 1")
تأكد_يساوي(ف(71020), 2017, "حالة 2")
تأكد_يساوي(ف(89345), 54398, "حالة 3")
تأكد_يساوي(ف(88547), 74588, "حالة 4")
تأكد_يساوي(ف(13159), 95131, "حالة 5")
