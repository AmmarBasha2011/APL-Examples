# مثال 5215 — الحد ن في متتالية حسابية فرقها 8
# Nth term of arithmetic sequence, step 8
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5215-arith-seq-8.apl

# الحد = الأول + (ن-1) × الفرق

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ن):
  ارجع أ + (ن - 1) * 8

تأكد_يساوي(ف(1, 1), 1, "حالة 1")
تأكد_يساوي(ف(1, 10), 73, "حالة 2")
تأكد_يساوي(ف(5, 7), 53, "حالة 3")
تأكد_يساوي(ف(-3, 4), 21, "حالة 4")
