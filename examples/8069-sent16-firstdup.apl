# مثال 8069 — أول كلمة تتكرر في الجملة رقم 17
# firstdup for sentence 17
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8069-sent16-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("sun sand sea sun sand sun"), "sun", "حالة 1")
تأكد_يساوي(ف("yes no yes yes no maybe"), "yes", "حالة 2")
تأكد_يساوي(ف("one fish two fish red fish blue fish"), "fish", "حالة 3")
