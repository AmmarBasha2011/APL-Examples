# مثال 4672 — آخر موضع (مسافة) في نص
# String: last position of space
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4672-string-last-space.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  ل = -1
  لكل خ في س:
    لو خ == " ":
      ل = ر
    ر = ر + 1
  ارجع ل

تأكد_يساوي(ف("Hello World 42"), 11, "حالة 1")
تأكد_يساوي(ف("  spaced   out  text "), 20, "حالة 2")
تأكد_يساوي(ف("Data Science 101"), 12, "حالة 3")
تأكد_يساوي(ف("quick brown fox"), 11, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
