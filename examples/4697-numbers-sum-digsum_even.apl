# مثال 4697 — مجموع الأعداد المجموع أرقامه زوجي حتى حد معين
# Numbers up to a limit: sum of the even digit sum ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4697-numbers-sum-digsum_even.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو sum([int(د) for د in str(ر)]) % 2 == 0:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(24), 161, "حالة 1")
تأكد_يساوي(ف(63), 1007, "حالة 2")
تأكد_يساوي(ف(85), 1826, "حالة 3")
تأكد_يساوي(ف(1), 0, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
