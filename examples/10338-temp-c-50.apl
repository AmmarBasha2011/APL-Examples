# مثال 10338 — تحويل 50 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 50 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10338-temp-c-50.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 50) * 9 // 5 + 32

تأكد_يساوي(ف(0), 122, "حالة 1")
تأكد_يساوي(ف(10), 140, "حالة 2")
تأكد_يساوي(ف(37), 188, "حالة 3")
تأكد_يساوي(ف(-5), 113, "حالة 4")
