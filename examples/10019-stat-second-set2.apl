# مثال 10019 — ثاني أكبر قيمة مختلفة (مجموعة 2)
# second (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10019-stat-second-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([57, -9, 59, 45, -16, 60, 27, 36]), 59, "حالة 1")
تأكد_يساوي(ف([-7, 38, 56, 16, 28, 34, 36]), 38, "حالة 2")
تأكد_يساوي(ف([-14, -9, 32, -11]), -9, "حالة 3")
تأكد_يساوي(ف([16, 26, 35, 55, 52, 26, 53]), 53, "حالة 4")
