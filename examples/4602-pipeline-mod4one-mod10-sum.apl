# مثال 4602 — مجموع نتيجة باقي قسمتها على 10 للأعداد الباقي قسمتها على 4 يساوي 1
# Sum of last digit mod 10 over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4602-pipeline-mod4one-mod10-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ % 10]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 1, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 1, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 6, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 10, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
