# مثال 4954 — شيفرة قيصر بإزاحة 3
# Caesar cipher shift 3
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4954-caesar-3.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 3) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "def", "حالة 1")
تأكد_يساوي(ف("hello world"), "khoor zruog", "حالة 2")
تأكد_يساوي(ف("xyz"), "abc", "حالة 3")
تأكد_يساوي(ف("a b-c"), "d e-f", "حالة 4")
