# مثال 6353 — هل الناتج فارغ بعد أخذ حروف آخر الأبجدية وتحويلها إلى (رقم الحرف)
# empty of code applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6353-txt-late-code-empty.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: هل الناتج فارغ

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + str(ord(خ))+","
  ارجع len(ر) == 0

تأكد_يساوي(ف("hello world 42"), خطأ, "حالة 1")
تأكد_يساوي(ف("apl is fun"), خطأ, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), صواب, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), خطأ, "حالة 4")
تأكد_يساوي(ف(""), صواب, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), خطأ, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), خطأ, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), خطأ, "حالة 8")
