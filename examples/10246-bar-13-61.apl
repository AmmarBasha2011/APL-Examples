# مثال 10246 — شريط بعرض 13 من الرمز =
# Bar of width 13 using =
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10246-bar-13-61.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "="
  ارجع ر + "|" + str(13)

تأكد_يساوي(ف(0), "|13", "حالة 1")
تأكد_يساوي(ف(3), "===|13", "حالة 2")
تأكد_يساوي(ف(13), "=============|13", "حالة 3")
