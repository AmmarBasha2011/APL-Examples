# مثال 9805 — إزاحة لليسار 8 خانات
# Shift left by 8
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9805-bits-shl-8.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 8

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 256, "حالة 2")
تأكد_يساوي(ف(5), 1280, "حالة 3")
تأكد_يساوي(ف(100), 25600, "حالة 4")
