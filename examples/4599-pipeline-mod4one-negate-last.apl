# مثال 4599 — آخر نتيجة سالبها للأعداد الباقي قسمتها على 4 يساوي 1
# Last (or -1) of negated over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4599-pipeline-mod4one-negate-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([3, 1, 2, 8, 5]), -5, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -25, "حالة 2")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), -9, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), -13, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
