# مثال 4586 — مجموع نتيجة مربعها للأعداد الباقي قسمتها على 4 يساوي 1
# Sum of square over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4586-pipeline-mod4one-square-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ * خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 441, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 81, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 196, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 81, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
