# مثال 5093 — ملء النص من اليسار حتى عرض 2
# Left pad to width 2
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5093-pad-left-2.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 2:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "07", "حالة 1")
تأكد_يساوي(ف("123"), "123", "حالة 2")
تأكد_يساوي(ف("11"), "11", "حالة 3")
تأكد_يساوي(ف(""), "00", "حالة 4")
