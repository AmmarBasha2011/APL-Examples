# مثال 8875 — حساب بنكي برسم سحب 2 وفائدة 2%
# Bank account, withdraw fee 2, interest 2%
# Demonstrates: البرمجة الكائنية
#
# Run:  python apl.py examples/8875-class-account-fee2-rate2.apl

# إيداع وسحب برسم ثابت
# وفائدة بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف حساب:
    دالة_إنشاء(ذات, رصيد):
        ذات.رصيد = رصيد

    دالة ايداع(ذات, م):
        ذات.رصيد = ذات.رصيد + م
        ارجع ذات.رصيد

    دالة سحب(ذات, م):
        ذات.رصيد = ذات.رصيد - م - 2
        ارجع ذات.رصيد

    دالة فائدة(ذات):
        ذات.رصيد = ذات.رصيد + ذات.رصيد * 2 // 100
        ارجع ذات.رصيد

ح = حساب(1000)
تأكد_يساوي(ح.ايداع(200), 1200, "عملية 1")
تأكد_يساوي(ح.سحب(100), 1098, "عملية 2")
تأكد_يساوي(ح.ايداع(50), 1148, "عملية 3")
تأكد_يساوي(ح.سحب(500), 646, "عملية 4")
تأكد_يساوي(ح.فائدة(), 658, "عملية 5")
