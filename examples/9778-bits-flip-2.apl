# مثال 9778 — قلب الخانة رقم 2
# Flip bit 2
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9778-bits-flip-2.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 2)

تأكد_يساوي(ف(0), 4, "حالة 1")
تأكد_يساوي(ف(255), 251, "حالة 2")
تأكد_يساوي(ف(1000), 1004, "حالة 3")
تأكد_يساوي(ف(12345), 12349, "حالة 4")
