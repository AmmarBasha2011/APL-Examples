# مثال 6321 — طول الناتج بعد أخذ حروف العلة وتحويلها إلى (رقم الحرف)
# len of code applied to vowel chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6321-txt-vowel-code-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف العلة فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "aeiou":
      ر = ر + str(ord(خ))+","
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 12, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 11, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 3, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 20, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 0, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 18, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 25, "حالة 8")
