# مثال 9396 — مجموع الأرقام (مجموعة اختبار 27)
# digsum (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9396-num-digsum-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(49319), 26, "حالة 1")
تأكد_يساوي(ف(50390), 17, "حالة 2")
تأكد_يساوي(ف(13415), 14, "حالة 3")
تأكد_يساوي(ف(38111), 14, "حالة 4")
تأكد_يساوي(ف(88755), 33, "حالة 5")
