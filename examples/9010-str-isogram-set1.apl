# مثال 9010 — هل لا يتكرر أي حرف (مجموعة اختبار 1)
# isogram (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9010-str-isogram-set1.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("google"), خطأ, "حالة 1")
تأكد_يساوي(ف("data"), خطأ, "حالة 2")
تأكد_يساوي(ف("moon"), خطأ, "حالة 3")
تأكد_يساوي(ف("banana"), خطأ, "حالة 4")
تأكد_يساوي(ف("radar"), خطأ, "حالة 5")
