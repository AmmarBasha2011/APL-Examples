# مثال 10041 — ثاني أكبر قيمة مختلفة (مجموعة 24)
# second (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10041-stat-second-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([-6, 3, 45, 15, 59]), 45, "حالة 1")
تأكد_يساوي(ف([22, 34, 49, 49, 45, 60]), 49, "حالة 2")
تأكد_يساوي(ف([59, 32, 12, 11, 6]), 32, "حالة 3")
تأكد_يساوي(ف([-17, 27, 27, 5, 30, -3, 42]), 30, "حالة 4")
