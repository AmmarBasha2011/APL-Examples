# مثال 9661 — هل العدد أرمسترونغ (مجموعة اختبار 12)
# arm (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9661-num-arm-set12.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(137), خطأ, "حالة 1")
تأكد_يساوي(ف(144), خطأ, "حالة 2")
تأكد_يساوي(ف(639), خطأ, "حالة 3")
تأكد_يساوي(ف(337), خطأ, "حالة 4")
تأكد_يساوي(ف(792), خطأ, "حالة 5")
