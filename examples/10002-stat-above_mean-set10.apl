# مثال 10002 — عدد العناصر فوق المتوسط (مجموعة 10)
# above_mean (data set 10)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10002-stat-above_mean-set10.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([14, 3, -10, 36, -20, -17, 28, 29, -17]), 4, "حالة 1")
تأكد_يساوي(ف([40, -5, 42, -16, 56, 33]), 4, "حالة 2")
تأكد_يساوي(ف([-12, 0, -16, -16]), 1, "حالة 3")
تأكد_يساوي(ف([-4, 49, 56]), 2, "حالة 4")
