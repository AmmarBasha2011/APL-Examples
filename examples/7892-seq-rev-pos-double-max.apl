# مثال 7892 — أكبر قيمة: من عكسية نأخذ الموجب ثم (ضعف)
# max over rev sequence, keep pos, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7892-seq-rev-pos-double-max.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ > 0:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 40, "حالة 2")
تأكد_يساوي(ف(5), 40, "حالة 3")
تأكد_يساوي(ف(10), 40, "حالة 4")
تأكد_يساوي(ف(15), 40, "حالة 5")
