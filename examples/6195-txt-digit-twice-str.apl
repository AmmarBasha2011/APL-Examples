# مثال 6195 — النص الناتج بعد أخذ الأرقام فقط وتحويلها إلى (حرف مكرر)
# str of twice applied to digit chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6195-txt-digit-twice-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ الأرقام فقط فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "0" و خ <= "9":
      ر = ر + خ + خ
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "4422", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "112233", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "22002266", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "", "حالة 8")
