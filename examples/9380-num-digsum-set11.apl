# مثال 9380 — مجموع الأرقام (مجموعة اختبار 11)
# digsum (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9380-num-digsum-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(75460), 22, "حالة 1")
تأكد_يساوي(ف(56209), 22, "حالة 2")
تأكد_يساوي(ف(69218), 26, "حالة 3")
تأكد_يساوي(ف(7956), 27, "حالة 4")
تأكد_يساوي(ف(56774), 29, "حالة 5")
