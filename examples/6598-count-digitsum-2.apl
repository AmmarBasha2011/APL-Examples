# مثال 6598 — عدد الأعداد التي مجموع أرقامها 2
# Count numbers below n with digit sum 2
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6598-count-digitsum-2.apl

# نجمع أرقام كل عدد ونقارن

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(ن):
    م = 0
    ت = ي
    طالما ت > 0:
      م = م + ت % 10
      ت = ت // 10
    لو م == 2:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(10), 1, "حالة 1")
تأكد_يساوي(ف(100), 3, "حالة 2")
تأكد_يساوي(ف(300), 6, "حالة 3")
تأكد_يساوي(ف(500), 6, "حالة 4")
