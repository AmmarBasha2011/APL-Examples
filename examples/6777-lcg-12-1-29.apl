# مثال 6777 — مولّد أرقام عشوائية خطي (12,1,29)
# LCG a=12 c=1 m=29
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6777-lcg-12-1-29.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (12 * س + 1) % 29
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [13, 12, 0, 1, 13], "حالة 1")
تأكد_يساوي(ف(0, 8), [1, 13, 12, 0, 1, 13, 12, 0], "حالة 2")
تأكد_يساوي(ف(7, 10), [27, 6, 15, 7, 27, 6, 15, 7, 27, 6], "حالة 3")
