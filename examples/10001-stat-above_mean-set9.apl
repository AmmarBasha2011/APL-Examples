# مثال 10001 — عدد العناصر فوق المتوسط (مجموعة 9)
# above_mean (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10001-stat-above_mean-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([-11, -1, 48, 35, 5, -3, 9, 55]), 3, "حالة 1")
تأكد_يساوي(ف([28, 25, 7]), 2, "حالة 2")
تأكد_يساوي(ف([16, 4, 3, 49, 4, 7, -5]), 2, "حالة 3")
تأكد_يساوي(ف([0, 6, 52]), 1, "حالة 4")
