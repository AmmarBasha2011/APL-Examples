# مثال 7579 — أكبر قيمة: من مربع ناقص ي نأخذ الزوجي ثم (ضعف)
# max over sq_minus sequence, keep even, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7579-seq-sq_minus-even-double-max.apl

# نولّد أول ن حد من: مربع ناقص ي
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي - ي
    لو خ % 2 == 0:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 24, "حالة 3")
تأكد_يساوي(ف(10), 144, "حالة 4")
تأكد_يساوي(ف(15), 364, "حالة 5")
