# مثال 9698 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 9)
# popcnt (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9698-num-popcnt-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(3178), 6, "حالة 1")
تأكد_يساوي(ف(4916), 6, "حالة 2")
تأكد_يساوي(ف(2029), 9, "حالة 3")
تأكد_يساوي(ف(3370), 6, "حالة 4")
تأكد_يساوي(ف(3949), 9, "حالة 5")
