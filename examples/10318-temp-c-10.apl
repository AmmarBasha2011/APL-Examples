# مثال 10318 — تحويل 10 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 10 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10318-temp-c-10.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 10) * 9 // 5 + 32

تأكد_يساوي(ف(0), 50, "حالة 1")
تأكد_يساوي(ف(10), 68, "حالة 2")
تأكد_يساوي(ف(37), 116, "حالة 3")
تأكد_يساوي(ف(-5), 41, "حالة 4")
