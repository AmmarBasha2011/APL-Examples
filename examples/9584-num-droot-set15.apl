# مثال 9584 — الجذر الرقمي (مجموعة اختبار 15)
# droot (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9584-num-droot-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(46037), 2, "حالة 1")
تأكد_يساوي(ف(62307), 9, "حالة 2")
تأكد_يساوي(ف(77814), 9, "حالة 3")
تأكد_يساوي(ف(20111), 5, "حالة 4")
تأكد_يساوي(ف(76300), 7, "حالة 5")
