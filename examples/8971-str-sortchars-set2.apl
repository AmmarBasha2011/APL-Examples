# مثال 8971 — حروف الكلمة مرتبة (مجموعة اختبار 2)
# sortchars (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8971-str-sortchars-set2.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("refer"), "eefrr", "حالة 1")
تأكد_يساوي(ف("comet"), "cemot", "حالة 2")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 3")
تأكد_يساوي(ف("star"), "arst", "حالة 4")
تأكد_يساوي(ف("tenet"), "eentt", "حالة 5")
