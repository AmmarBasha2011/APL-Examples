# مثال 8079 — أول كلمة تتكرر في الجملة رقم 18
# firstdup for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8079-sent17-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("bread milk bread eggs milk bread"), "bread", "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), "the", "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), "a", "حالة 3")
