# مثال 4793 — شكل المصفوفة
# shape (rows, cols)
# Demonstrates: مصفوفات وقوائم متداخلة
#
# Run:  python apl.py examples/4793-matrix-shape.apl

# المصفوفة قائمة من القوائم
# كل قائمة صغيرة هي صف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ارجع [len(م), len(م[0])]

تأكد_يساوي(ف([[1, 2], [3, 4]]), [2, 2], "حالة 1")
تأكد_يساوي(ف([[5, 0, 2], [1, 9, 3], [4, 4, 4]]), [3, 3], "حالة 2")
تأكد_يساوي(ف([[2, -1, 7], [0, 3, -5]]), [2, 3], "حالة 3")
تأكد_يساوي(ف([[1], [2], [3]]), [3, 1], "حالة 4")
تأكد_يساوي(ف([[6, 5, 4, 3], [2, 1, 0, -1]]), [2, 4], "حالة 5")
