# مثال 9051 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 2)
# dedupe (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9051-str-dedupe-set2.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("racecar"), "race", "حالة 1")
تأكد_يساوي(ف("silent"), "silent", "حالة 2")
تأكد_يساوي(ف("array"), "ary", "حالة 3")
تأكد_يساوي(ف("tenet"), "ten", "حالة 4")
تأكد_يساوي(ف("data"), "dat", "حالة 5")
