# مثال 9029 — هل لا يتكرر أي حرف (مجموعة اختبار 20)
# isogram (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9029-str-isogram-set20.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("python"), صواب, "حالة 1")
تأكد_يساوي(ف("apple"), خطأ, "حالة 2")
تأكد_يساوي(ف("listen"), صواب, "حالة 3")
تأكد_يساوي(ف("earth"), صواب, "حالة 4")
تأكد_يساوي(ف("banana"), خطأ, "حالة 5")
