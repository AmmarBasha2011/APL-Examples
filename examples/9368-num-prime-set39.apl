# مثال 9368 — هل العدد أولي (مجموعة اختبار 39)
# prime (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9368-num-prime-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 2:
    ارجع خطأ
  لكل ي في range(2, ن):
    لو ي * ي > ن:
      ارجع صواب
    لو ن % ي == 0:
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف(30), خطأ, "حالة 1")
تأكد_يساوي(ف(46), خطأ, "حالة 2")
تأكد_يساوي(ف(193), صواب, "حالة 3")
تأكد_يساوي(ف(128), خطأ, "حالة 4")
تأكد_يساوي(ف(78), خطأ, "حالة 5")
