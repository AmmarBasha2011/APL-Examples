# مثال 9699 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 10)
# popcnt (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9699-num-popcnt-set10.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(428), 5, "حالة 1")
تأكد_يساوي(ف(2192), 3, "حالة 2")
تأكد_يساوي(ف(714), 5, "حالة 3")
تأكد_يساوي(ف(3336), 4, "حالة 4")
تأكد_يساوي(ف(2183), 5, "حالة 5")
