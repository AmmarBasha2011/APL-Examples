# مثال 4505 — ترتيب نتيجة نصفها بالقسمة الصحيحة للأعداد الموجبة
# Sorted list of integer half over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4505-pipeline-positive-half-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ // 2]
  ارجع sorted(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [3, 7, 10, 14, 17, 21], "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [3, 4, 6, 7], "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [0, 0, 1, 1, 2, 4, 6], "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [2, 3, 4, 6, 8, 15], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
