# مثال 10333 — تحويل 40 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 40 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10333-temp-c-40.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 40) * 9 // 5 + 32

تأكد_يساوي(ف(0), 104, "حالة 1")
تأكد_يساوي(ف(10), 122, "حالة 2")
تأكد_يساوي(ف(37), 170, "حالة 3")
تأكد_يساوي(ف(-5), 95, "حالة 4")
