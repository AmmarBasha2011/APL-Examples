# مثال 9585 — الجذر الرقمي (مجموعة اختبار 16)
# droot (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9585-num-droot-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(5978), 2, "حالة 1")
تأكد_يساوي(ف(26666), 8, "حالة 2")
تأكد_يساوي(ف(96272), 8, "حالة 3")
تأكد_يساوي(ف(92946), 3, "حالة 4")
تأكد_يساوي(ف(3979), 1, "حالة 5")
