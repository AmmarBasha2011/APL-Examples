# مثال 9312 — الحرف الأكثر تكراراً (الأول عند التساوي) (مجموعة اختبار 23)
# mostfreq (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9312-str-mostfreq-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ح في ن:
    د[ح] = د.get(ح, 0) + 1
  ب = ن[0]
  لكل ح في ن:
    لو د[ح] > د[ب]:
      ب = ح
  ارجع ب

تأكد_يساوي(ف("banana"), "a", "حالة 1")
تأكد_يساوي(ف("rotor"), "r", "حالة 2")
تأكد_يساوي(ف("mars"), "m", "حالة 3")
تأكد_يساوي(ف("river"), "r", "حالة 4")
تأكد_يساوي(ف("star"), "s", "حالة 5")
