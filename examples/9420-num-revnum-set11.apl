# مثال 9420 — عكس الأرقام (مجموعة اختبار 11)
# revnum (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9420-num-revnum-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(75460), 6457, "حالة 1")
تأكد_يساوي(ف(56209), 90265, "حالة 2")
تأكد_يساوي(ف(69218), 81296, "حالة 3")
تأكد_يساوي(ف(7956), 6597, "حالة 4")
تأكد_يساوي(ف(56774), 47765, "حالة 5")
