# مثال 8928 — هل الكلمة متناظرة (مجموعة اختبار 39)
# palin (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8928-str-palin-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("comet"), خطأ, "حالة 1")
تأكد_يساوي(ف("deed"), صواب, "حالة 2")
تأكد_يساوي(ف("loop"), خطأ, "حالة 3")
تأكد_يساوي(ف("array"), خطأ, "حالة 4")
تأكد_يساوي(ف("refer"), صواب, "حالة 5")
