# مثال 6159 — أول 3 حروف من الناتج بعد أخذ الحروف فقط وتحويلها إلى (حرف كبير)
# head of upper applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6159-txt-alpha-upper-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + خ.upper()
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "HEL", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "APL", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "ABC", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "THE", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "ZZZ", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "DAT", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "PRO", "حالة 8")
