# مثال 6345 — النص الناتج بعد أخذ حروف أول الأبجدية وتحويلها إلى (رقم الحرف)
# str of code applied to early chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6345-txt-early-code-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف أول الأبجدية فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "m":
      ر = ر + str(ord(خ))+","
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "104,101,108,108,108,100,", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "97,108,105,102,", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "97,98,99,", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "104,101,105,99,107,98,102,", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "100,97,97,99,105,101,99,101,", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "103,97,109,109,105,103,105,97,97,98,105,99,", "حالة 8")
