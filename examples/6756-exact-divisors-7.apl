# مثال 6756 — الأعداد التي لها 7 قواسم بالضبط
# Numbers up to n with exactly 7 divisors
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6756-exact-divisors-7.apl

# نعد القواسم لكل عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    ع = 0
    لكل د في range(1, ي + 1):
      لو ي % د == 0:
        ع = ع + 1
    لو ع == 7:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(10), [], "حالة 1")
تأكد_يساوي(ف(30), [], "حالة 2")
تأكد_يساوي(ف(60), [], "حالة 3")
