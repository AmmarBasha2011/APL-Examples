# مثال 10020 — ثاني أكبر قيمة مختلفة (مجموعة 3)
# second (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10020-stat-second-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([39, 44, -6, 57, 54, 11, 35, 40]), 54, "حالة 1")
تأكد_يساوي(ف([22, 36, 50, 26, 1]), 36, "حالة 2")
تأكد_يساوي(ف([-5, -15, 49, 41, -7, 23, -13]), 41, "حالة 3")
تأكد_يساوي(ف([57, 2, 4]), 4, "حالة 4")
