# مثال 6867 — عدد المتناظرات في الأساس 8 حتى ن
# Count base-8 palindromes up to n
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6867-count-pal-base-8.apl

# نفحص كل عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(ن + 1):
    د = []
    ت = ي
    لو ت == 0:
      د = [0]
    طالما ت > 0:
      د = [ت % 8] + د
      ت = ت // 8
    لو د == د[::-1]:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(10), 9, "حالة 2")
تأكد_يساوي(ف(100), 20, "حالة 3")
تأكد_يساوي(ف(300), 45, "حالة 4")
