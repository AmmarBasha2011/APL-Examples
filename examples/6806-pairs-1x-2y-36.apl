# مثال 6806 — عدد حلول 1س + 2ص = 36
# Count solutions of 1x+2y=36
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6806-pairs-1x-2y-36.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 1 * س + 2 * ص == 36:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 0, "حالة 3")
تأكد_يساوي(ف(36), 19, "حالة 4")
