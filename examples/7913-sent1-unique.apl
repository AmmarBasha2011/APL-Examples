# مثال 7913 — عدد الكلمات المختلفة في الجملة رقم 2
# unique for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7913-sent1-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("to be or not to be"), 4, "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), 3, "حالة 2")
تأكد_يساوي(ف("a b c a b a"), 3, "حالة 3")
