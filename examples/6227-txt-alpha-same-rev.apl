# مثال 6227 — الناتج معكوس بعد أخذ الحروف فقط وتحويلها إلى (كما هو)
# rev of same applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6227-txt-alpha-same-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + خ
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "dlrowolleh", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "nufsilpa", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "cba", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "xofnworbkciuqeht", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "xxxyyyzzz", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "ecneicsatad", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "cibaranignimmargorp", "حالة 8")
