# مثال 4604 — أكبر نتيجة ناقص 3 للأعداد الباقي قسمتها على 4 يساوي 1
# Largest (or 0) of minus 3 over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4604-pipeline-mod4one-minus3-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 10, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -2, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 6, "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 22, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
