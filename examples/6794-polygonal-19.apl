# مثال 6794 — العدد المضلّع ذو 19 أضلاع
# 19-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6794-polygonal-19.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((19 - 2) * ن * ن - (19 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 19, "حالة 2")
تأكد_يساوي(ف(5), 175, "حالة 3")
تأكد_يساوي(ف(10), 775, "حالة 4")
