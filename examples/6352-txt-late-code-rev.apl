# مثال 6352 — الناتج معكوس بعد أخذ حروف آخر الأبجدية وتحويلها إلى (رقم الحرف)
# rev of code applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6352-txt-late-code-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + str(ord(خ))+","
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), ",411,111,911,111", "حالة 1")
تأكد_يساوي(ف("apl is fun"), ",011,711,511,211", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), ",021,111,011,911,111,411,711,311,611", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), ",021,021,021,121,121,121,221,221,221", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), ",011,511,611", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), ",411,011,011,411,111,411,211", "حالة 8")
