# مثال 9609 — الجذر الرقمي (مجموعة اختبار 40)
# droot (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9609-num-droot-set40.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(2488), 4, "حالة 1")
تأكد_يساوي(ف(57574), 1, "حالة 2")
تأكد_يساوي(ف(18598), 4, "حالة 3")
تأكد_يساوي(ف(43315), 7, "حالة 4")
تأكد_يساوي(ف(54001), 1, "حالة 5")
