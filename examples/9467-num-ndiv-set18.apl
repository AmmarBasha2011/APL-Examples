# مثال 9467 — عدد القواسم (مجموعة اختبار 18)
# ndiv (test set 18)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9467-num-ndiv-set18.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(123), 4, "حالة 1")
تأكد_يساوي(ف(92), 6, "حالة 2")
تأكد_يساوي(ف(70), 8, "حالة 3")
تأكد_يساوي(ف(98), 6, "حالة 4")
تأكد_يساوي(ف(189), 8, "حالة 5")
