# مثال 6147 — الناتج معكوس بعد أخذ حروف العلة وتحويلها إلى (حرف كبير)
# rev of upper applied to vowel chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6147-txt-vowel-upper-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف العلة فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "aeiou":
      ر = ر + خ.upper()
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "OOE", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "UIA", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "A", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "OOIUE", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "EEIAA", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "IAAIIAO", "حالة 8")
