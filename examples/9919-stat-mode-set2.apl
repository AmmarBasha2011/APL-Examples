# مثال 9919 — المنوال (الأصغر عند التساوي) (مجموعة 2)
# mode (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9919-stat-mode-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([22, -4, 23, -1, 16, 35, 12]), -4, "حالة 1")
تأكد_يساوي(ف([-13, 47, 15, 26, 54, -8, 26]), 26, "حالة 2")
تأكد_يساوي(ف([45, -19, -8]), -19, "حالة 3")
تأكد_يساوي(ف([43, 27, -17, 23, 43, -14, -18, 10]), 43, "حالة 4")
