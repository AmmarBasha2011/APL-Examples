# مثال 9803 — قلب الخانة رقم 7
# Flip bit 7
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9803-bits-flip-7.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 7)

تأكد_يساوي(ف(0), 128, "حالة 1")
تأكد_يساوي(ف(255), 127, "حالة 2")
تأكد_يساوي(ف(1000), 872, "حالة 3")
تأكد_يساوي(ف(12345), 12473, "حالة 4")
