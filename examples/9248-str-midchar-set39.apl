# مثال 9248 — الحرف الأوسط (مجموعة اختبار 39)
# midchar (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9248-str-midchar-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("river"), "v", "حالة 1")
تأكد_يساوي(ف("bob"), "o", "حالة 2")
تأكد_يساوي(ف("enlist"), "i", "حالة 3")
تأكد_يساوي(ف("silent"), "e", "حالة 4")
تأكد_يساوي(ف("stats"), "a", "حالة 5")
