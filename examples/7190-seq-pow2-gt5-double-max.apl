# مثال 7190 — أكبر قيمة: من قوى 2 نأخذ الأكبر من 5 ثم (ضعف)
# max over pow2 sequence, keep gt5, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7190-seq-pow2-gt5-double-max.apl

# نولّد أول ن حد من: قوى 2
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 ** ي
    لو خ > 5:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 32, "حالة 3")
تأكد_يساوي(ف(10), 1024, "حالة 4")
تأكد_يساوي(ف(15), 32768, "حالة 5")
