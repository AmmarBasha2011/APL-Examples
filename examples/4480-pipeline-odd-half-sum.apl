# مثال 4480 — مجموع نتيجة نصفها بالقسمة الصحيحة للأعداد الفردية
# Sum of integer half over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4480-pipeline-odd-half-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ // 2]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 14, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 3, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 9, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 9, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
