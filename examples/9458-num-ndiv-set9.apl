# مثال 9458 — عدد القواسم (مجموعة اختبار 9)
# ndiv (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9458-num-ndiv-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(67), 2, "حالة 1")
تأكد_يساوي(ف(44), 6, "حالة 2")
تأكد_يساوي(ف(198), 12, "حالة 3")
تأكد_يساوي(ف(142), 4, "حالة 4")
تأكد_يساوي(ف(194), 4, "حالة 5")
