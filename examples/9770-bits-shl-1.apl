# مثال 9770 — إزاحة لليسار 1 خانات
# Shift left by 1
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9770-bits-shl-1.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 1

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 10, "حالة 3")
تأكد_يساوي(ف(100), 200, "حالة 4")
