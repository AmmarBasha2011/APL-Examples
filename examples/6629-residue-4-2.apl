# مثال 6629 — الأعداد التي باقيها 2 عند القسمة على 4
# Numbers with remainder 2 mod 4
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6629-residue-4-2.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 4 == 2:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [2, 6], "حالة 2")
تأكد_يساوي(ف(40), [2, 6, 10, 14, 18, 22, 26, 30, 34, 38], "حالة 3")
تأكد_يساوي(ف(75), [2, 6, 10, 14, 18, 22, 26, 30, 34, 38, 42, 46, 50, 54, 58, 62, 66, 70, 74], "حالة 4")
