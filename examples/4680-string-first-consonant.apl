# مثال 4680 — أول موضع (حرف ساكن) في نص
# String: first position of consonant
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4680-string-first-consonant.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  لكل خ في س:
    لو ord(خ.lower()) >= 97 و ord(خ.lower()) <= 122 و "aeiou".find(خ.lower()) == -1:
      ارجع ر
    ر = ر + 1
  ارجع -1

تأكد_يساوي(ف("quick brown fox"), 0, "حالة 1")
تأكد_يساوي(ف("ZZtop and the Beatles"), 0, "حالة 2")
تأكد_يساوي(ف("Data Science 101"), 0, "حالة 3")
تأكد_يساوي(ف("apple PIE 7 and 9"), 1, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
