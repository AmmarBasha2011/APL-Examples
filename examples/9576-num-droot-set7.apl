# مثال 9576 — الجذر الرقمي (مجموعة اختبار 7)
# droot (test set 7)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9576-num-droot-set7.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(65032), 7, "حالة 1")
تأكد_يساوي(ف(60282), 9, "حالة 2")
تأكد_يساوي(ف(11625), 6, "حالة 3")
تأكد_يساوي(ف(16791), 6, "حالة 4")
تأكد_يساوي(ف(49600), 1, "حالة 5")
