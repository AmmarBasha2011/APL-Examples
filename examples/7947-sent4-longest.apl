# مثال 7947 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 5
# longest for sentence 5
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7947-sent4-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("a rose is a rose is a rose"), "rose", "حالة 1")
تأكد_يساوي(ف("run run run fast fast slow"), "fast", "حالة 2")
تأكد_يساوي(ف("up down up down up up down"), "down", "حالة 3")
