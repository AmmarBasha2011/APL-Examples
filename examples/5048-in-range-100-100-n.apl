# مثال 5048 — هل القيمة داخل المدى [-100, 100]؟
# Is value in range [-100,100]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5048-in-range-100-100-n.apl

# نقارن بالطرفين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >= -100 و ن <= 100

تأكد_يساوي(ف(-100), صواب, "حالة 1")
تأكد_يساوي(ف(100), صواب, "حالة 2")
تأكد_يساوي(ف(-101), خطأ, "حالة 3")
تأكد_يساوي(ف(101), خطأ, "حالة 4")
تأكد_يساوي(ف(0), صواب, "حالة 5")
