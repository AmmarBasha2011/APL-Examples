# مثال 9175 — عكس حالة الأحرف (مجموعة اختبار 6)
# swapcase (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9175-str-swapcase-set6.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("noon"), "NOON", "حالة 1")
تأكد_يساوي(ف("silent"), "SILENT", "حالة 2")
تأكد_يساوي(ف("data"), "DATA", "حالة 3")
تأكد_يساوي(ف("galaxy"), "GALAXY", "حالة 4")
تأكد_يساوي(ف("refer"), "REFER", "حالة 5")
