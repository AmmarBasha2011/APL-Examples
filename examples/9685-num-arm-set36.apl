# مثال 9685 — هل العدد أرمسترونغ (مجموعة اختبار 36)
# arm (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9685-num-arm-set36.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(73), خطأ, "حالة 1")
تأكد_يساوي(ف(621), خطأ, "حالة 2")
تأكد_يساوي(ف(544), خطأ, "حالة 3")
تأكد_يساوي(ف(450), خطأ, "حالة 4")
تأكد_يساوي(ف(68), خطأ, "حالة 5")
