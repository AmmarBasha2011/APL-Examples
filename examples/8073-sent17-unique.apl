# مثال 8073 — عدد الكلمات المختلفة في الجملة رقم 18
# unique for sentence 18
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8073-sent17-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("bread milk bread eggs milk bread"), 3, "حالة 1")
تأكد_يساوي(ف("the cat and the dog and the bird"), 5, "حالة 2")
تأكد_يساوي(ف("a rose is a rose is a rose"), 3, "حالة 3")
