# مثال 5232 — مجموع تراكمي مع زيادة 9
# Running total plus 9 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5232-cumulative-9.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 9
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [10, 21, 33], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [14, 28, 42, 56], "حالة 3")
