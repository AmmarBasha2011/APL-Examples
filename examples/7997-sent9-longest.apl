# مثال 7997 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 10
# longest for sentence 10
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7997-sent9-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("in the end the end is the start"), "start", "حالة 1")
تأكد_يساوي(ف("cairo is big and cairo is old"), "cairo", "حالة 2")
تأكد_يساوي(ف("sun sand sea sun sand sun"), "sand", "حالة 3")
