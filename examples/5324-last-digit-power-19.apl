# مثال 5324 — آخر رقم للعدد 19 أس ن
# Last digit of 19^n
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5324-last-digit-power-19.apl

# نستخدم الباقي على 10 في كل ضرب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 1
  لكل ي في range(ن):
    ر = ر * 19 % 10
  ارجع ر

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 9, "حالة 2")
تأكد_يساوي(ف(5), 9, "حالة 3")
تأكد_يساوي(ف(13), 9, "حالة 4")
تأكد_يساوي(ف(100), 1, "حالة 5")
