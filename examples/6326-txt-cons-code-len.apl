# مثال 6326 — طول الناتج بعد أخذ الحروف الساكنة وتحويلها إلى (رقم الحرف)
# len of code applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6326-txt-cons-code-len.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: رقم الحرف
# ثم نحسب: طول الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + str(ord(خ))+","
  ارجع len(ر)

تأكد_يساوي(ف("hello world 42"), 28, "حالة 1")
تأكد_يساوي(ف("apl is fun"), 20, "حالة 2")
تأكد_يساوي(ف("a1b2c3"), 6, "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), 42, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), 36, "حالة 6")
تأكد_يساوي(ف("data 2026 science"), 22, "حالة 7")
تأكد_يساوي(ف("programming in arabic"), 46, "حالة 8")
