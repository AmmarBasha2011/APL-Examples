# مثال 9178 — عكس حالة الأحرف (مجموعة اختبار 9)
# swapcase (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9178-str-swapcase-set9.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("comet"), "COMET", "حالة 1")
تأكد_يساوي(ف("civic"), "CIVIC", "حالة 2")
تأكد_يساوي(ف("moon"), "MOON", "حالة 3")
تأكد_يساوي(ف("earth"), "EARTH", "حالة 4")
تأكد_يساوي(ف("apple"), "APPLE", "حالة 5")
