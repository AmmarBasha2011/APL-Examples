# مثال 9871 — المتوسط الصحيح (مجموعة 4)
# mean (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9871-stat-mean-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([34, 27, -14, 53]), 25, "حالة 1")
تأكد_يساوي(ف([51, -15, -18]), 6, "حالة 2")
تأكد_يساوي(ف([14, 27, -17, -11, 36, 40, -6, 20]), 12, "حالة 3")
تأكد_يساوي(ف([19, 3, 12, 32]), 16, "حالة 4")
