# مثال 7983 — عدد الكلمات المختلفة في الجملة رقم 9
# unique for sentence 9
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7983-sent8-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("a b c a b a"), 3, "حالة 1")
تأكد_يساوي(ف("up down up down up up down"), 2, "حالة 2")
تأكد_يساوي(ف("stars and moon and stars again"), 4, "حالة 3")
