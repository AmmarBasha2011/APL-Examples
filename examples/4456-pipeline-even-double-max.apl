# مثال 4456 — أكبر نتيجة ضعفها للأعداد الزوجية
# Largest (or 0) of double over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4456-pipeline-even-double-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * 2]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 60, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 84, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 40, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 16, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
