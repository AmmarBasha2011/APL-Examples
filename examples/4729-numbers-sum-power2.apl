# مثال 4729 — مجموع الأعداد القوة للعدد 2 حتى حد معين
# Numbers up to a limit: sum of the power of two ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4729-numbers-sum-power2.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر > 0 و (ر & (ر - 1)) == 0:
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(14), 15, "حالة 1")
تأكد_يساوي(ف(60), 63, "حالة 2")
تأكد_يساوي(ف(129), 255, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
