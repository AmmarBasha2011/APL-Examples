# مثال 8123 — أصغر قيمة من المدى 0 إلى 20 بخطوة 1 بعد (سالب)
# min over range(0,20,1) mapped by neg
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8123-range-0-20-1-neg-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 0
  طالما خ < 20:
    ر = ر + [0 - خ]
    خ = خ + (1)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), -19, "المدى كله")
