# مثال 8898 — هل الكلمة متناظرة (مجموعة اختبار 9)
# palin (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8898-str-palin-set9.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("rocket"), خطأ, "حالة 1")
تأكد_يساوي(ف("array"), خطأ, "حالة 2")
تأكد_يساوي(ف("saturn"), خطأ, "حالة 3")
تأكد_يساوي(ف("rotor"), صواب, "حالة 4")
تأكد_يساوي(ف("google"), خطأ, "حالة 5")
