# مثال 7952 — تكرار كل كلمة في الجملة رقم 6
# freq for sentence 6
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7952-sent5-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("we love data and data loves us"), {"we": 1, "love": 1, "data": 2, "and": 1, "loves": 1, "us": 1}, "حالة 1")
تأكد_يساوي(ف("a b c a b a"), {"a": 3, "b": 2, "c": 1}, "حالة 2")
تأكد_يساوي(ف("cairo is big and cairo is old"), {"cairo": 2, "is": 2, "big": 1, "and": 1, "old": 1}, "حالة 3")
