# مثال 4867 — مجموع الأعداد من 1 إلى ضعف 7 وزيادة
# Sum 1..n for scaled n (k=7)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4867-triangle-number-7.apl

# مجموع الأعداد المتتالية = ن(ن+1)/2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ن = ن * 7
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 28, "حالة 1")
تأكد_يساوي(ف(2), 105, "حالة 2")
تأكد_يساوي(ف(3), 231, "حالة 3")
تأكد_يساوي(ف(10), 2485, "حالة 4")
