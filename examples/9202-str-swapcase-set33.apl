# مثال 9202 — عكس حالة الأحرف (مجموعة اختبار 33)
# swapcase (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9202-str-swapcase-set33.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("listen"), "LISTEN", "حالة 1")
تأكد_يساوي(ف("civic"), "CIVIC", "حالة 2")
تأكد_يساوي(ف("tenet"), "TENET", "حالة 3")
تأكد_يساوي(ف("kayak"), "KAYAK", "حالة 4")
تأكد_يساوي(ف("radar"), "RADAR", "حالة 5")
