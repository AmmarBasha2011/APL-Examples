# مثال 9721 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 32)
# popcnt (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9721-num-popcnt-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(4232), 3, "حالة 1")
تأكد_يساوي(ف(4484), 4, "حالة 2")
تأكد_يساوي(ف(3925), 8, "حالة 3")
تأكد_يساوي(ف(1229), 6, "حالة 4")
تأكد_يساوي(ف(4498), 5, "حالة 5")
