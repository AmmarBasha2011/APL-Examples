# مثال 7348 — المجموع: من ي * 4 باقي 9 نأخذ الأكبر من 5 ثم (سالب)
# sum over mod9 sequence, keep gt5, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7348-seq-mod9-gt5-neg-sum.apl

# نولّد أول ن حد من: ي * 4 باقي 9
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي * 4) % 9
    لو خ > 5:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -15, "حالة 3")
تأكد_يساوي(ف(10), -21, "حالة 4")
تأكد_يساوي(ف(15), -36, "حالة 5")
