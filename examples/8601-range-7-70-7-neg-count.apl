# مثال 8601 — العدد من المدى 7 إلى 70 بخطوة 7 بعد (سالب)
# count over range(7,70,7) mapped by neg
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8601-range-7-70-7-neg-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [0 - خ]
    خ = خ + (7)
  ارجع len(ر)

تأكد_يساوي(ف(), 9, "المدى كله")
