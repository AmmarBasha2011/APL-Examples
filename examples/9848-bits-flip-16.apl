# مثال 9848 — قلب الخانة رقم 16
# Flip bit 16
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9848-bits-flip-16.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 16)

تأكد_يساوي(ف(0), 65536, "حالة 1")
تأكد_يساوي(ف(255), 65791, "حالة 2")
تأكد_يساوي(ف(1000), 66536, "حالة 3")
تأكد_يساوي(ف(12345), 77881, "حالة 4")
