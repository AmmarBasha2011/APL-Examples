# مثال 9912 — الوسيط (بعد الترتيب) (مجموعة 20)
# median (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9912-stat-median-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([24, 45, 33, -19, 8]), 24, "حالة 1")
تأكد_يساوي(ف([41, 32, 21, -4, 32, 55, 49]), 32, "حالة 2")
تأكد_يساوي(ف([33, 34, -2, -11, 24, 41, 41, 51, 3]), 33, "حالة 3")
تأكد_يساوي(ف([29, -5, 6, 11, 20, 2, 60, 59]), 15, "حالة 4")
