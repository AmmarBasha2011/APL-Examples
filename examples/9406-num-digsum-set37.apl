# مثال 9406 — مجموع الأرقام (مجموعة اختبار 37)
# digsum (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9406-num-digsum-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(9125), 17, "حالة 1")
تأكد_يساوي(ف(6439), 22, "حالة 2")
تأكد_يساوي(ف(53441), 17, "حالة 3")
تأكد_يساوي(ف(18304), 16, "حالة 4")
تأكد_يساوي(ف(39095), 26, "حالة 5")
