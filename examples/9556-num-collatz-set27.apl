# مثال 9556 — خطوات كولاتز (مجموعة اختبار 27)
# collatz (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9556-num-collatz-set27.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(198), 26, "حالة 1")
تأكد_يساوي(ف(73), 115, "حالة 2")
تأكد_يساوي(ف(2), 1, "حالة 3")
تأكد_يساوي(ف(43), 29, "حالة 4")
تأكد_يساوي(ف(105), 38, "حالة 5")
