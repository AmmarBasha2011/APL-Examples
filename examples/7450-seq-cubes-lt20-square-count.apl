# مثال 7450 — العدد: من المكعبات نأخذ الأصغر من 20 ثم (مربع)
# count over cubes sequence, keep lt20, map square
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7450-seq-cubes-lt20-square-count.apl

# نولّد أول ن حد من: المكعبات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي * ي
    لو خ < 20:
      ر = ر + [خ * خ]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 3, "حالة 3")
تأكد_يساوي(ف(10), 3, "حالة 4")
تأكد_يساوي(ف(15), 3, "حالة 5")
