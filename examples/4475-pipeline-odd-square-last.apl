# مثال 4475 — آخر نتيجة مربعها للأعداد الفردية
# Last (or -1) of square over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4475-pipeline-odd-square-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 1, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 625, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 1225, "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 25, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
