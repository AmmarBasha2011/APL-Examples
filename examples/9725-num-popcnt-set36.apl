# مثال 9725 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 36)
# popcnt (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9725-num-popcnt-set36.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(2563), 4, "حالة 1")
تأكد_يساوي(ف(545), 3, "حالة 2")
تأكد_يساوي(ف(4611), 4, "حالة 3")
تأكد_يساوي(ف(4982), 8, "حالة 4")
تأكد_يساوي(ف(4470), 7, "حالة 5")
