# مثال 8032 — تكرار كل كلمة في الجملة رقم 14
# freq for sentence 14
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8032-sent13-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("nile river nile delta river"), {"nile": 2, "river": 2, "delta": 1}, "حالة 1")
تأكد_يساوي(ف("sun sand sea sun sand sun"), {"sun": 3, "sand": 2, "sea": 1}, "حالة 2")
تأكد_يساوي(ف("the cat and the dog and the bird"), {"the": 3, "cat": 1, "and": 2, "dog": 1, "bird": 1}, "حالة 3")
