# مثال 9827 — آخر 12 خانات ثنائية
# Low 12 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9827-bits-low-12.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 4095

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 255, "حالة 2")
تأكد_يساوي(ف(1000), 1000, "حالة 3")
تأكد_يساوي(ف(12345), 57, "حالة 4")
