# مثال 4615 — أصغر نتيجة زائد 7 للأعداد الغير الصفرية
# Smallest (or 0) of plus 7 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4615-pipeline-notzero-plus7-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ + 7]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 14, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 3, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 8, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 8, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
