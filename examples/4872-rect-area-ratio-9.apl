# مثال 4872 — مساحة مستطيل طوله 9 أضعاف عرضه
# Area of rectangle with length 9x width
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4872-rect-area-ratio-9.apl

# المساحة = العرض × الطول

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ع):
  ارجع ع * (ع * 9)

تأكد_يساوي(ف(1), 9, "حالة 1")
تأكد_يساوي(ف(2), 36, "حالة 2")
تأكد_يساوي(ف(5), 225, "حالة 3")
تأكد_يساوي(ف(10), 900, "حالة 4")
