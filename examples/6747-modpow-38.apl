# مثال 6747 — القوة بالباقي على 38
# Modular power mod 38
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6747-modpow-38.apl

# نضرب ونأخذ الباقي في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ب, أ):
  ر = 1
  لكل ي في range(أ):
    ر = ر * ب % 38
  ارجع ر

تأكد_يساوي(ف(2, 0), 1, "حالة 1")
تأكد_يساوي(ف(2, 10), 36, "حالة 2")
تأكد_يساوي(ف(3, 7), 21, "حالة 3")
تأكد_يساوي(ف(7, 13), 7, "حالة 4")
تأكد_يساوي(ف(10, 20), 24, "حالة 5")
