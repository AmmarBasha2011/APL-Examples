# مثال 9625 — الأصفار في نهاية العاملي (مجموعة اختبار 16)
# tzeros (test set 16)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9625-num-tzeros-set16.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(34), 7, "حالة 1")
تأكد_يساوي(ف(365), 89, "حالة 2")
تأكد_يساوي(ف(166), 40, "حالة 3")
تأكد_يساوي(ف(215), 52, "حالة 4")
تأكد_يساوي(ف(1), 0, "حالة 5")
