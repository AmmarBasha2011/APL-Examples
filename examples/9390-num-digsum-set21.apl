# مثال 9390 — مجموع الأرقام (مجموعة اختبار 21)
# digsum (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9390-num-digsum-set21.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(9148), 22, "حالة 1")
تأكد_يساوي(ف(71020), 10, "حالة 2")
تأكد_يساوي(ف(89345), 29, "حالة 3")
تأكد_يساوي(ف(88547), 32, "حالة 4")
تأكد_يساوي(ف(13159), 19, "حالة 5")
