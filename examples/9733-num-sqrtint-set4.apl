# مثال 9733 — الجذر التربيعي الصحيح (مجموعة اختبار 4)
# sqrtint (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9733-num-sqrtint-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(625), 25, "حالة 1")
تأكد_يساوي(ف(3276), 57, "حالة 2")
تأكد_يساوي(ف(327), 18, "حالة 3")
تأكد_يساوي(ف(4821), 69, "حالة 4")
تأكد_يساوي(ف(4807), 69, "حالة 5")
