# مثال 4582 — عدد نتيجة باقي قسمتها على 10 للأعداد الأقل من 5
# Count of last digit mod 10 over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4582-pipeline-small-mod10-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ % 10]
  ارجع len(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 0, "حالة 1")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 3, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 3, "حالة 3")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 3, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
