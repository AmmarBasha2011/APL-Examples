# مثال 6634 — الأعداد التي باقيها 3 عند القسمة على 5
# Numbers with remainder 3 mod 5
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6634-residue-5-3.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 5 == 3:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [3, 8], "حالة 2")
تأكد_يساوي(ف(40), [3, 8, 13, 18, 23, 28, 33, 38], "حالة 3")
تأكد_يساوي(ف(75), [3, 8, 13, 18, 23, 28, 33, 38, 43, 48, 53, 58, 63, 68, 73], "حالة 4")
