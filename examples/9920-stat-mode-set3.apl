# مثال 9920 — المنوال (الأصغر عند التساوي) (مجموعة 3)
# mode (data set 3)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9920-stat-mode-set3.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([19, 35, 11]), 11, "حالة 1")
تأكد_يساوي(ف([37, 17, 12, 51, -8, 43, 3, 39, 46]), -8, "حالة 2")
تأكد_يساوي(ف([-12, 26, 1, 32]), -12, "حالة 3")
تأكد_يساوي(ف([38, 44, -17, 47, -6, 29, -3, 27]), -17, "حالة 4")
