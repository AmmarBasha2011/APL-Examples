# مثال 4959 — شيفرة قيصر بإزاحة 8
# Caesar cipher shift 8
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4959-caesar-8.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 8) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "ijk", "حالة 1")
تأكد_يساوي(ف("hello world"), "pmttw ewztl", "حالة 2")
تأكد_يساوي(ف("xyz"), "fgh", "حالة 3")
تأكد_يساوي(ف("a b-c"), "i j-k", "حالة 4")
