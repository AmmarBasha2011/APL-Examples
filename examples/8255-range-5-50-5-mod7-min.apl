# مثال 8255 — أصغر قيمة من المدى 5 إلى 50 بخطوة 5 بعد (باقي على 7)
# min over range(5,50,5) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8255-range-5-50-5-mod7-min.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ % 7]
    خ = خ + (5)
  لو len(ر) == 0:
    ارجع 0
  ارجع min(ر)

تأكد_يساوي(ف(), 0, "المدى كله")
