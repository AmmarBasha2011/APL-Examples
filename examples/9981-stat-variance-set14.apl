# مثال 9981 — التباين الصحيح (مجموعة 14)
# variance (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9981-stat-variance-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-17, 21, 4, 57]), 734, "حالة 1")
تأكد_يساوي(ف([9, 40, 31, 6]), 207, "حالة 2")
تأكد_يساوي(ف([-19, 47, 47, -5, 7, -11, 27, 57, 48]), 766, "حالة 3")
تأكد_يساوي(ف([16, 20, 55, -15, -14, 11, 55, 34]), 640, "حالة 4")
