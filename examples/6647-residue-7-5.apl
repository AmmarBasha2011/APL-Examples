# مثال 6647 — الأعداد التي باقيها 5 عند القسمة على 7
# Numbers with remainder 5 mod 7
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6647-residue-7-5.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 7 == 5:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [5], "حالة 2")
تأكد_يساوي(ف(40), [5, 12, 19, 26, 33], "حالة 3")
تأكد_يساوي(ف(75), [5, 12, 19, 26, 33, 40, 47, 54, 61, 68], "حالة 4")
