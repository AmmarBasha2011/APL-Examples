# مثال 7834 — أكبر قيمة: من عكسية نأخذ الزوجي ثم (زيادة واحد)
# max over rev sequence, keep even, map inc
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7834-seq-rev-even-inc-max.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ % 2 == 0:
      ر = ر + [خ + 1]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 21, "حالة 2")
تأكد_يساوي(ف(5), 21, "حالة 3")
تأكد_يساوي(ف(10), 21, "حالة 4")
تأكد_يساوي(ف(15), 21, "حالة 5")
