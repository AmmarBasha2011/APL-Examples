# مثال 10113 — عدد العناصر الأصغر من 12
# Count items below 12
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10113-count-below-12.apl

# عدّاد بسيط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ع = 0
  لكل خ في ق:
    لو خ < 12:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39, 42, 45, 48]), 4, "حالة 1")
تأكد_يساوي(ف([12]), 0, "حالة 2")
تأكد_يساوي(ف([]), 0, "حالة 3")
