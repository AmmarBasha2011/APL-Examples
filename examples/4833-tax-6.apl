# مثال 4833 — إجمالي مع ضريبة 6%
# Total with 6 percent tax
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4833-tax-6.apl

# الإجمالي = السعر + الضريبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س + س * 6 // 100

تأكد_يساوي(ف(100), 106, "حالة 1")
تأكد_يساوي(ف(200), 212, "حالة 2")
تأكد_يساوي(ف(1500), 1590, "حالة 3")
تأكد_يساوي(ف(80), 84, "حالة 4")
