# مثال 8848 — صنف عداد يزيد 4 من 0
# Counter class step 4 from 0
# Demonstrates: البرمجة الكائنية
#
# Run:  python apl.py examples/8848-class-counter-4-0.apl

# صنف بحالة داخلية
# دالة تزيد القيمة وأخرى تصفّرها

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

صنف عداد:
    دالة_إنشاء(ذات, بداية):
        ذات.قيمة = بداية

    دالة زد(ذات):
        ذات.قيمة = ذات.قيمة + 4
        ارجع ذات.قيمة

    دالة صفر(ذات):
        ذات.قيمة = 0

ع = عداد(0)
تأكد_يساوي(ع.قيمة, 0, "البداية")
تأكد_يساوي(ع.زد(), 4, "خطوة 1")
تأكد_يساوي(ع.زد(), 8, "خطوة 2")
تأكد_يساوي(ع.زد(), 12, "خطوة 3")
تأكد_يساوي(ع.زد(), 16, "خطوة 4")
تأكد_يساوي(ع.زد(), 20, "خطوة 5")
ع.صفر()
تأكد_يساوي(ع.قيمة, 0, "بعد التصفير")
