# مثال 9973 — التباين الصحيح (مجموعة 6)
# variance (data set 6)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9973-stat-variance-set6.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([59, 38, 54, 2, 43, 16, 7]), 449, "حالة 1")
تأكد_يساوي(ف([6, 26, -3, -2, 2]), 112, "حالة 2")
تأكد_يساوي(ف([-13, -12, 23, -1, -13, -11, 39]), 376, "حالة 3")
تأكد_يساوي(ف([-12, 58, 46, 16, 36, 0, 26]), 532, "حالة 4")
