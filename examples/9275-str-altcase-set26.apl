# مثال 9275 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 26)
# altcase (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9275-str-altcase-set26.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("orbit"), "OrBiT", "حالة 1")
تأكد_يساوي(ف("deed"), "DeEd", "حالة 2")
تأكد_يساوي(ف("tenet"), "TeNeT", "حالة 3")
تأكد_يساوي(ف("google"), "GoOgLe", "حالة 4")
تأكد_يساوي(ف("silent"), "SiLeNt", "حالة 5")
