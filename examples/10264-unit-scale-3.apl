# مثال 10264 — تحويل وحدة إلى 3 وحدات صغرى والعكس
# Convert units with factor 3
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10264-unit-scale-3.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 3, ن // 3, ن % 3]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [3, 0, 1], "حالة 2")
تأكد_يساوي(ف(3), [9, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [3000, 333, 1], "حالة 4")
