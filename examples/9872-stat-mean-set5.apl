# مثال 9872 — المتوسط الصحيح (مجموعة 5)
# mean (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9872-stat-mean-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([10, 31, 45, 26, -3, 41, -17, -1, 20]), 16, "حالة 1")
تأكد_يساوي(ف([49, 12, 60, 53, 51, 18, -12, -6]), 28, "حالة 2")
تأكد_يساوي(ف([17, 27, -5]), 13, "حالة 3")
تأكد_يساوي(ف([36, 1, 31, 46, 25, 40, 21, 43, 21]), 29, "حالة 4")
