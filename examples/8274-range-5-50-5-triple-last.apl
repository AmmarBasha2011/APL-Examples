# مثال 8274 — آخر عنصر من المدى 5 إلى 50 بخطوة 5 بعد (ثلاثة أضعاف)
# last over range(5,50,5) mapped by triple
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8274-range-5-50-5-triple-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 5
  طالما خ < 50:
    ر = ر + [خ * 3]
    خ = خ + (5)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 135, "المدى كله")
