# مثال 9797 — آخر 6 خانات ثنائية
# Low 6 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9797-bits-low-6.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 63

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 63, "حالة 2")
تأكد_يساوي(ف(1000), 40, "حالة 3")
تأكد_يساوي(ف(12345), 57, "حالة 4")
