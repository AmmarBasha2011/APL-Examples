# مثال 9869 — المتوسط الصحيح (مجموعة 2)
# mean (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9869-stat-mean-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([22, -4, 23, -1, 16, 35, 12]), 14, "حالة 1")
تأكد_يساوي(ف([-13, 47, 15, 26, 54, -8, 26]), 21, "حالة 2")
تأكد_يساوي(ف([45, -19, -8]), 6, "حالة 3")
تأكد_يساوي(ف([43, 27, -17, 23, 43, -14, -18, 10]), 12, "حالة 4")
