# مثال 10034 — ثاني أكبر قيمة مختلفة (مجموعة 17)
# second (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10034-stat-second-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([26, 1, 60, 25, 1, 34, -15]), 34, "حالة 1")
تأكد_يساوي(ف([28, 44, -11, 11, 20, 5, -7, 21, 48]), 44, "حالة 2")
تأكد_يساوي(ف([11, 53, -12, 60]), 53, "حالة 3")
تأكد_يساوي(ف([-12, -9, 58]), -9, "حالة 4")
