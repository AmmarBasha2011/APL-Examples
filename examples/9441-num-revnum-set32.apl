# مثال 9441 — عكس الأرقام (مجموعة اختبار 32)
# revnum (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9441-num-revnum-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(67713), 31776, "حالة 1")
تأكد_يساوي(ف(71745), 54717, "حالة 2")
تأكد_يساوي(ف(62803), 30826, "حالة 3")
تأكد_يساوي(ف(19672), 27691, "حالة 4")
تأكد_يساوي(ف(71975), 57917, "حالة 5")
