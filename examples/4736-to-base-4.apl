# مثال 4736 — تحويل عدد إلى الأساس 4
# Convert a number to base 4
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4736-to-base-4.apl

# نقسم على الأساس ونجمع البواقي من الآخر
# لحد ما يبقى الناتج صفر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن == 0:
    ارجع "0"
  ر = ""
  لكل ي في range(100):
    لو ن == 0:
      ارجع ر
    ر = str(ن % 4) + ر
    ن = ن // 4
  ارجع ر

تأكد_يساوي(ف(0), "0", "حالة 1")
تأكد_يساوي(ف(5), "11", "حالة 2")
تأكد_يساوي(ف(17), "101", "حالة 3")
تأكد_يساوي(ف(100), "1210", "حالة 4")
تأكد_يساوي(ف(255), "3333", "حالة 5")
