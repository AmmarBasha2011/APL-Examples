# مثال 5178 — ضرب كل عنصر في 4
# Scale list by 4
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5178-scale-list-4.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 4]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [4, 8, 12], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -16, 40], "حالة 3")
