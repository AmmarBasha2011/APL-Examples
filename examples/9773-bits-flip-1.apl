# مثال 9773 — قلب الخانة رقم 1
# Flip bit 1
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9773-bits-flip-1.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 1)

تأكد_يساوي(ف(0), 2, "حالة 1")
تأكد_يساوي(ف(255), 253, "حالة 2")
تأكد_يساوي(ف(1000), 1002, "حالة 3")
تأكد_يساوي(ف(12345), 12347, "حالة 4")
