# مثال 4554 — أكبر نتيجة باقي قسمتها على 10 للأعداد الأكبر من 10
# Largest (or 0) of last digit mod 10 over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4554-pipeline-big-mod10-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ % 10]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([3, 1, 2, 8, 5]), 0, "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 5, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 5, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 1, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
