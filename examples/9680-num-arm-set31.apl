# مثال 9680 — هل العدد أرمسترونغ (مجموعة اختبار 31)
# arm (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9680-num-arm-set31.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(383), خطأ, "حالة 1")
تأكد_يساوي(ف(323), خطأ, "حالة 2")
تأكد_يساوي(ف(173), خطأ, "حالة 3")
تأكد_يساوي(ف(925), خطأ, "حالة 4")
تأكد_يساوي(ف(4), صواب, "حالة 5")
