# مثال 5094 — اقتطاع النص إلى 2 حروف مع نقاط
# Truncate to 2 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5094-truncate-2.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 2:
    ارجع ن
  ارجع ن[:2] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "he...", "حالة 2")
تأكد_يساوي(ف("xx"), "xx", "حالة 3")
تأكد_يساوي(ف("yyy"), "yy...", "حالة 4")
