# مثال 9021 — هل لا يتكرر أي حرف (مجموعة اختبار 12)
# isogram (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9021-str-isogram-set12.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("silent"), صواب, "حالة 1")
تأكد_يساوي(ف("noon"), خطأ, "حالة 2")
تأكد_يساوي(ف("rocket"), صواب, "حالة 3")
تأكد_يساوي(ف("level"), خطأ, "حالة 4")
تأكد_يساوي(ف("venus"), صواب, "حالة 5")
