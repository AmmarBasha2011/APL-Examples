# مثال 6177 — الناتج معكوس بعد أخذ حروف آخر الأبجدية وتحويلها إلى (حرف كبير)
# rev of upper applied to late chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6177-txt-late-upper-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ حروف آخر الأبجدية فقط
# ونحوّل كل حرف إلى: حرف كبير
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "n" و خ <= "z":
      ر = ر + خ.upper()
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "ROWO", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "NUSP", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "XONWORUQT", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "XXXYYYZZZ", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "NST", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "RNNRORP", "حالة 8")
