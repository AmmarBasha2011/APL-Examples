# مثال 8983 — حروف الكلمة مرتبة (مجموعة اختبار 14)
# sortchars (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8983-str-sortchars-set14.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("data"), "aadt", "حالة 1")
تأكد_يساوي(ف("galaxy"), "aaglxy", "حالة 2")
تأكد_يساوي(ف("array"), "aarry", "حالة 3")
تأكد_يساوي(ف("moon"), "mnoo", "حالة 4")
تأكد_يساوي(ف("deed"), "ddee", "حالة 5")
