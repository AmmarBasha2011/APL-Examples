# مثال 9658 — هل العدد أرمسترونغ (مجموعة اختبار 9)
# arm (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9658-num-arm-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(253), خطأ, "حالة 1")
تأكد_يساوي(ف(635), خطأ, "حالة 2")
تأكد_يساوي(ف(596), خطأ, "حالة 3")
تأكد_يساوي(ف(785), خطأ, "حالة 4")
تأكد_يساوي(ف(996), خطأ, "حالة 5")
