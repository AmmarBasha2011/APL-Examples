# مثال 8358 — آخر عنصر من المدى 3 إلى 40 بخطوة 3 بعد (زيادة واحد)
# last over range(3,40,3) mapped by inc
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8358-range-3-40-3-inc-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ + 1]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 40, "المدى كله")
