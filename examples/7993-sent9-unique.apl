# مثال 7993 — عدد الكلمات المختلفة في الجملة رقم 10
# unique for sentence 10
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7993-sent9-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("in the end the end is the start"), 5, "حالة 1")
تأكد_يساوي(ف("cairo is big and cairo is old"), 5, "حالة 2")
تأكد_يساوي(ف("sun sand sea sun sand sun"), 3, "حالة 3")
