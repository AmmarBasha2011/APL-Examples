# مثال 4474 — أكبر نتيجة مربعها للأعداد الفردية
# Largest (or 0) of square over the odd numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4474-pipeline-odd-square-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 1:
      ن = ن + [خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 625, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 81, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 1225, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 169, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
