# مثال 8067 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 17
# longest for sentence 17
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8067-sent16-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("sun sand sea sun sand sun"), "sand", "حالة 1")
تأكد_يساوي(ف("yes no yes yes no maybe"), "maybe", "حالة 2")
تأكد_يساوي(ف("one fish two fish red fish blue fish"), "fish", "حالة 3")
