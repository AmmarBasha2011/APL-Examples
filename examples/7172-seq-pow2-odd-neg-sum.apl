# مثال 7172 — المجموع: من قوى 2 نأخذ الفردي ثم (سالب)
# sum over pow2 sequence, keep odd, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7172-seq-pow2-odd-neg-sum.apl

# نولّد أول ن حد من: قوى 2
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 2 ** ي
    لو خ % 2 == 1:
      ر = ر + [0 - خ]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), -1, "حالة 2")
تأكد_يساوي(ف(5), -1, "حالة 3")
تأكد_يساوي(ف(10), -1, "حالة 4")
تأكد_يساوي(ف(15), -1, "حالة 5")
