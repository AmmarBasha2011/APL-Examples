# مثال 5128 — ملء النص من اليسار حتى عرض 9
# Left pad to width 9
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5128-pad-left-9.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 9:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "000000007", "حالة 1")
تأكد_يساوي(ف("123"), "000000123", "حالة 2")
تأكد_يساوي(ف("111111111"), "111111111", "حالة 3")
تأكد_يساوي(ف(""), "000000000", "حالة 4")
