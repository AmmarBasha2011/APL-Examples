# مثال 9884 — المتوسط الصحيح (مجموعة 17)
# mean (data set 17)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9884-stat-mean-set17.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([39, 47, 54, 39, 12, 28, 7, -7, 23]), 26, "حالة 1")
تأكد_يساوي(ف([53, -9, -18, 5, 22, 9, 30, 17, -14]), 10, "حالة 2")
تأكد_يساوي(ف([-12, 21, 37, 59, 19, 27, -3, 42, -6]), 20, "حالة 3")
تأكد_يساوي(ف([4, 27, 48, 0, 27, 26, 22, 36, 3]), 21, "حالة 4")
