# مثال 9989 — التباين الصحيح (مجموعة 22)
# variance (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9989-stat-variance-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([17, 41, 4, -19, 2, -1, 55, 14]), 497, "حالة 1")
تأكد_يساوي(ف([21, 31, 14, -12, 52, 29]), 375, "حالة 2")
تأكد_يساوي(ف([16, 38, 25, 5, -8, 47]), 350, "حالة 3")
تأكد_يساوي(ف([-3, -3, 7, 42, -5, 60]), 642, "حالة 4")
