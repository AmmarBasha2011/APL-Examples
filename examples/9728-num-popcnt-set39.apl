# مثال 9728 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 39)
# popcnt (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9728-num-popcnt-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(3781), 7, "حالة 1")
تأكد_يساوي(ف(4314), 6, "حالة 2")
تأكد_يساوي(ف(4737), 4, "حالة 3")
تأكد_يساوي(ف(3838), 10, "حالة 4")
تأكد_يساوي(ف(2094), 5, "حالة 5")
