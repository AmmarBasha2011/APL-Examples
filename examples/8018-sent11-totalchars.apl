# مثال 8018 — مجموع حروف الكلمات في الجملة رقم 12
# totalchars for sentence 12
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8018-sent11-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("up down up down up up down"), 20, "حالة 1")
تأكد_يساوي(ف("learn code learn more code more"), 26, "حالة 2")
تأكد_يساوي(ف("left right left left right"), 22, "حالة 3")
