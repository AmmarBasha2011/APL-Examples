# مثال 4885 — هل مثلث أضلاعه مضاعفات (9,40) قائم؟
# Right triangle check with scale of (9,40)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4885-hypot-check-9-40.apl

# نتحقق من فيثاغورس: أ² + ب² = ج²

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, ج):
  أ = 9 * م
  ب = 40 * م
  ارجع أ * أ + ب * ب == ج * ج

تأكد_يساوي(ف(1, 1), خطأ, "حالة 1")
تأكد_يساوي(ف(1, 5), خطأ, "حالة 2")
تأكد_يساوي(ف(2, 10), خطأ, "حالة 3")
تأكد_يساوي(ف(3, 3), خطأ, "حالة 4")
