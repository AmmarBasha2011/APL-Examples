# مثال 9935 — المنوال (الأصغر عند التساوي) (مجموعة 18)
# mode (data set 18)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9935-stat-mode-set18.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([-4, 36, 54, 24, 35, 48, -9, -14]), -14, "حالة 1")
تأكد_يساوي(ف([-5, 16, 10, 5, 58, 0]), -5, "حالة 2")
تأكد_يساوي(ف([-2, 9, 46]), -2, "حالة 3")
تأكد_يساوي(ف([-13, 8, 29]), -13, "حالة 4")
