# مثال 9962 — المدى (مجموعة 20)
# range (data set 20)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9962-stat-range-set20.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([40, 59, 4, 17]), 55, "حالة 1")
تأكد_يساوي(ف([-15, 59, 37]), 74, "حالة 2")
تأكد_يساوي(ف([6, -20, -18, -9, 47, 2, 33, -14]), 67, "حالة 3")
تأكد_يساوي(ف([24, -18, 41]), 59, "حالة 4")
