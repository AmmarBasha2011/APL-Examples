# مثال 9154 — ضغط التكرار (مجموعة اختبار 25)
# rle (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9154-str-rle-set25.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("saturn"), "s1a1t1u1r1n1", "حالة 1")
تأكد_يساوي(ف("sun"), "s1u1n1", "حالة 2")
تأكد_يساوي(ف("star"), "s1t1a1r1", "حالة 3")
تأكد_يساوي(ف("civic"), "c1i1v1i1c1", "حالة 4")
تأكد_يساوي(ف("galaxy"), "g1a1l1a1x1y1", "حالة 5")
