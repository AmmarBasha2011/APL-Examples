# مثال 8974 — حروف الكلمة مرتبة (مجموعة اختبار 5)
# sortchars (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8974-str-sortchars-set5.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("kayak"), "aakky", "حالة 1")
تأكد_يساوي(ف("mars"), "amrs", "حالة 2")
تأكد_يساوي(ف("noon"), "nnoo", "حالة 3")
تأكد_يساوي(ف("refer"), "eefrr", "حالة 4")
تأكد_يساوي(ف("orbit"), "biort", "حالة 5")
