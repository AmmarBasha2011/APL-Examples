# مثال 10332 — تحويل 38 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 38 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10332-temp-c-38.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 38) * 9 // 5 + 32

تأكد_يساوي(ف(0), 100, "حالة 1")
تأكد_يساوي(ف(10), 118, "حالة 2")
تأكد_يساوي(ف(37), 167, "حالة 3")
تأكد_يساوي(ف(-5), 91, "حالة 4")
