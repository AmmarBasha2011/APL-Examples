# مثال 9976 — التباين الصحيح (مجموعة 9)
# variance (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9976-stat-variance-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([19, 35, 26, 28, -15, 38]), 309, "حالة 1")
تأكد_يساوي(ف([35, 11, 45, 2, 16, 20, 51, 21, 22]), 226, "حالة 2")
تأكد_يساوي(ف([-10, 49, 16, 51, 0, 14, -14]), 592, "حالة 3")
تأكد_يساوي(ف([39, -16, 31, 7, 52, -2, -17]), 646, "حالة 4")
