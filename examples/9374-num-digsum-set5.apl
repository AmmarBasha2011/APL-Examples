# مثال 9374 — مجموع الأرقام (مجموعة اختبار 5)
# digsum (test set 5)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9374-num-digsum-set5.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(76121), 17, "حالة 1")
تأكد_يساوي(ف(25841), 20, "حالة 2")
تأكد_يساوي(ف(26964), 27, "حالة 3")
تأكد_يساوي(ف(96772), 31, "حالة 4")
تأكد_يساوي(ف(84144), 21, "حالة 5")
