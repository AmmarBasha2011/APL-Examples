# مثال 10301 — تحويل وحدة إلى 40 وحدات صغرى والعكس
# Convert units with factor 40
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10301-unit-scale-40.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 40, ن // 40, ن % 40]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [40, 0, 1], "حالة 2")
تأكد_يساوي(ف(40), [1600, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [40000, 25, 0], "حالة 4")
