# مثال 5330 — أقرب مضاعف للعدد 19
# Nearest multiple of 19
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5330-nearest-multiple-19.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 19
  لو ب * 2 < 19:
    ارجع ن - ب
  ارجع ن - ب + 19

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 0, "حالة 2")
تأكد_يساوي(ف(13), 19, "حالة 3")
تأكد_يساوي(ف(100), 95, "حالة 4")
تأكد_يساوي(ف(20), 19, "حالة 5")
