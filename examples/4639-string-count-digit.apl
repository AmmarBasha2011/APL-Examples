# مثال 4639 — عدّ (رقم) في نص
# String: count digit
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4639-string-count-digit.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ع = 0
  لكل خ في س:
    لو خ.isdigit():
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("a1b2c3d4"), 4, "حالة 1")
تأكد_يساوي(ف("Hello World 42"), 2, "حالة 2")
تأكد_يساوي(ف("aeiou AEIOU xyz"), 0, "حالة 3")
تأكد_يساوي(ف("quick brown fox"), 0, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
