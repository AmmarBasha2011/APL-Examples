# مثال 6816 — عدد حلول 2س + 6ص = 36
# Count solutions of 2x+6y=36
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6816-pairs-2x-6y-36.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 2 * س + 6 * ص == 36:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 0, "حالة 2")
تأكد_يساوي(ف(10), 4, "حالة 3")
تأكد_يساوي(ف(36), 7, "حالة 4")
