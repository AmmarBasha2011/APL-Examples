# مثال 7802 — أكبر قيمة: من قوى 3 نأخذ مضاعفات 3 ثم (سالب)
# max over geo3 sequence, keep m3, map neg
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7802-seq-geo3-m3-neg-max.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ % 3 == 0:
      ر = ر + [0 - خ]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), -3, "حالة 3")
تأكد_يساوي(ف(10), -3, "حالة 4")
تأكد_يساوي(ف(15), -3, "حالة 5")
