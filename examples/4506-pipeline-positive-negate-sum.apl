# مثال 4506 — مجموع نتيجة سالبها للأعداد الموجبة
# Sum of negated over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4506-pipeline-positive-negate-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [0 - خ]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), -43, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), -78, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), -147, "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -39, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
