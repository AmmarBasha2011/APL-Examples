# مثال 6938 — أكبر قيمة: من متتالية حسابية بخطوة 3 نأخذ الفردي ثم (ضعف)
# max over arith3 sequence, keep odd, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/6938-seq-arith3-odd-double-max.apl

# نولّد أول ن حد من: متتالية حسابية بخطوة 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 1 + ي * 3
    لو خ % 2 == 1:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 26, "حالة 3")
تأكد_يساوي(ف(10), 50, "حالة 4")
تأكد_يساوي(ف(15), 86, "حالة 5")
