# مثال 8901 — هل الكلمة متناظرة (مجموعة اختبار 12)
# palin (test set 12)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8901-str-palin-set12.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("data"), خطأ, "حالة 1")
تأكد_يساوي(ف("rocket"), خطأ, "حالة 2")
تأكد_يساوي(ف("mars"), خطأ, "حالة 3")
تأكد_يساوي(ف("silent"), خطأ, "حالة 4")
تأكد_يساوي(ف("array"), خطأ, "حالة 5")
