# مثال 8968 — عدد حروف العلة (مجموعة اختبار 39)
# vowels (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8968-str-vowels-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح في "aeiou":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("comet"), 2, "حالة 1")
تأكد_يساوي(ف("deed"), 2, "حالة 2")
تأكد_يساوي(ف("radar"), 2, "حالة 3")
تأكد_يساوي(ف("rocket"), 2, "حالة 4")
تأكد_يساوي(ف("loop"), 2, "حالة 5")
