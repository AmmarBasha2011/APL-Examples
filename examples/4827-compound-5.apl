# مثال 4827 — مبلغ بعد فائدة مركبة 5%
# Compound balance at 5 percent (integer)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4827-compound-5.apl

# كل سنة نضيف الفائدة على الرصيد
# القسمة صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  لكل ي في range(س):
    م = م + م * 5 // 100
  ارجع م

تأكد_يساوي(ف(1000, 1), 1050, "حالة 1")
تأكد_يساوي(ف(1000, 5), 1274, "حالة 2")
تأكد_يساوي(ف(500, 3), 578, "حالة 3")
تأكد_يساوي(ف(20000, 2), 22050, "حالة 4")
