# مثال 5047 — حصر القيمة بين -100 و 100
# Clamp value into [-100,100]
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5047-clamp-neg100-100.apl

# إن كانت أقل من الحد الأدنى نرجع الحد الأدنى
# وإن زادت نرجع الحد الأعلى

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < -100:
    ارجع -100
  لو ن > 100:
    ارجع 100
  ارجع ن

تأكد_يساوي(ف(-105), -100, "حالة 1")
تأكد_يساوي(ف(105), 100, "حالة 2")
تأكد_يساوي(ف(0), 0, "حالة 3")
تأكد_يساوي(ف(-100), -100, "حالة 4")
تأكد_يساوي(ف(100), 100, "حالة 5")
