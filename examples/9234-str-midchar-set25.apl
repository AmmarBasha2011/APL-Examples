# مثال 9234 — الحرف الأوسط (مجموعة اختبار 25)
# midchar (test set 25)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9234-str-midchar-set25.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("orbit"), "b", "حالة 1")
تأكد_يساوي(ف("bob"), "o", "حالة 2")
تأكد_يساوي(ف("banana"), "a", "حالة 3")
تأكد_يساوي(ف("pluto"), "u", "حالة 4")
تأكد_يساوي(ف("mars"), "r", "حالة 5")
