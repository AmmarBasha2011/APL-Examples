# مثال 9424 — عكس الأرقام (مجموعة اختبار 15)
# revnum (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9424-num-revnum-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(92663), 36629, "حالة 1")
تأكد_يساوي(ف(29017), 71092, "حالة 2")
تأكد_يساوي(ف(34809), 90843, "حالة 3")
تأكد_يساوي(ف(492), 294, "حالة 4")
تأكد_يساوي(ف(31643), 34613, "حالة 5")
