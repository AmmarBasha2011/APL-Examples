# مثال 8354 — المجموع من المدى 3 إلى 40 بخطوة 3 بعد (زيادة واحد)
# sum over range(3,40,3) mapped by inc
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8354-range-3-40-3-inc-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 3
  طالما خ < 40:
    ر = ر + [خ + 1]
    خ = خ + (3)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 286, "المدى كله")
