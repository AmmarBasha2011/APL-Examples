# مثال 9882 — المتوسط الصحيح (مجموعة 15)
# mean (data set 15)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9882-stat-mean-set15.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([51, 53, 44, -10]), 34, "حالة 1")
تأكد_يساوي(ف([16, 48, 55, 35, -14, -20, -3, 28]), 18, "حالة 2")
تأكد_يساوي(ف([9, -3, -13, 12, -2, 7]), 1, "حالة 3")
تأكد_يساوي(ف([3, -7, 23, 30, 51, -3]), 16, "حالة 4")
