# مثال 9712 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 23)
# popcnt (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9712-num-popcnt-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(1185), 4, "حالة 1")
تأكد_يساوي(ف(2394), 6, "حالة 2")
تأكد_يساوي(ف(1228), 5, "حالة 3")
تأكد_يساوي(ف(2661), 6, "حالة 4")
تأكد_يساوي(ف(1573), 5, "حالة 5")
