# مثال 8902 — هل الكلمة متناظرة (مجموعة اختبار 13)
# palin (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8902-str-palin-set13.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("kayak"), صواب, "حالة 1")
تأكد_يساوي(ف("racecar"), صواب, "حالة 2")
تأكد_يساوي(ف("stats"), صواب, "حالة 3")
تأكد_يساوي(ف("deed"), صواب, "حالة 4")
تأكد_يساوي(ف("radar"), صواب, "حالة 5")
