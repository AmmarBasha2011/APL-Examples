# مثال 9838 — قلب الخانة رقم 14
# Flip bit 14
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9838-bits-flip-14.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 14)

تأكد_يساوي(ف(0), 16384, "حالة 1")
تأكد_يساوي(ف(255), 16639, "حالة 2")
تأكد_يساوي(ف(1000), 17384, "حالة 3")
تأكد_يساوي(ف(12345), 28729, "حالة 4")
