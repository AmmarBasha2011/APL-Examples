# مثال 9009 — حروف الكلمة مرتبة (مجموعة اختبار 40)
# sortchars (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9009-str-sortchars-set40.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("noon"), "nnoo", "حالة 1")
تأكد_يساوي(ف("comet"), "cemot", "حالة 2")
تأكد_يساوي(ف("sun"), "nsu", "حالة 3")
تأكد_يساوي(ف("google"), "eggloo", "حالة 4")
تأكد_يساوي(ف("data"), "aadt", "حالة 5")
