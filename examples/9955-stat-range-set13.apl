# مثال 9955 — المدى (مجموعة 13)
# range (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9955-stat-range-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ارجع max(ق) - min(ق)

تأكد_يساوي(ف([44, -8, 11, -10]), 54, "حالة 1")
تأكد_يساوي(ف([-18, 41, 11, 23, 43, 2, 23, 48, 16]), 66, "حالة 2")
تأكد_يساوي(ف([44, 16, -15]), 59, "حالة 3")
تأكد_يساوي(ف([-1, 53, 53, -19, 39]), 72, "حالة 4")
