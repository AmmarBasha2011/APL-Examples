# مثال 4663 — آخر موضع (حرف صغير) في نص
# String: last position of lowercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4663-string-last-lower.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  ل = -1
  لكل خ في س:
    لو خ.islower():
      ل = ر
    ر = ر + 1
  ارجع ل

تأكد_يساوي(ف("ZZtop and the Beatles"), 20, "حالة 1")
تأكد_يساوي(ف("MixedCASE123abc"), 14, "حالة 2")
تأكد_يساوي(ف("Hello World 42"), 10, "حالة 3")
تأكد_يساوي(ف("aeiou AEIOU xyz"), 14, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
