# مثال 8790 — عدد الأصفار لمصفوفة قيمها (i+j) % 2
# Matrix zeros for cell formula (i+j) % 2
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8790-mat-chk-zeros.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [(ي + ك) % 2]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ع = 0
  لكل س في ق:
    لكل خ في س:
      لو خ == 0:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(بناء(1)), 1, "حجم 1")
تأكد_يساوي(ف(بناء(2)), 2, "حجم 2")
تأكد_يساوي(ف(بناء(3)), 5, "حجم 3")
تأكد_يساوي(ف(بناء(5)), 13, "حجم 5")
