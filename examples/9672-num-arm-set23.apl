# مثال 9672 — هل العدد أرمسترونغ (مجموعة اختبار 23)
# arm (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9672-num-arm-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(870), خطأ, "حالة 1")
تأكد_يساوي(ف(769), خطأ, "حالة 2")
تأكد_يساوي(ف(279), خطأ, "حالة 3")
تأكد_يساوي(ف(830), خطأ, "حالة 4")
تأكد_يساوي(ف(704), خطأ, "حالة 5")
