# مثال 9695 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 6)
# popcnt (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9695-num-popcnt-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(2652), 6, "حالة 1")
تأكد_يساوي(ف(4165), 4, "حالة 2")
تأكد_يساوي(ف(69), 3, "حالة 3")
تأكد_يساوي(ف(2170), 6, "حالة 4")
تأكد_يساوي(ف(1268), 6, "حالة 5")
