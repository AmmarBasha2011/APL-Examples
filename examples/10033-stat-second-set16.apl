# مثال 10033 — ثاني أكبر قيمة مختلفة (مجموعة 16)
# second (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10033-stat-second-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([-12, 18, 39, 21, 25, 11, 49, 26]), 39, "حالة 1")
تأكد_يساوي(ف([-11, 43, 47, -13, 46, 15, 52, 53]), 52, "حالة 2")
تأكد_يساوي(ف([35, 30, 31, 41, 7, 26, 7, 12, -16]), 35, "حالة 3")
تأكد_يساوي(ف([33, 15, 2, 43, 55, -3, 1, 10]), 43, "حالة 4")
