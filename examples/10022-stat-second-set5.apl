# مثال 10022 — ثاني أكبر قيمة مختلفة (مجموعة 5)
# second (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10022-stat-second-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([34, 14, 36, 38, -18, 25, 10]), 36, "حالة 1")
تأكد_يساوي(ف([23, 8, 23, 47, -7, 51, 6]), 47, "حالة 2")
تأكد_يساوي(ف([25, -18, 33, -17, 27, -2, -17, 43, 34]), 34, "حالة 3")
تأكد_يساوي(ف([42, 28, 30, -10, -15]), 30, "حالة 4")
