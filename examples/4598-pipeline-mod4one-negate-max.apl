# مثال 4598 — أكبر نتيجة سالبها للأعداد الباقي قسمتها على 4 يساوي 1
# Largest (or 0) of negated over the remainder 1 mod 4 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4598-pipeline-mod4one-negate-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 4 == 1:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), -9, "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), -1, "حالة 2")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), -25, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -1, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
