# مثال 10326 — تحويل 26 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 26 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10326-temp-c-26.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 26) * 9 // 5 + 32

تأكد_يساوي(ف(0), 78, "حالة 1")
تأكد_يساوي(ف(10), 96, "حالة 2")
تأكد_يساوي(ف(37), 145, "حالة 3")
تأكد_يساوي(ف(-5), 69, "حالة 4")
