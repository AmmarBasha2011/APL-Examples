# مثال 10029 — ثاني أكبر قيمة مختلفة (مجموعة 12)
# second (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10029-stat-second-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([56, 40, 15, 43, 4]), 43, "حالة 1")
تأكد_يساوي(ف([10, 22, 13, 1, 35, -13, -15, -19]), 22, "حالة 2")
تأكد_يساوي(ف([-18, 22, 40, 8, 48, -3]), 40, "حالة 3")
تأكد_يساوي(ف([46, 34, 35, 49]), 46, "حالة 4")
