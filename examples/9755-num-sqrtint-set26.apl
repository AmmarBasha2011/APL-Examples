# مثال 9755 — الجذر التربيعي الصحيح (مجموعة اختبار 26)
# sqrtint (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9755-num-sqrtint-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2038), 45, "حالة 1")
تأكد_يساوي(ف(4269), 65, "حالة 2")
تأكد_يساوي(ف(4330), 65, "حالة 3")
تأكد_يساوي(ف(4747), 68, "حالة 4")
تأكد_يساوي(ف(3432), 58, "حالة 5")
