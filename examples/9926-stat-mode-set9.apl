# مثال 9926 — المنوال (الأصغر عند التساوي) (مجموعة 9)
# mode (data set 9)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9926-stat-mode-set9.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([59, -18, 17, 49, -2, 4, 23, 15, 38]), -18, "حالة 1")
تأكد_يساوي(ف([13, -18, -7, 56, 13, 43]), 13, "حالة 2")
تأكد_يساوي(ف([-10, 16, -15, 15, 10, 14, 60, 55, -18]), -18, "حالة 3")
تأكد_يساوي(ف([27, 44, 14, -10]), -10, "حالة 4")
