# مثال 6753 — الأعداد التي لها 4 قواسم بالضبط
# Numbers up to n with exactly 4 divisors
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6753-exact-divisors-4.apl

# نعد القواسم لكل عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    ع = 0
    لكل د في range(1, ي + 1):
      لو ي % د == 0:
        ع = ع + 1
    لو ع == 4:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(10), [6, 8, 10], "حالة 1")
تأكد_يساوي(ف(30), [6, 8, 10, 14, 15, 21, 22, 26, 27], "حالة 2")
تأكد_يساوي(ف(60), [6, 8, 10, 14, 15, 21, 22, 26, 27, 33, 34, 35, 38, 39, 46, 51, 55, 57, 58], "حالة 3")
