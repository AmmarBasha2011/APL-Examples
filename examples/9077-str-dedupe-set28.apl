# مثال 9077 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 28)
# dedupe (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9077-str-dedupe-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("moon"), "mon", "حالة 1")
تأكد_يساوي(ف("noon"), "no", "حالة 2")
تأكد_يساوي(ف("river"), "rive", "حالة 3")
تأكد_يساوي(ف("rotor"), "rot", "حالة 4")
تأكد_يساوي(ف("kayak"), "kay", "حالة 5")
