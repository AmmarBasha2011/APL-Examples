# مثال 7432 — المجموع: من المكعبات نأخذ الأكبر من 5 ثم (ضعف)
# sum over cubes sequence, keep gt5, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7432-seq-cubes-gt5-double-sum.apl

# نولّد أول ن حد من: المكعبات
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = ي * ي * ي
    لو خ > 5:
      ر = ر + [خ * 2]
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 198, "حالة 3")
تأكد_يساوي(ف(10), 4048, "حالة 4")
تأكد_يساوي(ف(15), 22048, "حالة 5")
