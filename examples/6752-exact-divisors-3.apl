# مثال 6752 — الأعداد التي لها 3 قواسم بالضبط
# Numbers up to n with exactly 3 divisors
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6752-exact-divisors-3.apl

# نعد القواسم لكل عدد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    ع = 0
    لكل د في range(1, ي + 1):
      لو ي % د == 0:
        ع = ع + 1
    لو ع == 3:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(10), [4, 9], "حالة 1")
تأكد_يساوي(ف(30), [4, 9, 25], "حالة 2")
تأكد_يساوي(ف(60), [4, 9, 25, 49], "حالة 3")
