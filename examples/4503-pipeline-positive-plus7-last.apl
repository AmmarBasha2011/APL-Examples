# مثال 4503 — آخر نتيجة زائد 7 للأعداد الموجبة
# Last (or -1) of plus 7 over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4503-pipeline-positive-plus7-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ + 7]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 9, "حالة 1")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 49, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 12, "حالة 3")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 8, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
