# مثال 8510 — المجموع من المدى 20 إلى 2 بخطوة -2 بعد (ثلاثة أضعاف)
# sum over range(20,2,-2) mapped by triple
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8510-range-20-2-n2-triple-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [خ * 3]
    خ = خ + (-2)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 324, "المدى كله")
