# مثال 4645 — آخر موضع (رقم) في نص
# String: last position of digit
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4645-string-last-digit.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ر = 0
  ل = -1
  لكل خ في س:
    لو خ.isdigit():
      ل = ر
    ر = ر + 1
  ارجع ل

تأكد_يساوي(ف("MixedCASE123abc"), 11, "حالة 1")
تأكد_يساوي(ف("2026-11-28 launch"), 9, "حالة 2")
تأكد_يساوي(ف("ZZtop and the Beatles"), -1, "حالة 3")
تأكد_يساوي(ف("Data Science 101"), 15, "حالة 4")
تأكد_يساوي(ف(""), -1, "حالة 5")
