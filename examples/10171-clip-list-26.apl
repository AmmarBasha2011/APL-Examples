# مثال 10171 — قص كل عنصر عند 26
# Clip every item at 26
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10171-clip-list-26.apl

# نأخذ الأصغر بين العنصر والحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [min(خ, 26)]
  ارجع ر

تأكد_يساوي(ف([0, 5, 10, 15, 20, 25, 30, 35]), [0, 5, 10, 15, 20, 25, 26, 26], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([26, 27, 25]), [26, 26, 25], "حالة 3")
