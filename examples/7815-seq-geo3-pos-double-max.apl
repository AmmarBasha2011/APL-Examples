# مثال 7815 — أكبر قيمة: من قوى 3 نأخذ الموجب ثم (ضعف)
# max over geo3 sequence, keep pos, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7815-seq-geo3-pos-double-max.apl

# نولّد أول ن حد من: قوى 3
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 3 ** ي
    لو خ > 0:
      ر = ر + [خ * 2]
  لو len(ر) == 0:
    ارجع 0
  ارجع max(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(5), 162, "حالة 3")
تأكد_يساوي(ف(10), 39366, "حالة 4")
تأكد_يساوي(ف(15), 9565938, "حالة 5")
