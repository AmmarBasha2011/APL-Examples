# مثال 9751 — الجذر التربيعي الصحيح (مجموعة اختبار 22)
# sqrtint (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9751-num-sqrtint-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(2536), 50, "حالة 1")
تأكد_يساوي(ف(3665), 60, "حالة 2")
تأكد_يساوي(ف(675), 25, "حالة 3")
تأكد_يساوي(ف(2140), 46, "حالة 4")
تأكد_يساوي(ف(3702), 60, "حالة 5")
