# مثال 4820 — سعر بعد خصم 15%
# Price after 15 percent discount
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4820-discount-15.apl

# السعر × (100 - الخصم) ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س * (100 - 15) // 100

تأكد_يساوي(ف(100), 85, "حالة 1")
تأكد_يساوي(ف(250), 212, "حالة 2")
تأكد_يساوي(ف(999), 849, "حالة 3")
تأكد_يساوي(ف(40), 34, "حالة 4")
