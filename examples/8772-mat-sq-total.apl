# مثال 8772 — مجموع كل الخانات لمصفوفة قيمها i*i+j
# Matrix total for cell formula i*i+j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8772-mat-sq-total.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي + ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  م = 0
  لكل س في ق:
    لكل خ في س:
      م = م + خ
  ارجع م

تأكد_يساوي(ف(بناء(1)), 0, "حجم 1")
تأكد_يساوي(ف(بناء(2)), 4, "حجم 2")
تأكد_يساوي(ف(بناء(3)), 24, "حجم 3")
تأكد_يساوي(ف(بناء(5)), 200, "حجم 5")
