# مثال 5191 — مقارنة العدد مع 5
# Compare number with 5
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5191-triple-compare-5.apl

# نرجع نصاً: اصغر او اكبر او يساوي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو ن < 5:
    ارجع "اصغر"
  والا_لو ن > 5:
    ارجع "اكبر"
  ارجع "يساوي"

تأكد_يساوي(ف(4), "اصغر", "حالة 1")
تأكد_يساوي(ف(5), "يساوي", "حالة 2")
تأكد_يساوي(ف(6), "اكبر", "حالة 3")
تأكد_يساوي(ف(0), "اصغر", "حالة 4")
