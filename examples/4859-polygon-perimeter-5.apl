# مثال 4859 — محيط مضلع منتظم عدد أضلاعه 5
# Perimeter of regular 5-gon
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4859-polygon-perimeter-5.apl

# المحيط = عدد الأضلاع × طول الضلع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ض):
  ارجع 5 * ض

تأكد_يساوي(ف(1), 5, "حالة 1")
تأكد_يساوي(ف(5), 25, "حالة 2")
تأكد_يساوي(ف(12), 60, "حالة 3")
تأكد_يساوي(ف(7), 35, "حالة 4")
