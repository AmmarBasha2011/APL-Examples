# مثال 4847 — مبلغ بعد فائدة مركبة 15%
# Compound balance at 15 percent (integer)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4847-compound-15.apl

# كل سنة نضيف الفائدة على الرصيد
# القسمة صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  لكل ي في range(س):
    م = م + م * 15 // 100
  ارجع م

تأكد_يساوي(ف(1000, 1), 1150, "حالة 1")
تأكد_يساوي(ف(1000, 5), 2010, "حالة 2")
تأكد_يساوي(ف(500, 3), 760, "حالة 3")
تأكد_يساوي(ف(20000, 2), 26450, "حالة 4")
