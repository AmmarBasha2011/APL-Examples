# مثال 8166 — آخر عنصر من المدى 1 إلى 30 بخطوة 2 بعد (ضعف)
# last over range(1,30,2) mapped by double
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8166-range-1-30-2-double-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 1
  طالما خ < 30:
    ر = ر + [خ * 2]
    خ = خ + (2)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 58, "المدى كله")
