# مثال 4792 — مجموع القطر العكسي
# anti-diagonal sum
# Demonstrates: مصفوفات وقوائم متداخلة
#
# Run:  python apl.py examples/4792-matrix-anti-diag.apl

# المصفوفة قائمة من القوائم
# كل قائمة صغيرة هي صف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ج = 0
  ع = len(م[0])
  لكل ر في range(min(len(م), ع)):
    ج = ج + م[ر][ع - 1 - ر]
  ارجع ج

تأكد_يساوي(ف([[1, 2], [3, 4]]), 5, "حالة 1")
تأكد_يساوي(ف([[5, 0, 2], [1, 9, 3], [4, 4, 4]]), 15, "حالة 2")
تأكد_يساوي(ف([[2, -1, 7], [0, 3, -5]]), 10, "حالة 3")
تأكد_يساوي(ف([[1], [2], [3]]), 1, "حالة 4")
تأكد_يساوي(ف([[6, 5, 4, 3], [2, 1, 0, -1]]), 3, "حالة 5")
