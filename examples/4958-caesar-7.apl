# مثال 4958 — شيفرة قيصر بإزاحة 7
# Caesar cipher shift 7
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4958-caesar-7.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 7) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "hij", "حالة 1")
تأكد_يساوي(ف("hello world"), "olssv dvysk", "حالة 2")
تأكد_يساوي(ف("xyz"), "efg", "حالة 3")
تأكد_يساوي(ف("a b-c"), "h i-j", "حالة 4")
