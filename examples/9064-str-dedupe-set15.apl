# مثال 9064 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 15)
# dedupe (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9064-str-dedupe-set15.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("apple"), "aple", "حالة 1")
تأكد_يساوي(ف("river"), "rive", "حالة 2")
تأكد_يساوي(ف("tenet"), "ten", "حالة 3")
تأكد_يساوي(ف("moon"), "mon", "حالة 4")
تأكد_يساوي(ف("loop"), "lop", "حالة 5")
