# مثال 9810 — إزاحة لليسار 9 خانات
# Shift left by 9
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9810-bits-shl-9.apl

# الإزاحة لليسار تضرب في 2 أس k

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن << 9

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 512, "حالة 2")
تأكد_يساوي(ف(5), 2560, "حالة 3")
تأكد_يساوي(ف(100), 51200, "حالة 4")
