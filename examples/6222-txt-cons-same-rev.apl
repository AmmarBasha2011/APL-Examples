# مثال 6222 — الناتج معكوس بعد أخذ الحروف الساكنة وتحويلها إلى (كما هو)
# rev of same applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6222-txt-cons-same-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "dlrwllh", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "nfslp", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "cb", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "xfnwrbkcqht", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "xxxyyyzzz", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "cncstd", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "cbrngnmmrgrp", "حالة 8")
