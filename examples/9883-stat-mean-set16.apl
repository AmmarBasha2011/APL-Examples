# مثال 9883 — المتوسط الصحيح (مجموعة 16)
# mean (data set 16)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9883-stat-mean-set16.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([18, 12, 33, 28, -13]), 15, "حالة 1")
تأكد_يساوي(ف([12, -15, 7]), 1, "حالة 2")
تأكد_يساوي(ف([46, 10, -7, -14, -19, 4, 24, 51]), 11, "حالة 3")
تأكد_يساوي(ف([31, 60, 36, 34, 20, 26, 15, 44]), 33, "حالة 4")
