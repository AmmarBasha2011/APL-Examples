# مثال 9591 — الجذر الرقمي (مجموعة اختبار 22)
# droot (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9591-num-droot-set22.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(38473), 7, "حالة 1")
تأكد_يساوي(ف(65232), 9, "حالة 2")
تأكد_يساوي(ف(36442), 1, "حالة 3")
تأكد_يساوي(ف(5371), 7, "حالة 4")
تأكد_يساوي(ف(63465), 6, "حالة 5")
