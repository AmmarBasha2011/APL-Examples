# مثال 10075 — قص كل عنصر عند 2
# Clip every item at 2
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10075-clip-list-2.apl

# نأخذ الأصغر بين العنصر والحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [min(خ, 2)]
  ارجع ر

تأكد_يساوي(ف([0, 5, 10, 15, 20, 25, 30, 35]), [0, 2, 2, 2, 2, 2, 2, 2], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([2, 3, 1]), [2, 2, 1], "حالة 3")
