# مثال 10199 — شريط بعرض 4 من الرمز -
# Bar of width 4 using -
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10199-bar-4-45.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "-"
  ارجع ر + "|" + str(4)

تأكد_يساوي(ف(0), "|4", "حالة 1")
تأكد_يساوي(ف(3), "---|4", "حالة 2")
تأكد_يساوي(ف(4), "----|4", "حالة 3")
