# مثال 6635 — الأعداد التي باقيها 4 عند القسمة على 5
# Numbers with remainder 4 mod 5
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6635-residue-5-4.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 5 == 4:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [4, 9], "حالة 2")
تأكد_يساوي(ف(40), [4, 9, 14, 19, 24, 29, 34, 39], "حالة 3")
تأكد_يساوي(ف(75), [4, 9, 14, 19, 24, 29, 34, 39, 44, 49, 54, 59, 64, 69, 74], "حالة 4")
