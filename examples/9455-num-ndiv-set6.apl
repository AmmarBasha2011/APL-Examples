# مثال 9455 — عدد القواسم (مجموعة اختبار 6)
# ndiv (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9455-num-ndiv-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(20), 6, "حالة 1")
تأكد_يساوي(ف(50), 6, "حالة 2")
تأكد_يساوي(ف(86), 4, "حالة 3")
تأكد_يساوي(ف(35), 4, "حالة 4")
تأكد_يساوي(ف(177), 4, "حالة 5")
