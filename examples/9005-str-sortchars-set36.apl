# مثال 9005 — حروف الكلمة مرتبة (مجموعة اختبار 36)
# sortchars (test set 36)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9005-str-sortchars-set36.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("refer"), "eefrr", "حالة 1")
تأكد_يساوي(ف("mars"), "amrs", "حالة 2")
تأكد_يساوي(ف("racecar"), "aaccerr", "حالة 3")
تأكد_يساوي(ف("star"), "arst", "حالة 4")
تأكد_يساوي(ف("loop"), "loop", "حالة 5")
