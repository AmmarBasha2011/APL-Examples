# مثال 5328 — ضرب كل عنصر في 19
# Scale list by 19
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5328-scale-list-19.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 19]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [19, 38, 57], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -76, 190], "حالة 3")
