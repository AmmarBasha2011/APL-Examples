# مثال 7858 — العدد: من عكسية نأخذ الأصغر من 20 ثم (ضعف)
# count over rev sequence, keep lt20, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7858-seq-rev-lt20-double-count.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ < 20:
      ر = ر + [خ * 2]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 4, "حالة 3")
تأكد_يساوي(ف(10), 9, "حالة 4")
تأكد_يساوي(ف(15), 14, "حالة 5")
