# مثال 9179 — عكس حالة الأحرف (مجموعة اختبار 10)
# swapcase (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9179-str-swapcase-set10.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح == ح.upper():
      ر = ر + ح.lower()
    والا:
      ر = ر + ح.upper()
  ارجع ر

تأكد_يساوي(ف("google"), "GOOGLE", "حالة 1")
تأكد_يساوي(ف("mars"), "MARS", "حالة 2")
تأكد_يساوي(ف("level"), "LEVEL", "حالة 3")
تأكد_يساوي(ف("racecar"), "RACECAR", "حالة 4")
تأكد_يساوي(ف("data"), "DATA", "حالة 5")
