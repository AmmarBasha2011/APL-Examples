# مثال 9653 — هل العدد أرمسترونغ (مجموعة اختبار 4)
# arm (test set 4)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9653-num-arm-set4.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(655), خطأ, "حالة 1")
تأكد_يساوي(ف(115), خطأ, "حالة 2")
تأكد_يساوي(ف(26), خطأ, "حالة 3")
تأكد_يساوي(ف(760), خطأ, "حالة 4")
تأكد_يساوي(ف(282), خطأ, "حالة 5")
