# مثال 9608 — الجذر الرقمي (مجموعة اختبار 39)
# droot (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9608-num-droot-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(14904), 9, "حالة 1")
تأكد_يساوي(ف(23191), 7, "حالة 2")
تأكد_يساوي(ف(98368), 7, "حالة 3")
تأكد_يساوي(ف(65498), 5, "حالة 4")
تأكد_يساوي(ف(39470), 5, "حالة 5")
