# مثال 8037 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 14
# longest for sentence 14
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8037-sent13-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("nile river nile delta river"), "river", "حالة 1")
تأكد_يساوي(ف("sun sand sea sun sand sun"), "sand", "حالة 2")
تأكد_يساوي(ف("the cat and the dog and the bird"), "bird", "حالة 3")
