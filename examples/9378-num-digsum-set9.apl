# مثال 9378 — مجموع الأرقام (مجموعة اختبار 9)
# digsum (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9378-num-digsum-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(50860), 19, "حالة 1")
تأكد_يساوي(ف(78663), 30, "حالة 2")
تأكد_يساوي(ف(32474), 20, "حالة 3")
تأكد_يساوي(ف(53930), 20, "حالة 4")
تأكد_يساوي(ف(63184), 22, "حالة 5")
