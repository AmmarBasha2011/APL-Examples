# مثال 9604 — الجذر الرقمي (مجموعة اختبار 35)
# droot (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9604-num-droot-set35.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(53873), 8, "حالة 1")
تأكد_يساوي(ف(89114), 5, "حالة 2")
تأكد_يساوي(ف(68853), 3, "حالة 3")
تأكد_يساوي(ف(2021), 5, "حالة 4")
تأكد_يساوي(ف(78273), 9, "حالة 5")
