# مثال 6817 — عدد حلول 2س + 7ص = 27
# Count solutions of 2x+7y=27
# Demonstrates: خوارزميات متنوعة
#
# Run:  python apl.py examples/6817-pairs-2x-7y-27.apl

# حلقتان متداخلتان على الأعداد غير السالبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل س في range(ن + 1):
    لكل ص في range(ن + 1):
      لو 2 * س + 7 * ص == 27:
        ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 1, "حالة 2")
تأكد_يساوي(ف(10), 2, "حالة 3")
تأكد_يساوي(ف(27), 2, "حالة 4")
