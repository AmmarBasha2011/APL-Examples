# مثال 6710 — الأعداد التي باقيها 15 عند القسمة على 20
# Numbers with remainder 15 mod 20
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6710-residue-20-15.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 20 == 15:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [], "حالة 2")
تأكد_يساوي(ف(40), [15, 35], "حالة 3")
تأكد_يساوي(ف(75), [15, 35, 55], "حالة 4")
