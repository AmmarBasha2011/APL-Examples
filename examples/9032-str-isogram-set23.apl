# مثال 9032 — هل لا يتكرر أي حرف (مجموعة اختبار 23)
# isogram (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9032-str-isogram-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = {}
  لكل ح في ن:
    لو ح في ر:
      ارجع خطأ
    ر[ح] = 1
  ارجع صواب

تأكد_يساوي(ف("venus"), صواب, "حالة 1")
تأكد_يساوي(ف("rotor"), خطأ, "حالة 2")
تأكد_يساوي(ف("saturn"), صواب, "حالة 3")
تأكد_يساوي(ف("code"), صواب, "حالة 4")
تأكد_يساوي(ف("tenet"), خطأ, "حالة 5")
