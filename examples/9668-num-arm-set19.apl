# مثال 9668 — هل العدد أرمسترونغ (مجموعة اختبار 19)
# arm (test set 19)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9668-num-arm-set19.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(638), خطأ, "حالة 1")
تأكد_يساوي(ف(507), خطأ, "حالة 2")
تأكد_يساوي(ف(927), خطأ, "حالة 3")
تأكد_يساوي(ف(173), خطأ, "حالة 4")
تأكد_يساوي(ف(994), خطأ, "حالة 5")
