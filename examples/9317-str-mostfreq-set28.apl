# مثال 9317 — الحرف الأكثر تكراراً (الأول عند التساوي) (مجموعة اختبار 28)
# mostfreq (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9317-str-mostfreq-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ح في ن:
    د[ح] = د.get(ح, 0) + 1
  ب = ن[0]
  لكل ح في ن:
    لو د[ح] > د[ب]:
      ب = ح
  ارجع ب

تأكد_يساوي(ف("earth"), "e", "حالة 1")
تأكد_يساوي(ف("level"), "l", "حالة 2")
تأكد_يساوي(ف("stats"), "s", "حالة 3")
تأكد_يساوي(ف("code"), "c", "حالة 4")
تأكد_يساوي(ف("apple"), "p", "حالة 5")
