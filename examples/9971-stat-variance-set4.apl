# مثال 9971 — التباين الصحيح (مجموعة 4)
# variance (data set 4)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9971-stat-variance-set4.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([4, 49, 25, 39, -14, 44, 7]), 479, "حالة 1")
تأكد_يساوي(ف([8, 16, 42, 7, 22, 36, -11]), 282, "حالة 2")
تأكد_يساوي(ف([4, 0, -9, 36, 48]), 490, "حالة 3")
تأكد_يساوي(ف([4, 40, 21, 10, 31]), 174, "حالة 4")
