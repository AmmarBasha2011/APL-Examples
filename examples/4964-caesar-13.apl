# مثال 4964 — شيفرة قيصر بإزاحة 13
# Caesar cipher shift 13
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4964-caesar-13.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 13) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "nop", "حالة 1")
تأكد_يساوي(ف("hello world"), "uryyb jbeyq", "حالة 2")
تأكد_يساوي(ف("xyz"), "klm", "حالة 3")
تأكد_يساوي(ف("a b-c"), "n o-p", "حالة 4")
