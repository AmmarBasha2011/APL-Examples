# مثال 9086 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 37)
# dedupe (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9086-str-dedupe-set37.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("radar"), "rad", "حالة 1")
تأكد_يساوي(ف("data"), "dat", "حالة 2")
تأكد_يساوي(ف("earth"), "earth", "حالة 3")
تأكد_يساوي(ف("planet"), "planet", "حالة 4")
تأكد_يساوي(ف("river"), "rive", "حالة 5")
