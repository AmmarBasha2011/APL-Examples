# مثال 9611 — الأصفار في نهاية العاملي (مجموعة اختبار 2)
# tzeros (test set 2)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9611-num-tzeros-set2.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(346), 84, "حالة 1")
تأكد_يساوي(ف(22), 4, "حالة 2")
تأكد_يساوي(ف(401), 99, "حالة 3")
تأكد_يساوي(ف(458), 112, "حالة 4")
تأكد_يساوي(ف(266), 65, "حالة 5")
