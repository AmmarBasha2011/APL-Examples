# مثال 4629 — ترتيب نتيجة ناقص 3 للأعداد الغير الصفرية
# Sorted list of minus 3 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4629-pipeline-notzero-minus3-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ - 3]
  ارجع sorted(ن)

تأكد_يساوي(ف([9, 0, 0, 4, 16]), [1, 6, 13], "حالة 1")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), [-7, 4, 6, 9, 12], "حالة 2")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [-12, 2, 3, 5, 9, 14, 27], "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [-8, -1, -1, 7, 22], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
