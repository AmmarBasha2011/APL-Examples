# مثال 7982 — تكرار كل كلمة في الجملة رقم 9
# freq for sentence 9
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7982-sent8-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("a b c a b a"), {"a": 3, "b": 2, "c": 1}, "حالة 1")
تأكد_يساوي(ف("up down up down up up down"), {"up": 4, "down": 3}, "حالة 2")
تأكد_يساوي(ف("stars and moon and stars again"), {"stars": 2, "and": 2, "moon": 1, "again": 1}, "حالة 3")
