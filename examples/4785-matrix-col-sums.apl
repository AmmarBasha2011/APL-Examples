# مثال 4785 — مجموع كل عمود
# sum of each column
# Demonstrates: مصفوفات وقوائم متداخلة
#
# Run:  python apl.py examples/4785-matrix-col-sums.apl

# المصفوفة قائمة من القوائم
# كل قائمة صغيرة هي صف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م):
  ن = []
  لكل ع في range(len(م[0])):
    ج = 0
    لكل ص في م:
      ج = ج + ص[ع]
    ن = ن + [ج]
  ارجع ن

تأكد_يساوي(ف([[1, 2], [3, 4]]), [4, 6], "حالة 1")
تأكد_يساوي(ف([[5, 0, 2], [1, 9, 3], [4, 4, 4]]), [10, 13, 9], "حالة 2")
تأكد_يساوي(ف([[2, -1, 7], [0, 3, -5]]), [2, 2, 2], "حالة 3")
تأكد_يساوي(ف([[1], [2], [3]]), [6], "حالة 4")
تأكد_يساوي(ف([[6, 5, 4, 3], [2, 1, 0, -1]]), [8, 6, 4, 2], "حالة 5")
