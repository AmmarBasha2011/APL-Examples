# مثال 5108 — ملء النص من اليسار حتى عرض 5
# Left pad to width 5
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5108-pad-left-5.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 5:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "00007", "حالة 1")
تأكد_يساوي(ف("123"), "00123", "حالة 2")
تأكد_يساوي(ف("11111"), "11111", "حالة 3")
تأكد_يساوي(ف(""), "00000", "حالة 4")
