# مثال 10039 — ثاني أكبر قيمة مختلفة (مجموعة 22)
# second (data set 22)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10039-stat-second-set22.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)[::-1]
  لكل خ في س:
    لو خ != س[0]:
      ارجع خ
  ارجع -1

تأكد_يساوي(ف([20, 12, 20, 12, 16, 35, -20]), 20, "حالة 1")
تأكد_يساوي(ف([41, 42, 41, 42, -14, -13, -20, 12, -5]), 41, "حالة 2")
تأكد_يساوي(ف([-15, 52, 37]), 37, "حالة 3")
تأكد_يساوي(ف([53, 16, 52, 32, 50]), 52, "حالة 4")
