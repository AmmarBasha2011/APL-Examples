# مثال 4903 — اليوم بعد 7 أيام
# Weekday 7 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4903-week-day-shift-7.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 7) % 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(3), 3, "حالة 2")
تأكد_يساوي(ف(6), 6, "حالة 3")
تأكد_يساوي(ف(4), 4, "حالة 4")
