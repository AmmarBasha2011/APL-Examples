# مثال 6774 — مولّد أرقام عشوائية خطي (8,3,23)
# LCG a=8 c=3 m=23
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6774-lcg-8-3-23.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (8 * س + 3) % 23
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [11, 22, 18, 9, 6], "حالة 1")
تأكد_يساوي(ف(0, 8), [3, 4, 12, 7, 13, 15, 8, 21], "حالة 2")
تأكد_يساوي(ف(7, 10), [13, 15, 8, 21, 10, 14, 0, 3, 4, 12], "حالة 3")
