# مثال 9792 — آخر 5 خانات ثنائية
# Low 5 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9792-bits-low-5.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 31

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 31, "حالة 2")
تأكد_يساوي(ف(1000), 8, "حالة 3")
تأكد_يساوي(ف(12345), 25, "حالة 4")
