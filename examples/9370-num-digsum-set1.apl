# مثال 9370 — مجموع الأرقام (مجموعة اختبار 1)
# digsum (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9370-num-digsum-set1.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(75211), 16, "حالة 1")
تأكد_يساوي(ف(10560), 12, "حالة 2")
تأكد_يساوي(ف(63574), 25, "حالة 3")
تأكد_يساوي(ف(99905), 32, "حالة 4")
تأكد_يساوي(ف(34291), 19, "حالة 5")
