# مثال 10289 — تحويل وحدة إلى 28 وحدات صغرى والعكس
# Convert units with factor 28
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10289-unit-scale-28.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 28, ن // 28, ن % 28]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [28, 0, 1], "حالة 2")
تأكد_يساوي(ف(28), [784, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [28000, 35, 20], "حالة 4")
