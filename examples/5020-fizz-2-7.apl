# مثال 5020 — فيزباز بالعددين 2 و 7
# FizzBuzz variant with 2 and 7
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5020-fizz-2-7.apl

# A للقابل على الأول، B للثاني، AB للاثنين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    لو ي % 2 == 0 و ي % 7 == 0:
      ر = ر + ["AB"]
    والا_لو ي % 2 == 0:
      ر = ر + ["A"]
    والا_لو ي % 7 == 0:
      ر = ر + ["B"]
    والا:
      ر = ر + [str(ي)]
  ارجع ر

تأكد_يساوي(ف(1), ["1"], "حالة 1")
تأكد_يساوي(ف(10), ["1", "A", "3", "A", "5", "A", "B", "A", "9", "A"], "حالة 2")
تأكد_يساوي(ف(30), ["1", "A", "3", "A", "5", "A", "B", "A", "9", "A", "11", "A", "13", "AB", "15", "A", "17", "A", "19", "A", "B", "A", "23", "A", "25", "A", "27", "AB", "29", "A"], "حالة 3")
تأكد_يساوي(ف(0), [], "حالة 4")
