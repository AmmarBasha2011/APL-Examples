# مثال 6740 — القوة بالباقي على 31
# Modular power mod 31
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6740-modpow-31.apl

# نضرب ونأخذ الباقي في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ب, أ):
  ر = 1
  لكل ي في range(أ):
    ر = ر * ب % 31
  ارجع ر

تأكد_يساوي(ف(2, 0), 1, "حالة 1")
تأكد_يساوي(ف(2, 10), 1, "حالة 2")
تأكد_يساوي(ف(3, 7), 17, "حالة 3")
تأكد_يساوي(ف(7, 13), 19, "حالة 4")
تأكد_يساوي(ف(10, 20), 25, "حالة 5")
