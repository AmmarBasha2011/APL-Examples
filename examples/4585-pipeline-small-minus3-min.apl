# مثال 4585 — أصغر نتيجة ناقص 3 للأعداد الأقل من 5
# Smallest (or 0) of minus 3 over the below 5 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4585-pipeline-small-minus3-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ < 5:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), -12, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), -2, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), -2, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), -3, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
