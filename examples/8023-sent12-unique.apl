# مثال 8023 — عدد الكلمات المختلفة في الجملة رقم 13
# unique for sentence 13
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8023-sent12-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("cairo is big and cairo is old"), 5, "حالة 1")
تأكد_يساوي(ف("stars and moon and stars again"), 4, "حالة 2")
تأكد_يساوي(ف("yes no yes yes no maybe"), 3, "حالة 3")
