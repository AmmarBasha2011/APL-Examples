# مثال 8042 — تكرار كل كلمة في الجملة رقم 15
# freq for sentence 15
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8042-sent14-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("learn code learn more code more"), {"learn": 2, "code": 2, "more": 2}, "حالة 1")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), {"bread": 3, "milk": 2, "eggs": 1}, "حالة 2")
تأكد_يساوي(ف("to be or not to be"), {"to": 2, "be": 2, "or": 1, "not": 1}, "حالة 3")
