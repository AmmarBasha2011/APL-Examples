# مثال 6771 — مولّد أرقام عشوائية خطي (4,1,9)
# LCG a=4 c=1 m=9
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6771-lcg-4-1-9.apl

# س = (أ × س + ج) % م
# النتيجة محتومة لأن البذرة ثابتة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س, ن):
  ر = []
  لكل ي في range(ن):
    س = (4 * س + 1) % 9
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(1, 5), [5, 3, 4, 8, 6], "حالة 1")
تأكد_يساوي(ف(0, 8), [1, 5, 3, 4, 8, 6, 7, 2], "حالة 2")
تأكد_يساوي(ف(7, 10), [2, 0, 1, 5, 3, 4, 8, 6, 7, 2], "حالة 3")
