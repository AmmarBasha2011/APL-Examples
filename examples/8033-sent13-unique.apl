# مثال 8033 — عدد الكلمات المختلفة في الجملة رقم 14
# unique for sentence 14
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8033-sent13-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("nile river nile delta river"), 3, "حالة 1")
تأكد_يساوي(ف("sun sand sea sun sand sun"), 3, "حالة 2")
تأكد_يساوي(ف("the cat and the dog and the bird"), 5, "حالة 3")
