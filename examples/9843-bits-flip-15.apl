# مثال 9843 — قلب الخانة رقم 15
# Flip bit 15
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9843-bits-flip-15.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 15)

تأكد_يساوي(ف(0), 32768, "حالة 1")
تأكد_يساوي(ف(255), 33023, "حالة 2")
تأكد_يساوي(ف(1000), 33768, "حالة 3")
تأكد_يساوي(ف(12345), 45113, "حالة 4")
