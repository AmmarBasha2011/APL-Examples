# مثال 8696 — المجموع من المدى 2 إلى 26 بخطوة 3 بعد (ناقص 3)
# sum over range(2,26,3) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8696-range-2-26-3-dec3-sum.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [خ - 3]
    خ = خ + (3)
  م = 0
  لكل ع في ر:
    م = م + ع
  ارجع م

تأكد_يساوي(ف(), 76, "المدى كله")
