# مثال 10227 — شريط بعرض 9 من الرمز +
# Bar of width 9 using +
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10227-bar-9-43.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "+"
  ارجع ر + "|" + str(9)

تأكد_يساوي(ف(0), "|9", "حالة 1")
تأكد_يساوي(ف(3), "+++|9", "حالة 2")
تأكد_يساوي(ف(9), "+++++++++|9", "حالة 3")
