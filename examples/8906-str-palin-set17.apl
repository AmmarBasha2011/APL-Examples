# مثال 8906 — هل الكلمة متناظرة (مجموعة اختبار 17)
# palin (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8906-str-palin-set17.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("bob"), صواب, "حالة 1")
تأكد_يساوي(ف("array"), خطأ, "حالة 2")
تأكد_يساوي(ف("code"), خطأ, "حالة 3")
تأكد_يساوي(ف("rotor"), صواب, "حالة 4")
تأكد_يساوي(ف("moon"), خطأ, "حالة 5")
