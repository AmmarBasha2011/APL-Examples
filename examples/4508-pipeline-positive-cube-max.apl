# مثال 4508 — أكبر نتيجة مكعبها للأعداد الموجبة
# Largest (or 0) of cube over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4508-pipeline-positive-cube-max.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ * خ * خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع max(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 74088, "حالة 1")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), 512, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 2197, "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 15625, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
