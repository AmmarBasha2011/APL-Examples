# مثال 4687 — قائمة الأعداد التقبل القسمة على 3 أو 5 حتى حد معين
# Numbers up to a limit: list of the divisible by 3 or 5 ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4687-numbers-list-div3or5.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو ر % 3 == 0 أو ر % 5 == 0:
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(28), [3, 5, 6, 9, 10, 12, 15, 18, 20, 21, 24, 25, 27], "حالة 1")
تأكد_يساوي(ف(43), [3, 5, 6, 9, 10, 12, 15, 18, 20, 21, 24, 25, 27, 30, 33, 35, 36, 39, 40, 42], "حالة 2")
تأكد_يساوي(ف(97), [3, 5, 6, 9, 10, 12, 15, 18, 20, 21, 24, 25, 27, 30, 33, 35, 36, 39, 40, 42, 45, 48, 50, 51, 54, 55, 57, 60, 63, 65, 66, 69, 70, 72, 75, 78, 80, 81, 84, 85, 87, 90, 93, 95, 96], "حالة 3")
تأكد_يساوي(ف(1), [], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
