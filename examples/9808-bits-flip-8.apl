# مثال 9808 — قلب الخانة رقم 8
# Flip bit 8
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9808-bits-flip-8.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 8)

تأكد_يساوي(ف(0), 256, "حالة 1")
تأكد_يساوي(ف(255), 511, "حالة 2")
تأكد_يساوي(ف(1000), 744, "حالة 3")
تأكد_يساوي(ف(12345), 12601, "حالة 4")
