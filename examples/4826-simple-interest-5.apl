# مثال 4826 — فائدة بسيطة بنسبة 5%
# Simple interest at 5 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4826-simple-interest-5.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 5 * س // 100

تأكد_يساوي(ف(1000, 1), 50, "حالة 1")
تأكد_يساوي(ف(2500, 3), 375, "حالة 2")
تأكد_يساوي(ف(100, 10), 50, "حالة 3")
تأكد_يساوي(ف(8000, 2), 800, "حالة 4")
