# مثال 9847 — آخر 16 خانات ثنائية
# Low 16 bits
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9847-bits-low-16.apl

# نستخدم القناع AND

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن & 65535

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(255), 255, "حالة 2")
تأكد_يساوي(ف(1000), 1000, "حالة 3")
تأكد_يساوي(ف(12345), 12345, "حالة 4")
