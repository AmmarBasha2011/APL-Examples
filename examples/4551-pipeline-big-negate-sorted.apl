# مثال 4551 — ترتيب نتيجة سالبها للأعداد الأكبر من 10
# Sorted list of negated over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4551-pipeline-big-negate-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [0 - خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), [-25], "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [-30, -17, -12], "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), [], "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), [-16], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
