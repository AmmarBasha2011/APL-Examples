# مثال 10297 — تحويل وحدة إلى 36 وحدات صغرى والعكس
# Convert units with factor 36
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10297-unit-scale-36.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 36, ن // 36, ن % 36]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [36, 0, 1], "حالة 2")
تأكد_يساوي(ف(36), [1296, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [36000, 27, 28], "حالة 4")
