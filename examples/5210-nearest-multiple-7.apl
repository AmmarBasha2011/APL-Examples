# مثال 5210 — أقرب مضاعف للعدد 7
# Nearest multiple of 7
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5210-nearest-multiple-7.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 7
  لو ب * 2 < 7:
    ارجع ن - ب
  ارجع ن - ب + 7

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 7, "حالة 2")
تأكد_يساوي(ف(13), 14, "حالة 3")
تأكد_يساوي(ف(100), 98, "حالة 4")
تأكد_يساوي(ف(8), 7, "حالة 5")
