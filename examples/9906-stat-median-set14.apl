# مثال 9906 — الوسيط (بعد الترتيب) (مجموعة 14)
# median (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9906-stat-median-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([46, 50, 41, -1, 50, 33, -8, 35, 5]), 35, "حالة 1")
تأكد_يساوي(ف([-9, 47, 28, 4, 8, 13, -2]), 8, "حالة 2")
تأكد_يساوي(ف([54, -4, 3, 51, 40, -15, 2]), 3, "حالة 3")
تأكد_يساوي(ف([54, 55, 59, -18, 25, 5, -2, 25, -15]), 25, "حالة 4")
