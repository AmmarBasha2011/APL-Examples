# مثال 9875 — المتوسط الصحيح (مجموعة 8)
# mean (data set 8)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9875-stat-mean-set8.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([34, -9, 42, 15]), 20, "حالة 1")
تأكد_يساوي(ف([9, 25, 50, 37, 56, -12, -16]), 21, "حالة 2")
تأكد_يساوي(ف([14, 60, -10, 12, 60, 2, 33, 43, 11]), 25, "حالة 3")
تأكد_يساوي(ف([24, -7, 14]), 10, "حالة 4")
