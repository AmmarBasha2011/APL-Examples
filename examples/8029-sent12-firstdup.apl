# مثال 8029 — أول كلمة تتكرر في الجملة رقم 13
# firstdup for sentence 13
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8029-sent12-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("cairo is big and cairo is old"), "cairo", "حالة 1")
تأكد_يساوي(ف("stars and moon and stars again"), "and", "حالة 2")
تأكد_يساوي(ف("yes no yes yes no maybe"), "yes", "حالة 3")
