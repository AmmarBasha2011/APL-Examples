# مثال 8903 — هل الكلمة متناظرة (مجموعة اختبار 14)
# palin (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8903-str-palin-set14.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("refer"), صواب, "حالة 1")
تأكد_يساوي(ف("google"), خطأ, "حالة 2")
تأكد_يساوي(ف("moon"), خطأ, "حالة 3")
تأكد_يساوي(ف("rotor"), صواب, "حالة 4")
تأكد_يساوي(ف("python"), خطأ, "حالة 5")
