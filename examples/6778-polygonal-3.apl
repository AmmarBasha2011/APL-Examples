# مثال 6778 — العدد المضلّع ذو 3 أضلاع
# 3-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6778-polygonal-3.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((3 - 2) * ن * ن - (3 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 3, "حالة 2")
تأكد_يساوي(ف(5), 15, "حالة 3")
تأكد_يساوي(ف(10), 55, "حالة 4")
