# مثال 8097 — أطول كلمة (الأولى عند التساوي) في الجملة رقم 20
# longest for sentence 20
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8097-sent19-longest.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    لو len(ك) > len(ر):
      ر = ك
  ارجع ر

تأكد_يساوي(ف("yes no yes yes no maybe"), "maybe", "حالة 1")
تأكد_يساوي(ف("apl code is easy code is fun"), "code", "حالة 2")
تأكد_يساوي(ف("tea for two and two for tea"), "tea", "حالة 3")
