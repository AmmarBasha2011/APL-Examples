# مثال 9615 — الأصفار في نهاية العاملي (مجموعة اختبار 6)
# tzeros (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9615-num-tzeros-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(165), 40, "حالة 1")
تأكد_يساوي(ف(260), 64, "حالة 2")
تأكد_يساوي(ف(317), 77, "حالة 3")
تأكد_يساوي(ف(408), 100, "حالة 4")
تأكد_يساوي(ف(4), 0, "حالة 5")
