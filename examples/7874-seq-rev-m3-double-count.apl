# مثال 7874 — العدد: من عكسية نأخذ مضاعفات 3 ثم (ضعف)
# count over rev sequence, keep m3, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7874-seq-rev-m3-double-count.apl

# نولّد أول ن حد من: عكسية
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = 20 - ي * 2
    لو خ % 3 == 0:
      ر = ر + [خ * 2]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(5), 2, "حالة 3")
تأكد_يساوي(ف(10), 3, "حالة 4")
تأكد_يساوي(ف(15), 5, "حالة 5")
