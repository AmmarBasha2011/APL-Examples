# مثال 10192 — شريط بعرض 2 من الرمز +
# Bar of width 2 using +
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10192-bar-2-43.apl

# نكرر الرمز بحلقة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(ن):
    ر = ر + "+"
  ارجع ر + "|" + str(2)

تأكد_يساوي(ف(0), "|2", "حالة 1")
تأكد_يساوي(ف(3), "+++|2", "حالة 2")
تأكد_يساوي(ف(2), "++|2", "حالة 3")
