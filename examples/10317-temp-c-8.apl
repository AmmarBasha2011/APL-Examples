# مثال 10317 — تحويل 8 سيلسيوس وما بعده إلى فهرنهايت
# Celsius 8 onward to Fahrenheit
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10317-temp-c-8.apl

# ف = س × 9 ÷ 5 + 32
# بالقسمة الصحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(د):
  ارجع (د + 8) * 9 // 5 + 32

تأكد_يساوي(ف(0), 46, "حالة 1")
تأكد_يساوي(ف(10), 64, "حالة 2")
تأكد_يساوي(ف(37), 113, "حالة 3")
تأكد_يساوي(ف(-5), 37, "حالة 4")
