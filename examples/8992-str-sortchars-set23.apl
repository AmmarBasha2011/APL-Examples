# مثال 8992 — حروف الكلمة مرتبة (مجموعة اختبار 23)
# sortchars (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8992-str-sortchars-set23.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع "".join(sorted(ن))

تأكد_يساوي(ف("earth"), "aehrt", "حالة 1")
تأكد_يساوي(ف("galaxy"), "aaglxy", "حالة 2")
تأكد_يساوي(ف("array"), "aarry", "حالة 3")
تأكد_يساوي(ف("rocket"), "cekort", "حالة 4")
تأكد_يساوي(ف("silent"), "eilnst", "حالة 5")
