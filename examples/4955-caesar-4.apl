# مثال 4955 — شيفرة قيصر بإزاحة 4
# Caesar cipher shift 4
# Demonstrates: خوارزميات متقدمة
#
# Run:  python apl.py examples/4955-caesar-4.apl

# نزيح كل حرف إنجليزي صغير

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ح >= "a" و ح <= "z":
      ر = ر + chr((ord(ح) - 97 + 4) % 26 + 97)
    والا:
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("abc"), "efg", "حالة 1")
تأكد_يساوي(ف("hello world"), "lipps asvph", "حالة 2")
تأكد_يساوي(ف("xyz"), "bcd", "حالة 3")
تأكد_يساوي(ف("a b-c"), "e f-g", "حالة 4")
