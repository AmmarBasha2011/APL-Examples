# مثال 8640 — آخر عنصر من المدى 7 إلى 70 بخطوة 7 بعد (ناقص 3)
# last over range(7,70,7) mapped by dec3
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8640-range-7-70-7-dec3-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 7
  طالما خ < 70:
    ر = ر + [خ - 3]
    خ = خ + (7)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 60, "المدى كله")
