# مثال 5288 — ضرب كل عنصر في 15
# Scale list by 15
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5288-scale-list-15.apl

# قائمة جديدة بالقيم المضروبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [خ * 15]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [15, 30, 45], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([0, -4, 10]), [0, -60, 150], "حالة 3")
