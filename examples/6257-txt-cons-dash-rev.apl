# مثال 6257 — الناتج معكوس بعد أخذ الحروف الساكنة وتحويلها إلى (حرف مع شرطة)
# rev of dash applied to cons chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6257-txt-cons-dash-rev.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف الساكنة فقط
# ونحوّل كل حرف إلى: حرف مع شرطة
# ثم نحسب: الناتج معكوس

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ في "bcdfghjklmnpqrstvwxyz":
      ر = ر + خ + "-"
  ارجع ر[::-1]

تأكد_يساوي(ف("hello world 42"), "-d-l-r-w-l-l-h", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "-n-f-s-l-p", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "-c-b", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "-x-f-n-w-r-b-k-c-q-h-t", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "-x-x-x-y-y-y-z-z-z", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "-c-n-c-s-t-d", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "-c-b-r-n-g-n-m-m-r-g-r-p", "حالة 8")
