# مثال 9635 — الأصفار في نهاية العاملي (مجموعة اختبار 26)
# tzeros (test set 26)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9635-num-tzeros-set26.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(427), 105, "حالة 1")
تأكد_يساوي(ف(374), 90, "حالة 2")
تأكد_يساوي(ف(164), 39, "حالة 3")
تأكد_يساوي(ف(446), 109, "حالة 4")
تأكد_يساوي(ف(87), 20, "حالة 5")
