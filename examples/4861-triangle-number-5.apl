# مثال 4861 — مجموع الأعداد من 1 إلى ضعف 5 وزيادة
# Sum 1..n for scaled n (k=5)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4861-triangle-number-5.apl

# مجموع الأعداد المتتالية = ن(ن+1)/2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ن = ن * 5
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 15, "حالة 1")
تأكد_يساوي(ف(2), 55, "حالة 2")
تأكد_يساوي(ف(3), 120, "حالة 3")
تأكد_يساوي(ف(10), 1275, "حالة 4")
