# مثال 9826 — إزاحة لليمين 12 خانات
# Shift right by 12
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9826-bits-shr-12.apl

# الإزاحة لليمين تقسم وتقتطع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن >> 12

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(4096), 1, "حالة 3")
تأكد_يساوي(ف(100000), 24, "حالة 4")
