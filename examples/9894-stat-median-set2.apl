# مثال 9894 — الوسيط (بعد الترتيب) (مجموعة 2)
# median (data set 2)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9894-stat-median-set2.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([57, -9, 59, 45, -16, 60, 27, 36]), 40, "حالة 1")
تأكد_يساوي(ف([-7, 38, 56, 16, 28, 34, 36]), 34, "حالة 2")
تأكد_يساوي(ف([-14, -9, 32, -11]), -10, "حالة 3")
تأكد_يساوي(ف([16, 26, 35, 55, 52, 26, 53]), 35, "حالة 4")
