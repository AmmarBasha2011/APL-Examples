# مثال 8677 — أول عنصر من المدى 2 إلى 26 بخطوة 3 بعد (باقي على 7)
# first over range(2,26,3) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8677-range-2-26-3-mod7-first.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 2
  طالما خ < 26:
    ر = ر + [خ % 7]
    خ = خ + (3)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[0]

تأكد_يساوي(ف(), 2, "المدى كله")
