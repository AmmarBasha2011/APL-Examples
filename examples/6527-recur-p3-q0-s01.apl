# مثال 6527 — متتالية a(n) = 3·a(n-1) + 0·a(n-2) تبدأ بـ 0,1
# Linear recurrence p=3 q=0 start 0,1
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6527-recur-p3-q0-s01.apl

# كل حد يعتمد على الحدين السابقين
# نحدّث زوجاً من المتغيرات في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = 0
  ص = 1
  لكل ي في range(ن):
    ت = 3 * ص + 0 * س
    س = ص
    ص = ت
  ارجع س

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(2), 3, "حالة 3")
تأكد_يساوي(ف(5), 81, "حالة 4")
تأكد_يساوي(ف(8), 2187, "حالة 5")
تأكد_يساوي(ف(12), 177147, "حالة 6")
