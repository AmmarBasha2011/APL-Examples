# مثال 9978 — التباين الصحيح (مجموعة 11)
# variance (data set 11)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9978-stat-variance-set11.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([-14, 38, 31, 33, 1, 59, 18, 33]), 455, "حالة 1")
تأكد_يساوي(ف([28, 25, 4, 32, 1, -20, -9, 33]), 365, "حالة 2")
تأكد_يساوي(ف([38, 43, -20, 41, 35]), 569, "حالة 3")
تأكد_يساوي(ف([42, 44, 24]), 81, "حالة 4")
