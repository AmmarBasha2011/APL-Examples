# مثال 8932 — عدد حروف العلة (مجموعة اختبار 3)
# vowels (test set 3)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8932-str-vowels-set3.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ح في ن:
    لو ح في "aeiou":
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("data"), 2, "حالة 1")
تأكد_يساوي(ف("racecar"), 3, "حالة 2")
تأكد_يساوي(ف("python"), 1, "حالة 3")
تأكد_يساوي(ف("google"), 3, "حالة 4")
تأكد_يساوي(ف("pluto"), 2, "حالة 5")
