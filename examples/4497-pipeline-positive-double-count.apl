# مثال 4497 — عدد نتيجة ضعفها للأعداد الموجبة
# Count of double over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4497-pipeline-positive-double-count.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ * 2]
  ارجع len(ن)

تأكد_يساوي(ف([3, 1, 2, 8, 5]), 5, "حالة 1")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 3, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 4, "حالة 3")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 7, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
