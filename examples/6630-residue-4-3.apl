# مثال 6630 — الأعداد التي باقيها 3 عند القسمة على 4
# Numbers with remainder 3 mod 4
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6630-residue-4-3.apl

# نمر على الأعداد ونحتفظ بما يناسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    لو ي % 4 == 3:
      ر = ر + [ي]
  ارجع ر

تأكد_يساوي(ف(0), [], "حالة 1")
تأكد_يساوي(ف(10), [3, 7], "حالة 2")
تأكد_يساوي(ف(40), [3, 7, 11, 15, 19, 23, 27, 31, 35, 39], "حالة 3")
تأكد_يساوي(ف(75), [3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 71], "حالة 4")
