# مثال 9510 — هل العدد تام (مجموعة اختبار 21)
# perfect (test set 21)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9510-num-perfect-set21.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ي في range(1, ن):
    لو ن % ي == 0:
      م = م + ي
  ارجع م == ن و ن > 1

تأكد_يساوي(ف(102), خطأ, "حالة 1")
تأكد_يساوي(ف(12), خطأ, "حالة 2")
تأكد_يساوي(ف(228), خطأ, "حالة 3")
تأكد_يساوي(ف(492), خطأ, "حالة 4")
تأكد_يساوي(ف(176), خطأ, "حالة 5")
