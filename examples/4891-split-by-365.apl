# مثال 4891 — تقسيم القيمة على 365 إلى (خارج, باقي)
# Split into quotient and remainder by 365
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4891-split-by-365.apl

# نستخدم // و %

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن // 365, ن % 365]

تأكد_يساوي(ف(0), [0, 0], "حالة 1")
تأكد_يساوي(ف(364), [0, 364], "حالة 2")
تأكد_يساوي(ف(365), [1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [2, 270], "حالة 4")
تأكد_يساوي(ف(12345), [33, 300], "حالة 5")
