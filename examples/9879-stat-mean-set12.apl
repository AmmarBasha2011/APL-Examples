# مثال 9879 — المتوسط الصحيح (مجموعة 12)
# mean (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9879-stat-mean-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([16, -20, 1, 32, -7, 4, 27, -1, 16]), 7, "حالة 1")
تأكد_يساوي(ف([17, -14, 23, -2, -9, 58]), 12, "حالة 2")
تأكد_يساوي(ف([-20, 23, -2, 18, 42]), 12, "حالة 3")
تأكد_يساوي(ف([36, -4, 2, 55, 13, 60, 14, 37, 10]), 24, "حالة 4")
