# مثال 4830 — فائدة بسيطة بنسبة 6%
# Simple interest at 6 percent
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4830-simple-interest-6.apl

# الفائدة = المبلغ × النسبة × السنوات ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(م, س):
  ارجع م * 6 * س // 100

تأكد_يساوي(ف(1000, 1), 60, "حالة 1")
تأكد_يساوي(ف(2500, 3), 450, "حالة 2")
تأكد_يساوي(ف(100, 10), 60, "حالة 3")
تأكد_يساوي(ف(8000, 2), 960, "حالة 4")
