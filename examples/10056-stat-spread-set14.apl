# مثال 10056 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 14)
# spread (data set 14)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10056-stat-spread-set14.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([46, 50, 41, -1, 50, 33, -8, 35, 5]), 28, "حالة 1")
تأكد_يساوي(ف([-9, 47, 28, 4, 8, 13, -2]), 19, "حالة 2")
تأكد_يساوي(ف([54, -4, 3, 51, 40, -15, 2]), 37, "حالة 3")
تأكد_يساوي(ف([54, 55, 59, -18, 25, 5, -2, 25, -15]), 29, "حالة 4")
