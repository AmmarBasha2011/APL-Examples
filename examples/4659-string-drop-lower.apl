# مثال 4659 — حذف (حرف صغير) في نص
# String: drop lowercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4659-string-drop-lower.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = ""
  لكل خ في س:
    لو ليس (خ.islower()):
      ن = ن + خ
  ارجع ن

تأكد_يساوي(ف("ZZtop and the Beatles"), "ZZ   B", "حالة 1")
تأكد_يساوي(ف("  spaced   out  text "), "        ", "حالة 2")
تأكد_يساوي(ف("Hello World 42"), "H W 42", "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), "1234", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
