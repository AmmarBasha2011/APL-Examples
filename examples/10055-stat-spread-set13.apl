# مثال 10055 — الفرق بين أكبر قيمتين متتاليتين (مجموعة 13)
# spread (data set 13)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10055-stat-spread-set13.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  م = 0
  لكل ي في range(1, len(س)):
    م = max(م, س[ي] - س[ي - 1])
  ارجع م

تأكد_يساوي(ف([17, 31, 38]), 14, "حالة 1")
تأكد_يساوي(ف([36, 34, -17, -2]), 36, "حالة 2")
تأكد_يساوي(ف([23, -8, 56, 40]), 31, "حالة 3")
تأكد_يساوي(ف([-11, 38, 14]), 25, "حالة 4")
