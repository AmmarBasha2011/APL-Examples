# مثال 9575 — الجذر الرقمي (مجموعة اختبار 6)
# droot (test set 6)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9575-num-droot-set6.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(15523), 7, "حالة 1")
تأكد_يساوي(ف(38545), 7, "حالة 2")
تأكد_يساوي(ف(92150), 8, "حالة 3")
تأكد_يساوي(ف(60218), 8, "حالة 4")
تأكد_يساوي(ف(58990), 4, "حالة 5")
