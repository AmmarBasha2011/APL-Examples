# مثال 4507 — أصغر نتيجة سالبها للأعداد الموجبة
# Smallest (or 0) of negated over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4507-pipeline-positive-negate-min.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [0 - خ]
  لو len(ن) == 0:
    ارجع 0
  ارجع min(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), -42, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), -30, "حالة 2")
تأكد_يساوي(ف([3, 1, 2, 8, 5]), -8, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), -15, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
