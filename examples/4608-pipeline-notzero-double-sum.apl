# مثال 4608 — مجموع نتيجة ضعفها للأعداد الغير الصفرية
# Sum of double over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4608-pipeline-notzero-double-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ * 2]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 68, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 138, "حالة 2")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 78, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 58, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
