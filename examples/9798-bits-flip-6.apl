# مثال 9798 — قلب الخانة رقم 6
# Flip bit 6
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9798-bits-flip-6.apl

# XOR مع قناع الخانة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن ^ (1 << 6)

تأكد_يساوي(ف(0), 64, "حالة 1")
تأكد_يساوي(ف(255), 191, "حالة 2")
تأكد_يساوي(ف(1000), 936, "حالة 3")
تأكد_يساوي(ف(12345), 12409, "حالة 4")
