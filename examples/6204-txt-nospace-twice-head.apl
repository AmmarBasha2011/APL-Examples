# مثال 6204 — أول 3 حروف من الناتج بعد أخذ غير المسافات وتحويلها إلى (حرف مكرر)
# head of twice applied to nospace chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6204-txt-nospace-twice-head.apl

# نمر على النص حرفاً حرفاً
# نأخذ غير المسافات فقط
# ونحوّل كل حرف إلى: حرف مكرر
# ثم نحسب: أول 3 حروف من الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ != " ":
      ر = ر + خ + خ
  ارجع ر[:3]

تأكد_يساوي(ف("hello world 42"), "hhe", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "aap", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "aa1", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "tth", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "zzz", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "dda", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "ppr", "حالة 8")
