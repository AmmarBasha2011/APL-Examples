# مثال 7920 — الحروف الأولى في الجملة رقم 2
# initials for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7920-sent1-initials.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ك في ن.split(" "):
    ر = ر + ك[0]
  ارجع ر

تأكد_يساوي(ف("to be or not to be"), "tbontb", "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), "ariariar", "حالة 2")
تأكد_يساوي(ف("a b c a b a"), "abcaba", "حالة 3")
