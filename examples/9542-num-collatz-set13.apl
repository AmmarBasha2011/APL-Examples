# مثال 9542 — خطوات كولاتز (مجموعة اختبار 13)
# collatz (test set 13)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9542-num-collatz-set13.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(139), 41, "حالة 1")
تأكد_يساوي(ف(160), 10, "حالة 2")
تأكد_يساوي(ف(118), 33, "حالة 3")
تأكد_يساوي(ف(150), 15, "حالة 4")
تأكد_يساوي(ف(45), 16, "حالة 5")
