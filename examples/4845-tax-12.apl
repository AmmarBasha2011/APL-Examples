# مثال 4845 — إجمالي مع ضريبة 12%
# Total with 12 percent tax
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4845-tax-12.apl

# الإجمالي = السعر + الضريبة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س + س * 12 // 100

تأكد_يساوي(ف(100), 112, "حالة 1")
تأكد_يساوي(ف(200), 224, "حالة 2")
تأكد_يساوي(ف(1500), 1680, "حالة 3")
تأكد_يساوي(ف(80), 89, "حالة 4")
