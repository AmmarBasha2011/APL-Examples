# مثال 7953 — عدد الكلمات المختلفة في الجملة رقم 6
# unique for sentence 6
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7953-sent5-unique.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = 1
  ارجع len(د)

تأكد_يساوي(ف("we love data and data loves us"), 6, "حالة 1")
تأكد_يساوي(ف("a b c a b a"), 3, "حالة 2")
تأكد_يساوي(ف("cairo is big and cairo is old"), 5, "حالة 3")
