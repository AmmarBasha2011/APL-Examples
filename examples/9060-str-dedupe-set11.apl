# مثال 9060 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 11)
# dedupe (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9060-str-dedupe-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("refer"), "ref", "حالة 1")
تأكد_يساوي(ف("galaxy"), "galxy", "حالة 2")
تأكد_يساوي(ف("sun"), "sun", "حالة 3")
تأكد_يساوي(ف("river"), "rive", "حالة 4")
تأكد_يساوي(ف("enlist"), "enlist", "حالة 5")
