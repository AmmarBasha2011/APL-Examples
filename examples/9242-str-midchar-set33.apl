# مثال 9242 — الحرف الأوسط (مجموعة اختبار 33)
# midchar (test set 33)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9242-str-midchar-set33.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("apple"), "p", "حالة 1")
تأكد_يساوي(ف("stats"), "a", "حالة 2")
تأكد_يساوي(ف("sun"), "u", "حالة 3")
تأكد_يساوي(ف("google"), "g", "حالة 4")
تأكد_يساوي(ف("pluto"), "u", "حالة 5")
