# مثال 9393 — مجموع الأرقام (مجموعة اختبار 24)
# digsum (test set 24)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9393-num-digsum-set24.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  طالما ن > 0:
    م = م + ن % 10
    ن = ن // 10
  ارجع م

تأكد_يساوي(ف(23932), 19, "حالة 1")
تأكد_يساوي(ف(75335), 23, "حالة 2")
تأكد_يساوي(ف(74261), 20, "حالة 3")
تأكد_يساوي(ف(51225), 15, "حالة 4")
تأكد_يساوي(ف(82736), 26, "حالة 5")
