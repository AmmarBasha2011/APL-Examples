# مثال 8825 — مجموع كل صف لمصفوفة قيمها (i*j) % 5
# Matrix rows for cell formula (i*j) % 5
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8825-mat-mod5-rows.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [(ي * ك) % 5]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل س في ق:
    م = 0
    لكل خ في س:
      م = م + خ
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [0, 1], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [0, 3, 6], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [0, 10, 10, 10, 10], "حجم 5")
