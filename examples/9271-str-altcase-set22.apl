# مثال 9271 — أحرف كبيرة في المواضع الزوجية (مجموعة اختبار 22)
# altcase (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9271-str-altcase-set22.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ي في range(len(ن)):
    لو ي % 2 == 0:
      ر = ر + ن[ي].upper()
    والا:
      ر = ر + ن[ي]
  ارجع ر

تأكد_يساوي(ف("rotor"), "RoToR", "حالة 1")
تأكد_يساوي(ف("sun"), "SuN", "حالة 2")
تأكد_يساوي(ف("rocket"), "RoCkEt", "حالة 3")
تأكد_يساوي(ف("orbit"), "OrBiT", "حالة 4")
تأكد_يساوي(ف("mars"), "MaRs", "حالة 5")
