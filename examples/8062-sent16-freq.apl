# مثال 8062 — تكرار كل كلمة في الجملة رقم 17
# freq for sentence 17
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8062-sent16-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("sun sand sea sun sand sun"), {"sun": 3, "sand": 2, "sea": 1}, "حالة 1")
تأكد_يساوي(ف("yes no yes yes no maybe"), {"yes": 3, "no": 2, "maybe": 1}, "حالة 2")
تأكد_يساوي(ف("one fish two fish red fish blue fish"), {"one": 1, "fish": 4, "two": 1, "red": 1, "blue": 1}, "حالة 3")
