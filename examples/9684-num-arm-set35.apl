# مثال 9684 — هل العدد أرمسترونغ (مجموعة اختبار 35)
# arm (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9684-num-arm-set35.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(565), خطأ, "حالة 1")
تأكد_يساوي(ف(434), خطأ, "حالة 2")
تأكد_يساوي(ف(256), خطأ, "حالة 3")
تأكد_يساوي(ف(82), خطأ, "حالة 4")
تأكد_يساوي(ف(403), خطأ, "حالة 5")
