# مثال 9924 — المنوال (الأصغر عند التساوي) (مجموعة 7)
# mode (data set 7)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9924-stat-mode-set7.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([1, 22, 27]), 1, "حالة 1")
تأكد_يساوي(ف([8, 40, 30, -11]), -11, "حالة 2")
تأكد_يساوي(ف([-10, 47, -13, 55]), -13, "حالة 3")
تأكد_يساوي(ف([-12, 46, 25, 19, 30, -14, 23]), -14, "حالة 4")
