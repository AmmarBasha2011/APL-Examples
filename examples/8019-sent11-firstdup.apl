# مثال 8019 — أول كلمة تتكرر في الجملة رقم 12
# firstdup for sentence 12
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8019-sent11-firstdup.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    لو ك في د:
      ارجع ك
    د[ك] = 1
  ارجع ""

تأكد_يساوي(ف("up down up down up up down"), "up", "حالة 1")
تأكد_يساوي(ف("learn code learn more code more"), "learn", "حالة 2")
تأكد_يساوي(ف("left right left left right"), "left", "حالة 3")
