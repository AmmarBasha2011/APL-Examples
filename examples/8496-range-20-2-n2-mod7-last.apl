# مثال 8496 — آخر عنصر من المدى 20 إلى 2 بخطوة -2 بعد (باقي على 7)
# last over range(20,2,-2) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8496-range-20-2-n2-mod7-last.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [خ % 7]
    خ = خ + (-2)
  لو len(ر) == 0:
    ارجع -1
  ارجع ر[len(ر) - 1]

تأكد_يساوي(ف(), 4, "المدى كله")
