# مثال 4804 — تجميع الكلمات حسب الطول (مجموع الأطوال)
# Group words by length: total length
# Demonstrates: قواميس وتجميع
#
# Run:  python apl.py examples/4804-group-by-length-total-len.apl

# نمر على الكلمات
# ونحدّث القاموس حسب المفتاح

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    ك = len(خ)
    لو ك في د:
      د[ك] = د[ك] + len(خ)
    والا:
      د[ك] = len(خ)
  ارجع د

تأكد_يساوي(ف(["apple", "bob", "cat", "apricot", "bear", "dog", "axe"]), {5: 5, 3: 12, 7: 7, 4: 4}, "حالة 1")
تأكد_يساوي(ف(["sun", "moon", "star", "sky", "mars"]), {3: 6, 4: 12}, "حالة 2")
تأكد_يساوي(ف(["one", "two", "three", "four", "five", "six"]), {3: 9, 5: 5, 4: 8}, "حالة 3")
تأكد_يساوي(ف(["kiwi", "lime", "lemon", "kale", "leek"]), {4: 16, 5: 5}, "حالة 4")
