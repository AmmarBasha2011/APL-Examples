# مثال 9979 — التباين الصحيح (مجموعة 12)
# variance (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9979-stat-variance-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ت = 0
  لكل خ في ق:
    ت = ت + (خ - م) * (خ - م)
  ارجع ت // len(ق)

تأكد_يساوي(ف([44, 34, 17, 30, 52, 14]), 184, "حالة 1")
تأكد_يساوي(ف([16, 22, 46, 46, -19, 36, 21]), 434, "حالة 2")
تأكد_يساوي(ف([-4, 40, 15]), 324, "حالة 3")
تأكد_يساوي(ف([17, 11, 13, 57, -5, 27, 25]), 315, "حالة 4")
