# مثال 10298 — تحويل وحدة إلى 37 وحدات صغرى والعكس
# Convert units with factor 37
# Demonstrates: تحويلات ومقادير
#
# Run:  python apl.py examples/10298-unit-scale-37.apl

# نضرب للتحويل للوحدة الأصغر
# ونقسم مع الباقي للرجوع

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع [ن * 37, ن // 37, ن % 37]

تأكد_يساوي(ف(0), [0, 0, 0], "حالة 1")
تأكد_يساوي(ف(1), [37, 0, 1], "حالة 2")
تأكد_يساوي(ف(37), [1369, 1, 0], "حالة 3")
تأكد_يساوي(ف(1000), [37000, 27, 1], "حالة 4")
