# مثال 9220 — الحرف الأوسط (مجموعة اختبار 11)
# midchar (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9220-str-midchar-set11.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("racecar"), "e", "حالة 1")
تأكد_يساوي(ف("google"), "g", "حالة 2")
تأكد_يساوي(ف("river"), "v", "حالة 3")
تأكد_يساوي(ف("bob"), "o", "حالة 4")
تأكد_يساوي(ف("civic"), "v", "حالة 5")
