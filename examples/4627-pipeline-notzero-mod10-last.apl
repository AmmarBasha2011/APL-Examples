# مثال 4627 — آخر نتيجة باقي قسمتها على 10 للأعداد الغير الصفرية
# Last (or -1) of last digit mod 10 over the nonzero numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4627-pipeline-notzero-mod10-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ != 0:
      ن = ن + [خ % 10]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([3, 1, 2, 8, 5]), 5, "حالة 1")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 1, "حالة 2")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 3, "حالة 3")
تأكد_يساوي(ف([-5, 10, 25, 2, 2]), 2, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
