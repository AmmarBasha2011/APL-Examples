# مثال 4454 — ترتيب نتيجة مربعها للأعداد الزوجية
# Sorted list of square over the even numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4454-pipeline-even-square-sorted.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ % 2 == 0:
      ن = ن + [خ * خ]
  ارجع sorted(ن)

تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), [196, 784, 1764], "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), [4, 64], "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), [16, 36, 400], "حالة 3")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), [36, 64, 144, 900], "حالة 4")
تأكد_يساوي(ف([]), [], "حالة 5")
