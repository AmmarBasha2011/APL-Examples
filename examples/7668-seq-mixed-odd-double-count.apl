# مثال 7668 — العدد: من ي + 10 باقي 7 نأخذ الفردي ثم (ضعف)
# count over mixed sequence, keep odd, map double
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7668-seq-mixed-odd-double-count.apl

# نولّد أول ن حد من: ي + 10 باقي 7
# نصفّي ثم نحوّل
# ثم نختصر النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(ن):
    خ = (ي + 10) % 7
    لو خ % 2 == 1:
      ر = ر + [خ * 2]
  ارجع len(ر)

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(1), 1, "حالة 2")
تأكد_يساوي(ف(5), 2, "حالة 3")
تأكد_يساوي(ف(10), 5, "حالة 4")
تأكد_يساوي(ف(15), 7, "حالة 5")
