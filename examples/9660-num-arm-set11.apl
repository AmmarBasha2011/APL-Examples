# مثال 9660 — هل العدد أرمسترونغ (مجموعة اختبار 11)
# arm (test set 11)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9660-num-arm-set11.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(506), خطأ, "حالة 1")
تأكد_يساوي(ف(363), خطأ, "حالة 2")
تأكد_يساوي(ف(494), خطأ, "حالة 3")
تأكد_يساوي(ف(331), خطأ, "حالة 4")
تأكد_يساوي(ف(788), خطأ, "حالة 5")
