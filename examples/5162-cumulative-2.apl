# مثال 5162 — مجموع تراكمي مع زيادة 2
# Running total plus 2 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5162-cumulative-2.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 2
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [3, 7, 12], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [7, 14, 21, 28], "حالة 3")
