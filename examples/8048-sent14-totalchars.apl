# مثال 8048 — مجموع حروف الكلمات في الجملة رقم 15
# totalchars for sentence 15
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/8048-sent14-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("learn code learn more code more"), 26, "حالة 1")
تأكد_يساوي(ف("bread milk bread eggs milk bread"), 27, "حالة 2")
تأكد_يساوي(ف("to be or not to be"), 13, "حالة 3")
