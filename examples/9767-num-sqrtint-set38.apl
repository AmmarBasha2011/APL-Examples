# مثال 9767 — الجذر التربيعي الصحيح (مجموعة اختبار 38)
# sqrtint (test set 38)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9767-num-sqrtint-set38.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(918), 30, "حالة 1")
تأكد_يساوي(ف(4170), 64, "حالة 2")
تأكد_يساوي(ف(2578), 50, "حالة 3")
تأكد_يساوي(ف(4305), 65, "حالة 4")
تأكد_يساوي(ف(4378), 66, "حالة 5")
