# مثال 6798 — العدد المضلّع ذو 23 أضلاع
# 23-gonal number
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6798-polygonal-23.apl

# ((ك-2)ن² - (ك-4)ن) / 2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ((23 - 2) * ن * ن - (23 - 4) * ن) // 2

تأكد_يساوي(ف(1), 1, "حالة 1")
تأكد_يساوي(ف(2), 23, "حالة 2")
تأكد_يساوي(ف(5), 215, "حالة 3")
تأكد_يساوي(ف(10), 955, "حالة 4")
