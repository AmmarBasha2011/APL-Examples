# مثال 9151 — ضغط التكرار (مجموعة اختبار 22)
# rle (test set 22)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9151-str-rle-set22.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  ي = 0
  طالما ي < len(ن):
    ك = ي
    طالما ك < len(ن) و ن[ك] == ن[ي]:
      ك = ك + 1
    ر = ر + ن[ي] + str(ك - ي)
    ي = ك
  ارجع ر

تأكد_يساوي(ف("google"), "g1o2g1l1e1", "حالة 1")
تأكد_يساوي(ف("moon"), "m1o2n1", "حالة 2")
تأكد_يساوي(ف("river"), "r1i1v1e1r1", "حالة 3")
تأكد_يساوي(ف("tenet"), "t1e1n1e1t1", "حالة 4")
تأكد_يساوي(ف("enlist"), "e1n1l1i1s1t1", "حالة 5")
