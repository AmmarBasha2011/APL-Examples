# مثال 9922 — المنوال (الأصغر عند التساوي) (مجموعة 5)
# mode (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9922-stat-mode-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([10, 31, 45, 26, -3, 41, -17, -1, 20]), -17, "حالة 1")
تأكد_يساوي(ف([49, 12, 60, 53, 51, 18, -12, -6]), -12, "حالة 2")
تأكد_يساوي(ف([17, 27, -5]), -5, "حالة 3")
تأكد_يساوي(ف([36, 1, 31, 46, 25, 40, 21, 43, 21]), 21, "حالة 4")
