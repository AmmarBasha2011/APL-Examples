# مثال 9469 — عدد القواسم (مجموعة اختبار 20)
# ndiv (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9469-num-ndiv-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  لكل ي في range(1, ن + 1):
    لو ن % ي == 0:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(228), 12, "حالة 1")
تأكد_يساوي(ف(196), 9, "حالة 2")
تأكد_يساوي(ف(296), 8, "حالة 3")
تأكد_يساوي(ف(234), 12, "حالة 4")
تأكد_يساوي(ف(127), 2, "حالة 5")
