# مثال 8778 — المنقولة لمصفوفة قيمها i*i+j
# Matrix transpose for cell formula i*i+j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8778-mat-sq-transpose.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي + ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل ك في range(len(ق)):
    س = []
    لكل ي في range(len(ق)):
      س = س + [ق[ي][ك]]
    ر = ر + [س]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [[0]], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [[0, 1], [1, 2]], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [[0, 1, 4], [1, 2, 5], [2, 3, 6]], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [[0, 1, 4, 9, 16], [1, 2, 5, 10, 17], [2, 3, 6, 11, 18], [3, 4, 7, 12, 19], [4, 5, 8, 13, 20]], "حجم 5")
