# مثال 9681 — هل العدد أرمسترونغ (مجموعة اختبار 32)
# arm (test set 32)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9681-num-arm-set32.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(432), خطأ, "حالة 1")
تأكد_يساوي(ف(951), خطأ, "حالة 2")
تأكد_يساوي(ف(427), خطأ, "حالة 3")
تأكد_يساوي(ف(803), خطأ, "حالة 4")
تأكد_يساوي(ف(405), خطأ, "حالة 5")
