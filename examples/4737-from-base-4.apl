# مثال 4737 — قراءة عدد مكتوب بالأساس 4
# Read a number written in base 4
# Demonstrates: أرقام وخوارزميات
#
# Run:  python apl.py examples/4737-from-base-4.apl

# نمر على الأرقام من اليسار
# ونضرب الناتج في الأساس ونضيف الرقم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ن = 0
  لكل خ في س:
    ن = ن * 4 + int(خ)
  ارجع ن

تأكد_يساوي(ف("0"), 0, "حالة 1")
تأكد_يساوي(ف("1"), 1, "حالة 2")
تأكد_يساوي(ف("21"), 9, "حالة 3")
تأكد_يساوي(ف("132"), 30, "حالة 4")
تأكد_يساوي(ف("1031"), 77, "حالة 5")
