# مثال 9439 — عكس الأرقام (مجموعة اختبار 30)
# revnum (test set 30)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9439-num-revnum-set30.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(67658), 85676, "حالة 1")
تأكد_يساوي(ف(69629), 92696, "حالة 2")
تأكد_يساوي(ف(52894), 49825, "حالة 3")
تأكد_يساوي(ف(18998), 89981, "حالة 4")
تأكد_يساوي(ف(30437), 73403, "حالة 5")
