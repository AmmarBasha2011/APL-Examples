# مثال 6532 — متتالية a(n) = 3·a(n-1) + 2·a(n-2) تبدأ بـ 1,2
# Linear recurrence p=3 q=2 start 1,2
# Demonstrates: متتاليات ونظرية الأعداد
#
# Run:  python apl.py examples/6532-recur-p3-q2-s12.apl

# كل حد يعتمد على الحدين السابقين
# نحدّث زوجاً من المتغيرات في كل خطوة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = 1
  ص = 2
  لكل ي في range(ن):
    ت = 3 * ص + 2 * س
    س = ص
    ص = ت
  ارجع س

تأكد_يساوي(ف(0), 1, "حالة 1")
تأكد_يساوي(ف(1), 2, "حالة 2")
تأكد_يساوي(ف(2), 8, "حالة 3")
تأكد_يساوي(ف(5), 356, "حالة 4")
تأكد_يساوي(ف(8), 16084, "حالة 5")
تأكد_يساوي(ف(12), 2587924, "حالة 6")
