# مثال 9743 — الجذر التربيعي الصحيح (مجموعة اختبار 14)
# sqrtint (test set 14)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9743-num-sqrtint-set14.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما (ر + 1) * (ر + 1) <= ن:
    ر = ر + 1
  ارجع ر

تأكد_يساوي(ف(243), 15, "حالة 1")
تأكد_يساوي(ف(455), 21, "حالة 2")
تأكد_يساوي(ف(1831), 42, "حالة 3")
تأكد_يساوي(ف(910), 30, "حالة 4")
تأكد_يساوي(ف(3152), 56, "حالة 5")
