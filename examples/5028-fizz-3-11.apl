# مثال 5028 — فيزباز بالعددين 3 و 11
# FizzBuzz variant with 3 and 11
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5028-fizz-3-11.apl

# A للقابل على الأول، B للثاني، AB للاثنين

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = []
  لكل ي في range(1, ن + 1):
    لو ي % 3 == 0 و ي % 11 == 0:
      ر = ر + ["AB"]
    والا_لو ي % 3 == 0:
      ر = ر + ["A"]
    والا_لو ي % 11 == 0:
      ر = ر + ["B"]
    والا:
      ر = ر + [str(ي)]
  ارجع ر

تأكد_يساوي(ف(1), ["1"], "حالة 1")
تأكد_يساوي(ف(10), ["1", "2", "A", "4", "5", "A", "7", "8", "A", "10"], "حالة 2")
تأكد_يساوي(ف(30), ["1", "2", "A", "4", "5", "A", "7", "8", "A", "10", "B", "A", "13", "14", "A", "16", "17", "A", "19", "20", "A", "B", "23", "A", "25", "26", "A", "28", "29", "A"], "حالة 3")
تأكد_يساوي(ف(0), [], "حالة 4")
