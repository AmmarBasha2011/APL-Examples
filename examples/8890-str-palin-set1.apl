# مثال 8890 — هل الكلمة متناظرة (مجموعة اختبار 1)
# palin (test set 1)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8890-str-palin-set1.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("racecar"), صواب, "حالة 1")
تأكد_يساوي(ف("deed"), صواب, "حالة 2")
تأكد_يساوي(ف("venus"), خطأ, "حالة 3")
تأكد_يساوي(ف("apple"), خطأ, "حالة 4")
تأكد_يساوي(ف("galaxy"), خطأ, "حالة 5")
