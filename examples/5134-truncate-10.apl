# مثال 5134 — اقتطاع النص إلى 10 حروف مع نقاط
# Truncate to 10 chars with dots
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5134-truncate-10.apl

# إذا زاد الطول نقتطع ونضيف ...

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لو len(ن) <= 10:
    ارجع ن
  ارجع ن[:10] + "..."

تأكد_يساوي(ف("hi"), "hi", "حالة 1")
تأكد_يساوي(ف("hello world, this is long"), "hello worl...", "حالة 2")
تأكد_يساوي(ف("xxxxxxxxxx"), "xxxxxxxxxx", "حالة 3")
تأكد_يساوي(ف("yyyyyyyyyyy"), "yyyyyyyyyy...", "حالة 4")
