# مثال 4655 — هل كل الأحرف (حرف كبير) في نص
# String: are all characters uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4655-string-allq-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو ليس (خ.isupper()):
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("quick brown fox"), خطأ, "حالة 1")
تأكد_يساوي(ف("a1b2c3d4"), خطأ, "حالة 2")
تأكد_يساوي(ف("aeiou AEIOU xyz"), خطأ, "حالة 3")
تأكد_يساوي(ف("  spaced   out  text "), خطأ, "حالة 4")
تأكد_يساوي(ف(""), صواب, "حالة 5")
