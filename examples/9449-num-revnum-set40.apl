# مثال 9449 — عكس الأرقام (مجموعة اختبار 40)
# revnum (test set 40)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9449-num-revnum-set40.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = 0
  طالما ن > 0:
    ر = ر * 10 + ن % 10
    ن = ن // 10
  ارجع ر

تأكد_يساوي(ف(2157), 7512, "حالة 1")
تأكد_يساوي(ف(26866), 66862, "حالة 2")
تأكد_يساوي(ف(17271), 17271, "حالة 3")
تأكد_يساوي(ف(80977), 77908, "حالة 4")
تأكد_يساوي(ف(23779), 97732, "حالة 5")
