# مثال 7912 — تكرار كل كلمة في الجملة رقم 2
# freq for sentence 2
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7912-sent1-freq.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ك في ن.split(" "):
    د[ك] = د.get(ك, 0) + 1
  ارجع د

تأكد_يساوي(ف("to be or not to be"), {"to": 2, "be": 2, "or": 1, "not": 1}, "حالة 1")
تأكد_يساوي(ف("a rose is a rose is a rose"), {"a": 3, "rose": 3, "is": 2}, "حالة 2")
تأكد_يساوي(ف("a b c a b a"), {"a": 3, "b": 2, "c": 1}, "حالة 3")
