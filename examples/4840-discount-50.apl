# مثال 4840 — سعر بعد خصم 50%
# Price after 50 percent discount
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4840-discount-50.apl

# السعر × (100 - الخصم) ÷ 100

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ارجع س * (100 - 50) // 100

تأكد_يساوي(ف(100), 50, "حالة 1")
تأكد_يساوي(ف(250), 125, "حالة 2")
تأكد_يساوي(ف(999), 499, "حالة 3")
تأكد_يساوي(ف(40), 20, "حالة 4")
