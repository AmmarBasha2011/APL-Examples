# مثال 8917 — هل الكلمة متناظرة (مجموعة اختبار 28)
# palin (test set 28)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/8917-str-palin-set28.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن == ن[::-1]

تأكد_يساوي(ف("radar"), صواب, "حالة 1")
تأكد_يساوي(ف("data"), خطأ, "حالة 2")
تأكد_يساوي(ف("deed"), صواب, "حالة 3")
تأكد_يساوي(ف("sun"), خطأ, "حالة 4")
تأكد_يساوي(ف("racecar"), صواب, "حالة 5")
