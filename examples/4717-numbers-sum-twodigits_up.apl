# مثال 4717 — مجموع الأعداد الأرقامه تصاعدية حتى حد معين
# Numbers up to a limit: sum of the digits strictly increasing ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4717-numbers-sum-twodigits_up.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو list(str(ر)) == sorted(set(str(ر))):
      ن = ن + [ر]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف(22), 169, "حالة 1")
تأكد_يساوي(ف(43), 570, "حالة 2")
تأكد_يساوي(ف(113), 1485, "حالة 3")
تأكد_يساوي(ف(1), 1, "حالة 4")
تأكد_يساوي(ف(0), 0, "حالة 5")
