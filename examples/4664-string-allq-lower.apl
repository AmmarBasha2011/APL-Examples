# مثال 4664 — هل كل الأحرف (حرف صغير) في نص
# String: are all characters lowercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4664-string-allq-lower.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  لكل خ في س:
    لو ليس (خ.islower()):
      ارجع خطأ
  ارجع صواب

تأكد_يساوي(ف("ZZtop and the Beatles"), خطأ, "حالة 1")
تأكد_يساوي(ف("MixedCASE123abc"), خطأ, "حالة 2")
تأكد_يساوي(ف("Data Science 101"), خطأ, "حالة 3")
تأكد_يساوي(ف("a1b2c3d4"), خطأ, "حالة 4")
تأكد_يساوي(ف(""), صواب, "حالة 5")
