# مثال 4648 — عدّ (حرف كبير) في نص
# String: count uppercase letter
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4648-string-count-upper.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ع = 0
  لكل خ في س:
    لو خ.isupper():
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("Hello World 42"), 2, "حالة 1")
تأكد_يساوي(ف("ZZtop and the Beatles"), 3, "حالة 2")
تأكد_يساوي(ف("apple PIE 7 and 9"), 3, "حالة 3")
تأكد_يساوي(ف("  spaced   out  text "), 0, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
