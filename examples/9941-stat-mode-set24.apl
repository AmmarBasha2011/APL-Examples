# مثال 9941 — المنوال (الأصغر عند التساوي) (مجموعة 24)
# mode (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9941-stat-mode-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  د = {}
  لكل خ في ق:
    د[خ] = د.get(خ, 0) + 1
  ب = ق[0]
  لكل خ في sorted(ق):
    لو د[خ] > د[ب] أو (د[خ] == د[ب] و خ < ب):
      ب = خ
  ارجع ب

تأكد_يساوي(ف([-1, 56, 9, 42]), -1, "حالة 1")
تأكد_يساوي(ف([-12, -18, 56, 24]), -18, "حالة 2")
تأكد_يساوي(ف([55, 24, 52]), 24, "حالة 3")
تأكد_يساوي(ف([-17, 19, 35, 4, 16, 47]), -17, "حالة 4")
