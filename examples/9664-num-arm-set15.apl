# مثال 9664 — هل العدد أرمسترونغ (مجموعة اختبار 15)
# arm (test set 15)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9664-num-arm-set15.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  س = str(ن)
  م = 0
  لكل ح في س:
    م = م + int(ح) ** len(س)
  ارجع م == ن

تأكد_يساوي(ف(922), خطأ, "حالة 1")
تأكد_يساوي(ف(867), خطأ, "حالة 2")
تأكد_يساوي(ف(825), خطأ, "حالة 3")
تأكد_يساوي(ف(116), خطأ, "حالة 4")
تأكد_يساوي(ف(156), خطأ, "حالة 5")
