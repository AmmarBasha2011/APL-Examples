# مثال 6225 — النص الناتج بعد أخذ الحروف فقط وتحويلها إلى (كما هو)
# str of same applied to alpha chars
# Demonstrates: معالجة النصوص
#
# Run:  python apl.py examples/6225-txt-alpha-same-str.apl

# نمر على النص حرفاً حرفاً
# نأخذ الحروف فقط فقط
# ونحوّل كل حرف إلى: كما هو
# ثم نحسب: النص الناتج

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل خ في ن:
    لو خ >= "a" و خ <= "z":
      ر = ر + خ
  ارجع ر

تأكد_يساوي(ف("hello world 42"), "helloworld", "حالة 1")
تأكد_يساوي(ف("apl is fun"), "aplisfun", "حالة 2")
تأكد_يساوي(ف("a1b2c3"), "abc", "حالة 3")
تأكد_يساوي(ف("the quick brown fox"), "thequickbrownfox", "حالة 4")
تأكد_يساوي(ف(""), "", "حالة 5")
تأكد_يساوي(ف("zzz yyy xxx"), "zzzyyyxxx", "حالة 6")
تأكد_يساوي(ف("data 2026 science"), "datascience", "حالة 7")
تأكد_يساوي(ف("programming in arabic"), "programminginarabic", "حالة 8")
