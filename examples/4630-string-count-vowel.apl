# مثال 4630 — عدّ (حرف علة) في نص
# String: count vowel
# Demonstrates: نصوص وحلقات وشروط
#
# Run:  python apl.py examples/4630-string-count-vowel.apl

# نمرّ على حروف النص واحدًا واحدًا
# ونطبّق الشرط على كل حرف

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(س):
  ع = 0
  لكل خ في س:
    لو "aeiou".find(خ.lower()) != -1:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف("Data Science 101"), 5, "حالة 1")
تأكد_يساوي(ف("apple PIE 7 and 9"), 5, "حالة 2")
تأكد_يساوي(ف("  spaced   out  text "), 5, "حالة 3")
تأكد_يساوي(ف("Hello World 42"), 3, "حالة 4")
تأكد_يساوي(ف(""), 0, "حالة 5")
