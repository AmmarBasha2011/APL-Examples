# مثال 7998 — مجموع حروف الكلمات في الجملة رقم 10
# totalchars for sentence 10
# Demonstrates: متتاليات ومعالجة
#
# Run:  python apl.py examples/7998-sent9-totalchars.apl

# نقسم الجملة إلى كلمات
# ونعالجها حسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  م = 0
  لكل ك في ن.split(" "):
    م = م + len(ك)
  ارجع م

تأكد_يساوي(ف("in the end the end is the start"), 24, "حالة 1")
تأكد_يساوي(ف("cairo is big and cairo is old"), 23, "حالة 2")
تأكد_يساوي(ف("sun sand sea sun sand sun"), 20, "حالة 3")
