# مثال 9328 — الحرف الأكثر تكراراً (الأول عند التساوي) (مجموعة اختبار 39)
# mostfreq (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9328-str-mostfreq-set39.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  د = {}
  لكل ح في ن:
    د[ح] = د.get(ح, 0) + 1
  ب = ن[0]
  لكل ح في ن:
    لو د[ح] > د[ب]:
      ب = ح
  ارجع ب

تأكد_يساوي(ف("data"), "a", "حالة 1")
تأكد_يساوي(ف("galaxy"), "a", "حالة 2")
تأكد_يساوي(ف("refer"), "r", "حالة 3")
تأكد_يساوي(ف("star"), "s", "حالة 4")
تأكد_يساوي(ف("noon"), "n", "حالة 5")
