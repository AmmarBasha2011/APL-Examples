# مثال 8493 — العدد من المدى 20 إلى 2 بخطوة -2 بعد (باقي على 7)
# count over range(20,2,-2) mapped by mod7
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8493-range-20-2-n2-mod7-count.apl

# نمشي من البداية إلى النهاية بخطوة ثابتة
# ونطبق الدالة على كل قيمة
# ثم نختصر

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف():
  ر = []
  خ = 20
  طالما خ > 2:
    ر = ر + [خ % 7]
    خ = خ + (-2)
  ارجع len(ر)

تأكد_يساوي(ف(), 9, "المدى كله")
