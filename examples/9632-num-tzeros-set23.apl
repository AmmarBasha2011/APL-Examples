# مثال 9632 — الأصفار في نهاية العاملي (مجموعة اختبار 23)
# tzeros (test set 23)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9632-num-tzeros-set23.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(393), 96, "حالة 1")
تأكد_يساوي(ف(74), 16, "حالة 2")
تأكد_يساوي(ف(391), 96, "حالة 3")
تأكد_يساوي(ف(149), 35, "حالة 4")
تأكد_يساوي(ف(76), 18, "حالة 5")
