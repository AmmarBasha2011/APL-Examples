# مثال 8704 — مجموع كل عنصرين (الأولى مرتبة)
# two lists zipsum, sort1
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8704-two-zipsum-sort1.apl

# دالة تأخذ قائمتين
# وتعالجهما معاً

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(أ, ب):
  أ = sorted(أ)
  ر = []
  لكل ي في range(min(len(أ), len(ب))):
    ر = ر + [أ[ي] + ب[ي]]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]), [6, 6, 6, 6, 6], "حالة 1")
تأكد_يساوي(ف([5, 3, 8, 3], [3, 3, 9, 8]), [6, 6, 14, 16], "حالة 2")
تأكد_يساوي(ف([10, 20, 30], [10, 0, 30, 40]), [20, 20, 60], "حالة 3")
تأكد_يساوي(ف([2, 4, 6, 8, 10, 12], [1, 2, 3]), [3, 6, 9], "حالة 4")
تأكد_يساوي(ف([7, 7, 7, 1], [7, 1, 7, 7]), [8, 8, 14, 14], "حالة 5")
تأكد_يساوي(ف([9, 8, 7, 6, 5, 4, 3], [4, 5, 6, 7, 8]), [7, 9, 11, 13, 15], "حالة 6")
