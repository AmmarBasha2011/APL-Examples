# مثال 9566 — خطوات كولاتز (مجموعة اختبار 37)
# collatz (test set 37)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9566-num-collatz-set37.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن != 1:
    لو ن % 2 == 0:
      ن = ن // 2
    والا:
      ن = 3 * ن + 1
    ع = ع + 1
  ارجع ع

تأكد_يساوي(ف(17), 12, "حالة 1")
تأكد_يساوي(ف(1), 0, "حالة 2")
تأكد_يساوي(ف(164), 111, "حالة 3")
تأكد_يساوي(ف(144), 23, "حالة 4")
تأكد_يساوي(ف(172), 31, "حالة 5")
