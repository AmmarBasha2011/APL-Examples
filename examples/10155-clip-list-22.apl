# مثال 10155 — قص كل عنصر عند 22
# Clip every item at 22
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10155-clip-list-22.apl

# نأخذ الأصغر بين العنصر والحد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  لكل خ في ق:
    ر = ر + [min(خ, 22)]
  ارجع ر

تأكد_يساوي(ف([0, 5, 10, 15, 20, 25, 30, 35]), [0, 5, 10, 15, 20, 22, 22, 22], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([22, 23, 21]), [22, 22, 21], "حالة 3")
