# مثال 4899 — اليوم بعد 5 أيام
# Weekday 5 days later
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4899-week-day-shift-5.apl

# أيام الأسبوع مرقمة من 0 إلى 6

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ي):
  ارجع (ي + 5) % 7

تأكد_يساوي(ف(0), 5, "حالة 1")
تأكد_يساوي(ف(3), 1, "حالة 2")
تأكد_يساوي(ف(6), 4, "حالة 3")
تأكد_يساوي(ف(4), 2, "حالة 4")
