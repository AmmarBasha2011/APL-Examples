# مثال 9603 — الجذر الرقمي (مجموعة اختبار 34)
# droot (test set 34)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9603-num-droot-set34.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(47430), 9, "حالة 1")
تأكد_يساوي(ف(9087), 6, "حالة 2")
تأكد_يساوي(ف(68207), 5, "حالة 3")
تأكد_يساوي(ف(25761), 3, "حالة 4")
تأكد_يساوي(ف(51189), 6, "حالة 5")
