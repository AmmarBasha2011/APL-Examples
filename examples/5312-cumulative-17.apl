# مثال 5312 — مجموع تراكمي مع زيادة 17
# Running total plus 17 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5312-cumulative-17.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 17
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [18, 37, 57], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [22, 44, 66, 88], "حالة 3")
