# مثال 9891 — المتوسط الصحيح (مجموعة 24)
# mean (data set 24)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9891-stat-mean-set24.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  ارجع م // len(ق)

تأكد_يساوي(ف([-1, 56, 9, 42]), 26, "حالة 1")
تأكد_يساوي(ف([-12, -18, 56, 24]), 12, "حالة 2")
تأكد_يساوي(ف([55, 24, 52]), 43, "حالة 3")
تأكد_يساوي(ف([-17, 19, 35, 4, 16, 47]), 17, "حالة 4")
