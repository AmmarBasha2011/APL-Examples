# مثال 4723 — قائمة الأعداد المثلثي حتى حد معين
# Numbers up to a limit: list of the triangular ones
# Demonstrates: حلقات وشروط وأعداد
#
# Run:  python apl.py examples/4723-numbers-list-triangular.apl

# نفحص الأعداد من 1 إلى الحد
# ونجمع منها اللي يحقق الشرط

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ح):
  ن = []
  لكل ر في range(1, ح + 1):
    لو len([م for م in range(0, ر + 1) if م * (م + 1) // 2 == ر]) == 1:
      ن = ن + [ر]
  ارجع ن

تأكد_يساوي(ف(27), [1, 3, 6, 10, 15, 21], "حالة 1")
تأكد_يساوي(ف(42), [1, 3, 6, 10, 15, 21, 28, 36], "حالة 2")
تأكد_يساوي(ف(86), [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 66, 78], "حالة 3")
تأكد_يساوي(ف(1), [1], "حالة 4")
تأكد_يساوي(ف(0), [], "حالة 5")
