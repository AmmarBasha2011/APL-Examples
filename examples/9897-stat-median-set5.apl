# مثال 9897 — الوسيط (بعد الترتيب) (مجموعة 5)
# median (data set 5)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/9897-stat-median-set5.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  س = sorted(ق)
  ن = len(س)
  لو ن % 2 == 1:
    ارجع س[ن // 2]
  ارجع (س[ن // 2 - 1] + س[ن // 2]) // 2

تأكد_يساوي(ف([34, 14, 36, 38, -18, 25, 10]), 25, "حالة 1")
تأكد_يساوي(ف([23, 8, 23, 47, -7, 51, 6]), 23, "حالة 2")
تأكد_يساوي(ف([25, -18, 33, -17, 27, -2, -17, 43, 34]), 25, "حالة 3")
تأكد_يساوي(ف([42, 28, 30, -10, -15]), 28, "حالة 4")
