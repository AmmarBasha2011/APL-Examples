# مثال 5260 — أقرب مضاعف للعدد 12
# Nearest multiple of 12
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5260-nearest-multiple-12.apl

# نقرب للأدنى أو الأعلى حسب الباقي

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ب = ن % 12
  لو ب * 2 < 12:
    ارجع ن - ب
  ارجع ن - ب + 12

تأكد_يساوي(ف(0), 0, "حالة 1")
تأكد_يساوي(ف(7), 12, "حالة 2")
تأكد_يساوي(ف(13), 12, "حالة 3")
تأكد_يساوي(ف(100), 96, "حالة 4")
تأكد_يساوي(ف(13), 12, "حالة 5")
