# مثال 5113 — ملء النص من اليسار حتى عرض 6
# Left pad to width 6
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5113-pad-left-6.apl

# نضيف أصفاراً قبل النص

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ن
  طالما len(ر) < 6:
    ر = "0" + ر
  ارجع ر

تأكد_يساوي(ف("7"), "000007", "حالة 1")
تأكد_يساوي(ف("123"), "000123", "حالة 2")
تأكد_يساوي(ف("111111"), "111111", "حالة 3")
تأكد_يساوي(ف(""), "000000", "حالة 4")
