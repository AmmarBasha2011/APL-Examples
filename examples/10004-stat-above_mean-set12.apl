# مثال 10004 — عدد العناصر فوق المتوسط (مجموعة 12)
# above_mean (data set 12)
# Demonstrates: إحصاء وبحث
#
# Run:  python apl.py examples/10004-stat-above_mean-set12.apl

# إحصاء بسيط على قائمة أعداد صحيحة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  م = 0
  لكل خ في ق:
    م = م + خ
  م = م // len(ق)
  ع = 0
  لكل خ في ق:
    لو خ > م:
      ع = ع + 1
  ارجع ع

تأكد_يساوي(ف([58, 53, 24, 21, 14, 20, 17, 59, 38]), 4, "حالة 1")
تأكد_يساوي(ف([8, 31, 39, 9, 15, 14]), 2, "حالة 2")
تأكد_يساوي(ف([12, 24, 50, 41, -9, 44, -16, 14]), 4, "حالة 3")
تأكد_يساوي(ف([7, -5, 43, 58, 14, -2]), 2, "حالة 4")
