# مثال 5192 — مجموع تراكمي مع زيادة 5
# Running total plus 5 per step
# Demonstrates: تمارين متنوعة
#
# Run:  python apl.py examples/5192-cumulative-5.apl

# كل خطوة نضيف العنصر والزيادة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ر = []
  م = 0
  لكل خ في ق:
    م = م + خ + 5
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف([1, 2, 3]), [6, 13, 21], "حالة 1")
تأكد_يساوي(ف([]), [], "حالة 2")
تأكد_يساوي(ف([5, 5, 5, 5]), [10, 20, 30, 40], "حالة 3")
