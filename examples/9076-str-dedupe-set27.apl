# مثال 9076 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 27)
# dedupe (test set 27)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9076-str-dedupe-set27.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("tenet"), "ten", "حالة 1")
تأكد_يساوي(ف("racecar"), "race", "حالة 2")
تأكد_يساوي(ف("level"), "lev", "حالة 3")
تأكد_يساوي(ف("bob"), "bo", "حالة 4")
تأكد_يساوي(ف("radar"), "rad", "حالة 5")
