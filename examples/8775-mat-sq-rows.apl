# مثال 8775 — مجموع كل صف لمصفوفة قيمها i*i+j
# Matrix rows for cell formula i*i+j
# Demonstrates: برمجة متنوعة
#
# Run:  python apl.py examples/8775-mat-sq-rows.apl

# نبني مصفوفة مربعة حسب الصيغة
# ثم نحسب المطلوب

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة بناء(ن):
  ر = []
  لكل ي في range(ن):
    س = []
    لكل ك في range(ن):
      س = س + [ي * ي + ك]
    ر = ر + [س]
  ارجع ر

دالة ف(ق):
  ر = []
  لكل س في ق:
    م = 0
    لكل خ في س:
      م = م + خ
    ر = ر + [م]
  ارجع ر

تأكد_يساوي(ف(بناء(1)), [0], "حجم 1")
تأكد_يساوي(ف(بناء(2)), [1, 3], "حجم 2")
تأكد_يساوي(ف(بناء(3)), [3, 6, 15], "حجم 3")
تأكد_يساوي(ف(بناء(5)), [10, 15, 30, 55, 90], "حجم 5")
