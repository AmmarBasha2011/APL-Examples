# مثال 4561 — آخر نتيجة ناقص 3 للأعداد الأكبر من 10
# Last (or -1) of minus 3 over the greater than 10 numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4561-pipeline-big-minus3-last.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 10:
      ن = ن + [خ - 3]
  لو len(ن) == 0:
    ارجع -1
  ارجع ن[len(ن) - 1]

تأكد_يساوي(ف([3, 1, 2, 8, 5]), -1, "حالة 1")
تأكد_يساوي(ف([30, 17, 8, -9, 5, 12, 6]), 9, "حالة 2")
تأكد_يساوي(ف([20, 11, 6, 4, 3, 1]), 8, "حالة 3")
تأكد_يساوي(ف([12, 7, 0, -4, 9, 15]), 12, "حالة 4")
تأكد_يساوي(ف([]), -1, "حالة 5")
