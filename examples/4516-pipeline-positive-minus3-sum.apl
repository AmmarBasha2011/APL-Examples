# مثال 4516 — مجموع نتيجة ناقص 3 للأعداد الموجبة
# Sum of minus 3 over the positive numbers
# Demonstrates: قوائم وتصفية وتحويل وتجميع
#
# Run:  python apl.py examples/4516-pipeline-positive-minus3-sum.apl

# نختار من القائمة الأعداد التي تحقق الشرط
# ثم نحوّلها ونجمع النتيجة

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ق):
  ن = []
  لكل خ في ق:
    لو خ > 0:
      ن = ن + [خ - 3]
  ج = 0
  لكل ي في ن:
    ج = ج + ي
  ارجع ج

تأكد_يساوي(ف([3, 1, 2, 8, 5]), 4, "حالة 1")
تأكد_يساوي(ف([1, 1, 2, 3, 5, 8, 13]), 12, "حالة 2")
تأكد_يساوي(ف([7, 14, 21, 28, 35, 42]), 129, "حالة 3")
تأكد_يساوي(ف([9, 0, 0, 4, 16]), 20, "حالة 4")
تأكد_يساوي(ف([]), 0, "حالة 5")
