# مثال 9219 — الحرف الأوسط (مجموعة اختبار 10)
# midchar (test set 10)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9219-str-midchar-set10.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("civic"), "v", "حالة 1")
تأكد_يساوي(ف("silent"), "e", "حالة 2")
تأكد_يساوي(ف("galaxy"), "a", "حالة 3")
تأكد_يساوي(ف("orbit"), "b", "حالة 4")
تأكد_يساوي(ف("stats"), "a", "حالة 5")
