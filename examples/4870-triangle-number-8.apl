# مثال 4870 — مجموع الأعداد من 1 إلى ضعف 8 وزيادة
# Sum 1..n for scaled n (k=8)
# Demonstrates: مالية وهندسة
#
# Run:  python apl.py examples/4870-triangle-number-8.apl

# مجموع الأعداد المتتالية = ن(ن+1)/2

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ن = ن * 8
  ارجع ن * (ن + 1) // 2

تأكد_يساوي(ف(1), 36, "حالة 1")
تأكد_يساوي(ف(2), 136, "حالة 2")
تأكد_يساوي(ف(3), 300, "حالة 3")
تأكد_يساوي(ف(10), 3240, "حالة 4")
