# مثال 9080 — حذف الحروف المكررة مع الحفاظ على الترتيب (مجموعة اختبار 31)
# dedupe (test set 31)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9080-str-dedupe-set31.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ر = ""
  لكل ح في ن:
    لو ليس (ح في ر):
      ر = ر + ح
  ارجع ر

تأكد_يساوي(ف("rotor"), "rot", "حالة 1")
تأكد_يساوي(ف("array"), "ary", "حالة 2")
تأكد_يساوي(ف("comet"), "comet", "حالة 3")
تأكد_يساوي(ف("apple"), "aple", "حالة 4")
تأكد_يساوي(ف("sun"), "sun", "حالة 5")
