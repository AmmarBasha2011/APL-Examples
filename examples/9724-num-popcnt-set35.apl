# مثال 9724 — عدد الآحاد في التمثيل الثنائي (مجموعة اختبار 35)
# popcnt (test set 35)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9724-num-popcnt-set35.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  طالما ن > 0:
    ع = ع + ن % 2
    ن = ن // 2
  ارجع ع

تأكد_يساوي(ف(2296), 6, "حالة 1")
تأكد_يساوي(ف(2040), 8, "حالة 2")
تأكد_يساوي(ف(966), 6, "حالة 3")
تأكد_يساوي(ف(2408), 5, "حالة 4")
تأكد_يساوي(ف(1290), 4, "حالة 5")
