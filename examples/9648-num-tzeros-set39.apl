# مثال 9648 — الأصفار في نهاية العاملي (مجموعة اختبار 39)
# tzeros (test set 39)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9648-num-tzeros-set39.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(408), 100, "حالة 1")
تأكد_يساوي(ف(236), 57, "حالة 2")
تأكد_يساوي(ف(486), 119, "حالة 3")
تأكد_يساوي(ف(269), 65, "حالة 4")
تأكد_يساوي(ف(296), 72, "حالة 5")
