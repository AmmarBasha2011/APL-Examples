# مثال 9586 — الجذر الرقمي (مجموعة اختبار 17)
# droot (test set 17)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9586-num-droot-set17.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(19942), 7, "حالة 1")
تأكد_يساوي(ف(53329), 4, "حالة 2")
تأكد_يساوي(ف(28901), 2, "حالة 3")
تأكد_يساوي(ف(37250), 8, "حالة 4")
تأكد_يساوي(ف(2608), 7, "حالة 5")
