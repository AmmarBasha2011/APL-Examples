# مثال 9629 — الأصفار في نهاية العاملي (مجموعة اختبار 20)
# tzeros (test set 20)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9629-num-tzeros-set20.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ع = 0
  ك = 5
  طالما ك <= ن:
    ع = ع + ن // ك
    ك = ك * 5
  ارجع ع

تأكد_يساوي(ف(275), 68, "حالة 1")
تأكد_يساوي(ف(272), 66, "حالة 2")
تأكد_يساوي(ف(195), 47, "حالة 3")
تأكد_يساوي(ف(208), 50, "حالة 4")
تأكد_يساوي(ف(443), 108, "حالة 5")
