# مثال 5082 — موضع أول ظهور للحرف n
# Index of first n
# Demonstrates: منطق وتمارين
#
# Run:  python apl.py examples/5082-first-index-n.apl

# نرجع -1 إن لم يوجد

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  لكل ي في range(len(ن)):
    لو ن[ي] == "n":
      ارجع ي
  ارجع -1

تأكد_يساوي(ف("banana"), 2, "حالة 1")
تأكد_يساوي(ف("education"), 8, "حالة 2")
تأكد_يساوي(ف(""), -1, "حالة 3")
تأكد_يساوي(ف("sky"), -1, "حالة 4")
