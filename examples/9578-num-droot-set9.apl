# مثال 9578 — الجذر الرقمي (مجموعة اختبار 9)
# droot (test set 9)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9578-num-droot-set9.apl

# دالة على عدد واحد
# نختبرها على خمس قيم

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  طالما ن >= 10:
    م = 0
    طالما ن > 0:
      م = م + ن % 10
      ن = ن // 10
    ن = م
  ارجع ن

تأكد_يساوي(ف(36645), 6, "حالة 1")
تأكد_يساوي(ف(30017), 2, "حالة 2")
تأكد_يساوي(ف(60198), 6, "حالة 3")
تأكد_يساوي(ف(58988), 2, "حالة 4")
تأكد_يساوي(ف(71726), 5, "حالة 5")
