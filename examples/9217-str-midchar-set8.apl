# مثال 9217 — الحرف الأوسط (مجموعة اختبار 8)
# midchar (test set 8)
# Demonstrates: دوال أساسية
#
# Run:  python apl.py examples/9217-str-midchar-set8.apl

# دالة على نص واحد
# نختبرها على خمس كلمات

دالة تأكد_يساوي(فعلي, متوقع, اسم):
  لو فعلي != متوقع:
    اطبع "فشل:", اسم
    اطبع "  متوقع:", متوقع
    اطبع "  فعلي:", فعلي
    قياسي_نظام_اخرج(1)
  اطبع "ناجح:", اسم

دالة ف(ن):
  ارجع ن[len(ن) // 2]

تأكد_يساوي(ف("saturn"), "u", "حالة 1")
تأكد_يساوي(ف("level"), "v", "حالة 2")
تأكد_يساوي(ف("comet"), "m", "حالة 3")
تأكد_يساوي(ف("venus"), "n", "حالة 4")
تأكد_يساوي(ف("enlist"), "i", "حالة 5")
